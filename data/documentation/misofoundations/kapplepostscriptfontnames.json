n to the OS"},{"type":"text","text":" "},{"type":"text","text":"except their PostScript names."},{"type":"text","text":" "},{"type":"text","text":"This dictionnary defines the expected PostScript names of font families known in iOS."},{"type":"text","text":" "},{"type":"text","text":"Depending to the font family, several rules are applied, with for example removal of whitespaces"},{"type":"text","text":" "},{"type":"text","text":"and adding of prefixes of suffixes after the font family name or the weight."}],"kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostScriptFontNamesMap","kind":"identifier"}],"navigatorTitle":[{"text":"PostScriptFontNamesMap","kind":"identifier"}],"role":"symbol","title":"PostScriptFontNamesMap","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/PostScriptFontNamesMap"},"ic_layers.png":{"type":"image","alt":null,"identifier":"ic_layers.png","variants":[{"url":"\/images\/MISOFoundations\/ic_layers.png","traits":["1x","light"]}]}}}