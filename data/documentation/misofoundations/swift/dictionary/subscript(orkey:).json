{"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"Foundations","relatedModules":["Swift"]}],"title":"subscript(orKey:)","role":"symbol","extendedModule":"Swift","symbolKind":"subscript","roleHeading":"Instance Subscript","externalID":"s:SD15MISOFoundationsAA25PostScriptFontNamesMapKeyVRszSSRs_rlE02orG0SSAC_tcip","conformance":{"constraints":[{"type":"codeVoice","code":"Key"},{"type":"text","text":" is "},{"type":"codeVoice","code":"PostScriptFontNamesMapKey"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Value"},{"type":"text","text":" is "},{"type":"codeVoice","code":"String"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"fragments":[{"text":"subscript","kind":"keyword"},{"text":"(","kind":"text"},{"text":"orKey","kind":"externalParam"},{"text":" _: ","kind":"text"},{"text":"Key","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}]},"identifier":{"url":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/Swift\/Dictionary\/subscript(orKey:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/MISOFoundations\/documentation\/MISOFoundations","doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/Swift","doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/Swift\/Dictionary"]]},"sections":[],"abstract":[{"type":"text","text":"If there is no value for the given "},{"code":"key","type":"codeVoice"},{"type":"text","text":", returns the description of this key,"},{"type":"text","text":" "},{"type":"text","text":"i.e.font family name without the font weight in the end and without whitespaces."}],"variants":[{"paths":["\/documentation\/misofoundations\/swift\/dictionary\/subscript(orkey:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swif