xtual elements.","type":"text"},{"text":" ","type":"text"},{"text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not.","type":"text"},{"text":" ","type":"text"},{"text":"See for example ","type":"text"},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"reference","isActive":true}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOWCAG21Ratio"}],"navigatorTitle":[{"text":"MISOWCAG21Ratio","kind":"identifier"}],"type":"topic","url":"\/documentation\/misofoundations\/misowcag21ratio","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio","title":"MISOWCAG21Ratio"},"doc://MISOFoundations/documentation/MISOFoundations":{"abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets."}],"url":"\/documentation\/misofoundations","kind":"symbol","type":"topic","title":"Foundations","role":"collection","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations","images":[{"identifier":"ic_layers.png","type":"icon"}]}}}