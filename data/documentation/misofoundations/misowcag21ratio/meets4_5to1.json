:" ","type":"text"},{"text":"See for example ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"type":"topic","title":"MISOWCAG21Ratio","kind":"symbol","navigatorTitle":[{"text":"MISOWCAG21Ratio","kind":"identifier"}],"url":"\/documentation\/misofoundations\/misowcag21ratio","role":"symbol"},"https://system.design.orange.com/0c1af118d/p/2531b9-accessibility-compliance":{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"link","title":"the following guidelines","titleInlineContent":[{"type":"text","text":"the following guidelines"}],"url":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"},"doc://MISOFoundations/documentation/MISOFoundations":{"kind":"symbol","images":[{"type":"icon","identifier":"ic_layers.png"}],"abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets."}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations","title":"Foundations","type":"topic","role":"collection","url":"\/documentation\/misofoundations"}}}