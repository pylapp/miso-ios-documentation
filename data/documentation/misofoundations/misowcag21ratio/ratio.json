ple "},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"reference","isActive":true}],"url":"\/documentation\/misofoundations\/misowcag21ratio","type":"topic","title":"MISOWCAG21Ratio"},"doc://MISOFoundations/documentation/MISOFoundations":{"type":"topic","title":"Foundations","abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets."}],"images":[{"identifier":"ic_layers.png","type":"icon"}],"kind":"symbol","role":"collection","url":"\/documentation\/misofoundations","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations"},"https://accessibilite.numerique.gouv.fr":{"title":"Référentiel Général d’Amélioration de l’Accessibilité","identifier":"https:\/\/accessibilite.numerique.gouv.fr","titleInlineContent":[{"text":"Référentiel Général d’Amélioration de l’Accessibilité","type":"text"}],"type":"link","url":"https:\/\/accessibilite.numerique.gouv.fr"}}}