rast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"role":"symbol","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOWCAG21Ratio"}],"url":"\/documentation\/misofoundations\/misowcag21ratio","navigatorTitle":[{"kind":"identifier","text":"MISOWCAG21Ratio"}],"type":"topic","kind":"symbol","title":"MISOWCAG21Ratio"},"doc://MISOFoundations/documentation/MISOFoundations":{"images":[{"type":"icon","identifier":"ic_layers.png"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations","role":"collection","url":"\/documentation\/misofoundations","type":"topic","title":"Foundations","kind":"symbol","abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets. Inherited from OUDS."}]},"https://system.design.orange.com/0c1af118d/p/2531b9-accessibility-compliance":{"type":"link","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","title":"the following guidelines","titleInlineContent":[{"type":"text","text":"the following guidelines"}],"url":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}}}