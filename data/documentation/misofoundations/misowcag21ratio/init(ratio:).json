":{"title":"Référentiel Général d’Amélioration de l’Accessibilité","titleInlineContent":[{"type":"text","text":"Référentiel Général d’Amélioration de l’Accessibilité"}],"identifier":"https:\/\/accessibilite.numerique.gouv.fr","type":"link","url":"https:\/\/accessibilite.numerique.gouv.fr"},"ic_layers.png":{"alt":null,"identifier":"ic_layers.png","type":"image","variants":[{"url":"\/images\/MISOFoundations\/ic_layers.png","traits":["1x","light"]}]},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio/init(ratio:)":{"abstract":[{"type":"text","text":"Defines a WCAG 2.1 ratio with the given contrast ratio value"}],"role":"symbol","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ratio"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"kind":"text","text":")"}],"url":"\/documentation\/misofoundations\/misowcag21ratio\/init(ratio:)","title":"init(ratio:)","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio\/init(ratio:)","kind":"symbol"},"doc://MISOFoundations/documentation/MISOFoundations":{"abstract":[{"text":"Contains a set of helpers and extensions shared for higher level targets.","type":"text"}],"role":"collection","images":[{"type":"icon","identifier":"ic_layers.png"}],"type":"topic","url":"\/documentation\/misofoundations","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations","title":"Foundations","kind":"symbol"},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio":{"navigatorTitle":[{"kind":"identifier","text":"MISOWCAG21Ratio"}],"role":"symbol","type":"topic","abstract":[{"text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"identifier":"https:\/\/accessibilite.numerique.gouv.fr","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"type":"text","text":" "},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","isActive":true}],"title":"MISOWCAG21Ratio","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MISOWCAG21Ratio","kind":"identifier"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio","url":"\/documentation\/misofoundations\/misowcag21ratio","kind":"symbol"}}}