ype":"text"},{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"text":" ","type":"text"},{"type":"text","text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual"},{"type":"text","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"text":" ","type":"text"},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"role":"symbol","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOWCAG21Ratio"}],"url":"\/documentation\/misofoundations\/misowcag21ratio","navigatorTitle":[{"kind":"identifier","text":"MISOWCAG21Ratio"}],"type":"topic","kind":"symbol","title":"MISOWCAG21Ratio"},"ic_layers.png":{"type":"image","alt":null,"identifier":"ic_layers.png","variants":[{"traits":["1x","light"],"url":"\/images\/MISOFoundations\/ic_layers.png"}]},"https://system.design.orange.com/0c1af118d/p/2531b9-accessibility-compliance":{"type":"link","titleInlineContent":[{"type":"text","text":"the following guidelines"}],"title":"the following guidelines","url":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}}}