text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"type":"reference","isActive":true,"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"kind":"symbol","type":"topic","title":"MISOWCAG21Ratio","url":"\/documentation\/misofoundations\/misowcag21ratio","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOWCAG21Ratio","kind":"identifier"}]},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio/init(ratio:)":{"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio\/init(ratio:)","type":"topic","abstract":[{"text":"Defines a WCAG 2.1 ratio with the given contrast ratio value","type":"text"}],"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ratio","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":")","kind":"text"}],"url":"\/documentation\/misofoundations\/misowcag21ratio\/init(ratio:)","title":"init(ratio:)","kind":"symbol"}}}