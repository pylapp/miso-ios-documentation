mpliance"}],"role":"symbol","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOWCAG21Ratio"}],"url":"\/documentation\/misofoundations\/misowcag21ratio","navigatorTitle":[{"kind":"identifier","text":"MISOWCAG21Ratio"}],"type":"topic","kind":"symbol","title":"MISOWCAG21Ratio"},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio/meets3to1":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"If the computed contrast ratio between two given colors meets the 3:1 requirement"}],"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"meets3to1","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"meets3to1","kind":"symbol","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio\/meets3to1","url":"\/documentation\/misofoundations\/misowcag21ratio\/meets3to1"},"doc://MISOFoundations/documentation/MISOFoundations":{"images":[{"type":"icon","identifier":"ic_layers.png"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations","role":"collection","url":"\/documentation\/misofoundations","type":"topic","title":"Foundations","kind":"symbol","abstract":[{"type":"text","text":"Contains a set of helpers and extensions shared for higher level targets. Inherited from OUDS."}]},"ic_layers.png":{"alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/MISOFoundations\/ic_layers.png"}],"identifier":"ic_layers.png","type":"image"}}}