{"metadata":{"externalID":"s:15MISOFoundations15MISOWCAG21RatioV9meets3to1Sbvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"meets3to1","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"meets3to1","modules":[{"name":"Foundations"}],"symbolKind":"property","roleHeading":"Instance Property","role":"symbol"},"abstract":[{"type":"text","text":"If the computed contrast ratio between two given colors meets the 3:1 requirement"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"meets3to1","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misofoundations\/misowcag21ratio\/meets3to1"]}],"hierarchy":{"paths":[["doc:\/\/MISOFoundations\/documentation\/MISOFoundations","doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio"]]},"sections":[],"identifier":{"url":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio\/meets3to1","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://MISOFoundations/documentation/MISOFoundations":{"abstract":[{"text":"Contains a set of helpers and extensions shared for higher level targets.","type":"text"}],"kind":"symbol","type":"topic","images":[{"identifier":"ic_layers.png","type":"icon"}],"title":"Foundations","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations","role":"collection","url":"\/documentation\/misofoundations"},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio":{"title":"MISOWCAG21Ratio","fragments":[{"text":"struct","