,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"text":" ","type":"text"},{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"text":" ","type":"text"},{"text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual","type":"text"},{"text":" ","type":"text"},{"text":"and 4.5:1 for non-textual elements.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"text":"See for example ","type":"text"},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","isActive":true,"type":"reference"}],"role":"symbol"},"doc://MISOFoundations/documentation/MISOFoundations/WCAG21Requirements":{"url":"\/documentation\/misofoundations\/wcag21requirements","role":"symbol","navigatorTitle":[{"text":"WCAG21Requirements","kind":"identifier"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/WCAG21Requirements","type":"topic","kind":"symbol","title":"WCAG21Requirements","abstract":[{"text":"WCAG 2.1 AA and AAA requirements use ratio for textual and non textual components","type":"text"}],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WCAG21Requirements","kind":"identifier"}]},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio/requirementsAA":{"url":"\/documentation\/misofoundations\/misowcag21ratio\/requirementsaa","role":"symbol","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio\/requirementsAA","type":"topic","title":"requirementsAA","kind":"symbol","abstract":[{"type":"text","text":"WCAG 2.1 requirement for AA level needs to have textual component matching 4.5:1 contrast ratio"},{"type":"text","text":" "},{"type":"text","text":"and non textual component matching 3:1 contrast ratio."},{"type":"text","text":" "},{"type":"text","text":"This is recommended for web projects."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"requirementsAA"},{"kind":"text","text":": "},{"preciseIdentifier":"s:15MISOFoundations18WCAG21Requirementsa","kind":"typeIdentifier","text":"WCAG21Requirements"}]}}}