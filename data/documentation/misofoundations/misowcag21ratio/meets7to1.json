xt","text":" "},{"type":"text","text":"and 4.5:1 for non-textual elements."},{"type":"text","text":" "},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"type":"text","text":"See for example "},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","type":"reference","isActive":true}],"url":"\/documentation\/misofoundations\/misowcag21ratio","type":"topic","title":"MISOWCAG21Ratio"},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio/meets7to1":{"title":"meets7to1","url":"\/documentation\/misofoundations\/misowcag21ratio\/meets7to1","role":"symbol","type":"topic","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio\/meets7to1","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"meets7to1"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"abstract":[{"type":"text","text":"If the computed contrast ratio between two given colors meets the 7:1 requirement"}]}}}