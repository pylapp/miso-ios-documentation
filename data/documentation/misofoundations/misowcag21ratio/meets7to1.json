r example ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"type":"topic","title":"MISOWCAG21Ratio","kind":"symbol","navigatorTitle":[{"text":"MISOWCAG21Ratio","kind":"identifier"}],"url":"\/documentation\/misofoundations\/misowcag21ratio","role":"symbol"},"ic_layers.png":{"identifier":"ic_layers.png","alt":null,"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOFoundations\/ic_layers.png"}]},"doc://MISOFoundations/documentation/MISOFoundations/MISOWCAG21Ratio/meets7to1":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"meets7to1"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/MISOWCAG21Ratio\/meets7to1","abstract":[{"type":"text","text":"If the computed contrast ratio between two given colors meets the 7:1 requirement"}],"kind":"symbol","type":"topic","title":"meets7to1","url":"\/documentation\/misofoundations\/misowcag21ratio\/meets7to1","role":"symbol"}}}