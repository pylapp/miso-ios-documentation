y on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"type":"text","text":", and together define a "},{"inlineContent":[{"type":"text","text":"composite raw token"}],"type":"emphasis"},{"type":"text","text":" for "},{"inlineContent":[{"type":"text","text":"elevation"}],"type":"emphasis"},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"kind":"symbol","title":"ElevationCompositeRawToken","identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationCompositeRawToken","url":"\/documentation\/misotokensraw\/elevationcompositerawtoken","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeRawToken","kind":"identifier"}],"navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}]},"doc://MISOTokensRaw/documentation/MISOTokensRaw/ColorRawToken":{"title":"ColorRawToken","url":"\/documentation\/misotokensraw\/colorrawtoken","identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ColorRawToken","kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ColorRawToken"}],"abstract":[{"text":"A color raw token is finaly a ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" containing the hexadecimal code of the color, to keep grammar clean and clear with design system grammar.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ColorRawToken"}],"role":"symbol"},"doc://MISOTokensRaw/documentation/MISOTokensRaw/FontRaw