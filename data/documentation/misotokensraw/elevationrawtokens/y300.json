"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationRawToken","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ElevationRawToken","kind":"identifier"}],"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationRawToken","abstract":[{"type":"text","text":"Type aliases precising "},{"type":"codeVoice","code":"CGFloat"},{"type":"text","text":" values are used (because used in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"SwiftUI"}]},{"type":"text","text":" API) for each "},{"type":"strong","inlineContent":[{"type":"text","text":"elevation raw token"}]},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"url":"\/documentation\/misotokensraw\/elevationrawtoken"},"doc://MISOTokensRaw/documentation/MISOTokensRaw/ElevationRawTokens/y300":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationRawTokens\/y300","abstract":[{"type":"text","text":"Has for value 4"}],"title":"y300","url":"\/documentation\/misotokensraw\/elevationrawtokens\/y300","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"y300","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ElevationRawToken","preciseIdentifier":"s:13MISOTokensRaw09ElevationB5Tokena","kind":"typeIdentifier"}]},"doc://MISOTokensRaw/documentation/MISOTokensRaw/ElevationRawTokens":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationRawTokens","abstract":[{"type":"text","text":"Defined as the group of all "},{"type":"strong","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":" related to "},{"type":"strong","inlineContent":[{"type":"text","text":"elevations"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationRawTokens","type":"reference","isActive":true},{"type":"text","text":" are tokens to use to define "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevations"}]},{"type":"text","text":" , i.e. in the end box shadow effects."},{"type":"text","text":" "},{"type":"text","text":"These tokens are used to define these effects thanks to several types: the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"blur"}]},{"type":"text","text":", the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"X offset"}]},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Y offset"}]},{"type":"text","text":", all of them being "},{"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationRawToken","type":"reference","isActive":true},{"type":"text","text":" type."},{"type":"text","text":" "},{"type":"text","text":"Combinations of these three values can be defined inside "},{"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationCompositeRawToken","type":"reference","isActive":true},{"type":"text","text":" i.e. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite tokens"}]},{"type":"text","text":" defining a whil box shadow to use for elevation effect."}],"title":"ElevationRawTokens","url":"\/documentation\/misotokensraw\/elevationrawtokens","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationRawTokens","kind":"identifier"}],"navigatorTitle":[{"text":"ElevationRawTokens","kind":"identifier"}]},"doc://MISOTokensRaw/documentation/MISOTokensRaw/ElevationCompositeRawToken":{"role":"symbol","title":"ElevationCompositeRawToken","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeRawToken","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}],"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationCompositeRawToken","abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" global design system, composite tokens are defined for elevation effects."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" is caracterized by "},{"type":"emphasis","inlineContent":[{"type":"text","text":"X and Y offsets"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"radius"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"url":"\/documentation\/misotokensraw\/elevationcompositerawtoken"},"doc://MISOTokensRaw/documentation/MISOTokensRaw":{"role":"collection","type":"topic","abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Raw tokens"}]},{"type":"text","text":" are smallest "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" possible. They are associated to raw values and will be finaly the values assigned to the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" properties."}],"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw","kind":"symbol","title":"Tokens with raw values","url":"\/documentation\/misotokensraw","images":[{"type":"icon","identifier":"ic_design_tokens_raws_intro.png"}]}}}