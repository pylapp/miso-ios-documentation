","navigatorTitle":[{"text":"ElevationCompositeRawToken","kind":"identifier"}],"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationCompositeRawToken","abstract":[{"type":"text","text":"In the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" global design system, composite tokens are defined for elevation effects."},{"type":"text","text":" "},{"type":"text","text":"Composite tokens are tokens defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" by other tokens."},{"type":"text","text":" "},{"type":"text","text":"Here an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" is caracterized by "},{"type":"emphasis","inlineContent":[{"type":"text","text":"X and Y offsets"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"radius"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"url":"\/documentation\/misotokensraw\/elevationcompositerawtoken"},"doc://MISOTokensRaw/documentation/MISOTokensRaw/ElevationCompositeRawToken/color":{"role":"symbol","title":"color","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"color","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:13MISOTokensRaw05ColorB5Tokena","text":"ColorRawToken","kind":"typeIdentifier"}],"type":"topic","identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationCompositeRawToken\/color","abstract":[{"type":"text","text":"The color of the shadow effect"}],"url":"\/documentation\/misotokensraw\/elevationcompositerawtoken\/color"},"doc://MISOTokensRaw/documentation/MISOTokensRaw":{"role":"collection","type":"topic","abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Raw tokens"}]},{"type":"text","text":" are smallest "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" possible. They are associated to raw values and will be finaly the values assigned to the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" properties."}],"identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw","kind":"symbol","title":"Tokens with raw values","url":"\/documentation\/misotokensraw","images":[{"type":"icon","identifier":"ic_design_tokens_raws_intro.png"}]},"doc://MISOTokensRaw/documentation/MISOTokensRaw/ColorRawToken":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ColorRawToken","abstract":[{"type":"text","text":"A color raw token is finaly a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" containing the hexadecimal code of the color, to keep grammar clean and clear with design system grammar."}],"title":"ColorRawToken","url":"\/documentation\/misotokensraw\/colorrawtoken","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorRawToken"}],"navigatorTitle":[{"kind":"identif