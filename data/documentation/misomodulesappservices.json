{"topicSections":[{"title":"Classes","identifiers":["doc:\/\/MISOModulesAppServices\/documentation\/MISOModulesAppServices\/MISOAppStoreUpdateViewModel"],"anchor":"Classes","generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/MISOModulesAppServices\/documentation\/MISOModulesAppServices\/MISOAppStoreUpdateService"],"generated":true},{"anchor":"Extended-Modules","title":"Extended Modules","identifiers":["doc:\/\/MISOModulesAppServices\/documentation\/MISOModulesAppServices\/Foundation"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misomodulesappservices"]}],"identifier":{"url":"doc:\/\/MISOModulesAppServices\/documentation\/MISOModulesAppServices","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Applications are exposed through the App Store, and updates can be available."},{"type":"text","text":" "},{"type":"text","text":"In addition, applications have build informations and maintainers, and these informations can be displayed."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Check-for-App-Store-updates","text":"Check for App Store updates"},{"type":"paragraph","inlineContent":[{"text":"In your view, instanciate the dedicated view model:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["    @State private var appStoreVM = MISOAppStoreUpdateViewModel(appStoreID: APP_STORE_ID, country: COUNTRY_CODE)    "]},{"inlineContent":[{"type":"text","text":"It will automatically check for App Store updates."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Then, in your view:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["    var body: some View {","        SomeView()","        .alert(appStoreVM.alertTitle, isPresented: $appStoreVM.showUpdateAlert) {","            Button(\"Dismiss\", role: .cancel) {}","            if let url = appStoreVM.appStoreURL {","                Button(\"Go to App Store\") {","                    UIApplication.shared.open(url)","                }","            }","        } message: {","            Text(appStoreVM.alertMessage)","        }","    }    "]},{"text":"App details sheet","anchor":"App-details-sheet","level":2,"type":"heading"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"image_appdetails_BlueCoat_BrutToSuit","type":"image"}]}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"image_appdetails_FoxyRough_BrutToSuit"}]}]}]},{"inlineContent":[{"type":"text","text":"Applications have a build number, a version and also a build type (debug, beta, stable)."},{"type":"text","text":" "},{"type":"text","text":"Open source applications should also open their bug tracker and redirect the users to their source code."},{"text":" ","type":"text"},{"type":"text","text":"Applications should also have privacy statement and terms of use documents, and information about"},{"text":" ","type":"text"},{"type":"text","text":"their editor. The "},{"code":"MISOAppDetailsSheet","type":"codeVoice"},{"text":" displays all of that at once, assembling the","type":"text"},{"text":" ","type":"text"},{"code":"MISOAppAboutSection","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MISOAppLegalSection","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MISOAppEditorSection","type":"codeVoice"},{"text":" views from the","type":"text"},{"text":" ","type":"text"},{"code":"MISOComponentsMISO","type":"codeVoice"},{"text":" module.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    let myAppLegalInfo = MISOAppLegalInfo(privacyStatement: URL(string: somePrivacyDocumentUrl)!,","                                          termsOfUses: URL(string: someToSDocumentUrl)!)","    let myAppSupportInfo = MISOAppSupportInfo(bugReport: issueTrackerURL, sourceCode: forgeURL)","    let myAppEditor = MISOAppEditor(name: someName, website: websiteReference, mastodon: mastodonReference)","","    SomeView()","        .sheet(isPresented: $isAboutSheetPresented) {","            MISOAppDetailsSheet(appIcon: myAppLogoImage,","                                legalInfo: myAppLegalInfo,","                                supportInfo: myAppSupportInfo,","                                editorInfo: myAppEditor)","        }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Several elements msut be defined in the app Info.plist:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CFBundleDisplayName:"}]},{"text":" App name","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CFBundleShortVersionString"}]},{"text":": Marketing version of the app","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CFBundleVersion:"}]},{"text":" Build number of the app","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MISO_ForApp_ReleaseTag"}]},{"text":": The release tag, e.g. 1.2.3-rc.4","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MISO_ForApp_BuildType"}]},{"text":": In “debug”, “beta (TestFlight)”, and “stable (AppStore)”","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[[]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"title":"MISO Module App Services","roleHeading":"Library","role":"collection","symbolKind":"module","images":[{"identifier":"ic_modules_miso_appservices.png","type":"icon"}],"externalID":"MISOModulesAppServices","modules":[{"name":"MISO Module App Services"}]},"sec