}],"type":"paragraph"},{"type":"codeListing","code":["    let myAppURLS = MISOAppDetailsURL(bugReport: issueTrackerURL, sourceCode: forgeURL)","    let myAppEditor = MISOAppEditor(name: someName, website: websiteReference, mastodon: mastodonReference)","","    SomeView()","        .sheet(isPresented: $isAboutSheetPresented) {","            MISOAppDetailsSheet(appIcon: myAppLogoImage, appURLs: myAppURLS, editor: myAppEditor)","        }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Several elements msut be defined in the app Info.plist:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CFBundleDisplayName:"}]},{"type":"text","text":" App name"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CFBundleShortVersionString"}]},{"type":"text","text":": Marketing version of the app"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"CFBundleVersion:","type":"text"}]},{"type":"text","text":" Build number of the app"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"MISO_ForApp_ReleaseTag","type":"text"}]},{"type":"text","text":": The release tag, e.g. 1.2.3-rc.4"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"MISO_ForApp_BuildType"}]},{"text":": In “debug”, “beta (TestFlight)”, and “stable (AppStore)”","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misomodulesappservices"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Library","symbolKind":"module","role":"collection","title":"MISO Module App Services","externalID":"MISOModulesAppServices","modules":[{"name":"MISO Module App Services"}],"images":[{"type":"icon","ide