:[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"image_confettis_BlueCoat_BrutToSuit.png"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"image_confettis_FoxyRough_BrutToSuit.png"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Easter eggs are fun, and confettis too."}]},{"syntax":"swift","type":"codeListing","code":["    someView","    .overlay {","        if showConfetti { \/\/ Toggle this boolea flag with your logic","            MISOConfettiView(isActive: $showConfetti)","            .ignoresSafeArea()","            .allowsHitTesting(false)","        }","    } "]},{"level":2,"text":"Splash screen","anchor":"Splash-screen","type":"heading"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"image_splashscreen_BlueCoat_BrutToSuit.png"}],"type":"paragraph"}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"identifier":"image_splashscreen_FoxyRough_BrutToSuit.png","type":"image"}],"type":"paragraph"}],"title":"FoxyRough"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"A splash screen is an element to display quickly in fullscreen when the app starts, with the app logo centered.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["    MISOSplashScreenView(appLogo: Image(decorative: \"Logo\")) {","        \/\/ Action to done with splash screen is done","    }    "]},{"level":2,"text":"Onboarding","anchor":"Onboarding","type":"heading"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"image_onboarding_BlueCoat_BrutToSuit.png"}]}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"identifier":"image_onboarding_FoxyRough_BrutToSuit.png","type":"image"}],"type":"paragraph"}],"title":"FoxyRough"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Onboarding users to the app can be very useful to introduce key concepts and features."}]},{"type":"codeListing","code":["    \/\/ Define the pages","    private var onboardingPages: [MISOOnboardingPage] {","        [","         MISOOnboardingPage(","            image: Image(systemName: \"hand.wave\"),","            itle: Text(\"onboarding.page1.title\"),","            description: Text(\"onboarding.page1.description\")),","         MISOOnboardingPage(","            image: Image(systemName: \"arrow.left.arrow.right\"),","            title: Text(\"onboarding.page2.title\"),","            description: Text(\"onboarding.page2.description\")),","         MISOOnboardingPage(","            image: Image(systemName: \"cpu\"),","            title: Text(\"onboarding.page3.title\"),","             description: Text(\"onboarding.page3.description\"))","         ]","    }","","    \/\/ Add to the view","    MISOOnboardingView(pages: onboardingPages) {","        \/\/ Action to do when the onboarding is done","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional "},{"code":"showProgressIndicator","type":"codeVoice"},{"type":"text","text":" flag ("},{"code":"false","type":"codeVoice"},{"type":"text","text":" by default) displays a "},{"code":"MISOLinearProgressIndicator","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"above the navigation bar, filled according to the current page position (e.g. page 1 of 4 fills"},{"type":"text","text":" "},{"type":"text","text":"the indicator to 25%). The progress is also vocalized to VoiceOver as “Page X of Y”. Its layout space"},{"type":"text","text":" "},{"type":"text","text":"is reserved from the view’s first display to avoid any reflow of the page content; it only fades in"},{"type":"text","text":" "},{"type":"text","text":"after a short delay."}]},{"type":"codeListing","code":["    MISOOnboardingView(pages: onboardingPages, showProgressIndicator: true) {","        \/\/ Action to do when the onboarding is done","    }"],"syntax":