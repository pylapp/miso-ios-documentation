{"hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"The catalog of all components provided by MISO, not inherited from OUDS."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"collection","modules":[{"name":"Components (MISO)"}],"title":"Components (MISO)","externalID":"MISOComponentsMISO","images":[{"identifier":"ic_components_miso.png","type":"icon"}],"roleHeading":"Library","symbolKind":"module"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Here are the original components."}],"type":"paragraph"},{"text":"Display confettis (like easter eggs)","level":2,"anchor":"Display-confettis-like-easter-eggs","type":"heading"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"image_confettis_BlueCoat_BrutToSuit.png","type":"image"}]}],"title":"BlueCoat"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"image_confettis_FoxyRough_BrutToSuit.png"}]}],"title":"FoxyRough"}],"type":"tabNavigator"},{"inlineContent":[{"text":"Easter eggs are fun, and confettis too.","type":"text"}],"type":"paragraph"},{"code":["    someView","    .overlay {","        if showConfetti { \/\/ Toggle this boolea flag with your logic","            MISOConfettiView(isActive: $showConfetti)","            .ignoresSafeArea()","            .allowsHitTesting(false)","        }","    } "],"type":"codeListing","syntax":"swift"},{"text":"Splash screen","level":2,"anchor":"Splash-screen","type":"heading"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"image_splashscreen_BlueCoat_BrutToSuit.png"}]}],"title":"BlueCoat"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"image_splashscreen_FoxyRough_BrutToSuit.png","type":"image"}]}],"title":"FoxyRough"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"A splash screen is an element to display quickly in fullscreen when the app starts, with the app logo centered."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    MISOSplashScreenView(appLogo: Image(decorative: \"Logo\")) {","        \/\/ Action to done with splash screen is done","    }    "]},{"anchor":"Onboarding","level":2,"type":"heading","text":"Onboarding"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"image_onboarding_BlueCoat_BrutToSuit.png"}]}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"identifier":"image_onboarding_FoxyRough_BrutToSuit.png","type":"image"}]}]}]},{"inlineContent":[{"type":"text","text":"Onboarding users to the app can be very useful to introduce key concepts and features."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Define the pages","    private var onboardingPages: [MISOOnboardingPage] {","        [","         MISOOnboardingPage(","            image: Image(systemName: \"hand.wave\"),","            itle: Text(\"onboarding.page1.title\"),","            description: Text(\"onboarding.page1.description\")),","         MISOOnboardingPage(","            image: Image(systemName: \"arrow.left.arrow.right\"),","            title: Text(\"onboarding.page2.title\"),","            description: Text(\"onboarding.page2.description\")),","         MISOOnboardingPage(","            image: Image(systemName: \"cpu\"),","            title: Text(\"onboarding.page3.title\"),","             description: Text(\"onboarding.page3.description\"))","         ]","    }","","    \/\/ Add to the view","    MISOOnboardingView(pages: onboardingPages) {","        \/\/ Action to do when the onboarding is done","    }"]},{"inlineContent":[{"type":"text","text":"An optional "},{"type":"codeVoice","code":"showProgressIndicator"},{"text":" flag (","type":"text"},{"code":"false","type":"codeVoice"},{"text":" by default) displays a ","type":"text"},{"code":"MISOLinearProgressIndicator","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"above the navigation bar, filled according to the current page position (e.g. page 1 of 4 fills"},{"type":"text","text":" "},{"type":"text","text":"the indicator to 25%). The progress is also vocalized to VoiceOver as “Page X of Y”. Its layout space"},{"type":"text","text":" "},{"type":"text","text":"is reserved from the view’s first display to avoid any reflow of the page content; it only fades in"},{"type":"text","text":" "},{"type":"text","text":"after a short delay."}],"type":"paragraph"},{"code":["    MISOOnboardingView(pages: onboardingPages, showProgressIndicator: true) {","        \/\/ Action to do when the onboarding is done","    }"],"type":"codeListing","syntax":"swift"},{"anchor":"Display-app-about-information","level":2,"text":"Display app about information","type":"heading"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"image_buildinfo_BlueCoat_BrutToSuit.png","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"image_buildinfo_FoxyRough_BrutToSuit.png"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Applications have a build number, a version and also a build type (debug, beta, stable), plus an"},{"type":"text","text":" "},{"type":"text","text":"optional release tag. The "},{"type":"codeVoice","code":"MISOAppAboutSection"},{"type":"text","text":" view displays them, and also drives a hidden action"},{"type":"text","text":" "},{"type":"text","text":"(tap the build-type row 8 times) that can be wired to a "},{"type":"codeVoice","code":"MISOConfettiView"},{"type":"text","text":" easter egg."}],"type":"paragraph"},{"syntax":"swift","code":["    @State private var showConfetti = false","","    MISOAppAboutSection(","        appAbout: MISOAppAbout(","            version: BuildInfo.appVersion,","            buildNumber: BuildInfo.buildNumber,","            buildInfo: BuildInfo.buildTypeInfo,","            releaseTag: BuildInfo.releaseTag),","        actionTriggered: $showConfetti)"],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Display-app-editor-information","text":"Display app editor information"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"image_editorinfo_BlueCoat_BrutToSuit.png","type":"image"}]}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"identifier":"image_editorinfo_FoxyRough_BrutToSuit.png","type":"image"}],"type":"paragraph"}],"title":"FoxyRough"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applications can credit their editor with a name and links to their website and Mastodon profile."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"MISOAppEditorSection"},{"type":"text","text":" view displays them, opening the links in-app."}]},{"syntax":"swift","code":["    let myAppEditor = MISOAppEditor(name: someName, website: websiteReference, mastodon: mastodonReference)","","    MISOAppEditorSection(appEditor: myAppEditor)"],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Display-app-legal-information","text":"Display app legal information"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"image_legalinfo_BlueCoat_BrutToSuit.png","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"identifier":"image_legalinfo_FoxyRough_BrutToSuit.png","type":"image"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Applications should have privacy statement and terms of use documents."},{"type":"text","text":" "},{"type":"text","text":"They can be displayed through a dedicated view."}]},{"syntax":"swift","type":"codeListing","code":["    MISOAppLegalSection(","        appLegal: MISOAppLegalInfo(privacyStatement: URL(string: somePrivacyDocumentUrl