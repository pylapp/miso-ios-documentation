YSemanticToken"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationBlurSemanticToken"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationColorSemanticToken"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"However the composite tokens (here for box shadows) are defined in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticTokens"},{"type":"text","text":" because the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"type":"text","text":" "},{"type":"text","text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted."},{"type":"text","text":" "},{"type":"text","text":"Any elevation semantic token must be declared there (except "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticTokens"},{"type":"text","text":")"}],"title":"ElevationSemanticTokens","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ElevationSemanticTokens"}]},"ic_logo_miso.png":{"identifier":"ic_logo_miso.png","alt":null,"variants":[{"url":"\/images\/MISOThemesContract\/ic_logo_miso.png","traits":["1x","light"]}],"type":"image"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ElevationCompositeSemanticTokens":{"abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":", but only "},{"type":"strong","inlineContent":[{"type":"text","text":"composite tokens"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"There are splitted and not declared in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationSemanticTokens"},{"type":"text","text":" as the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"type":"text","text":" tool parsing "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" JSON to Swift code is not able to manage them."},{"type":"text","text":" "},{"type":"text","text":"Thus we need to declare them in another file to prevent them to be erased."},{"type":"text","text":" "},{"type":"text","text":"It declares in fact box shadows effects."}],"title":"ElevationCompositeSemanticTokens","url":"\/documentation\/misotokenssemantic\/elevationcompositesemantictokens","type":"topic","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticTokens","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeSemanticTokens"}],"navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeSemanticTokens"}],"kind":"symbol","role":"symbol"},"https://github.com/Orange-OpenSource/ouds-ios":{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","title":"ouds-ios","type":"link","titleInlineContent":[{"type":"text","text":"ouds-ios"}],"url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},"doc://MISOThemesContract/documentation/MISOThemesContract/TokensProvider":{"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"TokensProvider","kind":"identifier"}],"navigatorTitle":[{"text":"TokensProvider","kind":"identifier"}],"abstract":[{"type":"text","text":"Protocol to add to any semantic or component tokens provider so as to be gather with all providers and given to the theme for initialization"}],"type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/TokensProvider","