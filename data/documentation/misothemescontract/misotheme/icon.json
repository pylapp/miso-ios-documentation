xt","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"text":"object oriented paradigm","type":"text"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"text":"theme contract","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"text":"final","type":"text"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"text":", that is the reason why this conformity is unchecked.","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","navigatorTitle":[{"text":"MISOTheme","kind":"identifier"}],"url":"\/documentation\/misothemescontract\/misotheme","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"MISOTheme","kind":"identifier"}]},"doc://MISOThemesContract/documentation/MISOThemesContract/AllIconComponentTokensProvider":{"abstract":[{"type":"text","text":"Something which provides all components tokens for icons"}],"title":"AllIconComponentTokensProvider","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/AllIconComponentTokensProvider","type":"topic","navigatorTitle":[{"text":"AllIconComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemescontract\/alliconcomponenttokensprovider","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AllIconComponentTokensProvider"}]}}}