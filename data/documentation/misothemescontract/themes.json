{"identifier":{"url":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Themes","interfaceLanguage":"swift"},"metadata":{"images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"roleHeading":"Article","role":"article","modules":[{"name":"Welcome to MISO"}],"title":"Themes"},"hierarchy":{"paths":[["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract"]]},"kind":"article","seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/GettingStarted","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules"],"anchor":"Essentials"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"This framework exposes today following themes:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"BlueCoat"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For mockups, prototypes and prooves of concepts without any brand-flavoured styles"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"All themes are based on a theme contract called "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Themes"}]},{"type":"text","text":" use "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens providers"}]},{"type":"text","text":" which provide the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" to apply in the project."},{"type":"text","text":" "},{"type":"text","text":"These tokens in most of cases can be overridden thanks to "},{"type":"codeVoice","code":"@objc open"},{"type":"text","text":" combination so as to make possible to override these values in extensions (thanks to "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":") and from objects outside the module (thanks to "},{"type":"codeVoice","code":"open"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"Thus we can split values and responsabilities in different "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift Package Manager"}]},{"type":"text","text":" targets and keep overriding and inheritance possible."}],"type":"paragraph"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It is possible to subclass an existing theme, or to build its own theme from scratch."}]}]},{"text":"Architecture","type":"heading","level":2,"anchor":"Architecture"},{"inlineContent":[{"type":"text","text":"A theme is a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift class"}]},{"type":"text","text":" which several tokens providers providing their own definition of tokens."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"We choose to pack all semantic tokens in protocols, so as to force any theme to manage them through tokens providers. Because Swift does not have notions of abstract classes compared to Kotlin, the "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" which can be considered like an almost-abstract class."},{"type":"text","text":" "},{"type":"text","text":"Then, a white label theme may just inherit from this class and override the tokens it needs. A concrete example is the "},{"type":"codeVoice","code":"BlueCoatTheme"},{"type":"text","text":", providing in its module its own colors and overriding some tokens with the suitable values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Themes can be able to override semantic tokens and components tokens, and use its own raw or semantic tokens without sharing them to other themes. The existing raw tokens, shared between all themes, are not overridable because their definitions are frozen."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A theme can use its own tokens providers, implemented from scratch or by inheriting from existing tokens providers."}],"type":"paragraph"},{"text":"Use themeable view","type":"heading","level":2,"anchor":"Use-themeable-view"},{"type":"codeListing","syntax":"swift","code":["\/\/ Add themeable view to your root view to use the BlueCoatTheme","MISOThemeableView(theme: BlueCoatTheme()) {","    YourRootView()","}","","\/\/ Or use your custom theme if you want","MISOThemeableView(theme: YourCustomTheme()) {","    YourRootView()","}"]},{"text":"Theme tuning","type":"heading","level":2,"anchor":"Theme-tuning"},{"text":"Tunable themes or not","type":"heading","level":3,"anchor":"Tunable-themes-or-not"},{"inlineContent":[{"type":"text","text":"A theme can be made tunable so as to be more flexible and adapt to different contexts or constraints."},{"type":"text","text":" "},{"type":"text","text":"By default, the "},{"type":"codeVoice","code":"BlueCoatTheme"},{"type":"text","text":" is not tuned."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tuning represents the group of “flexibility points” a theme can expose to tailor and customize itself for particular contexts."}]}]},{"text":"Tuned values","type":"heading","level":3,"anchor":"Tuned-values"},{"inlineContent":[{"type":"text","text":"If your theme supports tuning, define the elements which can be tuned and provide predefined tunings if relevant."}],"type":"paragraph"},{"text":"Tuning usages","type":"heading","level":3,"anchor":"Tuning-usages"},{"inlineContent":[{"type":"text","text":"The tuning to apply must be done at theme init, for a theme that supports it, for example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Define your theme tuning with for example only rounded corners for buttons","    let tuning = Tuning(hasRoundedButtons: true)","","    \/\/ Apply it to your theme","    let theme = YourAppTheme(tuning: tuning)","    \/\/ Or in one line","    let theme = YourAppTheme(tuning: Tuning(hasRoundedButtons: true))"]},{"text":"Define a custom theme if needed","type":"heading","level":2,"anchor":"Define-a-custom-theme-if-needed"},{"inlineContent":[{"type":"text","text":"You will have to create a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift class"}]},{"type":"text","text":" which will inherit from an existing theme like "},{"type":"codeVoice","code":"BlueCoatTheme"},{"type":"text","text":" (if you need its assets and resources) or from "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" directly."},{"type":"text","text":" "},{"type":"text","text":"You can see "},{"type":"codeVoice","code":"BlueCoatTheme"},{"type":"text","text":" as more specified and less abstract as "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" which is the base of all themes."},{"type":"text","text":" "},{"type":"text","text":"We do not recommend to use directly the "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" as is, but you can of course, you just will have to add your own tokens providers or pick existing ones."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Then, you should override the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components tokens"}]},{"type":"text","text":" you want using the providers; we recommend to use "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift extensions"}]},{"type":"text","text":" for clarity reasons. You can use existing tokens providers or override them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If your theme needs to define its own "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", you can also define them using a "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens types"}]},{"type":"text","text":"."}],"type":"paragraph"},{"text":"By subclassing","type":"heading","level":3,"anchor":"By-subclassing"},{"inlineContent":[{"type":"text","text":"You may want to define your own theme, thus you can override an existing theme like "},{"type":"codeVoice","code":"BlueCoatTheme"},{"type":"text","text":" with your own class or just override the providers."},{"type":"text","text":" "},{"type":"text","text":"For clarity reasons maybe you should define your own class inheriting from "},{"type":"codeVoice","code":"BlueCoatTheme"},{"type":"text","text":", or, more difficult, from "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" but we do not recommand that."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You must consider the tokens provider you need (to inherit from for overriding, or to use as is):"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"spaces tokens are "},{"type":"codeVoice","code":"BlueCoatThemeSpaceSemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"sizes tokens are in "},{"type":"codeVoice","code":"BlueCoatThemeSizeSemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"colors tokens are all defined in "},{"type":"codeVoice","code":"BlueCoatThemeColorSemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"borders tokens are in "},{"type":"codeVoice","code":"BlueCoatThemeBorderSemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"elevations tokens are in "},{"type":"codeVoice","code":"BlueCoatThemeElevationSemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"opacity tokens are in "},{"type":"codeVoice","code":"BlueCoatThemeOpacitySemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"grid tokens are in "},{"type":"codeVoice","code":"BlueCoatThemeGridSemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"font tokens are in "},{"type":"codeVoice","code":"BlueCoatThemeFontSemanticTokensProvider"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"and same logic for component tokens"}]}]}]},{"inlineContent":[{"type":"text","text":"Find below some example"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Token provider for spaces","","class YourAppThemeSpaceTokensProvider: BlueCoatThemeSpaceSemanticTokensProvider {","    override var fixedMedium: SpaceSemanticToken {","        DimensionRawTokens._400","    }","    override var scaledSmall: MultipleSpaceSemanticToken {","        MultipleSpaceSemanticToken(compact: fixed5xl, regular: fixed5xl)","    }","}","","\/\/ Token provider for sizes","","class YourAppThemeSizeTokensProvider: BlueCoatThemeSizeSemanticTokensProvider {","    override var iconDecorative2xl: SizeSemanticToken {","        DimensionRawTokens._300","    }","    override var iconDecorativeMd: SizeSemanticToken {","        DimensionRawTokens._900","    }","}","","\/\/ Token provider for colors","","class YourAppThemeColorTokensProvider: BlueCoatThemeColorSemanticTokensProvider {","    override var bgSecondary: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.colorDecorativeAmber500, dark: BlueCoatBrandColorRawTokens.royalBlue300)","    }","    override var actionEnabled: MultipleColorSemanticToken {","        MultipleColorSemanticToken(light: ColorRawTokens.colorDecorativeShockingPink100, dark: ColorRawTokens.functionalScarlet600)","    }","}","","\/\/ Token provider for border","","class YourAppThemeBorderTokensProvider: BlueCoatThemeBorderSemanticTokensProvider {","    override var styleDefault: BorderStyleSemanticToken {","        BorderRawTokens.styleDashed","    }","    override var widthw: BorderWidthSemanticToken {","        BorderRawTokens.width100","    }","    override var radiusLarge: BorderRadiusSemanticToken {","        BorderRawTokens.radius800","    }","}","","\/\/ Token provider for elevation","","class YourAppThemeElevationTokensProvider: BlueCoatThemeElevationSemanticTokensProvider {","    override var stickyEmphasized: ElevationCompositeSemanticToken {","        ElevationCompositeSemanticToken(ElevationRawTokens.bottom_4_600)","    }","}","","\/\/ Token provider for opacity","","class YourAppThemeOpacityTokensProvider: BlueCoatThemeOpacitySemanticTokensProvider {","    override var strong: OpacitySemanticToken {","        OpacityRawTokens._920","    }","}","","\/\/ Token provider for grid","","class YourAppThemeGridTokensProvider: BlueCoatThemeGridSemanticTokensProvider {","    override var extraCompactColumnGap: GridSemanticToken {","        GridRawTokens.columnGap200","    }","    override var compactColumnGap: GridSemanticToken {","        GridRawTokens.columnGap200","    }","    override var regularColumnGap: GridSemanticToken {","        GridRawTokens.columnGap200","    }","}","","\/\/ Token provider for font","","class YourAppThemeFontTokensProvider: BlueCoatThemeFontSemanticTokensProvider {","    override var displayLarge: MultipleFontCompositeSemanticToken { ","        MultipleFontCompositeSemanticToken(FontCompositeSemanticToken(","            size: sizeDisplayLargeMobile,","            lineHeight: lineHeightDisplayLargeMobile,","            weight: weightDisplay,","            letterSpacing: letterSpacingDisplayLargeMobile))) ","    }","}"]},{"inlineContent":[{"type":"text","text":"You can instead of overriding existing semantic tokens provider implement your own provider but it will imply to implement maybe hundreds of tokens. Your own provider must match the suitable signature."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Then define your own theme class and assign the providers. You can just use some custom providers and leave the others as they are."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import MISOThemesMISOBlueCoat \/\/ To get BlueCoatTheme","","\/\/ Define your theme","class YourAppTheme: BlueCoatTheme {","    ","    override init() {","        super.init(colors: YourAppThemeColorTokensProvider(),","                   borders: YourAppThemeBorderTokensProvider(),","                   elevations: YourAppThemeElevationTokensProvider(),","                   fonts: YourAppThemeFontTokensProvider(),","                   grids: YourAppThemeGridTokensProvider(),","                   opacities: YourAppThemeOpacityTokensProvider(),","                   sizes: YourAppThemeSizeTokensProvider(),","                   spaces: YourAppThemeSpaceTokensProvider(),","                   button: YourAppThemeButtonComponentTokensProvider,","                ","                    Etc...)","    }","}"]},{"inlineContent":[{"type":"text","text":"Finaly for your app root view:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct MyAppRootView: View {","","    var body: some View {","        MISOThemeableView(theme: YourAppTheme()) {","            \/\/ ...","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"You can define your own set of raw tokens, and asign them in the semantic tokens you override as values, for example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public typealias MyOwnFontRawTokens = FontRawTokens \/\/ Refer to type FontRawTokens for consistency, declared in MISOTokensRaw","","public enum MyOwnFontRawTokens {","    public static let someFontBody: MyOwnFontRawTokens = \"Arial\"","}"]},{"inlineContent":[{"type":"text","text":"All components the MISO library provides are based on themes, handle through the abstract "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":", exposing "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":", defined by "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":" assigned to usable final values."},{"type":"text","text":" "},{"type":"text","text":"In few words, if you want to change the look and feel for the MISO components you use, you will have to override the matching "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":", but it will bring side effects as these "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":" are shared accross several components."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You are also able to define your "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components tokens"}]},{"type":"text","text":" and your "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":" used by them."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"emphasis","inlineContent":[{"text":"Themes","type":"text"}]},{"text":" are applications of specific values for ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"components tokens","type":"text"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"semantic tokens","type":"text"}]},{"text":" using in the end ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"raw tokens","type":"text"}]},{"text":".(thus final usable low level values).","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"theme","type":"text"}]},{"text":" contains any relevant tokens which can be used for components rendering.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"theme","type":"text"}]},{"text":" can use its own assets like fonts and icons.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/misothemescontract\/themes"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MISOThemesContract/documentation/MISOThemesContract/GettingStarted":{"url":"\/documentation\/misothemescontract\/gettingstarted","abstract":[{"text":"How to add the package as dependency, import libraries and use theme and components for your apps.","type":"text"}],"images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"title":"Getting Started with MISO","kind":"article","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/GettingStarted","role":"article"},"doc://MISOThemesContract/documentation/MISOThemesContract/Tokens":{"url":"\/documentation\/misothemescontract\/tokens","abstract":[{"text":"Design tokens represent the small, repeated design decisions that make up a design system’s visual style. Tokens wrap hard-coded static values, such as hexadecimal codes for color, with self-explanatory names. They are used to define the look and feel and the style of everything. They are exposed through the themes and can be used as they are.","type":"text"}],"images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"title":"Tokens","kind":"article","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","role":"article"},"doc://MISOThemesContract/documentation/MISOThemesContract/Components":{"url":"\/documentation\/misothemescontract\/components","abstract":[{"inlineContent":[{"type":"text","text":"Components"}],"type":"emphasis"},{"type":"text","text":" are the "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects you can add in the views of your apps, like buttons, links, cards etc."}],"images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"title":"Components","kind":"article","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","role":"article"},"https://github.com/Orange-OpenSource/ouds-ios":{"titleInlineContent":[{"text":"ouds-ios","type":"text"}],"url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"link","title":"ouds-ios","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},"doc://MISOThemesContract/documentation/MISOThemesContract":{"abstract":[{"text":"🐙🍜 MISO is a library of SwiftUI components (forked from ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"text":"), themes and tools for iOS app development.","type":"text"}],"title":"Welcome to MISO","url":"\/documentation\/misothemescontract","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract","type":"topic","role":"collection","images":[{"type":"icon","identifier":"ic_logo_miso.png"}],"kind":"symbol"},"ic_logo_miso.png":{"alt":null,"type":"image","variants":[{"url":"\/images\/MISOThemesContract\/ic_logo_miso.png","traits":["1x","light"]}],"identifier":"ic_logo_miso.png"},"doc://MISOThemesContract/documentation/MISOThemesContract/Modules":{"url":"\/documentation\/misothemescontract\/modules","abstract":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"module"}],"type":"emphasis"},{"type":"text","text":" can be seen as a set of features and components to fill a need."}],"images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"title":"Modules","kind":"article","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules","role":"article"}}}