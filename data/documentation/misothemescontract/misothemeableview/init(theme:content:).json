ge-OpenSource\/ouds-ios"},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOTheme":{"abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","type":"reference","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"inlineContent":[{"type":"text","text":"object oriented paradigm"}],"type":"emphasis"},{"type":"text","text":", or "},{"inlineContent":[{"type":"text","text":"theme contract"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" is not a "},{"inlineContent":[{"type":"text","text":"final"}],"type":"emphasis"},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTheme","kind":"identifier"}],"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","title":"MISOTheme","type":"topic","kind":"symbol","url":"\/documentation\/misothemescontract\/misotheme","navigatorTitle":[{"text":"MISOTheme","kind":"identifier"}],"role":"symbol"},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOThemeableView":{"type":"topic","abstract":[{"type":"text","text":"This is a kind of root "},{"type":"codeVoice","code":"SwiftUI.View"},{"type":"text","text":" to add at the top level of your views tree so as to define"},{"type":"text","text":" "},{"type":"text","text":"as an environment variable the theme which will be applied."},{"type":"text","text":" "},{"type":"text","text":"Any theme to apply must be a child of "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":", direct or not."}],"navigatorTitle":[{"kind":"identifier","text":"MISOThemeableView"}],"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOThemeableView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOThemeableView","kind":"identifier"}],"role":"symbol","title":"MISOThemeableView","kind":"symbol","url":"\/documentation\/misothemescontract\/misothemeableview"}}}