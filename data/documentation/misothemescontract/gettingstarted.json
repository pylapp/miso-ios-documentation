ype":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"MISOSwiftUI"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above and the BlueCoat theme"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"MISOSwiftUIBlueCoat"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above but with only BlueCoat theme"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"heading","level":3,"text":"Chose your theme","anchor":"Chose-your-theme"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"MISO"}],"type":"emphasis"},{"text":" framework provides today one theme:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"BlueCoat"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For mockups, prototypes and prooves of concepts without any brand-flavoured styles"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"heading","level":3,"text":"Apply a theme","anchor":"Apply-a-theme"},{"type":"row","columns":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This special view is here to define some elements as environment variables and injects the choosen theme."}]}],"size":1},{"size":1,"content":[{"code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"type":"codeListing","syntax":"swift"}]}],"numberOfColumns":2},{"columns":[{"size":1,"content":[{"inlineContent":[{"