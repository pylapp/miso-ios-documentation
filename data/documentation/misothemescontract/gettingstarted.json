{"hierarchy":{"paths":[["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract"]]},"metadata":{"title":"Getting Started with MISO","images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"roleHeading":"Article","role":"article","modules":[{"name":"Welcome to MISO"}]},"identifier":{"url":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/GettingStarted","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Themes","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules"],"anchor":"Essentials","title":"Essentials","generated":true}],"abstract":[{"type":"text","text":"How to add the package as dependency, import libraries and use theme and components for your apps."}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","anchor":"Integrate-MISO","level":2,"text":"Integrate MISO"},{"type":"heading","anchor":"Use-Swift-Package-Manager","level":3,"text":"Use Swift Package Manager"},{"type":"paragraph","inlineContent":[{"text":"If you want to add the iOS library of ","type":"text"},{"inlineContent":[{"type":"text","text":"MISO"}],"type":"emphasis"},{"text":", you need to add our ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Package"}],"type":"emphasis"},{"text":" into your project.","type":"text"},{"text":" ","type":"text"},{"text":"To do that, add a new ","type":"text"},{"inlineContent":[{"type":"text","text":"package dependency"}],"type":"emphasis"},{"text":" to your ","type":"text"},{"inlineContent":[{"type":"text","text":"Xcode"}],"type":"emphasis"},{"text":" project by refering to it by ","type":"text"},{"code":"github.com\/Orange-OpenSource\/miso-ios","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"You are free to choose whether or not you want a branch or a specific tag, pick the solution you want.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can "},{"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/miso-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds","isActive":true},{"type":"text","text":" for more details about versions, releases and tags. You can find release tags (e.g. "},{"type":"emphasis","inlineContent":[{"text":"1.0.0","type":"text"}]},{"type":"text","text":") and release candidates tags (e.g. "},{"type":"emphasis","inlineContent":[{"text":"1.0.0-rc3","type":"text"}]},{"type":"text","text":")."}]},{"type":"heading","anchor":"Import-the-libraries-you-need","level":3,"text":"Import the libraries you need"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You should use one (or several) of the following imports for your needs, which are basically "},{"type":"emphasis","inlineContent":[{"text":"Swift Package","type":"text"}]},{"type":"text","text":" products."}]},{"name":"Tip","content":[{"inlineContent":[{"type":"text","text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets."}],"type":"paragraph"}],"type":"aside","style":"tip"},{"type":"codeListing","code":["import MISOThemesContract \/\/ If you want to define your theme, use themes or MISOThemeableView","import MISOModules \/\/ To use modules","import MISOComponents \/\/ To use components","import MISOThemesMISOBlueCoat \/\/ To use the BlueCoat theme","import MISOTokensComponent \/\/ If you need to override or use directly components tokens","import MISOTokenSemantic \/\/ If you need to override or use directly semantic tokens","import MISOTokensRaw \/\/ If you need to override or use directly raw tokens","import MISOFoundations \/\/ For some utilities"],"syntax":"swift"},{"text":"Or more simple, import umbrella library","anchor":"Or-more-simple-import-umbrella-library","type":"heading","level":3},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements."},{"type":"text","text":" "},{"type":"text","text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)"},{"type":"text","text":" "},{"type":"text","text":"and useless constants."}]}],"type":"aside","style":"note"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Import the "},{"inlineContent":[{"text":"Swift Package","type":"text"}],"type":"emphasis"},{"type":"text","text":" product which suits your needs:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Umbrella"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"MISOSwiftUI","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above and the BlueCoat theme"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"MISOSwiftUIBlueCoat","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All libraries listed above but with only BlueCoat theme"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Chose your theme","anchor":"Chose-your-theme","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"text":"MISO","type":"text"}],"type":"emphasis"},{"type":"text","text":" framework provides today one theme:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"BlueCoat","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For mockups, prototypes and prooves of concepts without any brand-flavoured styles","type":"text"}],"type":"paragraph"}]]]},{"type":"heading","anchor":"Apply-a-theme","level":3,"text":"Apply a theme"},{"numberOfColumns":2,"columns":[{"content":[{"inlineContent":[{"text":"You will need to use for your application root view the ","type":"text"},{"code":"MISOThemeableView","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This special view is here to define some elements as environment variables and injects the choosen theme.","type":"text"}],"type":"paragraph"}],"size":1},{"content":[{"code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"type":"codeListing","syntax":"swift"}],"size":1}],"type":"row"},{"numberOfColumns":2,"columns":[{"content":[{"inlineContent":[{"type":"text","text":"Then get the current applied theme in your views and use the tokens you want."},{"text":" ","type":"text"},{"text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want.","type":"text"}],"type":"paragraph"}],"size":1},{"content":[{"code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"],"type":"codeListing","syntax":"swift"}],"size":1}],"type":"row"},{"name":"Tip","content":[{"inlineContent":[{"text":"Keep in mind only one theme can be used within one ","type":"text"},{"type":"codeVoice","code":"MISOThemeableView"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"tip"},{"text":"Trick for Xcode Preview","anchor":"Trick-for-Xcode-Preview","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use Xcode "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks, you will have to be sure the theme is instanciated and injected through the "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because it is not possible today to override the legit "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" block, you can instead use some of our utilities to wrap your content"},{"type":"text","text":" "},{"type":"text","text":"inside the "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme."}]},{"code":["\/\/ Apply BlueCoat theme","#Preview {","    SampleView()","        .blueCoatPreview()","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misothemescontract\/gettingstarted"]}],"references":{"https://github.com/Orange-OpenSource/miso-ios/wiki/50-%E2%80%90-About-versions,-releases-and-builds":{"title":"refer to the wiki","url":"https:\/\/github.com\/Orange-OpenSource\/miso-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds","titleInlineContent":[{"text":"refer to the wiki","type":"text"}],"type":"link","identifier":"https:\/\/github.com\/Orange-OpenSource\/miso-ios\/wiki\/50-%E2%80%90-About-versions,-releases-and-builds"},"doc://MISOThemesContract/documentation/MISOThemesContract/Tokens":{"url":"\/documentation\/misothemescontract\/tokens","abstract":[{"text":"Design tokens represent the small, repeated design decisions that make up a design system’s visual style. Tokens wrap hard-coded static values, such as hexadecimal codes for color, with self-explanatory names. They are used to define the look and feel and the style of everything. They are exposed through the themes and can be used as they are.","type":"text"}],"images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"title":"Tokens","kind":"article","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","role":"article"},"doc://MISOThemesContract/documentation/MISOThemesContract/Components":{"url":"\/documentation\/misothemescontract\/components","abstract":[{"inlineContent":[{"type":"text","text":"Components"}],"type":"emphasis"},{"type":"text","text":" are the "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects you can add in the views of your apps, like buttons, links, cards etc."}],"images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"title":"Components","kind":"article","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","role":"article"},"doc://MISOThemesContract/documentation/MISOThemesContract/Themes":{"url":"\/documentation\/misothemescontract\/themes","abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Themes"}]},{"type":"text","text":" are applications of specific values for "},{"inlineContent":[{"type":"text","text":"components tokens"}],"type":"emphasis"},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":" using in the end "},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"type":"text","text":".(thus final usable low level values)."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme"}]},{"type":"text","text":" contains any relevant tokens which can be used for components rendering."},{"type":"text","text":" "},{"type":"text","text":"A "},{"inlineContent":[{"type":"text","text":"theme"}],"type":"emphasis"},{"type":"text","text":" can use its own assets like fonts and icons."}],"images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Themes","kind":"article","type":"topic","title":"Themes","role":"article"},"https://github.com/Orange-OpenSource/ouds-ios":{"type":"link","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","title":"ouds-ios","titleInlineContent":[{"text":"ouds-ios","type":"text"}],"url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},"doc://MISOThemesContract/documentation/MISOThemesContract":{"abstract":[{"text":"🐙🍜 MISO is a library of SwiftUI components (forked from ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},{"text":"), themes and tools for iOS app development.","type":"text"}],"title":"Welcome to MISO","url":"\/documentation\/misothemescontract","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract","type":"topic","role":"collection","images":[{"type":"icon","identifier":"ic_logo_miso.png"}],"kind":"symbol"},"ic_logo_miso.png":{"type":"image","variants":[{"url":"\/images\/MISOThemesContract\/ic_logo_miso.png","traits":["1x","light"]}],"alt":null,"identifier":"ic_logo_miso.png"},"doc://MISOThemesContract/documentation/MISOThemesContract/Modules":{"url":"\/documentation\/misothemescontract\/modules","abstract":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"module"}],"type":"emphasis"},{"type":"text","text":" can be seen as a set of features and components to fill a need."}],"images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"title":"Modules","kind":"article","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules","role":"article"}}}