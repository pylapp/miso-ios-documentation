{"hierarchy":{"paths":[["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Integrate-MISO","type":"heading","level":2,"text":"Integrate MISO"},{"anchor":"Use-Swift-Package-Manager","type":"heading","level":3,"text":"Use Swift Package Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to add the iOS library of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"MISO"}]},{"type":"text","text":", you need to add our "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift Package"}]},{"type":"text","text":" into your project."},{"type":"text","text":" "},{"type":"text","text":"To do that, add a new "},{"type":"emphasis","inlineContent":[{"type":"text","text":"package dependency"}]},{"type":"text","text":" to your "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Xcode"}]},{"type":"text","text":" project by refering to it by "},{"type":"codeVoice","code":"github.com\/pylapp\/miso-ios"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You are free to choose whether or not you want a branch or a specific tag, pick the solution you want."}]},{"anchor":"Import-the-libraries-you-need","type":"heading","level":3,"text":"Import the libraries you need"},{"inlineContent":[{"text":"You should use one (or several) of the following imports for your needs, which are basically ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Package"}],"type":"emphasis"},{"text":" products.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets.","type":"text"}]}]},{"code":["import MISOThemesContract \/\/ If you want to define your theme, use themes or MISOThemeableView","import MISOModules \/\/ To use modules","import MISOComponents \/\/ To use components","import MISOThemesMISOBlueCoat \/\/ To use the BlueCoat theme","import MISOTokensComponent \/\/ If you need to override or use directly components tokens","import MISOTokenSemantic \/\/ If you need to override or use directly semantic tokens","import MISOTokensRaw \/\/ If you need to override or use directly raw tokens","import MISOFoundations \/\/ For some utilities"],"type":"codeListing","syntax":"swift"},{"anchor":"Or-more-simple-import-umbrella-library","type":"heading","level":3,"text":"Or more simple, import umbrella library"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements."},{"type":"text","text":" "},{"type":"text","text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)"},{"type":"text","text":" "},{"type":"text","text":"and useless constants."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"Import the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift Package"}]},{"type":"text","text":" product which suits your needs:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Umbrella"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"MISOSwiftUI","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All libraries listed above and the BlueCoat theme","type":"text"}],"type":"paragraph"}]]]},{"text":"Chose your theme","anchor":"Chose-your-theme","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"inlineContent":[{"type":"text","text":"MISO"}],"type":"emphasis"},{"text":" framework provides today several themes:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Theme","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"BlueCoat"}]}],[{"type":"paragraph","inlineContent":[{"text":"Basic theme of the framework, quite blue and a bit cold","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"FoxyRough"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hotter, red and gray"}]}]]]},{"type":"heading","anchor":"Apply-a-theme","level":3,"text":"Apply a theme"},{"type":"row","columns":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This special view is here to define some elements as environment variables and injects the choosen theme."}]}],"size":1},{"size":1,"content":[{"syntax":"swift","type":"codeListing","code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","          }","       }","    }","}"]}]}],"numberOfColumns":2},{"columns":[{"content":[{"inlineContent":[{"text":"Then get the current applied theme in your views and use the tokens you want.","type":"text"},{"text":" ","type":"text"},{"text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want.","type":"text"}],"type":"paragraph"}],"size":1},{"content":[{"syntax":"swift","type":"codeListing","code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"]}],"size":1}],"numberOfColumns":2,"type":"row"},{"style":"tip","content":[{"inlineContent":[{"type":"text","text":"Keep in mind only one theme can be used within one "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Tip","type":"aside"},{"level":3,"anchor":"Trick-for-Xcode-Preview","text":"Trick for Xcode Preview","type":"heading"},{"inlineContent":[{"type":"text","text":"If you use Xcode "},{"code":"#Preview","type":"codeVoice"},{"type":"text","text":" blocks, you will have to be sure the theme is instanciated and injected through the "},{"code":"MISOThemeableView","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because it is not possible today to override the legit "},{"code":"#Preview","type":"codeVoice"},{"type":"text","text":" block, you can instead use some of our utilities to wrap your content"},{"type":"text","text":" "},{"type":"text","text":"inside the "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Apply BlueCoat theme","#Preview {","    SampleView()","        .blueCoatPreview()","}"]}]}],"identifier":{"url":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/GettingStarted","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/misothemescontract\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"article","roleHeading":"Article","images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"modules":[{"name":"Welcome to MISO"}],"title":"Getting Started with MISO"},"abstract":[{"text":"How to add the package as dependency, import libraries and use theme and components for your apps.","type":"text"}],"sections":[],"seeAlsoSections":[{"title":"Essentials","generated":true,"identifiers":["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Themes","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules"],"anchor":"Essentials"}],"kind":"article","references":{"ic_logo_miso.png":{"type":"image","identifier":"ic_logo_miso.png","variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesContract\/ic_logo_miso.png"}],"alt":null},"doc://MISOThemesContract/documentation/MISOThemesContract/Components":{"url":"\/documentation\/misothemescontract\/components","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","type":"topic","images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"abstract":[{"inlineContent":[{"type":"text","text":"Components"}],"type":"emphasis"},{"text":" are the ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" objects you can add in the views of your apps, like buttons, links, cards etc.","type":"text"}],"kind":"article","title":"Components","role":"article"},"doc://MISOThemesContract/documentation/MISOThemesContract/Modules":{"kind":"article","url":"\/documentation\/misothemescontract\/modules","title":"Modules","abstract":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"module"}]},{"type":"text","text":" can be seen as a set of features and components to fill a need."}],"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules","role":"article","images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"type":"topic"},"doc://MISOThemesContract/documentation/MISOThemesContract/Tokens":{"role":"article","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","type":"topic","images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"url":"\/documentation\/misothemescontract\/tokens","title":"Tokens","kind":"article","abstract":[{"type":"text","text":"Design tokens represent the small, repeated design decisions that make up a design system’s visual style. Tokens wrap hard-coded static values, such as hexadecimal codes for color, with self-explanatory names. They are used to define the look and feel and the style of everything. They are exposed through the themes and can be used as they are."}]},"doc://MISOThemesContract/documentation/MISOThemesContract/Themes":{"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Themes","url":"\/documentation\/misothemescontract\/themes","type":"topic","images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Themes"}]},{"type":"text","text":" are applications of specific values for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components tokens"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":" using in the end "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":".(thus final usable low level values)."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme"}]},{"type":"text","text":" contains any relevant tokens which can be used for components rendering."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme"}]},{"type":"text","text":" can use its own assets like fonts and icons."}],"kind":"article","title":"Themes","role":"article"},"https://github.com/Orange-OpenSource/ouds-ios":{"type":"link","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","titleInlineContent":[{"text":"ouds-ios","type":"text"}],"title":"ouds-ios","url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios"},"doc://MISOThemesContract/documentation/MISOThemesContract":{"kind":"symbol","title":"Welcome to MISO","abstract":[{"type":"text","text":"🐙🍜 MISO is a library of SwiftUI components (forked from "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"reference","isActive":true},{"text":"), themes and tools for iOS app development.","type":"text"}],"type":"topic","images":[{"identifier":"ic_logo_miso.png","type":"icon"}],"url":"\/documentation\/misothemescontract","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract","role":"collection"}}}