 current applied theme in your views and use the tokens you want."},{"type":"text","text":" "},{"type":"text","text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want."}]}]},{"size":1,"content":[{"code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"],"type":"codeListing","syntax":"swift"}]}],"numberOfColumns":2},{"type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep in mind only one theme can be used within one "},{"code":"MISOThemeableView","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"Tip"},{"level":3,"type":"heading","anchor":"Trick-for-Xcode-Preview","text":"Trick for Xcode Preview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use Xcode "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" blocks, you will have to be sure the theme is instanciated and injected through the "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because it is not possible today to override the legit "},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" block, you can instead use some of our utilities to wrap your content"},{"type":"text","text":" "},{"type":"text","text":"inside the "},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme."}]},{"code":["\/\/ Apply BlueCoat theme","#Preview {","    SampleView()","        .blueCoatPreview()","}"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"How to add the package as dependency, import libraries and use theme and components for your apps."}],"kind":"article","variants":[{"paths":["\/documentation\/misothemescontract\/gettingstarted"],"traits":[{"interfaceLangua