{"identifier":{"url":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/GettingStarted","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Themes","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misothemescontract\/gettingstarted"]}],"kind":"article","abstract":[{"type":"text","text":"How to add the package as dependency, import libraries and use theme and components for your apps."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Integrate MISO","type":"heading","anchor":"Integrate-MISO"},{"level":3,"text":"Use Swift Package Manager","type":"heading","anchor":"Use-Swift-Package-Manager"},{"inlineContent":[{"type":"text","text":"If you want to add the iOS library of "},{"inlineContent":[{"text":"MISO","type":"text"}],"type":"emphasis"},{"type":"text","text":", you need to add our "},{"inlineContent":[{"text":"Swift Package","type":"text"}],"type":"emphasis"},{"type":"text","text":" into your project."},{"type":"text","text":" "},{"type":"text","text":"To do that, add a new "},{"inlineContent":[{"text":"package dependency","type":"text"}],"type":"emphasis"},{"type":"text","text":" to your "},{"inlineContent":[{"text":"Xcode","type":"text"}],"type":"emphasis"},{"type":"text","text":" project by refering to it by "},{"code":"github.com\/pylapp\/miso-ios","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"You are free to choose whether or not you want a branch or a specific tag, pick the solution you want."}],"type":"paragraph"},{"level":3,"text":"Import the libraries you need","type":"heading","anchor":"Import-the-libraries-you-need"},{"inlineContent":[{"type":"text","text":"You should use one (or several) of the following imports for your needs, which are basically "},{"inlineContent":[{"text":"Swift Package","type":"text"}],"type":"emphasis"},{"type":"text","text":" products."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"We recommend to embed in your apps only the ones you need to avoid to embed useless assets.","type":"text"}],"type":"paragraph"}],"name":"Tip","type":"aside","style":"tip"},{"syntax":"swift","type":"codeListing","code":["import MISOThemesContract \/\/ If you want to define your theme, use themes or MISOThemeableView","import MISOModules \/\/ To use modules","import MISOComponents \/\/ To use components","import MISOThemesMISOBlueCoat \/\/ To use the BlueCoat theme","import MISOTokensComponent \/\/ If you need to override or use directly components tokens","import MISOTokenSemantic \/\/ If you need to override or use directly semantic tokens","import MISOTokensRaw \/\/ If you need to override or use directly raw tokens","import MISOFoundations \/\/ For some utilities"]},{"level":3,"text":"Or more simple, import umbrella library","type":"heading","anchor":"Or-more-simple-import-umbrella-library"},{"content":[{"inlineContent":[{"text":"We do not recommend this solution because from our point of view use of tailored imports is better to import only the needed elements.","type":"text"},{"text":" ","type":"text"},{"text":"use of umbrella products can increase app sizes and needed storage because it emebds plenty of assets (images, fonts, etc.)","type":"text"},{"text":" ","type":"text"},{"text":"and useless constants.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"inlineContent":[{"type":"text","text":"Import the "},{"inlineContent":[{"text":"Swift Package","type":"text"}],"type":"emphasis"},{"type":"text","text":" product which suits your needs:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Umbrella","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"MISOSwiftUI","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All libraries listed above and the BlueCoat theme","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"MISOSwiftUIBlueCoat","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All libraries listed above but with only BlueCoat theme","type":"text"}],"type":"paragraph"}]]]},{"level":3,"text":"Chose your theme","type":"heading","anchor":"Chose-your-theme"},{"inlineContent":[{"type":"text","text":"The "},{"inlineContent":[{"text":"MISO","type":"text"}],"type":"emphasis"},{"type":"text","text":" framework provides today one theme:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"BlueCoat","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For mockups, prototypes and prooves of concepts without any brand-flavoured styles","type":"text"}],"type":"paragraph"}]]]},{"level":3,"text":"Apply a theme","type":"heading","anchor":"Apply-a-theme"},{"numberOfColumns":2,"columns":[{"content":[{"inlineContent":[{"type":"text","text":"You will need to use for your application root view the "},{"code":"MISOThemeableView","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This special view is here to define some elements as environment variables and injects the choosen theme.","type":"text"}],"type":"paragraph"}],"size":1},{"content":[{"code":["@main","struct YourApp: App {","    var body: some Scene {","       WindowGroup {","          MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","          }","       }","    }","}"],"type":"codeListing","syntax":"swift"}],"size":1}],"type":"row"},{"numberOfColumns":2,"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"text":"Then get the current applied theme in your views and use the tokens you want.","type":"text"},{"text":" ","type":"text"},{"text":"The tokens are wrapped in providers with clear names, you only need to choose the ones you want.","type":"text"}]}]},{"size":1,"content":[{"code":["\/\/ Use it in views as an environment variable","@Environment(\\.theme) var theme"],"type":"codeListing","syntax":"swift"}]}],"type":"row"},{"content":[{"inlineContent":[{"text":"Keep in mind only one theme can be used within one ","type":"text"},{"type":"codeVoice","code":"MISOThemeableView"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"tip","name":"Tip","type":"aside"},{"level":3,"type":"heading","text":"Trick for Xcode Preview","anchor":"Trick-for-Xcode-Preview"},{"inlineContent":[{"text":"If you use Xcode ","type":"text"},{"type":"codeVoice","code":"#Preview"},{"text":" blocks, you will have to be sure the theme is instanciated and injected through the ","type":"text"},{"code":"MISOThemeableView","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"Because it is not possible today to override the legit ","type":"text"},{"type":"codeVoice","code":"#Preview"},{"type":"text","text":" block, you can instead use some of our utilities to wrap your content"},{"type":"text","text":" "},{"type":"text","text":"inside the "},{"code":"MISOThemeableView","type":"codeVoice"},{"type":"text","text":" automatically. These utilities come with the themes modules. Without them you may face errors about undefined theme."}],"type":"paragraph"},{"code":["\/\/ Apply BlueCoat theme","#Preview {","    SampleView()","        .blueCoatPreview()","}"],"syntax":"swift","type":"codeListing"}]}],"metadata":{"modules":[{"name":"Welcome to MISO"}],"title":"Getting Started with MISO","role":"article","roleHeading":"Article","images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract"]]},"references":{"doc://MISOThemesContract/documentation/MISOThemesContract/Tokens":{"role":"article","images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"kind":"article","abstract":[{"type":"text","text":"Design tokens represent the small, repeated design decisions that make up a design system’s visual style. Tokens wrap hard-coded static values, such as hexadecimal codes for color, with self-explanatory names. They are used to define the look and feel and the style of everything. They are exposed through the themes and can be used as they are."}],"type":"topic","title":"Tokens","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Tokens","url":"\/documentation\/misothemescontract\/tokens"},"doc://MISOThemesContract/documentation/MISOThemesContract/Components":{"role":"article","images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}],"kind":"article","abstract":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Components"}]},{"type":"text","text":" are the "},{"type":"codeVoice","code":"View"},{"type":"text","text":" objects you can add in the views of your apps, like buttons, links, cards etc."}],"type":"topic","title":"Components","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Components","url":"\/documentation\/misothemescontract\/components"},"ic_logo_miso.png":{"variants":[{"url":"\/images\/MISOThemesContract\/ic_logo_miso.png","traits":["1x","light"]}],"identifier":"ic_logo_miso.png","alt":null,"type":"image"},"doc://MISOThemesContract/documentation/MISOThemesContract":{"abstract":[{"type":"text","text":"🐙🍜 MISO is a library of SwiftUI components (forked from "},{"identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"reference","isActive":true},{"type":"text","text":"), themes and tools for iOS app development."}],"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract","type":"topic","images":[{"identifier":"ic_logo_miso.png","type":"icon"}],"kind":"symbol","url":"\/documentation\/misothemescontract","role":"collection","title":"Welcome to MISO"},"doc://MISOThemesContract/documentation/MISOThemesContract/Themes":{"title":"Themes","url":"\/documentation\/misothemescontract\/themes","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Themes","role":"article","type":"topic","kind":"article","abstract":[{"inlineContent":[{"type":"text","text":"Themes"}],"type":"emphasis"},{"text":" are applications of specific values for ","type":"text"},{"inlineContent":[{"type":"text","text":"components tokens"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"semantic tokens"}],"type":"emphasis"},{"text":" using in the end ","type":"text"},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"text":".(thus final usable low level values).","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"theme"}],"type":"emphasis"},{"text":" contains any relevant tokens which can be used for components rendering.","type":"text"},{"text":" ","type":"text"},{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"theme"}],"type":"emphasis"},{"text":" can use its own assets like fonts and icons.","type":"text"}],"images":[{"type":"icon","identifier":"ic_logo_miso.png"},{"type":"card","identifier":"ic_logo_miso.png"}]},"doc://MISOThemesContract/documentation/MISOThemesContract/Modules":{"role":"article","images":[{"identifier":"ic_logo_miso.png","type":"icon"},{"identifier":"ic_logo_miso.png","type":"card"}],"kind":"article","abstract":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"module"}]},{"type":"text","text":" can be seen as a set of features and components to fill a need."}],"type":"topic","title":"Modules","url":"\/documentation\/misothemescontract\/modules","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/Modules"},"https://github.com/Orange-OpenSource/ouds-ios":{"url":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","type":"link","identifier":"https:\/\/github.com\/Orange-OpenSource\/ouds-ios","title":"ouds-ios","titleInlineContent":[{"type":"text","text":"ouds-ios"}]}}}