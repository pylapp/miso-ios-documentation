{"hierarchy":{"paths":[[]]},"topicSections":[{"title":"Group","anchor":"Group","identifiers":["doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionFaqComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertMessageComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BarComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BadgeComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BulletListComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CategoricalTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CheckboxComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ChipComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/DividerComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/IconComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ListItemComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/PinCodeInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ProgressIndicatorComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/QuantityInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/RadioButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SelectInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SkeletonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SwitchComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ToastComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/InputTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextAreaComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TypographyComponentTokens"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misotokenscomponent"]}],"identifier":{"url":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","abstract":[{"text":"These ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"tokens","type":"text"}]},{"text":" are defined for components and refer to semantic tokens or raw tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as a kind of bridge between components and in the end primitive values of the design kit.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"codeListing","code":["🧬 Core version: 1.11.0"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"Thus if a component need to change for example its ","type":"text"},{"inlineContent":[{"text":"background color","type":"text"}],"type":"emphasis"},{"text":", and if a ","type":"text"},{"inlineContent":[{"type":"text","text":"component token"}],"type":"emphasis"},{"text":" is used for it, then only the value of this ","type":"text"},{"inlineContent":[{"text":"token","type":"text"}],"type":"emphasis"},{"text":" should be changed without any modification on the ","type":"text"},{"inlineContent":[{"text":"component","type":"text"}],"type":"emphasis"},{"text":" definition.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Components","type":"text"}],"type":"emphasis"},{"text":" use ","type":"text"},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"text":" exposed through the ","type":"text"},{"inlineContent":[{"type":"text","text":"theme"}],"type":"emphasis"},{"text":" thanks to token providers to get their style values.","type":"text"}]},{"inlineContent":[{"text":"Components tokens are defined and gathered inside ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift protocol"}],"type":"emphasis"},{"text":" so as to be exposed then through implementation of ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"text":" thanks to dedicated tokens providers.","type":"text"},{"text":" ","type":"text"},{"text":"Because we choose to split responsabilities and objects into their own modules, we faced troubles to make possible for children themes or providers to override properties declared in ","type":"text"},{"inlineContent":[{"text":"protocols","type":"text"}],"type":"emphasis"},{"text":" and defined in ","type":"text"},{"inlineContent":[{"type":"text","text":"extensions"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That is the reason why tokens are exposed as ","type":"text"},{"code":"@objc open","type":"codeVoice"},{"text":" to be available and overridable anywhere.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Example with ","type":"text"},{"identifier":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Declare some component tokens for buttons with properties they must apply","public protocol ButtonComponentTokens {","    var sizeMaxHeightIconOnly: SizeSemanticToken { get }","    var borderWidthDefault: BorderWidthSemanticToken { get }","    var borderRadius: BorderRadiusSemanticToken { get }","    var colorBgDefaultPressedMono: MultipleColorSemanticToken { get }","    var spacePaddingBlock: SpaceSemanticToken { get }","}","","\/\/ There is an existing provider for such tokens","open class BlueCoatThemeButtonComponentTokensProvider { }","","\/\/ Define the components tokens exposed through the theme thanks to provider","extension BlueCoatThemeButtonComponentTokensProvider: ButtonComponentTokens {","","    \/\/ Raw tokens can be used","","    @objc open var sizeMaxHeightIconOnly: SizeSemanticToken { DimensionRawTokens._600 }","    ","    \/\/ And also semantic tokens","","    @objc open var borderWidthDefault: BorderWidthSemanticToken { borders.widthThicker }","    @objc open var borderRadius: BorderRadiusSemanticToken { borders.radiusMedium }","    @objc open var colorBgDefaultPressedMono: MultipleColorSemanticToken { colors.repositoryOpacityBlackHigher }","    @objc open var spacePaddingBlock: SpaceSemanticToken { spaces.paddingInlineSpacious }","}","","\/\/ This provider is then exposed through MISOTheme as an AllButtonComponentTokensProvider"],"syntax":"swift"},{"text":"How to use component tokens","type":"heading","anchor":"How-to-use-component-tokens","level":2},{"inlineContent":[{"text":"In fact, the component tokens are declared and gathered in ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift protocol"}],"type":"emphasis"},{"text":" so as to force any theme to implement them, and also to allow any theme to expose such properties whathever the implementation of the theme is, across providers.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Because "},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"type":"text","text":" have for values "},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"type":"text","text":" or "},{"inlineContent":[{"type":"text","text":"semantic tokens"}],"type":"emphasis"},{"type":"text","text":", and in the end for values primitive types, and all these tokens are declared with "},{"inlineContent":[{"text":"type aliases","type":"text"}],"type":"emphasis"},{"type":"text","text":" refering all together, you can handle a "},{"inlineContent":[{"type":"text","text":"component token"}],"type":"emphasis"},{"type":"text","text":" directly in your view because the final value will be used."},{"type":"text","text":" "},{"type":"text","text":"Thus, get the theme and call the needed property with some helpers."}],"type":"paragraph"},{"type":"codeListing","code":["struct SomeView: View {","","    @Environment(\\.theme) private var theme \/\/ Supposed you used in your root view the `MISOThemeableView` to register the theme","    @Environment(\\.colorScheme) private var colorScheme","","    var body: some View {","        Button {","            \/\/ Some action","        } label: {","            Text(\"Some label\")","                .cornerRadius(theme.button.borderRadius)","        }","        .padding(.leading, theme.button.spacePaddingInlineChevronStartDefault)","        .padding(.trailing, theme.button.spacePaddingInlineChevronEndDefault)","        .background(theme.button.colorBgStrongEnabledMono)","        .overlay(","            RoundedRectangle(cornerRadius: theme.button.borderRadius)","                .stroke(Color.blue, lineWidth: theme.button.borderWidthDefault)","        )","    }","\/*","    - The theme provides border semantic tokens \"borderRadius\" and \"borderWidthDefault\"","    - The theme provides a color semantic token \"colorBgStrongEnabledMono\"","    - The theme provides spaces semantic token \"spacePaddingInlineChevronStart\" and \"spacePaddingInlineChevronEnd\"","*\/","}","","\/\/ Do not forget in your app to use the `MISOThemeableView` for your theme, e.g. `BlueCoatTheme`","@main","struct DesignToolbox: App {","","    var body: some Scene {","        WindowGroup {","            MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","                ...","            }","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The components tokens are wrapped in tokens provider accessible through the themes:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components tokens provider"}]}],[{"type":"paragraph","inlineContent":[{"text":"Target component","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"accordion \/ accordionFaq"}]}],[{"type":"paragraph","inlineContent":[{"text":"For accordions components","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"alert"}]}],[{"type":"paragraph","inlineContent":[{"text":"For alert mesdsages and inline alert components like ","type":"text"},{"type":"codeVoice","code":"MISOAlertMessage"},{"type":"text","text":" and "},{"code":"MISOInlineAlert","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"bar","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"For bars components like bottom and navigation bars","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"badge"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For badges like "},{"code":"MISOBadgeStandard","type":"codeVoice"},{"type":"text","text":", "},{"code":"MISOBadgeIcon","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISOBadgeCount","type":"codeVoice"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"button"}]}],[{"type":"paragraph","inlineContent":[{"text":"For buttons like ","type":"text"},{"code":"MISOButton","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"bulletList"}]}],[{"type":"paragraph","inlineContent":[{"text":"For list of elements with bullets like ","type":"text"},{"code":"MISOBulletList","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"checkbox"}]}],[{"type":"paragraph","inlineContent":[{"text":"For checkboxes like ","type":"text"},{"type":"codeVoice","code":"MISOCheckbox"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MISOCheckboxItem"},{"text":" and their indeterminate variants","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"chip","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For chips like "},{"code":"MISOSuggestionChip","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISOFilterChip","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"divider"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For dividers like "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOVerticalDivider"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"icon"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components containing icons like "},{"type":"codeVoice","code":"MISOTag"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"link","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"For links like ","type":"text"},{"type":"codeVoice","code":"MISOLink"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"listItem"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shared and used for switch, checkbox, radio items and list items layouts","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"pinCodeInput"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[]}]],[[{"inlineContent":[{"type":"text","text":"quantityInput"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"radioButton"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For radio components like "},{"type":"codeVoice","code":"MISORadio"},{"type":"text","text":" and "},{"code":"MISORadioItem","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"selectInput"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"text":"skeleton","type":"text"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"text":"switch","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For switch components like "},{"type":"codeVoice","code":"MISOSwitch"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MISOSwitchItem"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"tag","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For tag components like "},{"type":"codeVoice","code":"MISOTag"}]}]],[[{"inlineContent":[{"type":"text","text":"inputTag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For input tag components like "},{"type":"codeVoice","code":"MISOInputTag"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"textArea","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For text area components like ","type":"text"},{"code":"MISOTextArea","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"textInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For text field input components like ","type":"text"},{"code":"MISOTextInput","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"typography","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For textual components like "},{"code":"MISOText","type":"codeVoice"}],"type":"paragraph"}]]]}]}],"metadata":{"title":"Tokens for componen