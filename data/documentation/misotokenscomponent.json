{"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Group","title":"Group","identifiers":["doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionFaqComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertMessageComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BarComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BadgeComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BulletListComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CategoricalTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CheckboxComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ChipComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/DividerComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/IconComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ListItemComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/PinCodeInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ProgressIndicatorComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/QuantityInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/RadioButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SelectInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SkeletonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SwitchComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ToastComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/InputTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextAreaComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TypographyComponentTokens"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"codeListing","code":["🧬 Core version: 1.11.0"],"syntax":null},{"inlineContent":[{"text":"Thus if a component need to change for example its ","type":"text"},{"inlineContent":[{"text":"background color","type":"text"}],"type":"emphasis"},{"text":", and if a ","type":"text"},{"inlineContent":[{"text":"component token","type":"text"}],"type":"emphasis"},{"text":" is used for it, then only the value of this ","type":"text"},{"inlineContent":[{"text":"token","type":"text"}],"type":"emphasis"},{"text":" should be changed without any modification on the ","type":"text"},{"inlineContent":[{"text":"component","type":"text"}],"type":"emphasis"},{"text":" definition.","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Components","type":"text"}],"type":"emphasis"},{"text":" use ","type":"text"},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"text":" exposed through the ","type":"text"},{"inlineContent":[{"text":"theme","type":"text"}],"type":"emphasis"},{"text":" thanks to token providers to get their style values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Components tokens are defined and gathered inside ","type":"text"},{"inlineContent":[{"text":"Swift protocol","type":"text"}],"type":"emphasis"},{"text":" so as to be exposed then through implementation of ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"text":" thanks to dedicated tokens providers.","type":"text"},{"text":" ","type":"text"},{"text":"Because we choose to split responsabilities and objects into their own modules, we faced troubles to make possible for children themes or providers to override properties declared in ","type":"text"},{"inlineContent":[{"text":"protocols","type":"text"}],"type":"emphasis"},{"text":" and defined in ","type":"text"},{"inlineContent":[{"text":"extensions","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That is the reason why tokens are exposed as ","type":"text"},{"code":"@objc open","type":"codeVoice"},{"text":" to be available and overridable anywhere.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Example with ","type":"text"},{"identifier":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Declare some component tokens for buttons with properties they must apply","public protocol ButtonComponentTokens {","    var sizeMaxHeightIconOnly: SizeSemanticToken { get }","    var borderWidthDefault: BorderWidthSemanticToken { get }","    var borderRadius: BorderRadiusSemanticToken { get }","    var colorBgDefaultPressedMono: MultipleColorSemanticToken { get }","    var spacePaddingBlock: SpaceSemanticToken { get }","}","","\/\/ There is an existing provider for such tokens","open class BlueCoatThemeButtonComponentTokensProvider { }","","\/\/ Define the components tokens exposed through the theme thanks to provider","extension BlueCoatThemeButtonComponentTokensProvider: ButtonComponentTokens {","","    \/\/ Raw tokens can be used","","    @objc open var sizeMaxHeightIconOnly: SizeSemanticToken { DimensionRawTokens._600 }","    ","    \/\/ And also semantic tokens","","    @objc open var borderWidthDefault: BorderWidthSemanticToken { borders.widthThicker }","    @objc open var borderRadius: BorderRadiusSemanticToken { borders.radiusMedium }","    @objc open var colorBgDefaultPressedMono: MultipleColorSemanticToken { colors.repositoryOpacityBlackHigher }","    @objc open var spacePaddingBlock: SpaceSemanticToken { spaces.paddingInlineSpacious }","}","","\/\/ This provider is then exposed through MISOTheme as an AllButtonComponentTokensProvider"],"syntax":"swift"},{"text":"How to use component tokens","anchor":"How-to-use-component-tokens","type":"heading","level":2},{"inlineContent":[{"text":"In fact, the component tokens are declared and gathered in ","type":"text"},{"inlineContent":[{"text":"Swift protocol","type":"text"}],"type":"emphasis"},{"text":" so as to force any theme to implement them, and also to allow any theme to expose such properties whathever the implementation of the theme is, across providers.","type":"text"},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"text":" have for values ","type":"text"},{"inlineContent":[{"text":"raw tokens","type":"text"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"semantic tokens","type":"text"}],"type":"emphasis"},{"text":", and in the end for values primitive types, and all these tokens are declared with ","type":"text"},{"inlineContent":[{"text":"type aliases","type":"text"}],"type":"emphasis"},{"text":" refering all together, you can handle a ","type":"text"},{"inlineContent":[{"text":"component token","type":"text"}],"type":"emphasis"},{"text":" directly in your view because the final value will be used.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, get the theme and call the needed property with some helpers.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct SomeView: View {","","    @Environment(\\.theme) private var theme \/\/ Supposed you used in your root view the `MISOThemeableView` to register the theme","    @Environment(\\.colorScheme) private var colorScheme","","    var body: some View {","        Button {","            \/\/ Some action","        } label: {","            Text(\"Some label\")","                .cornerRadius(theme.button.borderRadius)","        }","        .padding(.leading, theme.button.spacePaddingInlineChevronStartDefault)","        .padding(.trailing, theme.button.spacePaddingInlineChevronEndDefault)","        .background(theme.button.colorBgStrongEnabledMono)","        .overlay(","            RoundedRectangle(cornerRadius: theme.button.borderRadius)","                .stroke(Color.blue, lineWidth: theme.button.borderWidthDefault)","        )","    }","\/*","    - The theme provides border semantic tokens \"borderRadius\" and \"borderWidthDefault\"","    - The theme provides a color semantic token \"colorBgStrongEnabledMono\"","    - The theme provides spaces semantic token \"spacePaddingInlineChevronStart\" and \"spacePaddingInlineChevronEnd\"","*\/","}","","\/\/ Do not forget in your app to use the `MISOThemeableView` for your theme, e.g. `BlueCoatTheme`","@main","struct DesignToolbox: App {","","    var body: some Scene {","        WindowGroup {","            MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","                ...","            }","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"The components tokens are wrapped in tokens provider accessible through the themes:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Components tokens provider","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Target component","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"accordion \/ accordionFaq","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For accordions components","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"alert","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For alert mesdsages and inline alert components like ","type":"text"},{"code":"MISOAlertMessage","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MISOInlineAlert","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"bar","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For bars components like bottom and navigation bars","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"badge","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For badges like ","type":"text"},{"code":"MISOBadgeStandard","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MISOBadgeIcon","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MISOBadgeCount","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"button","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For buttons like ","type":"text"},{"code":"MISOButton","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"bulletList","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For list of elements with bullets like ","type":"text"},{"code":"MISOBulletList","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"checkbox","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For checkboxes like ","type":"text"},{"code":"MISOCheckbox","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MISOCheckboxItem","type":"codeVoice"},{"text":" and their indeterminate variants","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"chip","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For chips like ","type":"text"},{"code":"MISOSuggestionChip","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MISOFilterChip","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"divider","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For dividers like ","type":"text"},{"code":"MISOHorizontalDivider","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MISOVerticalDivider","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"icon","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For components containing icons like ","type":"text"},{"code":"MISOTag","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"link","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For links like ","type":"text"},{"code":"MISOLink","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"listItem","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shared and used for switch, checkbox, radio items and list items layouts","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"pinCodeInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"quantityInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"radioButton","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"For radio components like ","type":"text"},{"code":"MISORadio","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MISORadioItem","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"selectInput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"skeleton","type":"text"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"text":"switch","type":"text"}],