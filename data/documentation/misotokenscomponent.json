{"metadata":{"role":"collection","externalID":"MISOTokensComponent","title":"Tokens for components","roleHeading":"Library","modules":[{"name":"Tokens for components"}],"images":[{"identifier":"ic_design_tokens_components_intro.png","type":"icon"}],"symbolKind":"module"},"kind":"symbol","hierarchy":{"paths":[[]]},"abstract":[{"type":"text","text":"These "},{"inlineContent":[{"type":"text","text":"tokens"}],"type":"emphasis"},{"type":"text","text":" are defined for components and refer to semantic tokens or raw tokens."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as a kind of bridge between components and in the end primitive values of the design kit."}],"sections":[],"topicSections":[{"title":"Group","anchor":"Group","identifiers":["doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionFaqComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertMessageComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BarComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BadgeComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BulletListComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CategoricalTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CheckboxComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ChipComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/DividerComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/IconComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ListItemComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/PinCodeInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ProgressIndicatorComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/QuantityInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/RadioButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SelectInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SkeletonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SwitchComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ToastComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/InputTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextAreaComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TypographyComponentTokens"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misotokenscomponent"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"code":["🧬 Core version: 1.11.0"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Thus if a component need to change for example its "},{"type":"emphasis","inlineContent":[{"type":"text","text":"background color"}]},{"type":"text","text":", and if a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component token"}]},{"type":"text","text":" is used for it, then only the value of this "},{"type":"emphasis","inlineContent":[{"type":"text","text":"token"}]},{"type":"text","text":" should be changed without any modification on the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component"}]},{"type":"text","text":" definition."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Components"}]},{"type":"text","text":" use "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" exposed through the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme"}]},{"type":"text","text":" thanks to token providers to get their style values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Components tokens are defined and gathered inside "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift protocol"}]},{"type":"text","text":" so as to be exposed then through implementation of "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" thanks to dedicated tokens providers."},{"type":"text","text":" "},{"type":"text","text":"Because we choose to split responsabilities and objects into their own modules, we faced troubles to make possible for children themes or providers to override properties declared in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"protocols"}]},{"type":"text","text":" and defined in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"extensions"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That is the reason why tokens are exposed as "},{"type":"codeVoice","code":"@objc open"},{"type":"text","text":" to be available and overridable anywhere."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Example with "},{"identifier":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ Declare some component tokens for buttons with properties they must apply","public protocol ButtonComponentTokens {","    var sizeMaxHeightIconOnly: SizeSemanticToken { get }","    var borderWidthDefault: BorderWidthSemanticToken { get }","    var borderRadius: BorderRadiusSemanticToken { get }","    var colorBgDefaultPressedMono: MultipleColorSemanticToken { get }","    var spacePaddingBlock: SpaceSemanticToken { get }","}","","\/\/ There is an existing provider for such tokens","open class BlueCoatThemeButtonComponentTokensProvider { }","","\/\/ Define the components tokens exposed through the theme thanks to provider","extension BlueCoatThemeButtonComponentTokensProvider: ButtonComponentTokens {","","    \/\/ Raw tokens can be used","","    @objc open var sizeMaxHeightIconOnly: SizeSemanticToken { DimensionRawTokens._600 }","    ","    \/\/ And also semantic tokens","","    @objc open var borderWidthDefault: BorderWidthSemanticToken { borders.widthThicker }","    @objc open var borderRadius: BorderRadiusSemanticToken { borders.radiusMedium }","    @objc open var colorBgDefaultPressedMono: MultipleColorSemanticToken { colors.repositoryOpacityBlackHigher }","    @objc open var spacePaddingBlock: SpaceSemanticToken { spaces.paddingInlineSpacious }","}","","\/\/ This provider is then exposed through MISOTheme as an AllButtonComponentTokensProvider"],"syntax":"swift","type":"codeListing"},{"anchor":"How-to-use-component-tokens","type":"heading","text":"How to use component tokens","level":2},{"inlineContent":[{"type":"text","text":"In fact, the component tokens are declared and gathered in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift protocol"}]},{"type":"text","text":" so as to force any theme to implement them, and also to allow any theme to expose such properties whathever the implementation of the theme is, across providers."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" have for values "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":", and in the end for values primitive types, and all these tokens are declared with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"type aliases"}]},{"type":"text","text":" refering all together, you can handle a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component token"}]},{"type":"text","text":" directly in your view because the final value will be used."},{"type":"text","text":" "},{"type":"text","text":"Thus, get the theme and call the needed property with some helpers."}],"type":"paragraph"},{"code":["struct SomeView: View {","","    @Environment(\\.theme) private var theme \/\/ Supposed you used in your root view the `MISOThemeableView` to register the theme","    @Environment(\\.colorScheme) private var colorScheme","","    var body: some View {","        Button {","            \/\/ Some action","        } label: {","            Text(\"Some label\")","                .cornerRadius(theme.button.borderRadius)","        }","        .padding(.leading, theme.button.spacePaddingInlineChevronStartDefault)","        .padding(.trailing, theme.button.spacePaddingInlineChevronEndDefault)","        .background(theme.button.colorBgStrongEnabledMono)","        .overlay(","            RoundedRectangle(cornerRadius: theme.button.borderRadius)","                .stroke(Color.blue, lineWidth: theme.button.borderWidthDefault)","        )","    }","\/*","    - The theme provides border semantic tokens \"borderRadius\" and \"borderWidthDefault\"","    - The theme provides a color semantic token \"colorBgStrongEnabledMono\"","    - The theme provides spaces semantic token \"spacePaddingInlineChevronStart\" and \"spacePaddingInlineChevronEnd\"","*\/","}","","\/\/ Do not forget in your app to use the `MISOThemeableView` for your theme, e.g. `BlueCoatTheme`","@main","struct DesignToolbox: App {","","    var body: some Scene {","        WindowGroup {","            MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","                ...","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The components tokens are wrapped in tokens provider accessible through the themes:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components tokens provider"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Target component"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"accordion \/ accordionFaq"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For accordions components"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"alert"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For alert mesdsages and inline alert components like "},{"type":"codeVoice","code":"MISOAlertMessage"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOInlineAlert"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"bar"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For bars components like bottom and navigation bars"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"badge"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For badges like "},{"type":"codeVoice","code":"MISOBadgeStandard"},{"type":"text","text":", "},{"type":"codeVoice","code":"MISOBadgeIcon"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOBadgeCount"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"button"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For buttons like "},{"type":"codeVoice","code":"MISOButton"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"bulletList"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For list of elements with bullets like "},{"type":"codeVoice","code":"MISOBulletList"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"checkbox"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For checkboxes like "},{"type":"codeVoice","code":"MISOCheckbox"},{"type":"text","text":", "},{"type":"codeVoice","code":"MISOCheckboxItem"},{"type":"text","text":" and their indeterminate variants"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"chip"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For chips like "},{"type":"codeVoice","code":"MISOSuggestionChip"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOFilterChip"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"divider"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For dividers like "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOVerticalDivider"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"icon"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components containing icons like "},{"type":"codeVoice","code":"MISOTag"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"link"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For links like "},{"type":"codeVoice","code":"MISOLink"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"listItem"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared and used for switch, checkbox, radio items and list items layouts"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"pinCodeInput"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"quantityInput"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"radioButton"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For radio components like "},{"type":"codeVoice","code":"MISORadio"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISORadioItem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"selectInput"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"skeleton"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"switch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For switch components like "},{"type":"codeVoice","code":"MISOSwitch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOSwitchItem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"tag"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For tag components like "},{"type":"codeVoice","code":"MISOTag"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"inputTag"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For input tag components like "},{"type":"codeVoice","code":"MISOInputTag"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"textArea"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For text area components like "},{"type":"codeVoice","code":"MISOTextArea"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"textInput"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For text field input components like "},{"type":"codeVoice","code":"MISOTextInput"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"typography"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For textual components like "},{"type":"codeVoice","code":"MISOText"}]}]]]}],"kind":"content"}],"references":{"doc://MISOTokensComponent/documentation/MISOTokensComponent/BadgeComponentTokens":{"kind":"symbol","abstract":[{"type":"text","text":"Declares all component tokens for badge components like "},{"type":"codeVoice","code":"MISOBadgeStandard"},{"type":"text","text":", "},{"type":"codeVoice","code":"MISOBadgeIcon"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOBadgeCount"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Use for tokens providers like "},{"type":"codeVoice","code":"BlueCoatThemeBadgeComponentTokensProvider"},{"type":"text","text":"."}],"title":"BadgeComponentTokens","url":"\/documentation\/misotokenscomponent\/badgecomponenttokens","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"BadgeComponentTokens"}],"identifier":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BadgeComponentTokens","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BadgeComponentTokens"}],"type":"topic"},"doc://MISOTokensComponent/documentation/MISOTokensComponent/InputTagComponentTokens":{"kind":"symbol","abstract":[{"type":"text","text":"Declares all component tokens for tags components like "},{"type":"codeVoice","code":"MISOInputTag"},{"type":"text","text":" "},{"type":"text","text":"Used for tokens providers like "},{"type":"codeVoice","code":"BlueCoatThemeInputTagComponentTokensProvider"},{"type":"text","text":"."}],"title":"InputTagComponentTokens","url":"\/documentation\/misotokenscomponent\/inputtagcomponenttokens","role":"symbol","navigatorTitle":[{"text":"InputTagComponentTokens","kind":"identifier"}],"identifier":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/InputTagComponentTokens"