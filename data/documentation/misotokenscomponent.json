{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"code":["🧬 Core version: 1.11.0"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"Thus if a component need to change for example its ","type":"text"},{"inlineContent":[{"type":"text","text":"background color"}],"type":"emphasis"},{"text":", and if a ","type":"text"},{"inlineContent":[{"type":"text","text":"component token"}],"type":"emphasis"},{"text":" is used for it, then only the value of this ","type":"text"},{"inlineContent":[{"type":"text","text":"token"}],"type":"emphasis"},{"text":" should be changed without any modification on the ","type":"text"},{"inlineContent":[{"text":"component","type":"text"}],"type":"emphasis"},{"type":"text","text":" definition."},{"type":"text","text":" "},{"inlineContent":[{"text":"Components","type":"text"}],"type":"emphasis"},{"type":"text","text":" use "},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"type":"text","text":" exposed through the "},{"inlineContent":[{"text":"theme","type":"text"}],"type":"emphasis"},{"type":"text","text":" thanks to token providers to get their style values."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Components tokens are defined and gathered inside "},{"inlineContent":[{"type":"text","text":"Swift protocol"}],"type":"emphasis"},{"text":" so as to be exposed then through implementation of ","type":"text"},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" thanks to dedicated tokens providers."},{"type":"text","text":" "},{"type":"text","text":"Because we choose to split responsabilities and objects into their own modules, we faced troubles to make possible for children themes or providers to override properties declared in "},{"inlineContent":[{"type":"text","text":"protocols"}],"type":"emphasis"},{"text":" and defined in ","type":"text"},{"inlineContent":[{"type":"text","text":"extensions"}],"type":"emphasis"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"That is the reason why tokens are exposed as ","type":"text"},{"code":"@objc open","type":"codeVoice"},{"text":" to be available and overridable anywhere.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example with "},{"identifier":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Declare some component tokens for buttons with properties they must apply","public protocol ButtonComponentTokens {","    var sizeMaxHeightIconOnly: SizeSemanticToken { get }","    var borderWidthDefault: BorderWidthSemanticToken { get }","    var borderRadius: BorderRadiusSemanticToken { get }","    var colorBgDefaultPressedMono: MultipleColorSemanticToken { get }","    var spacePaddingBlock: SpaceSemanticToken { get }","}","","\/\/ There is an existing provider for such tokens","open class BlueCoatThemeButtonComponentTokensProvider { }","","\/\/ Define the components tokens exposed through the theme thanks to provider","extension BlueCoatThemeButtonComponentTokensProvider: ButtonComponentTokens {","","    \/\/ Raw tokens can be used","","    @objc open var sizeMaxHeightIconOnly: SizeSemanticToken { DimensionRawTokens._600 }","    ","    \/\/ And also semantic tokens","","    @objc open var borderWidthDefault: BorderWidthSemanticToken { borders.widthThicker }","    @objc open var borderRadius: BorderRadiusSemanticToken { borders.radiusMedium }","    @objc open var colorBgDefaultPressedMono: MultipleColorSemanticToken { colors.repositoryOpacityBlackHigher }","    @objc open var spacePaddingBlock: SpaceSemanticToken { spaces.paddingInlineSpacious }","}","","\/\/ This provider is then exposed through MISOTheme as an AllButtonComponentTokensProvider"]},{"level":2,"text":"How to use component tokens","type":"heading","anchor":"How-to-use-component-tokens"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In fact, the component tokens are declared and gathered in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Swift protocol"}]},{"type":"text","text":" so as to force any theme to implement them, and also to allow any theme to expose such properties whathever the implementation of the theme is, across providers."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" have for values "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"semantic tokens"}]},{"type":"text","text":", and in the end for values primitive types, and all these tokens are declared with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"type aliases"}]},{"type":"text","text":" refering all together, you can handle a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component token"}]},{"type":"text","text":" directly in your view because the final value will be used."},{"type":"text","text":" "},{"type":"text","text":"Thus, get the theme and call the needed property with some helpers."}]},{"syntax":"swift","type":"codeListing","code":["struct SomeView: View {","","    @Environment(\\.theme) private var theme \/\/ Supposed you used in your root view the `MISOThemeableView` to register the theme","    @Environment(\\.colorScheme) private var colorScheme","","    var body: some View {","        Button {","            \/\/ Some action","        } label: {","            Text(\"Some label\")","                .cornerRadius(theme.button.borderRadius)","        }","        .padding(.leading, theme.button.spacePaddingInlineChevronStartDefault)","        .padding(.trailing, theme.button.spacePaddingInlineChevronEndDefault)","        .background(theme.button.colorBgStrongEnabledMono)","        .overlay(","            RoundedRectangle(cornerRadius: theme.button.borderRadius)","                .stroke(Color.blue, lineWidth: theme.button.borderWidthDefault)","        )","    }","\/*","    - The theme provides border semantic tokens \"borderRadius\" and \"borderWidthDefault\"","    - The theme provides a color semantic token \"colorBgStrongEnabledMono\"","    - The theme provides spaces semantic token \"spacePaddingInlineChevronStart\" and \"spacePaddingInlineChevronEnd\"","*\/","}","","\/\/ Do not forget in your app to use the `MISOThemeableView` for your theme, e.g. `BlueCoatTheme`","@main","struct DesignToolbox: App {","","    var body: some Scene {","        WindowGroup {","            MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","                ...","            }","        }","    }","}"]},{"inlineContent":[{"text":"The components tokens are wrapped in tokens provider accessible through the themes:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Components tokens provider"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Target component"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"accordion \/ accordionFaq"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For accordions components"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"alert"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For alert mesdsages and inline alert components like "},{"type":"codeVoice","code":"MISOAlertMessage"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOInlineAlert"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"bar"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For bars components like bottom and navigation bars"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"badge"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For badges like "},{"type":"codeVoice","code":"MISOBadgeStandard"},{"type":"text","text":", "},{"type":"codeVoice","code":"MISOBadgeIcon"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOBadgeCount"},{"type":"text","text":"."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"button"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For buttons like "},{"type":"codeVoice","code":"MISOButton"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"bulletList"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For list of elements with bullets like "},{"type":"codeVoice","code":"MISOBulletList"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"checkbox"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For checkboxes like "},{"type":"codeVoice","code":"MISOCheckbox"},{"type":"text","text":", "},{"type":"codeVoice","code":"MISOCheckboxItem"},{"type":"text","text":" and their indeterminate variants"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"chip"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For chips like "},{"type":"codeVoice","code":"MISOSuggestionChip"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOFilterChip"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"divider"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For dividers like "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOVerticalDivider"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"icon"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For components containing icons like "},{"type":"codeVoice","code":"MISOTag"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"link"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For links like "},{"type":"codeVoice","code":"MISOLink"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"listItem"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shared and used for switch, checkbox, radio items and list items layouts"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"pinCodeInput"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"quantityInput"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"radioButton"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For radio components like "},{"type":"codeVoice","code":"MISORadio"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISORadioItem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"selectInput"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"skeleton"}]}],[{"type":"paragraph","inlineContent":[]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"switch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For switch components like "},{"type":"codeVoice","code":"MISOSwitch"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOSwitchItem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"tag"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For tag components like "},{"type":"codeVoice","code":"MISOTag"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"inputTag"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For input tag components like "},{"type":"codeVoice","code":"MISOInputTag"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"textArea"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"For text area components like "},{"type":"codeVoice","code":"MISOTextArea"}]}]],[[{"type":"paragrap