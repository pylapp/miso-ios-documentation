{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"These ","type":"text"},{"inlineContent":[{"type":"text","text":"tokens"}],"type":"emphasis"},{"text":" are defined for components and refer to semantic tokens or raw tokens.","type":"text"},{"text":" ","type":"text"},{"text":"They can be seen as a kind of bridge between components and in the end primitive values of the design kit.","type":"text"}],"topicSections":[{"title":"Group","identifiers":["doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AccordionFaqComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/AlertMessageComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BarComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BadgeComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/BulletListComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CategoricalTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/CheckboxComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ChipComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/DividerComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/IconComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/LinkMonoComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ListItemComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/PinCodeInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ProgressIndicatorComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/QuantityInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/RadioButtonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SelectInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SkeletonComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/SwitchComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ToastComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/InputTagComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextAreaComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TextInputComponentTokens","doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/TypographyComponentTokens"],"anchor":"Group"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"syntax":null,"code":["🧬 Core version: 1.11.0"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Thus if a component need to change for example its "},{"inlineContent":[{"type":"text","text":"background color"}],"type":"emphasis"},{"type":"text","text":", and if a "},{"inlineContent":[{"type":"text","text":"component token"}],"type":"emphasis"},{"type":"text","text":" is used for it, then only the value of this "},{"inlineContent":[{"type":"text","text":"token"}],"type":"emphasis"},{"type":"text","text":" should be changed without any modification on the "},{"inlineContent":[{"type":"text","text":"component"}],"type":"emphasis"},{"type":"text","text":" definition."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Components"}],"type":"emphasis"},{"type":"text","text":" use "},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"type":"text","text":" exposed through the "},{"inlineContent":[{"type":"text","text":"theme"}],"type":"emphasis"},{"type":"text","text":" thanks to token providers to get their style values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Components tokens are defined and gathered inside "},{"inlineContent":[{"type":"text","text":"Swift protocol"}],"type":"emphasis"},{"type":"text","text":" so as to be exposed then through implementation of "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" thanks to dedicated tokens providers."},{"type":"text","text":" "},{"type":"text","text":"Because we choose to split responsabilities and objects into their own modules, we faced troubles to make possible for children themes or providers to override properties declared in "},{"inlineContent":[{"type":"text","text":"protocols"}],"type":"emphasis"},{"type":"text","text":" and defined in "},{"inlineContent":[{"type":"text","text":"extensions"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That is the reason why tokens are exposed as "},{"type":"codeVoice","code":"@objc open"},{"type":"text","text":" to be available and overridable anywhere."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Example with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensComponent\/documentation\/MISOTokensComponent\/ButtonComponentTokens"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Declare some component tokens for buttons with properties they must apply","public protocol ButtonComponentTokens {","    var sizeMaxHeightIconOnly: SizeSemanticToken { get }","    var borderWidthDefault: BorderWidthSemanticToken { get }","    var borderRadius: BorderRadiusSemanticToken { get }","    var colorBgDefaultPressedMono: MultipleColorSemanticToken { get }","    var spacePaddingBlock: SpaceSemanticToken { get }","}","","\/\/ There is an existing provider for such tokens","open class BlueCoatThemeButtonComponentTokensProvider { }","","\/\/ Define the components tokens exposed through the theme thanks to provider","extension BlueCoatThemeButtonComponentTokensProvider: ButtonComponentTokens {","","    \/\/ Raw tokens can be used","","    @objc open var sizeMaxHeightIconOnly: SizeSemanticToken { DimensionRawTokens._600 }","    ","    \/\/ And also semantic tokens","","    @objc open var borderWidthDefault: BorderWidthSemanticToken { borders.widthThicker }","    @objc open var borderRadius: BorderRadiusSemanticToken { borders.radiusMedium }","    @objc open var colorBgDefaultPressedMono: MultipleColorSemanticToken { colors.repositoryOpacityBlackHigher }","    @objc open var spacePaddingBlock: SpaceSemanticToken { spaces.paddingInlineSpacious }","}","","\/\/ This provider is then exposed through MISOTheme as an AllButtonComponentTokensProvider"],"type":"codeListing"},{"text":"How to use component tokens","type":"heading","level":2,"anchor":"How-to-use-component-tokens"},{"inlineContent":[{"type":"text","text":"In fact, the component tokens are declared and gathered in "},{"inlineContent":[{"type":"text","text":"Swift protocol"}],"type":"emphasis"},{"type":"text","text":" so as to force any theme to implement them, and also to allow any theme to expose such properties whathever the implementation of the theme is, across providers."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"inlineContent":[{"type":"text","text":"component tokens"}],"type":"emphasis"},{"type":"text","text":" have for values "},{"inlineContent":[{"type":"text","text":"raw tokens"}],"type":"emphasis"},{"type":"text","text":" or "},{"inlineContent":[{"type":"text","text":"semantic tokens"}],"type":"emphasis"},{"type":"text","text":", and in the end for values primitive types, and all these tokens are declared with "},{"inlineContent":[{"type":"text","text":"type aliases"}],"type":"emphasis"},{"type":"text","text":" refering all together, you can handle a "},{"inlineContent":[{"type":"text","text":"component token"}],"type":"emphasis"},{"type":"text","text":" directly in your view because the final value will be used."},{"type":"text","text":" "},{"type":"text","text":"Thus, get the theme and call the needed property with some helpers."}],"type":"paragraph"},{"syntax":"swift","code":["struct SomeView: View {","","    @Environment(\\.theme) private var theme \/\/ Supposed you used in your root view the `MISOThemeableView` to register the theme","    @Environment(\\.colorScheme) private var colorScheme","","    var body: some View {","        Button {","            \/\/ Some action","        } label: {","            Text(\"Some label\")","                .cornerRadius(theme.button.borderRadius)","        }","        .padding(.leading, theme.button.spacePaddingInlineChevronStartDefault)","        .padding(.trailing, theme.button.spacePaddingInlineChevronEndDefault)","        .background(theme.button.colorBgStrongEnabledMono)","        .overlay(","            RoundedRectangle(cornerRadius: theme.button.borderRadius)","                .stroke(Color.blue, lineWidth: theme.button.borderWidthDefault)","        )","    }","\/*","    - The theme provides border semantic tokens \"borderRadius\" and \"borderWidthDefault\"","    - The theme provides a color semantic token \"colorBgStrongEnabledMono\"","    - The theme provides spaces semantic token \"spacePaddingInlineChevronStart\" and \"spacePaddingInlineChevronEnd\"","*\/","}","","\/\/ Do not forget in your app to use the `MISOThemeableView` for your theme, e.g. `BlueCoatTheme`","@main","struct DesignToolbox: App {","","    var body: some Scene {","        WindowGroup {","            MISOThemeableView(theme: BlueCoatTheme()) {","                \/\/ Your root view","                ...","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The components tokens are wrapped in tokens provider accessible through the themes:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Components tokens provider"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Target component"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"accordion \/ accordionFaq"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For accordions components"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"alert"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For alert mesdsages and inline alert components like "},{"code":"MISOAlertMessage","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISOInlineAlert","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"bar"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For bars components like bottom and navigation bars"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"badge"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For badges like "},{"code":"MISOBadgeStandard","type":"codeVoice"},{"type":"text","text":", "},{"code":"MISOBadgeIcon","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISOBadgeCount","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"button"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For buttons like "},{"code":"MISOButton","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"bulletList"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For list of elements with bullets like "},{"code":"MISOBulletList","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"checkbox"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For checkboxes like "},{"code":"MISOCheckbox","type":"codeVoice"},{"type":"text","text":", "},{"code":"MISOCheckboxItem","type":"codeVoice"},{"type":"text","text":" and their indeterminate variants"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"chip"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For chips like "},{"code":"MISOSuggestionChip","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISOFilterChip","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"divider"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For dividers like "},{"code":"MISOHorizontalDivider","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISOVerticalDivider","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"icon"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For components containing icons like "},{"code":"MISOTag","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"link"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For links like "},{"code":"MISOLink","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"listItem"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shared and used for switch, checkbox, radio items and list items layouts"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"pinCodeInput"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"quantityInput"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"radioButton"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For radio components like "},{"code":"MISORadio","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISORadioItem","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"selectInput"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"skeleton"}],"type":"paragraph"}],[{"inlineContent":[],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"switch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For switch components like "},{"code":"MISOSwitch","type":"codeVoice"},{"type":"text","text":" and "},{"code":"MISOSwitchItem","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"tag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For tag components like "},{"code":"MISOTag","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"inputTag"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For input tag components like "},{"code":"MISOInputTag","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"textArea"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For text area components like "},{"code":"MISOTextArea","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"textInput"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For text field input components like "},{"code":"MISOTextInput","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"typography"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"For textual components like "},{"code":"MISOText","type":"codeVoice"}],"type":"paragraph"}]]]}],"kind":"content"}],"kind":"symbol","variants":[{"paths":["\/documentation\/misotokenscomponent"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[[]]},"metadata":{"modules":[{"name":"Tokens f