,{"type":"emphasis","inlineContent":[{"type":"text","text":"radius"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"type":"topic","role":"symbol","title":"ElevationCompositeRawToken","identifier":"doc:\/\/MISOTokensRaw\/documentation\/MISOTokensRaw\/ElevationCompositeRawToken","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"url":"\/documentation\/misotokensraw\/elevationcompositerawtoken","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeRawToken"}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic":{"type":"topic","abstract":[{"type":"text","text":"These "},{"inlineContent":[{"type":"text","text":"tokens"}],"type":"emphasis"},{"type":"text","text":" can be used mainly for "},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"title":"Tokens for semantics","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic","url":"\/documentation\/misotokenssemantic","role":"collection","kind":"symbol","images":[{"type":"icon","identifier":"ic_design_tokens_semantics_intro.png"}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleElevationCompositeRawToken":{"navigatorTitle":[{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"url":"\/documentation\/misotokenssemantic\/multipleelevationcompositerawtoken","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken","kind":"symbol","title":"MultipleElevationCompositeRawToken","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"code":"ElevationCompositeRawToken","type":"codeVoice"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"role":"symbol"}}}