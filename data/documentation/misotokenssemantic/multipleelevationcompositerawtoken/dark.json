s_intro.png":{"alt":null,"type":"image","variants":[{"url":"\/images\/MISOTokensSemantic\/ic_design_tokens_semantics_intro.png","traits":["1x","light"]}],"identifier":"ic_design_tokens_semantics_intro.png"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic":{"title":"Tokens for semantics","kind":"symbol","url":"\/documentation\/misotokenssemantic","images":[{"identifier":"ic_design_tokens_semantics_intro.png","type":"icon"}],"role":"collection","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic","type":"topic","abstract":[{"text":"These ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"text":" to apply some style and configuration values ; today ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"text":" are not defined yet.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleElevationCompositeRawToken/dark":{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/dark","title":"dark","abstract":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"type":"text","text":"dark"}]},{"type":"text","text":" mode scheme"}],"type":"topic","kind":"symbol","url":"\/documentation\/misotokenssemantic\/multipleelevationcompositerawtoken\/dark","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"dark"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@MISOTokensRaw@objc(cs)ElevationCompositeRawToken","text":"ElevationCom