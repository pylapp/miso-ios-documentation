 and a "},{"type":"emphasis","inlineContent":[{"text":"color","type":"text"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"text":"composite raw token","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"role":"symbol","type":"topic","kind":"symbol","title":"ElevationCompositeRawToken","navigatorTitle":[{"kind":"identifier","text":"ElevationCompositeRawToken"}],"url":"\/documentation\/misotokensraw\/elevationcompositerawtoken"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleElevationCompositeRawToken/light":{"role":"symbol","abstract":[{"text":"For ","type":"text"},{"type":"strong","inlineContent":[{"text":"light","type":"text"}]},{"text":" mode scheme","type":"text"}],"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/light","kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"light"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@MISOTokensRaw@objc(cs)ElevationCompositeRawToken","text":"ElevationCompositeRawToken"}],"url":"\/documentation\/misotokenssemantic\/multipleelevationcompositerawtoken\/light","type":"topic","title":"light"}}}