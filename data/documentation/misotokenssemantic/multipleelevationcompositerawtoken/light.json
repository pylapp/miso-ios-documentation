xt"}],"type":"emphasis"},{"text":" is caracterized by ","type":"text"},{"inlineContent":[{"type":"text","text":"X and Y offsets"}],"type":"emphasis"},{"text":", a ","type":"text"},{"inlineContent":[{"text":"radius","type":"text"}],"type":"emphasis"},{"text":" for the shadow and a ","type":"text"},{"inlineContent":[{"text":"color","type":"text"}],"type":"emphasis"},{"text":" to apply on that shadow.","type":"text"},{"text":" ","type":"text"},{"text":"All these elements are ","type":"text"},{"inlineContent":[{"text":"raw tokens","type":"text"}],"type":"emphasis"},{"text":", and together define a ","type":"text"},{"inlineContent":[{"type":"text","text":"composite raw token"}],"type":"emphasis"},{"text":" for ","type":"text"},{"inlineContent":[{"text":"elevation","type":"text"}],"type":"emphasis"},{"text":" effect.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}],"url":"\/documentation\/misotokensraw\/elevationcompositerawtoken","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationCompositeRawToken"}],"kind":"symbol"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleElevationCompositeRawToken/light":{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/light","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"light","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ElevationCompositeRawToken","kind":"typeIdentifier","preciseIdentifier":"c:@M@MISOTokensRaw@objc(cs)ElevationCompositeRawToken"}],"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"For "},{"type":"strong","inlineC