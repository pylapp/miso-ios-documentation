 an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" is caracterized by "},{"type":"emphasis","inlineContent":[{"type":"text","text":"X and Y offsets"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"radius"}]},{"type":"text","text":" for the shadow and a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color"}]},{"type":"text","text":" to apply on that shadow."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"composite raw token"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"elevation"}]},{"type":"text","text":" effect."},{"type":"text","text":" "},{"type":"text","text":"It is defined as a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" and "},{"type":"codeVoice","code":"NSObject"},{"type":"text","text":" so as to be shared through "},{"type":"codeVoice","code":"@objc"},{"type":"text","text":" with extensions and protocols within modules."}]},"ic_design_tokens_semantics_intro.png":{"variants":[{"url":"\/images\/MISOTokensSemantic\/ic_design_tokens_semantics_intro.png","traits":["1x","light"]}],"identifier":"ic_design_tokens_semantics_intro.png","alt":null,"type":"image"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic":{"title":"Tokens for semantics","kind":"symbol","url":"\/documentation\/misotokenssemantic","images":[{"identifier":"ic_design_tokens_semantics_intro.png","type":"icon"}],"role":"collection","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic","type":"topic","abstract":[{"text":"These ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokens"}]},{"type":"text","text":" can be used mainly for "},{"type":"emphasis"