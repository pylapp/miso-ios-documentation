e values, but not named “composite” because this word is already used in the design system.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"text":" inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If a font token exists with its value depending to the size class, it must be packed in such ","type":"text"},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken","isActive":true,"type":"reference"},{"text":".","type":"text"}],"sections":[],"metadata":{"role":"symbol","symbolKind":"class","modules":[{"name":"Tokens for semantics"}],"externalID":"c:@M@MISOTokensSemantic@objc(cs)MultipleFontCompositeSemanticToken","navigatorTitle":[{"text":"MultipleFontCompositeSemanticToken","kind":"identifier"}],"roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleFontCompositeSemanticToken","kind":"identifier"}],"title":"MultipleFontCompositeSemanticToken"},"relationshipsSections":[{"identifiers":["doc:\/\/MISOTokensSemantic\/objc(cs)NSObject"],"title":"Inherits From","kind":"relationships","type":"inheritsFrom"},{"identifiers":["doc:\/\/MISOTokensSemantic\/objc(pl)NSObject","doc:\/\/MISOTokensSemantic\/s7CVarArgP","doc:\/\/MISOTokensSemantic\/SL","doc:\/\/MISOTokensSemantic\/s28CustomDebugStringConvertibleP","doc:\/\/MISOTokensSemantic\/s23CustomStringConvertibleP","doc:\/\/MISOTokensSemantic\/SQ","doc:\/\/MISOTokensSemantic\/SH","doc:\/\/MISOTokensSemantic\/s8SendableP","doc:\/\/MISOTokensSemantic\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleFontCompositeSemanticToken","kind