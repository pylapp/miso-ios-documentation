{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"FontCompositeSemanticToken"},{"type":"text","text":" depending to size classes."},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a font token exists with its value depending to the size class, it must be packed in such "},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken","isActive":true,"type":"reference"},{"type":"text","text":"."}],"topicSections":[{"generated":true,"anchor":"Operators","title":"Operators","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken\/_(_:_:)"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken\/init(_:)","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken\/init(compact:regular:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken\/compact","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken\/regular"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken\/fontTok