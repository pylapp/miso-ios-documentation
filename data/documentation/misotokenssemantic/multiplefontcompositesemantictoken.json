her level version as it is less error-prone."],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The case of this ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken"},{"text":" is quite particular because in fact it contains ","type":"text"},{"code":"FontCompositeSemanticToken","type":"codeVoice"},{"type":"text","text":" "},{"text":"(i.e. raw tokens) instead of semantic tokens.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"In fact there is not “font composite semantic tokens” defined in the "},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"text":" kit.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.22.0"}]}],"type":"aside","style":"note","name":"Since"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/misotokenssemantic\/multiplefontcompositesemantictoken"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic"]]},"kind":"symbol","sections":[],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/MISOTokensSemantic\/objc(cs)NSObject"],"kind":"relationships"},{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOTokensSemantic\/objc(pl)NSObject","doc:\/\/MISOTokensSemantic\/s7CVarArgP","doc:\/\/MISOTokensSemantic\/SL","doc:\/\/MISOTokensSemantic\/s28CustomDebugStringConvertibleP","doc:\/\/MISOTokensSemantic\/s23CustomStringConvertibleP","doc:\/\/MISOTokensSemantic\/SQ","doc:\/\/MISOTokensSemantic\/SH","doc:\/\/MISOTokensSemantic\/s8SendableP","doc:\/\/MISOTokensSemantic\/s16SendableMetatypeP"],"type":"conformsTo"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken"},"metadata":{"title":"M