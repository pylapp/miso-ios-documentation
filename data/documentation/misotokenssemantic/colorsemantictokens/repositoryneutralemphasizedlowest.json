antic\/ColorMultipleSemanticTokens","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If it possible a theme won’t have such semantic tokens of colors defined as not specified nor used in Figma."},{"type":"text","text":" "},{"type":"text","text":"Thus the value for these tokens will be “miso-forbidden-color-value” as returned by the tokenator."},{"type":"text","text":" "},{"type":"text","text":"Thus if the token is still used, even if explained in the documentation it should not,"},{"type":"text","text":" "},{"type":"text","text":"this special value won’t be successfully parsed as color and the app will crash like expected."}]},"ic_design_tokens_semantics_intro.png":{"type":"image","identifier":"ic_design_tokens_semantics_intro.png","alt":null,"variants":[{"url":"\/images\/MISOTokensSemantic\/ic_design_tokens_semantics_intro.png","traits":["1x","light"]}]}}}