:"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken","isActive":true,"type":"reference"},{"type":"text","text":"  a theme must have."},{"type":"text","text":" "},{"type":"text","text":"These tokens are then gathered inside "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken"},{"type":"text","text":" objects defined in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorMultipleSemanticTokens"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If it possible a theme won’t have such semantic tokens of colors defined as not specified nor used in Figma."},{"type":"text","text":" "},{"type":"text","text":"Thus the value for these tokens will be “miso-forbidden-color-value” as returned by the tokenator."},{"type":"text","text":" "},{"type":"text","text":"Thus if the token is still used, even if explained in the documentation it should not,"},{"type":"text","text":" "},{"type":"text","text":"this special value won’t be successfully parsed as color and the app will crash like expected."}],"fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ColorSemanticTokens"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticTokens","url":"\/documentation\/misotokenssemantic\/colorsemantictokens","title":"ColorSemanticTokens","navigatorTitle":[{"text":"ColorSemanticTokens","kind":"identifier"}]},"ic_design_tokens_semantics_intro.png":{"type":"image","identifier":"ic_design_tokens_semantics_intro.png","alt":null,"variants":[{"url":"\/images\/MISOTokensSemantic\/ic_design_tokens_semantics_intro.png","traits":["1x","light"]}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ColorSemanticTokens/repositoryWarningHigh":{"abstract