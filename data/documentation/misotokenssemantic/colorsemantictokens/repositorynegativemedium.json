fier"}],"url":"\/documentation\/misotokenssemantic\/colorsemantictoken","role":"symbol","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ColorSemanticToken","kind":"identifier"}],"title":"ColorSemanticToken","type":"topic","abstract":[{"type":"text","text":"Basically a color semantic  token is a "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":", to keep grammar clean and clear with design system grammar."}],"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ColorSemanticTokens":{"navigatorTitle":[{"kind":"identifier","text":"ColorSemanticTokens"}],"title":"ColorSemanticTokens","kind":"symbol","url":"\/documentation\/misotokenssemantic\/colorsemantictokens","role":"symbol","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticTokens","type":"topic","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"inlineContent":[{"type":"text","text":"colors"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all "},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken","isActive":true,"type":"reference"},{"text":"  a theme must have.","type":"text"},{"text":" ","type":"text"},{"text":"These tokens are then gathered inside ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken"},{"type":"text","text":" objects defined in "},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorMultipleSemanticTokens","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If it possible a theme won’t have such semantic tokens of colors defined as not specified nor used in Figma.","type":"text"},{"text":" ","type":"text"},{"text":"Thus the value for these tokens will be “miso-forbidden-color-value” as returned by the tokenator.","type":"text"},{"text":" ","type":"text"},{"text":"Thus if the token is still used, even if explained in the documentation it should not,","type":"text"},{"text":" ","type":"text"},{"text":"this special value won’t be successfully parsed as color and the app will crash like expected.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorSemanticTokens"}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ColorSemanticTokens/repositoryNegativeMedium":{"abstract":[],"required":true,"url":"\/documentation\/misotokenssemantic\/colorsemantictokens\/repositorynegativemedium","role":"symbol","title":"repositoryNegativeMedium","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticTokens\/repositoryNegativeMedium","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"repositoryNegativeMedium","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ColorSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic05ColorB5Tokena","kind":"typeIdentifier"}],"type":"topic"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleColorSemanticToken":{"navigatorTitle":[{"text":"MultipleColorSemanticToken","kind":"identifier"}],"url":"\/documentation\/misotokenssemantic\/multiplecolorsemantictoken","role":"symbol","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleColorSemanticToken","kind":"identifier"}],"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken","title":"MultipleColorSemanticToken","type":"topic","abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"reference","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken","isActive":true},{"type":"text","text":" depending to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color scheme"}]},{"text":" (i.e. ligh mode or dark mode).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"text":"Allows to gather the multiple-value tokens from ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If a color token exists with its value depending to the color scheme, it must be packed in such ``MultipleColorSemanticToken`"}]}}}