 successfully parsed as color and the app will crash like expected.","type":"text"}],"role":"symbol"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleColorSemanticToken":{"title":"MultipleColorSemanticToken","navigatorTitle":[{"kind":"identifier","text":"MultipleColorSemanticToken"}],"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken","type":"topic","url":"\/documentation\/misotokenssemantic\/multiplecolorsemantictoken","kind":"symbol","abstract":[{"text":"Kind of semantic tokens which will wrap a combination of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken"},{"type":"text","text":" depending to "},{"type":"emphasis","inlineContent":[{"text":"color scheme","type":"text"}]},{"text":" (i.e. ligh mode or dark mode).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"text":" inside one object.","type":"text"},{"type":"text","text":" "},{"text":"If a color token exists with its value depending to the color scheme, it must be packed in such ``MultipleColorSemanticToken`","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleColorSemanticToken"}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ColorMultipleSemanticTokens":{"abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"type":"text","text":"colors"}]},{"type":"text","text":" but using "},{"isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken","type":"reference"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ColorMultipleSemanticTokens"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorMultipleSemanticTokens","title":"ColorMultipleSemanticTokens","url":"\/documentation\/misotokenssemantic\/colormultiplesemantictokens","navigatorTitle":[{"kind":"identifier","text":"ColorMultipleSemanticTokens"}]},"ic_design_tokens_semantics_intro.png":{"type":"image","identifier":"ic_design_tokens_semantics_intro.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/MISOTokensSemantic\/ic_design_tokens_semantics_intro.png"}]}}}