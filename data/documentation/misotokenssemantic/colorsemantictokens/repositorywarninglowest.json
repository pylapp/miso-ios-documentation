,"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"components","type":"text"}],"type":"emphasis"},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"type":"topic"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ColorSemanticToken":{"url":"\/documentation\/misotokenssemantic\/colorsemantictoken","navigatorTitle":[{"kind":"identifier","text":"ColorSemanticToken"}],"abstract":[{"type":"text","text":"Basically a color semantic  token is a "},{"type":"codeVoice","code":"ColorRawToken"},{"text":", to keep grammar clean and clear with design system grammar.","type":"text"}],"title":"ColorSemanticToken","kind":"symbol","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken","type":"topic","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"kind":"text","text":" "},{"text":"ColorSemanticToken","kind":"identifier"}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleColorSemanticToken":{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken","url":"\/documentation\/misotokenssemantic\/multiplecolorsemantictoken","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"MultipleColorSemanticToken","kind":"identifier"}],"title":"MultipleColorSemanticToken","abstract":[{"text":"Kind of semantic tokens which will wrap a combination of ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken"},{"type":"text","text":" depending to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"color scheme"}]},{"text":" (i.e. ligh mode or dark mode).","type":"text"},{"text":" ","type":"text"},{"text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"text":" inside one object.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"If a color token exists with its value depending to the color scheme, it must be packed in such ``MultipleColorSemanticToken`"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MultipleColorSemanticToken"}]},"ic_design_tokens_semantics_intro.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOTokensSemantic\/ic_design_tokens_semantics_intro.png"}],"identifier":"ic_design_tokens_semantics_intro.png","alt":null}}}