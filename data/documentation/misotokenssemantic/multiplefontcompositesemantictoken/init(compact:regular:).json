ng is caracterized by a "},{"type":"emphasis","inlineContent":[{"text":"font size","type":"text"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"line height"}]},{"type":"text","text":", a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font weight"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"letter spacing","type":"text"}]},{"type":"text","text":" values."},{"type":"text","text":" "},{"type":"text","text":"All these elements are "},{"type":"emphasis","inlineContent":[{"type":"text","text":"raw tokens"}]},{"type":"text","text":", and together define a "},{"type":"emphasis","inlineContent":[{"text":"composite raw token","type":"text"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"font"}]},{"type":"text","text":" thing."}],"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/FontCompositeSemanticToken","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FontCompositeSemanticToken","kind":"identifier"}],"navigatorTitle":[{"text":"FontCompositeSemanticToken","kind":"identifier"}],"url":"\/documentation\/misotokenssemantic\/fontcompositesemantictoken","type":"topic","title":"FontCompositeSemanticToken"}}}