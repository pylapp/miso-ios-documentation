 today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic","images":[{"type":"icon","identifier":"ic_design_tokens_semantics_intro.png"}],"url":"\/documentation\/misotokenssemantic","title":"Tokens for semantics","kind":"symbol","role":"collection"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleFontCompositeSemanticToken/compact":{"title":"compact","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"compact","kind":"identifier"},{"text":": ","kind":"text"},{"text":"FontCompositeSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic013FontCompositeB5TokenV","kind":"typeIdentifier"}],"url":"\/documentation\/misotokenssemantic\/multiplefontcompositesemantictoken\/compact","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"For "},{"type":"strong","inlineContent":[{"text":"extra-compact","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"text":"compact","type":"text"}]},{"type":"text","text":" viewports"}],"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontCompositeSemanticToken\/compact"}}}