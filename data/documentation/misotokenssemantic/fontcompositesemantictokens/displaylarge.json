g"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/FontSemanticTokens":{"abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"font","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all font semantic tokens a theme must have"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"reference","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/FontFamilySemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/FontWeightSemanticToken","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/FontSizeSemanticToken","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/FontLineHeightSemanticToken","type":"reference","isActive":true},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"However the composite tokens (here the ones gathering each type of semantic token here) are defined in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/FontCompositeSemanticTokens"},{"type":"text","text":" because the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tokenator"}]},{"type":"text","text":" "},{"type":"text","text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted."},{"type":"text","text":" "},{"type":"text","text":"Any font semantic token must be declared there (except "},{"isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/FontCompositeSemanticTokens","type":"reference"},{"type":"text","text":")."}],"type":"topic","role":"symbol","title":"FontSemanticTokens","identifier":"doc:\/\/MIS