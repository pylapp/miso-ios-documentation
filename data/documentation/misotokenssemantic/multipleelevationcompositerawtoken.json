{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misotokenssemantic\/multipleelevationcompositerawtoken"]}],"abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","identifiers":["doc:\/\/MISOTokensSemantic\/objc(cs)NSObject"],"kind":"relationships"},{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOTokensSemantic\/objc(pl)NSObject","doc:\/\/MISOTokensSemantic\/s7CVarArgP","doc:\/\/MISOTokensSemantic\/s28CustomDebugStringConvertibleP","doc:\/\/MISOTokensSemantic\/s23CustomStringConvertibleP","doc:\/\/MISOTokensSemantic\/SQ","doc:\/\/MISOTokensSemantic\/SH","doc:\/\/MISOTokensSemantic\/s8SendableP","doc:\/\/MISOTokensSemantic\/s16SendableMetatypeP"],"kind":"relationships"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"syntax":"swift","code":["        \/\/ Assuming in Figma with have a elevation semantic token none,","        \/\/ with values depending to color scheme. These values are defined as elevation raw tokens.","        let bottom_0 = ElevationCompositeRawToken(x: x0, y: y0, blur: blur0, color: ColorRawTokens.opacityBlack0)","        let bottom_1_100 = ElevationCompositeRawToken(x: x0, y: y100, blur: blur200, color: ColorRawTokens.opacityBlack100)","","        \/\/ Then the develoment team declares an \"higher\" level elevation semantic token","        \/\/ inside ElevationCompositeSemanticTokens protocol,","        \/\/ and defined inside BlueCoatTheme+ElevationCompositeSemanticTokens extension","        \/\/ ElevationCompositeSemanticToken is a typealias for MultipleElevationCompositeRawToken to keep same grammar as design kit","        var none: ElevationCompositeSemanticToken {","            ElevationCompositeSemanticToken(light: bottom_0, dark: bottom_1_100)","        }","","        \/\/ If the same elevation is used whatever the color scheme is","        var none: ElevationCompositeSemanticToken {","            ElevationCompositeSemanticToken(bottom_0)","        }"],"type":"codeListing"},{"syntax":"swift","code":["        \/\/ The theme exposes both generated elevation semantic tokens and \"crafted\" higher level elevation semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone.","","        @Environment(\\.theme) var theme","        @Environment(\\.colorScheme) var colorScheme","","        \/\/ Given you want to apply the elevation token \"raised\"","        var body: some View {","            \/\/ Apply the token of elevation for the shadow effect without managing yourself the color scheme","            Rectangle()","                .shadow(elevation: theme.elevations.raised))","        }"],"type":"codeListing"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Or get the token depending to the color scheme and do whatever you want with","    theme.elevations.raised.elevation(for: colorScheme)"]},{"type":"paragraph","inlineContent":[{"text":"The case of this ","type":"text"},{"type":"codeVoice","code":"MultipleElevationCompositeRawToken"},{"text":" is quite particular because in fact it contains ","type":"text"},{"type":"codeVoice","code":"MultipleElevationCompositeRawToken"},{"text":" (i.e. raw tokens) instead of semantic tokens.","type":"text"},{"text":" ","type":"text"},{"text":"In fact only the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"color"}]},{"text":" of the elevation effect vary depending to the color scheme,","type":"text"},{"text":" ","type":"text"},{"text":"but in the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"text":" kit this is composite raw tokens which are defined for ligh and dark mode as only one token.","type":"text"}]},{"style":"note","name":"Since","type":"aside","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.8.0"}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}],"modules":[{"name":"Tokens for semantics"}],"symbolKind":"class","roleHeading":"Class","role":"symbol","navigatorTitle":[{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"title":"MultipleElevationCompositeRawToken","externalID":"c:@M@MISOTokensSemantic@objc(cs)MultipleElevationCompositeRawToken"},"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic"]]},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\