{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misotokenssemantic\/multipleelevationcompositerawtoken"]}],"abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"sections":[],"metadata":{"modules":[{"name":"Tokens for semantics"}],"symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"navigatorTitle":[{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"roleHeading":"Class","role":"symbol","title":"MultipleElevationCompositeRawToken","externalID":"c:@M@MISOTokensSemantic@objc(cs)MultipleElevationCompositeRawToken"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/MISOTokensSemantic\/objc(cs)NSObject"],"type":"inheritsFrom","title":"Inherits From"},{"kind":"relationships","identifiers":["doc:\/\/MISOTokensSemantic\/objc(pl)NSObject","doc:\/\/MISOTokensSemantic\/s7CVarArgP","doc:\/\/MISOTokensSemantic\/s28CustomDebugStringConvertibleP","doc:\/\/MISOTokensSemantic\/s23CustomStringConvertibleP","doc:\/\/MISOTokensSemantic\/SQ","doc:\/\/MISOTokensSemantic\/SH","doc:\/\/MISOTokensSemantic\/s8SendableP","doc:\/\/MISOTokensSemantic\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic"]]},"topicSections":[{"identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/init(_:)","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/init(light:dark:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/dark","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/light"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/elevation(for:)","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken\/isEqual(_:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"codeListing","code":["        \/\/ Assuming in Figma with have a elevation semantic token none,","        \/\/ with values depending to color scheme. These values are defined as elevation raw tokens.","        let bottom_0 = ElevationCompositeRawToken(x: x0, y: y0, blur: blur0, color: ColorRawTokens.opacityBlack0)","        let bottom_1_100 = ElevationCompositeRawToken(x: x0, y: y100, blur: blur200, color: ColorRawTokens.opacityBlack100)","","        \/\/ Then the develoment team declares an \"higher\" level elevation semantic token","        \/\/ inside ElevationCompositeSemanticTokens protocol,","        \/\/ and defined inside BlueCoatTheme+ElevationCompositeSemanticTokens extension","        \/\/ ElevationCompositeSemanticToken is a typealias for MultipleElevationCompositeRawToken to keep same grammar as design kit","        var none: ElevationCompositeSemanticToken {","            ElevationCompositeSemanticToken(light: bottom_0, dark: bottom_1_100)","        }","","        \/\/ If the same elevation is used whatever the color scheme is","        var none: ElevationCompositeSemanticToken {","            ElevationCompositeSemanticToken(bottom_0)","        }"],"syntax":"swift"},{"type":"codeListing","code":["        \/\/ The theme exposes both generated elevation semantic tokens and \"crafted\" higher level elevation semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone.","","        @Environment(\\.theme) var theme","        @Environment(\\.colorScheme) var colorScheme","","        \/\/ Given you want to apply the elevation token \"raised\"","        var body: some View {","            \/\/ Apply the token of elevation for the shadow effect without managing yourself the color scheme","            Rectangle()","                .shadow(elevation: theme.elevations.raised))","        }"],"syntax":"swift"},{"type":"codeListing","code":["    \/\/ Or get the token depending to the color scheme and do whatever you want with","    theme.elevations.raised.elevation(for: colorScheme)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The case of this "},{"code":"MultipleElevationCompositeRawToken","type":"codeVoice"},{"type":"text","text":" is quite particular because in fact it contains "},{"code":"MultipleElevationCompositeRawToken","type":"codeVoice"},{"type":"text","text":" (i.e. raw tokens) instead of semantic tokens."},{"type":"text","text":" "},{"type":"text","text":"In fact only the "},{"inlineContent":[{"type":"text","text":"color"}],"type":"emphasis"},{"type":"text","text":" of the elevation effect vary depending to the color scheme,"},{"type":"text","text":" "},{"type":"text","text":"but in the "},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"type":"text","text":" kit this is composite raw tokens which are defined for ligh and dark mode as only one token."}],"type":"paragraph"},{"name":"Since","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.8.0"}],"type":"paragraph"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken"},"references":{"doc://MISOTokensSemantic/s23CustomStringConvertibleP":{"identifier":"doc:\/\/MISOTokensSemantic\/s23CustomStringConvertibleP","type":"unresolvable","title":"Swift.CustomStringConvertible"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleElevationCompositeRawToken":{"title":"MultipleElevationCompositeRawToken","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}],"navigatorTitle":[{"kind":"identifier","text":"MultipleElevationCompositeRawToken"}],"url":"\/documentation\/misotokenssemantic\/multipleelevationcompositerawtoken","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"inlineC