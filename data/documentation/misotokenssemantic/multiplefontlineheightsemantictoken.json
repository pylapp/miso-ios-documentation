pleSemanticTokens extension","        var lineHeightLabelXLarge: MultipleFontLineHeightSemanticToken {","            MultipleFontLineHeightSemanticToken(compact: lineHeightLabelXLargeMobile, regular: lineHeightLabelXLargeTablet)","        }","","        \/\/ If the same value is used whatever the size class is","        var lineHeightLabelXLarge: MultipleFontLineHeightSemanticToken { MultipleFontLineHeightSemanticToken(lineHeightLabelXLargeMobile) }","","        \/\/ The theme exposes both generated font line height semantic tokens and \"crafted\" higher level color semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone."],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.8.0"}]}]}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLineHeightSemanticToken\/_(_:_:)"],"anchor":"Operators","title":"Operators"},{"generated":true,"identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLineHeightSemanticToken\/init(_:)","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLineHeightSemanticToken\/init(compact:regular:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLineHeightSemanticToken\/compact","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLineHeightSemanticToken\/regular"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLineHeightSemanticToken\/isEqual(_:)","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLineHeightSemanticToken\/lineHeight(for:)"],"anchor":"Instance-Methods","title":