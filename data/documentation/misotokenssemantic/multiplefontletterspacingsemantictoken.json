/ It is recommended to use the higher level version as it is less error-prone."],"syntax":"swift"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 0.8.0","type":"text"}]}],"name":"Since"}]}],"abstract":[{"text":"Kind of semantic tokens which will wrap a combination of ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLetterSpacingSemanticToken","type":"reference"},{"text":" depending to size classes.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from ","type":"text"},{"inlineContent":[{"type":"text","text":"Figma"}],"type":"emphasis"},{"text":" inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If a font letter spacing token exists with its value depending to the size class (i.e. comapct or regular mode), it must be packed in such ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLetterSpacingSemanticToken","type":"reference"}],"sections":[],"identifier":{"url":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleFontLetterSpacingSemanticToken","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/MISOTokensSemantic\/objc(cs)NSObject"],"type":"inheritsFrom","title":"Inherits From"},{"kind":"relationships","identifiers":["doc:\/\/MISOTokensSemantic\/objc(pl)NSObject","doc:\/\/MISOTokensSemantic\/s7CVarArgP","doc:\/\/MISOTokensSemantic\/s28CustomDebugStringConvertibleP","doc:\/\/MISOTokensSemantic\/s23CustomStringConvertibleP","doc:\/\/MISOTokensSemantic\/SQ","doc:\/\/MISOTokensSemantic\/SH","doc:\/\/MISOTokensSemantic\/s8SendableP","doc:\/\/MISOTokensSemantic\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleFontLetterSpacingSe