{"abstract":[{"type":"text","text":"Kind of semantic tokens which will wrap a combination of "},{"type":"reference","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ColorSemanticToken","isActive":true},{"text":" depending to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"color scheme"}]},{"text":" (i.e. ligh mode or dark mode).","type":"text"},{"text":" ","type":"text"},{"text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system.","type":"text"},{"text":" ","type":"text"},{"text":"Allows to gather the multiple-value tokens from ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"text":" inside one object.","type":"text"},{"text":" ","type":"text"},{"text":"If a color token exists with its value depending to the color scheme, it must be packed in such ``MultipleColorSemanticToken`","type":"text"}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken\/init(_:)","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken\/init(light:dark:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken\/dark","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken\/light"],"generated":true,"title":"Instance Properties"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken\/color(for:)","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken\/hasForbiddenColorValue()","doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleColorSemanticToken\/isEqual(_:)"],"generated":true,"title":"Instance Methods"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/MISOTokensSemantic\/objc(cs)NSObject"],"type":"inheritsFrom","title":"Inherits From"},{"kind":"relationships","identifiers":["doc:\/\/MISOTokensSemantic\/objc(pl)NSObject","doc:\/\/MISOTokensSemantic\/s7CVarArgP","doc:\/\/MISOTokensSemantic\/s28CustomDebugStringConvertibleP","doc:\/\/MISOTokensSemantic\/s23CustomStringConvertibleP","doc:\/\/MISOTokensSemantic\/SQ","doc:\/\/MISOTokensSemantic\/SH","doc:\/\/MISOTokensSemantic\/s8SendableP","doc:\/\/MISOTokensSemantic\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"metadata":{"externalID":"c:@M@MISOTokensSemantic@objc(cs)MultipleColorSemanticToken","title":"MultipleColorSemanticToken","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleColorSemanticToken","kind":"identifier"}],"roleHeading":"Class","modules":[{"name":"Tokens for semantics"}],"navigatorTitle":[{"text":"MultipleColorSemanticToken","kind":"identifier"}],"symbolKind":"class"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleColorSemanticToken","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"syntax":"swift","code":["        \/\/ Assuming in Figma with have a color semantic token bgPrimary,","        \/\/ two semantic color tokens will be defined in Figma and generated by tokenator.","        \/\/ They can be declared in protocol ColorSemanticTokens,","        \/\/ and defined automaticaly in MISOTheme+ColorSemanticTokens extension","        var bgPrimaryLight: ColorSemanticToken { ColorRawTokens.functionalWhite }","        var bgPrimaryDark: ColorSemanticToken { ColorRawTokens.functionalDarkGray880 }","","        \/\/ Then the develoment team declares an \"higher\" level color semantic token for bgPrimary","        \/\/ inside ColorMultipleSemanticTokens protocol,","        \/\/ and defined inside MISOTheme+ColorMultipleSemanticToken extension","        var bgPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(light: bgPrimaryLight, dark: bgPrimaryDark) }","","        \/\/ If the same color is used whatever the color scheme is","        var bgPrimary: MultipleColorSemanticToken { MultipleColorSemanticToken(bgPrimaryLight) }","","        \/\/ The theme exposes both generated color semantic tokens and \"crafted\" higher level color semantic tokens.","        \/\/ It is recommended to use the higher level version as it is less error-prone."],"type":"codeListing"},{"syntax":"swift","code":["     @Environment(\\.theme) var theme","     @Environment(\\.colorScheme) var colorScheme","","    \/\/ Given you want to apply the color token \"surfaceBrandPrimary\"","    var body: some View {","        \/\/ Apply the token of color for the view without managing yourself the color scheme","        SomeView()","            .background(theme.colors.surfaceBrandPrimary)","","        \/\/ Or also foregroundStyle(), foregroundColor(), accentColor(), ...","    }"],"type":"codeListing"},{"syntax":"swift","code":["    \/\/ Or get the token depending to the color scheme and do whatever you want with","    theme.colors.surfaceBrandPrimary.color(for: colorScheme)"],"type":"codeListing"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.8.0"}],"type":"paragraph"}],"style":"note","name":"Since"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/misotokenssemantic\/multiplecolorsemantictoken"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSe