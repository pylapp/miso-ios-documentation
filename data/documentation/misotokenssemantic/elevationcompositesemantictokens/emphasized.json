text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It defines all elevation semantic tokens a theme must have ("},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationXSemanticToken","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationYSemanticToken","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationBlurSemanticToken","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationColorSemanticToken","isActive":true,"type":"reference"},{"type":"text","text":")."},{"type":"text","text":" "},{"text":"However the composite tokens (here for box shadows) are defined in ","type":"text"},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticTokens","isActive":true,"type":"reference"},{"text":" because the ","type":"text"},{"inlineContent":[{"type":"text","text":"tokenator"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"is not able to generate them yet, and they must be defined elsewhere to not be deleted.","type":"text"},{"text":" ","type":"text"},{"text":"Any elevation semantic token must be declared there (except ","type":"text"},{"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticTokens","isActive":true,"type":"reference"},{"text":")","type":"text"}],"title":"ElevationSemanticTokens","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationSemanticTokens","url":"\/documentation\/misotokenssemantic\/elevationsemantictokens","navigatorTitle":[{"text":"ElevationSemanticTokens","kind":"identifier"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ElevationSemanticTokens"}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ElevationCompositeSemanticToken":{"type":"topic","abstract":[{"text":"Basically an elevationcomposite  semantic token, used mainly for box shadow, is a pair of elevation composite raw tokens used depending to the color scheme.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken"},{"type":"text","text":" contains "},{"type":"codeVoice","code":"ElevationCompositeRawToken"},{"type":"text","text":" objects for light and dark modes, which contains "},{"type":"codeVoice","code":"ElevationRawToken"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ColorRawToken"},{"type":"text","text":" values."}],"title":"ElevationCompositeSemanticToken","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticToken","url":"\/documentation\/misotokenssemantic\/elevationcompositesemantictoken","navigatorTitle":[{"text":"ElevationCompositeSemanticToken","kind":"identifier"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"ElevationCompositeSemanticToken","kind":"identifier"}]},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/MultipleElevationCompositeRawToken":{"navigatorTitle":[{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"url":"\/documentation\/misotokenssemantic\/multipleelevationcompositerawtoken","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/MultipleElevationCompositeRawToken","kind":"symbol","title":"MultipleElevationCompositeRawToken","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MultipleElevationCompositeRawToken","kind":"identifier"}],"abstract":[{"type":"text","text":"Semantic tokens which will wrap a combination of "},{"code":"ElevationCompositeRawToken","type":"codeVoice"},{"type":"text","text":" depending to color scheme (i.e. light mode or dark mode)"},{"type":"text","text":" "},{"type":"text","text":"Kind of composite token with multiple values, but not named “composite” because this word is already used in the design system."},{"type":"text","text":" "},{"type":"text","text":"Allows to gather the multiple-value tokens from "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Figma"}]},{"type":"text","text":" inside one object."},{"type":"text","text":" "},{"type":"text","text":"If an elevation token exists with its value depending to the color scheme, it must be packed in such ``MultipleElevationCompositeRawToken`"}],"role":"symbol"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic":{"type":"topic","abstract":[{"type":"text","text":"These "},{"inlineContent":[{"type":"text","text":"tokens"}],"type":"emphasis"},{"type":"text","text":" can be used mainly for "},{"inlineContent":[{"text":"component tokens","type":"text"}],"type":"emphasis"},{"type":"text","text":" to apply some style and configuration values ; today "},{"type":"emphasis","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"components"}]},{"type":"text","text":" are not defined yet."},{"type":"text","text":" "},{"type":"text","text":"They can be seen as an high level of usage with functional meanings."}],"title":"Tokens for semantics","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic","url":"\/documentation\/misotokenssemantic","role":"collection","kind":"symbol","images":[{"type":"icon","identifier":"ic_design_tokens_semantics_intro.png"}]},"ic_design_tokens_semantics_intro.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOTokensSemantic\/ic_design_tokens_semantics_intro.png"}],"identifier":"ic_design_tokens_semantics_intro.png","type":"image","alt":null},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ElevationCompositeSemanticTokens/emphasized":{"role":"symbol","abstract":[],"kind":"symbol","required":true,"type":"topic","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticTokens\/emphasized","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"emphasized","kind":"identifier"},{"text":": ","kind":"text"},{"text":"ElevationCompositeSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18MISOTokensSemantic018ElevationCompositeB5Tokena"}],"url":"\/documentation\/misotokenssemantic\/elevationcompositesemantictokens\/emphasized","title":"emphasized"},"doc://MISOTokensSemantic/documentation/MISOTokensSemantic/ElevationCompositeSemanticTokens":{"type":"topic","abstract":[{"type":"text","text":"This is a group of semantic tokens for "},{"type":"strong","inlineContent":[{"text":"elevations","type":"text"}]},{"type":"text","text":", but only "},{"type":"strong","inlineContent":[{"text":"composite tokens","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"There are splitted and not declared in "},{"isActive":true,"identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationSemanticTokens","type":"reference"},{"type":"text","text":" as the "},{"type":"emphasis","inlineContent":[{"text":"tokenator","type":"text"}]},{"type":"text","text":" tool parsing "},{"type":"emphasis","inlineContent":[{"text":"Figma","type":"text"}]},{"type":"text","text":" JSON to Swift code is not able to manage them."},{"type":"text","text":" "},{"type":"text","text":"Thus we need to declare them in another file to prevent them to be erased."},{"type":"text","text":" "},{"type":"text","text":"It declares in fact box shadows effects."}],"title":"ElevationCompositeSemanticTokens","identifier":"doc:\/\/MISOTokensSemantic\/documentation\/MISOTokensSemantic\/ElevationCompositeSemanticTokens","url":"\/documentation\/misotokenssemantic\/elevationcompositesemantictokens","navigatorTitle":[{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}],"role":"symbol","kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ElevationCompositeSemanticTokens","kind":"identifier"}]}}}