"),  sizes (from "},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and borders (from "},{"code":"AllBorderSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")."}],"type":"topic"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTagComponentTokensProvider/spacePaddingBlockDefault":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTagComponentTokensProvider\/spacePaddingBlockDefault","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spacePaddingBlockDefault","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:18MISOTokensSemantic05SpaceB5Tokena","text":"SpaceSemanticToken","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Has for value token spaces.paddingBlock2xsmall (= 6)"}],"type":"topic","role":"symbol","title":"spacePaddingBlockDefault","kind":"symbol","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetagcomponenttokensprovider\/spacepaddingblockdefault"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTagComponentTokensProvider/sizeMinWidthDefault":{"abstract":[{"text":"Has for value token dimensions._xsmall (= 32)","type":"text"}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeMinWidthDefault","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SizeSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena","kind":"typeIdentifier"}],"kind":"symbol","title":"sizeMinWidthDefault","type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTagComponentTokensProvider\/sizeMinWidthDefault","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetagcomponenttokensprovider\/sizeminwidthdefault"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMIS