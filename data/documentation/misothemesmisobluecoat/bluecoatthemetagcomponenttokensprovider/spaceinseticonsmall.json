type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetagcomponenttokensprovider","navigatorTitle":[{"text":"BlueCoatThemeTagComponentTokensProvider","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeTagComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeTagComponentTokensProvider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTagComponentTokensProvider/spaceInsetIconSmall":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTagComponentTokensProvider\/spaceInsetIconSmall","title":"spaceInsetIconSmall","abstract":[{"type":"text","text":"Has for value token spaces.insetNone (= 0)"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetagcomponenttokensprovider\/spaceinseticonsmall","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"spaceInsetIconSmall"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SpaceSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic05SpaceB5Tokena"}],"type":"topic"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme."}],"url":"\/documentation\/misothemesmisobluecoat","title":"Theme BlueCoat","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}]},"ic_theme_bluecoat.png":{"alt":null,"variants":[{"url":"\/images