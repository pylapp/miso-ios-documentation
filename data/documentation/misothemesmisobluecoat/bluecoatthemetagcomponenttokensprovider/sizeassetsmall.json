s (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":"),  sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetagcomponenttokensprovider","navigatorTitle":[{"text":"BlueCoatThemeTagComponentTokensProvider","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeTagComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeTagComponentTokensProvider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme."}],"url":"\/documentation\/misothemesmisobluecoat","title":"Theme BlueCoat","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTagComponentTokensProvider/sizeAssetSmall":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTagComponentTokensProvider\/sizeAssetSmall","title":"sizeAssetSmall","abstract":[{"type":"text","text":"Has for value token sizes.iconWithLabelSmallSizeSmall (= 12)"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetagcomponenttokensprovider\/sizeassetsmall","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sizeAssetSmall"},{"kind":"text","text":": "},{"kind":"typeIdentifier","