 the protocol "},{"type":"codeVoice","code":"TagComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"text":"tags","type":"text"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Tags","type":"text"}]},{"type":"text","text":" components tokens are defined with semantic tokens of dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") ,"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":"),  sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":")."}],"kind":"symbol","navigatorTitle":[{"text":"BlueCoatThemeTagComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeTagComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetagcomponenttokensprovider","type":"topic","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTagComponentTokensProvider/spacePaddingBlockDefault":{"abstract":[{"text":"Has for value token spaces.paddingBlock2xsmall (= 6)","type":"text"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTagComponentTokensProvider\/spacePaddingBlockDefault","title":"spacePaddingBlockDefault","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spacePaddingBlockDefault","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SpaceSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18MISOTokensSemantic05SpaceB5Tokena"}],"role":"symbol","