ionSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeBadgeComponentTokensProvider","kind":"identifier"}],"navigatorTitle":[{"text":"BlueCoatThemeBadgeComponentTokensProvider","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeBadgeComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemebadgecomponenttokensprovider","title":"BlueCoatThemeBadgeComponentTokensProvider"}}}