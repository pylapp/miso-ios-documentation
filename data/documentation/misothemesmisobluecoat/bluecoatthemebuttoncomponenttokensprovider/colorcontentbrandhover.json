onent tokens for "},{"inlineContent":[{"text":"buttons","type":"text"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Button"}],"type":"emphasis"},{"text":" components tokens are defined with raw and semantic tokens of sizes (from ","type":"text"},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"text":"), borders","type":"text"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"title":"BlueCoatThemeButtonComponentTokensProvider","navigatorTitle":[{"text":"BlueCoatThemeButtonComponentTokensProvider","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeButtonComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemebuttoncomponenttokensprovider","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeButtonComponentTokensProvider","kind":"symbol","type":"topic","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeButtonComponentTokensProvider/colorContentBrandHover":{"abstract":[{"type":"text","text":"Has for value token colors.contentOnActionHover (= light: “#FFFFFFFF” \/ dark: “#08090DFF”)"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeButtonComponentTokensProvider\/colorContentBrandHover","title":"colorContentBrandHover","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorContentBrandHover","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MultipleColorSemanticToken","kind":"typeIdentifier","preciseIdentifier":"c:@M@MISOTokensSemantic@objc(cs)MultipleColorSemanticToken"}],"role":"symbol","kind":"s