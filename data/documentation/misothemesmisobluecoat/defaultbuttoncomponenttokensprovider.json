text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Button"}],"type":"emphasis"},{"text":" components tokens are defined with raw and semantic tokens of sizes (from ","type":"text"},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"text":"), borders","type":"text"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"title":"BlueCoatThemeButtonComponentTokensProvider","navigatorTitle":[{"text":"BlueCoatThemeButtonComponentTokensProvider","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeButtonComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemebuttoncomponenttokensprovider","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeButtonComponentTokensProvider","kind":"symbol","type":"topic","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/DefaultButtonComponentTokensProvider":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/DefaultButtonComponentTokensProvider","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"DefaultButtonComponentTokensProvider"}],"abstract":[{"type":"codeVoice","code":"BlueCoat"},{"type":"text","text":" can be considered as default theme for MISO"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DefaultButtonComponentTokensProvider"}],"title":"DefaultButtonComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/defaultbuttoncomponenttokensprovider","type":"topic","role":"symbol"}}}