aces (from ","type":"text"},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"text":"), opacities (from ","type":"text"},{"type":"codeVoice","code":"AllOpacitySemanticTokensProvider"},{"text":")","type":"text"},{"text":" ","type":"text"},{"text":"and dimensions (from ","type":"text"},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"text":").","type":"text"}],"title":"BlueCoatThemeListItemComponentTokensProvider","navigatorTitle":[{"text":"BlueCoatThemeListItemComponentTokensProvider","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeListItemComponentTokensProvider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"type":"topic","title":"Theme BlueCoat","url":"\/documentation\/misothemesmisobluecoat","abstract":[{"type":"text","text":"This BlueCoat theme is a blue theme, quite smooth and simple."}],"images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","kind":"symbol","role":"collection"},"ic_theme_bluecoat.png":{"type":"image","identifier":"ic_theme_bluecoat.png","variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"alt":null},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeListItemComponentTokensProvider/sizeAssetLarge":{"abstract":[{"text":"Has for value token dimensions._medium (= 40)","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeAssetLarge","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SizeSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeListItemComponentTokensProvider\/sizeAssetLarge","url":"\/documentation\/misothemesmisobluecoat\/bluecoat