xt":"), colors (from "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":"), opacities (from "},{"type":"codeVoice","code":"AllOpacitySemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelistitemcomponenttokensprovider","kind":"symbol","type":"topic","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeListItemComponentTokensProvider/sizeMinWidth":{"title":"sizeMinWidth","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeMinWidth","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SizeSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelistitemcomponenttokensprovider\/sizeminwidth","abstract":[{"text":"Has for value token DimensionRawTokens._2000 (= 160)","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeListItemComponentTokensProvider\/sizeMinWidth","kind":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"title":"Theme BlueCoat","role":"collection","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}],"url":"\/documentation\/misothemesmisobluecoat","abstract":[{"text":"This BlueCoat theme is a blue theme, quite smooth and simple, provided by MISO and not OUDS.","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","kind":"symbol"},"ic_theme_bluecoat.png":{"type":"image","i