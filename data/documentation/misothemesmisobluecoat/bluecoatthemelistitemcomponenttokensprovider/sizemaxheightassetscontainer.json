","url":"\/documentation\/misothemesmisobluecoat","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","title":"Theme BlueCoat","type":"topic","abstract":[{"text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme.","type":"text"}],"role":"collection","images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeListItemComponentTokensProvider/sizeMaxHeightAssetsContainer":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeMaxHeightAssetsContainer","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SizeSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena","kind":"typeIdentifier"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeListItemComponentTokensProvider\/sizeMaxHeightAssetsContainer","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelistitemcomponenttokensprovider\/sizemaxheightassetscontainer","kind":"symbol","title":"sizeMaxHeightAssetsContainer","abstract":[{"type":"text","text":"Has for value token DimensionRawTokens._1200 (= 96)"}],"type":"topic","role":"symbol"},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","alt":null,"type":"image","variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeListItemComponentTokensProvider":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeListItemComponentTokensProvider"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelistitemcomponenttokensprovider","kind":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeListItemComponentTokensProvider","title":"BlueCoatThemeListItemComponentTokensProvider","type":"topic","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" for list item components like "},{"type":"codeVoice","code":"MISOListItem"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllListItemComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"ListItemComponentTokens"},{"type":"text","text":" so as to expose the component tokens for list item components through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Such component tokens are defined with raw and semantic tokens of sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":"), colors (from "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":"), opacities (from "},{"type":"codeVoice","code":"AllOpacitySemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")."}],"navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeListItemComponentTokensProvider"}],"role":"symbol"}}}