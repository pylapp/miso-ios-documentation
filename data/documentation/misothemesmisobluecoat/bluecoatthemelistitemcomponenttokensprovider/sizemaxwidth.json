"url":"\/documentation\/misothemesmisobluecoat","abstract":[{"text":"This BlueCoat theme is a blue theme, quite smooth and simple, provided by MISO and not OUDS.","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","kind":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeListItemComponentTokensProvider/sizeMaxWidth":{"title":"sizeMaxWidth","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sizeMaxWidth"},{"kind":"text","text":": "},{"preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena","kind":"typeIdentifier","text":"SizeSemanticToken"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeListItemComponentTokensProvider\/sizeMaxWidth","abstract":[{"text":"Has for value token DimensionRawTokens._4000 (= 480)","type":"text"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelistitemcomponenttokensprovider\/sizemaxwidth","kind":"symbol","type":"topic","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeListItemComponentTokensProvider":{"title":"BlueCoatThemeListItemComponentTokensProvider","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeListItemComponentTokensProvider","kind":"identifier"}],"navigatorTitle":[{"text":"BlueCoatThemeListItemComponentTokensProvider","kind":"identifier"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeListItemComponentTokensProvider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"component tokens"}]},{"type":"text","text":" for list item components like "},{"type":"codeVoice","code":"MISOListItem"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllListItemComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"ListItemComponentTokens"},{"type":"text","text":" so as to expose the component tokens for list item components through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Such component tokens are defined with raw and semantic tokens of sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":"), colors (from "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":"), opacities (from "},{"type":"codeVoice","code":"AllOpacitySemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelistitemcomponenttokensprovider","kind":"symbol","type":"topic","role":"symbol"},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","alt":null,"variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"type":"image"}}}