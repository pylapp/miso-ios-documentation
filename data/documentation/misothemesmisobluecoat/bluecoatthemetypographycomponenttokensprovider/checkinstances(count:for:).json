:"text","text":"A class which wraps all "},{"inlineContent":[{"text":"component  tokens of typography","type":"text"}],"type":"strong"},{"type":"text","text":" for "},{"inlineContent":[{"text":"typography","type":"text"}],"type":"emphasis"},{"type":"text","text":" components like "},{"type":"codeVoice","code":"MISOText"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllTypographyComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"TypographyComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"inlineContent":[{"text":"typography","type":"text"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"text":"Typography","type":"text"}],"type":"emphasis"},{"type":"text","text":" components tokens are defined with semantic tokens of spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"kind":"symbol","navigatorTitle":[{"text":"BlueCoatThemeTypographyComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeTypographyComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetypographycomponenttokensprovider","type":"topic","