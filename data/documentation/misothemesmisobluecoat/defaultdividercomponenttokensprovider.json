text":" through any ","type":"text"},{"type":"codeVoice","code":"MISOTheme"},{"text":".","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Divider","type":"text"}]},{"text":" components tokens are defined with raw and semantic tokens of borders (from ","type":"text"},{"code":"AllBorderSemanticTokensProvider","type":"codeVoice"},{"text":").","type":"text"}],"type":"topic","title":"BlueCoatThemeDividerComponentTokensProvider","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeDividerComponentTokensProvider","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"BlueCoatThemeDividerComponentTokensProvider","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeDividerComponentTokensProvider","kind":"identifier"}]},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","alt":null,"type":"image","variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/DefaultDividerComponentTokensProvider":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/DefaultDividerComponentTokensProvider","abstract":[{"type":"codeVoice","code":"BlueCoat"},{"text":" can be considered as default theme for MISO","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"DefaultDividerComponentTokensProvider","kind":"identifier"}],"title":"DefaultDividerComponentTokensProvider","type":"topic","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DefaultDividerComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/defaultdividercomponenttokensprovider"}}}