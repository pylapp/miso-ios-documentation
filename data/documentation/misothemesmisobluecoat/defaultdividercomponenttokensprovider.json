atThemeDividerComponentTokensProvider":{"title":"BlueCoatThemeDividerComponentTokensProvider","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeDividerComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemedividercomponenttokensprovider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"component  tokens of divider"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"divider"}]},{"type":"text","text":" objects like "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOVerticalDivider"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllDividerComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"DividerComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"divider"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Divider"}]},{"type":"text","text":" components tokens are defined with raw and semantic tokens of borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":")."}],"navigatorTitle":[{"text":"BlueCoatThemeDividerComponentTokensProvider","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeDividerComponentTokensProvider","kind":"symbol"},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"type":"image","alt":null},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/DefaultDividerComponentTokensProvider":{"title":"DefaultDividerComponentTokensProvider","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DefaultDividerComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/defaultdividercomponenttokensprovider","abstract":[{"type":"codeVoice","code":"BlueCoat"},{"type":"text","text":" can be considered as default theme for MISO"}],"navigatorTitle":[{"text":"DefaultDividerComponentTokensProvider","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/DefaultDividerComponentTokensProvider","kind":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"title":"Theme BlueCoat","role":"collection","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}],"url":"\/documentation\/misothemesmisobluecoat","abstract":[{"text":"This BlueCoat theme is a blue theme, quite smooth and simple, provided by MISO and not OUDS.","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","kind":"symbol"}}}