:"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"text":"input text","type":"text"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Inout text","type":"text"}]},{"type":"text","text":" components tokens are defined with raw and semantic tokens of sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":"), colors ("},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"kind":"symbol","navigatorTitle":[{"text":"BlueCoatThemeTextInputComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeTextInputComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetextinputcomponenttokensprovider","type":"topic","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/DefaultTextInputComponentTokensProvider":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/DefaultTextInputComponentTokensProvider","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"DefaultTextInputComponentTokensProvider"}],"abstract":[{"type":"codeVoice","code":"BlueCoat"},{"type":"text","text":" can be considered as default theme for MISO"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DefaultTextInputComponentTokensProvider"}],"title":"DefaultTextInputComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/defaulttextinputcomponenttokensprovider","type":"topic","role":"symbol"},"ic_theme_bluecoat.png":{"type":"image","identifier":"ic_theme_bluecoat.png","alt":null,"variants":[{"url":"\/images\/MISOThemesMISOB