{"kind":"symbol","abstract":[{"type":"codeVoice","code":"BlueCoat"},{"text":" can be considered as default theme for MISO","type":"text"}],"variants":[{"paths":["\/documentation\/misothemesmisobluecoat\/defaulttextinputcomponenttokensprovider"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DefaultTextInputComponentTokensProvider","kind":"identifier"}],"externalID":"s:22MISOThemesMISOBlueCoat39DefaultTextInputComponentTokensProvidera","modules":[{"name":"Theme BlueCoat"}],"symbolKind":"typealias","roleHeading":"Type Alias","role":"symbol","navigatorTitle":[{"text":"DefaultTextInputComponentTokensProvider","kind":"identifier"}],"title":"DefaultTextInputComponentTokensProvider"},"identifier":{"url":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/DefaultTextInputComponentTokensProvider","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"DefaultTextInputComponentTokensProvider"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTextInputComponentTokensProvider","preciseIdentifier":"s:22MISOThemesMISOBlueCoat04BlueC37ThemeTextInputComponentTokensProviderC","text":"BlueCoatThemeTextInputComponentTokensProvider"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"1.0.0"}],"type":"paragraph"}],"style":"note","name":"Since"}]}],"hierarchy":{"paths":[["doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat"]]},"references":{"ic_theme_bluecoat.png":{"alt":null,"variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"identifier":"ic_theme_bluecoat.png","type":"image"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTextInputComponentTokensProvider":{"role":"symbol","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"component  tokens of input text"}]},{"type":"text","text":" for "},{"inlineContent":[{"type":"text","text":"input text"}],"type":"emphasis"},{"type":"text","text":" objects like "},{"type":"codeVoice","code":"MISOTextInput"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllTextInputComponentTokensProvider"},{"text":" implementation inside ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":" so as to provide"},{"text":" ","type":"text"},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"text":" implementation to use.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"code":"InouttextComponentTokens","type":"codeVoice"},{"type":"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"input text"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Inout text","type":"text"}]},{"text":" components tokens are defined with raw and semantic tokens of sizes (from ","type":"text"},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"text":"), colors (","type":"text"},{"code":"AllColorSemanticTokensProvider","type":"codeVoice"},{"text":")","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and spaces (from "},{"code":"AllSpaceSemanticTokensProvider","type":"codeVoice"},{"text":").","type":"text"}],"kind":"symbol","title":"BlueCoatThemeTextInputComponentTokensProvider","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTextInputComponentTokensProvider","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"BlueCoatThemeTextInputComponentTokensProvider","kind":"identifier"}],"navigatorTitle":[{"text":"BlueCoatThemeTextInputComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetextinputcomponenttokensprovider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","title":"Theme BlueCoat","url":"\/documentation\/misothemesmisobluecoat","kind":"symbol","abstract":[{"type":"text","text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme."}],"type":"topic","role":"collection","images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/DefaultTextInputComponentTokensProvider":{"kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DefaultTextInputComponentTokensProvider","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"BlueCoat"},{"text":" can be considered as default theme for MISO","type":"text"}],"type":"topic","title":"DefaultTextInputComponentTokensProvider","navigatorTitle":[{"text":"DefaultTextInputComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/defaulttextinputcomponenttokensprovider","role":"symb