image","variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"identifier":"ic_theme_bluecoat.png","alt":null},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/DefaultSelectInputComponentTokensProvider":{"abstract":[{"type":"codeVoice","code":"BlueCoat"},{"type":"text","text":" can be considered as default theme for MISO"}],"url":"\/documentation\/misothemesmisobluecoat\/defaultselectinputcomponenttokensprovider","title":"DefaultSelectInputComponentTokensProvider","navigatorTitle":[{"kind":"identifier","text":"DefaultSelectInputComponentTokensProvider"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"DefaultSelectInputComponentTokensProvider"}],"role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/DefaultSelectInputComponentTokensProvider","type":"topic"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"title":"Theme BlueCoat","role":"collection","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}],"url":"\/documentation\/misothemesmisobluecoat","abstract":[{"text":"This BlueCoat theme is a blue theme, quite smooth and simple, provided by MISO and not OUDS.","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","kind":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeSelectInputComponentTokensProvider":{"title":"BlueCoatThemeSelectInputComponentTokensProvider","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeSelectInputComponentTokensProvider","kind":"identifier"}],"navigatorTitle":[{"text":"BlueCoatThemeSelectInputComponentTokensProvider","kind":"identifier"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeSelectInputComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemeselectinputcomponenttokensprovider","abstract":[{"type":"text","text":"A class which wraps all "},{"inlineContent":[{"text":"component  tokens of select input","type":"text"}],"type":"strong"},{"type":"text","text":" for objects like "},{"type":"codeVoice","code":"MISOSelectInput"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllSelectInputComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"SelectInputComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"select"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Select input"}]},{"type":"text","text":" components tokens are defined with semantic tokens of dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")."}],"kind":"symbol","type":"topic","role":"symbol"}}}