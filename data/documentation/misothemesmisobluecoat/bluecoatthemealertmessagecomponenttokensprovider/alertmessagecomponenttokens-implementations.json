ed with semantic tokens of borders ("},{"type":"codeVoice","code":"AllBorderSemanticTokensProviders"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"title":"BlueCoatThemeAlertMessageComponentTokensProvider","navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeAlertMessageComponentTokensProvider"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeAlertMessageComponentTokensProvider","kind":"symbol","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemealertmessagecomponenttokensprovider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"type":"topic","title":"Theme BlueCoat","url":"\/documentation\/misothemesmisobluecoat","abstract":[{"type":"text","text":"This BlueCoat theme is a blue theme, quite smooth and simple."}],"images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","kind":"symbol","role":"collection"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeAlertMessageComponentTokensProvider/spaceRowGapBullet":{"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemealertmessagecomponenttokensprovider\/spacerowgapbullet","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeAlertMessageComponentTokensProvider\/spaceRowGapBullet","title":"spaceRowGapBullet","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spaceRowGapBullet","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SpaceSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18MISOTokensSemantic05SpaceB5Tokena"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Has for value token spaces.rowGapNone (= 0)"}]},"ic_theme_bluecoat.png":{"type