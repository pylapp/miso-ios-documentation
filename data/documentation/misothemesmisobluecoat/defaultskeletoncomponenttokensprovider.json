odeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"SkeletonComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"inlineContent":[{"type":"text","text":"skeleton"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Skeleton"}],"type":"emphasis"},{"type":"text","text":" components tokens are defined with semantic tokens of colors (from "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":")."}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeSkeletonComponentTokensProvider","title":"BlueCoatThemeSkeletonComponentTokensProvider","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeSkeletonComponentTokensProvider","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemeskeletoncomponenttokensprovider","navigatorTitle":[{"text":"BlueCoatThemeSkeletonComponentTokensProvider","kind":"identifier"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","abstract":[{"text":"This BlueCoat theme is a blue theme, quite smooth and simple.","type":"text"}],"kind":"symbol","title":"Theme BlueCoat","type":"topic","url":"\/documentation\/misothemesmisobluecoat","images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}],"role":"collection"}}}