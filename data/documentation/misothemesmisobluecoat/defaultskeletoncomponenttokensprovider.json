xt":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"SkeletonComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"inlineContent":[{"type":"text","text":"skeleton"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Skeleton"}],"type":"emphasis"},{"type":"text","text":" components tokens are defined with semantic tokens of colors (from "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":")."}],"navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeSkeletonComponentTokensProvider"}],"role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"kind":"symbol","url":"\/documentation\/misothemesmisobluecoat","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","title":"Theme BlueCoat","type":"topic","abstract":[{"text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme.","type":"text"}],"role":"collection","images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}]},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","alt":null,"variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"type":"image"}}}