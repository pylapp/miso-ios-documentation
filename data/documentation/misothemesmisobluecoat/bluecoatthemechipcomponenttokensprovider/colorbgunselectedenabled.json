nticTokensProvider","type":"codeVoice"},{"type":"text","text":"), dimensions ("},{"code":"AllDimensionSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"border  (from "},{"code":"AllBorderSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":") and sizes  (from "},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeChipComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeChipComponentTokensProvider"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeChipComponentTokensProvider","title":"BlueCoatThemeChipComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemechipcomponenttokensprovider"},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png"}],"type":"image"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeChipComponentTokensProvider/colorBgUnselectedEnabled":{"title":"colorBgUnselectedEnabled","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorBgUnselectedEnabled","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MultipleColorSemanticToken","preciseIdentifier":"c:@M@MISOTokensSemantic@objc(cs)MultipleColorSemanticToken","kind":"typeIdentifier"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeChipComponentTokensProvider\/colorBgUnselectedEnabled","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemechipcomponenttokensprovider\/colorbgunselectedenabled","abstract":[{"type":"text","text":"Has for value token colors.opacityTranspare