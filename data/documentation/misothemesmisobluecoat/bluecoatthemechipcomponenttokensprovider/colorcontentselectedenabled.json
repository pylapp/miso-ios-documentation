Provider","type":"codeVoice"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeChipComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeChipComponentTokensProvider"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeChipComponentTokensProvider","title":"BlueCoatThemeChipComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemechipcomponenttokensprovider"}}}