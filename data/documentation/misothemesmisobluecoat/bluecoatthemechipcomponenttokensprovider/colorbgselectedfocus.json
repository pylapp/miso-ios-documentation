manticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemechipcomponenttokensprovider","navigatorTitle":[{"text":"BlueCoatThemeChipComponentTokensProvider","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeChipComponentTokensProvider","kind":"identifier"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeChipComponentTokensProvider"}}}