neContent":[{"type":"text","text":"chip"}]},{"type":"text","text":" through any "},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Chip","type":"text"}]},{"type":"text","text":" components tokens are defined with semantic tokens of colors (from "},{"code":"AllColorSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":") ,"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"code":"AllSpaceSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":"), dimensions ("},{"code":"AllDimensionSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"border  (from "},{"code":"AllBorderSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":") and sizes  (from "},{"code":"AllSizeSemanticTokensProvider","type":"codeVoice"},{"type":"text","text":")."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeChipComponentTokensProvider"}],"navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeChipComponentTokensProvider"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeChipComponentTokensProvider","title":"BlueCoatThemeChipComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemechipcomponenttokensprovider"},"ic_theme_bluecoat.png":{"type":"image","identifier":"ic_theme_bluecoat.png","variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png"}],"alt":null}}}