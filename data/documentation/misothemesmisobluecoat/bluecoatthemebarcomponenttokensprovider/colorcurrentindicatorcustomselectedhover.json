ined with semantic tokens of colors ("},{"type":"codeVoice","code":"AllColorSemanticTokensProviders"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":"), borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and effects (from "},{"type":"codeVoice","code":"AllEffectSemanticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemebarcomponenttokensprovider","navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeBarComponentTokensProvider"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeBarComponentTokensProvider"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeBarComponentTokensProvider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeBarComponentTokensProvider/colorCurrentIndicatorCustomSelectedHover":{"role":"symbol","title":"colorCurrentIndicatorCustomSelectedHover","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeBarComponentTokensProvider\/colorCurrentIndicatorCustomSelectedHover","type":"topic","abstract":[{"type":"text","text":"Has for value token colors.actionHover (= light: “#223CABFF” \/ dark: “#C1D8FCFF”)"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemebarcomponenttokensprovider\/colorcurrentindicatorcustomselectedhover","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"colorCurrentIndicatorCustomSelectedHover"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@M@MISOTokensSemantic@objc(cs)MultipleColorSemanticToken","kind":"typeIdentifier","text"