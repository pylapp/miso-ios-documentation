tation\/MISOThemesMISOBlueCoat\/BlueCoatThemeCategoricalTagComponentTokensProvider\/colorBgCategory4"},"references":{"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeCategoricalTagComponentTokensProvider/colorBgCategory4":{"title":"colorBgCategory4","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorBgCategory4","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@MISOTokensSemantic@objc(cs)MultipleColorSemanticToken","text":"MultipleColorSemanticToken","kind":"typeIdentifier"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemecategoricaltagcomponenttokensprovider\/colorbgcategory4","abstract":[{"text":"Has for value token MultipleColorSemanticToken(light: BlueCoatBrandColorRawTokens.colorGoldTips500, dark: BlueCoatBrandColorRawTokens.colorGoldTips400) (= light: “#E7BB2CFF” \/ dark: “#ECCA5AFF”)","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeCategoricalTagComponentTokensProvider\/colorBgCategory4","kind":"symbol"},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","alt":null,"variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"type":"image"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeCategoricalTagComponentTokensProvider":{"title":"BlueCoatThemeCategoricalTagComponentTokensProvider","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeCategoricalTagComponentTokensProvider","kind":"identifier"}],"navigatorTitle":[{"text":"BlueCoatThemeCategoricalTagComponentTokensProvider","kind":"identifier"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeCategoricalTagComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemecategoricaltagcomponenttokensprovider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"component  tokens of categorical tag"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tag"}]},{"type":"text","text":" objects like "},{"type":"codeVoice","code":"MISOCategoricalTag"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllCategoricalTagComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"CategoricalTagComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"categorical tags"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Categorical tags"}]},{"type":"text","text":" components tokens are defined with semantic tokens of colors ("},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":")"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"title":"Theme BlueCoat","role":"collection","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}],"url":"\/documentation\/misothemesmisobluecoat","abstract":[{"text":"This BlueCoat theme is a blue theme, quite smooth and simple, provided by MISO and not OUDS.","type":"text"}],"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","kind":"symbol"}}}