":"text","text":"and spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"title":"BlueCoatThemeTextInputComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetextinputcomponenttokensprovider","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeTextInputComponentTokensProvider"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeTextInputComponentTokensProvider"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTextInputComponentTokensProvider/spaceColumnGapDefault":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTextInputComponentTokensProvider\/spaceColumnGapDefault","title":"spaceColumnGapDefault","abstract":[{"type":"text","text":"Has for value token spaces.columnGapMedium (= 12)"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetextinputcomponenttokensprovider\/spacecolumngapdefault","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"spaceColumnGapDefault"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SpaceSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic05SpaceB5Tokena"}],"type":"topic"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme."}],"url":"\/documentation\/misothemesmisobluecoat","title":"Theme BlueCoat","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}]},"ic_theme_bluecoat.png":{"type":"image","alt":null,"variants":[{"