rovider"},{"type":"text","text":"), colors ("},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"kind":"symbol","navigatorTitle":[{"text":"BlueCoatThemeTextInputComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeTextInputComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetextinputcomponenttokensprovider","type":"topic","role":"symbol"},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","alt":null,"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTextInputComponentTokensProvider/spaceColumnGapInlineText":{"type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTextInputComponentTokensProvider\/spaceColumnGapInlineText","title":"spaceColumnGapInlineText","abstract":[{"type":"text","text":"Has for value token spaces.columnGapXsmall (= 6)"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetextinputcomponenttokensprovider\/spacecolumngapinlinetext","role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"spaceColumnGapInlineText","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SpaceSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic05SpaceB5Tokena","kind":"typeIdentifier"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","abstract":[{"text":"This BlueCoat theme is a blue theme, quite smooth and simple.","type":"text"}],"kind":"symbol","title":"Theme BlueCoat","type":"topic","url":"\/documentation\/misothemesmisobluecoat",