oat/BlueCoatThemeTextInputComponentTokensProvider":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeTextInputComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeTextInputComponentTokensProvider","role":"symbol","abstract":[{"type":"text","text":"A class which wraps all "},{"inlineContent":[{"type":"text","text":"component  tokens of input text"}],"type":"strong"},{"type":"text","text":" for "},{"inlineContent":[{"type":"text","text":"input text"}],"type":"emphasis"},{"type":"text","text":" objects like "},{"type":"codeVoice","code":"MISOTextInput"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllTextInputComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"InouttextComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"inlineContent":[{"type":"text","text":"input text"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Inout text"}],"type":"emphasis"},{"type":"text","text":" components tokens are defined with raw and semantic tokens of sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":"), colors ("},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeTextInputComponentTokensProvider","kind":"symbol","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemetextinputcomponenttokensprovider","navigatorTitle":[{"text":"BlueCoatThemeTextInputComponentTokensProvider","kind":"identifier"}],"type":"topic"},"ic_theme_bluecoat.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png"}],"alt":null,"identifier":"ic_theme_bluecoat.png"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"kind":"symbol","url":"\/documentation\/misothemesmisobluecoat","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","title":"Theme BlueCoat","type":"topic","abstract":[{"text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme.","type":"text"}],"role":"collection","images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeTextInputComponentTokensProvider/sizeCountrySelectorFlagHeight":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeCountrySelectorFlagHeight","kind":"identifier"},{"text":": ","kind":"text"},{"text":"SizeSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena","kind":"typeIdentifier"}],"title":"sizeCountrySelectorFlagHeight","role":"symbol","abstract":[{"type":"text","text":"Has for value token sizes.iconWithLabelLargeSizeXsmall (= 20)"}],"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/Blu