,"code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")."}],"role":"symbol","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelinkcomponenttokensprovider"}}}