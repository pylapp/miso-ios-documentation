 components tokens are defined with raw and semantic tokens of sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"colors (from "},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"type":"text","text":"), spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"and dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":")."}],"title":"BlueCoatThemeLinkComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelinkcomponenttokensprovider","type":"topic","role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}],"kind":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","abstract":[{"type":"text","text":"This BlueCoat theme is a blue theme, quite smooth and simple."}],"type":"topic","title":"Theme BlueCoat","url":"\/documentation\/misothemesmisobluecoat","role":"collection"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeLinkComponentTokensProvider/colorChevronHover":{"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemelinkcomponenttokensprovider\/colorchevronhover","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"colorChevronHover","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MultipleColorSemanticToken","kind":"typeIdentifier","preciseIdentifier":"c:@M@MISOTokensSemantic@objc(cs)MultipleColorSemanticToken"}],"kind":"symbol","title":"colorChevronHover","type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeLinkComponentTokensProvider\/colorChevronHover","abstract":[{"text":"Has for value token c