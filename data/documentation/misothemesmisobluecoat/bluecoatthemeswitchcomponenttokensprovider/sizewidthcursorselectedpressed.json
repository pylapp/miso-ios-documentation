,"},{"type":"text","text":" "},{"type":"text","text":"borders ("},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":") , opacities ("},{"type":"codeVoice","code":"AllOpacitySemanticTokensProvider"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"and  sizes ("},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"text":").","type":"text"}],"title":"BlueCoatThemeSwitchComponentTokensProvider","navigatorTitle":[{"text":"BlueCoatThemeSwitchComponentTokensProvider","kind":"identifier"}],"role":"symbol"}}}