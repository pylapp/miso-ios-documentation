nts also the protocol ","type":"text"},{"type":"codeVoice","code":"SwitchComponentTokens"},{"text":" so as to expose the component tokens for ","type":"text"},{"inlineContent":[{"type":"text","text":"switch \/ toggle"}],"type":"emphasis"},{"text":" through any ","type":"text"},{"type":"codeVoice","code":"MISOTheme"},{"text":".","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Switch"}],"type":"emphasis"},{"text":" components tokens are defined with semantic tokens of colors (from ","type":"text"},{"type":"codeVoice","code":"AllColorSemanticTokensProvider"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"spaces (from ","type":"text"},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"text":") , dimensions (","type":"text"},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"borders (","type":"text"},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"text":") , opacities (","type":"text"},{"type":"codeVoice","code":"AllOpacitySemanticTokensProvider"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"and  sizes (","type":"text"},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"text":").","type":"text"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemeswitchcomponenttokensprovider","navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeSwitchComponentTokensProvider"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeSwitchComponentTokensProvider"}],"title":"BlueCoatThemeSwitchComponentTokensProvider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeSwitchComponentTokensProvider/borderRadiusTrack":{"title":"borderRadiusTrack","abstract":[{"type":"text","text":"Has for value token borders.radiusDefault (= 6)"}],"url":"\/documentation\/