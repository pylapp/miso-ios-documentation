type":"text","text":") , dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"borders ("},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":") , opacities ("},{"type":"codeVoice","code":"AllOpacitySemanticTokensProvider"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"and  sizes ("},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")."}],"role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeSwitchComponentTokensProvider","kind":"symbol"}}}