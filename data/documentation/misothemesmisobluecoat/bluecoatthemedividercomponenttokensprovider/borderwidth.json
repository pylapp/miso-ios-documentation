xt","text":"Divider"}]},{"type":"text","text":" components tokens are defined with raw and semantic tokens of borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":")."}],"navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeDividerComponentTokensProvider"}],"role":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeDividerComponentTokensProvider/borderWidth":{"type":"topic","title":"borderWidth","role":"symbol","abstract":[{"type":"text","text":"Has for value token borders.widthThin"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"borderWidth"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:18MISOTokensSemantic011BorderWidthB5Tokena","text":"BorderWidthSemanticToken"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemedividercomponenttokensprovider\/borderwidth","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeDividerComponentTokensProvider\/borderWidth","kind":"symbol"},"ic_theme_bluecoat.png":{"identifier":"ic_theme_bluecoat.png","variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png"}],"alt":null,"type":"image"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"kind":"symbol","url":"\/documentation\/misothemesmisobluecoat","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","title":"Theme BlueCoat","type":"topic","abstract":[{"text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme.","type":"text"}],"role":"collection","images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}]}}}