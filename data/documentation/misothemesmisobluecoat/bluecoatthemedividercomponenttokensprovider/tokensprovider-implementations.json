ntifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":")"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeDividerComponentTokensProvider":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeDividerComponentTokensProvider","title":"BlueCoatThemeDividerComponentTokensProvider","abstract":[{"type":"text","text":"A class which wraps all "},{"type":"strong","inlineContent":[{"type":"text","text":"component  tokens of divider"}]},{"type":"text","text":" for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"divider"}]},{"type":"text","text":" objects like "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" and "},{"type":"codeVoice","code":"MISOVerticalDivider"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllDividerComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"DividerComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"type":"emphasis","inlineContent":[{"type":"text","text":"divider"}]},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Divider"}]},{"type":"text","text":" components tokens are defined with raw and semantic tokens of borders (from "},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemedividercomponenttokensprovider","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeDividerComponentTokensProvider"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeDividerComponentTokensProvider"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme."}],"url":"\/documentation\/misothemesmisobluecoat","title":"Theme BlueCoat","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}]},"ic_theme_bluecoat.png":{"type":"image","variants":[{"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png","traits":["1x","light"]}],"alt":null,"identifier":"ic_theme_bluecoat.png"}}}