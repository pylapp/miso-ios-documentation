om "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":") and sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")."}],"type":"topic","role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeAlertComponentTokensProvider","navigatorTitle":[{"text":"BlueCoatThemeAlertComponentTokensProvider","kind":"identifier"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemealertcomponenttokensprovider","title":"BlueCoatThemeAlertComponentTokensProvider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeAlertComponentTokensProvider/spacePaddingBlockBottomContent":{"title":"spacePaddingBlockBottomContent","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeAlertComponentTokensProvider\/spacePaddingBlockBottomContent","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemealertcomponenttokensprovider\/spacepaddingblockbottomcontent","type":"topic","abstract":[{"type":"text","text":"Has for value token spaces.paddingBlock3xsmall (= 4)"}],"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"spacePaddingBlockBottomContent"},{"text":": ","kind":"text"},{"text":"SpaceSemanticToken","kind":"typeIdentifier","preciseIdentifier":"s:18MISOTokensSemantic05SpaceB5Tokena"}],"role":"symbol","kind":"symbol"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","title":"Theme BlueCoat","url":"\/documentation\/misothemesmisobluecoat","kind":"symbol","abstract":[{"type":"text","text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme."}],"type":"topic","role":"collection","images":[{"type":"icon","identifier":"ic_theme_bluecoat.png"}]}}}