":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Alert","type":"text"}]},{"type":"text","text":" components tokens are defined with semantic tokens of borders ("},{"type":"codeVoice","code":"AllBorderSemanticTokensProviders"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":") and sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")."}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemealertcomponenttokensprovider","navigatorTitle":[{"kind":"identifier","text":"BlueCoatThemeAlertComponentTokensProvider"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"BlueCoatThemeAlertComponentTokensProvider"}],"title":"BlueCoatThemeAlertComponentTokensProvider"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemeAlertComponentTokensProvider/sizeMinHeight":{"role":"symbol","title":"sizeMinHeight","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeAlertComponentTokensProvider\/sizeMinHeight","type":"topic","url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemealertcomponenttokensprovider\/sizeminheight","abstract":[{"text":"Has for value token sizes.minInteractiveAreaDefault (= 48)","type":"text"}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sizeMinHeight","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena","text":"SizeSemanticToken","kind":"typeIdentifier"}]}}}