t"},{"type":"emphasis","inlineContent":[{"text":"Toast","type":"text"}]},{"type":"text","text":" components tokens are defined with semantic tokens of borders ("},{"type":"codeVoice","code":"AllBorderSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"dimensions ("},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":") and sizes (from "},{"type":"codeVoice","code":"AllSizeSemanticTokensProvider"},{"type":"text","text":")."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemeToastComponentTokensProvider","navigatorTitle":[{"text":"BlueCoatThemeToastComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemeToastComponentTokensProvider","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemeToastComponentTokensProvider","kind":"identifier"}],"role":"symbol"},"ic_theme_bluecoat.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png"}],"alt":null,"identifier":"ic_theme_bluecoat.png","type":"image"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/DefaultToastComponentTokensProvider":{"abstract":[{"type":"codeVoice","code":"BlueCoat"},{"type":"text","text":" can be considered as default theme for MISO"}],"role":"symbol","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/DefaultToastComponentTokensProvider","navigatorTitle":[{"text":"DefaultToastComponentTokensProvider","kind":"identifier"}],"kind":"symbol","type":"topic","title":"DefaultToastComponentTokensProvider","url":"\/documentation\/misothemesmisobluecoat\/defaulttoastcomponenttokensprovider","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DefaultToastComponentTokensProvider","kind":"identifier"}]}}}