misobluecoat\/bluecoatthemepincodeinputcomponenttokensprovider","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BlueCoatThemePinCodeInputComponentTokensProvider","kind":"identifier"}],"title":"BlueCoatThemePinCodeInputComponentTokensProvider","identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemePinCodeInputComponentTokensProvider","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A class which wraps all "},{"inlineContent":[{"type":"text","text":"component  tokens of pin code input"}],"type":"strong"},{"type":"text","text":" like "},{"type":"codeVoice","code":"MISOPinCodeInput"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Contains also references to semantic tokens providers so as to be able to use them to define the component tokens."},{"type":"text","text":" "},{"type":"text","text":"This provider should be integrated as a "},{"type":"codeVoice","code":"AllPinCodeInputComponentTokensProvider"},{"type":"text","text":" implementation inside "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" so as to provide"},{"type":"text","text":" "},{"type":"text","text":"all tokens to the users. It helps users to override some of the tokens and assign them to an "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" implementation to use."},{"type":"text","text":" "},{"type":"text","text":"It implements also the protocol "},{"type":"codeVoice","code":"PinCodeInputComponentTokens"},{"type":"text","text":" so as to expose the component tokens for "},{"inlineContent":[{"type":"text","text":"pin code input"}],"type":"emphasis"},{"type":"text","text":" through any "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Pint code input"}],"type":"emphasis"},{"type":"text","text":" components tokens are defined with semantic tokens of dimensions (from "},{"type":"codeVoice","code":"AllDimensionSemanticTokensProvider"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"ans spaces (from "},{"type":"codeVoice","code":"AllSpaceSemanticTokensProvider"},{"type":"text","text":")."}],"navigatorTitle":[{"text":"BlueCoatThemePinCodeInputComponentTokensProvider","kind":"identifier"}]},"ic_theme_bluecoat.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOThemesMISOBlueCoat\/ic_theme_bluecoat.png"}],"type":"image","alt":null,"identifier":"ic_theme_bluecoat.png"},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat","role":"collection","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"This BlueCoat theme is a theme for some specific usages, like for prototyping and design of journeys without any brand-charted theme."}],"url":"\/documentation\/misothemesmisobluecoat","title":"Theme BlueCoat","images":[{"identifier":"ic_theme_bluecoat.png","type":"icon"}]},"doc://MISOThemesMISOBlueCoat/documentation/MISOThemesMISOBlueCoat/BlueCoatThemePinCodeInputComponentTokensProvider/sizeMaxWidth":{"identifier":"doc:\/\/MISOThemesMISOBlueCoat\/documentation\/MISOThemesMISOBlueCoat\/BlueCoatThemePinCodeInputComponentTokensProvider\/sizeMaxWidth","abstract":[{"type":"text","text":"Has for value token dimensions._3xlarge (= 56)"}],"url":"\/documentation\/misothemesmisobluecoat\/bluecoatthemepincodeinputcomponenttokensprovider\/sizemaxwidth","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"sizeMaxWidth"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"SizeSemanticToken","preciseIdentifier":"s:18MISOTokensSemantic04SizeB5Tokena"}],"title":"sizeMaxWidth"}}}