umentation\/MISOFoundations\/MISOWCAG21Ratio","navigatorTitle":[{"text":"MISOWCAG21Ratio","kind":"identifier"}],"type":"topic","kind":"symbol","url":"\/documentation\/misofoundations\/misowcag21ratio","abstract":[{"text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr","type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"also named “RGAA”."},{"text":" ","type":"text"},{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"text":" ","type":"text"},{"text":"However it is higly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for textual","type":"text"},{"text":" ","type":"text"},{"text":"and 4.5:1 for non-textual elements.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not."},{"type":"text","text":" "},{"text":"See for example ","type":"text"},{"identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","isActive":true,"type":"reference"}],"role":"symbol"},"doc://MISOFoundations/documentation/MISOFoundations/PSFNMK":{"abstract":[{"type":"text","text":"PostScriptFontNamesMapKey in shorter"}],"type":"topic","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PSFNMK","kind":"identifier"}],"title":"PSFNMK","navigatorTitle":[{"text":"PSFNMK","kind":"identifier"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/PSFNMK","role":"symbol","url":"\/documentation\/misofoundations\/psfnmk"},"doc://MISOFoundations/documentation/MISOFoundations/PostScriptFontNamesMapKey":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostScriptFontNamesMapKey","kind":"identifier"}],"abstract":[{"type":"text","text":"Key of the map containing PostScript name to use for a font depending to its family name and weight."}],"title":"PostScriptFontNamesMapKey","role":"symbol","kind":"symbol","url":"\/documentation\/misofoundations\/postscriptfontnamesmapkey","navigatorTitle":[{"text":"PostScriptFontNamesMapKey","kind":"identifier"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/PostScriptFontNamesMapKey"},"https://accessibilite.numerique.gouv.fr":{"type":"link","identifier":"https:\/\/accessibilite.numerique.gouv.fr","title":"Référentiel Général d’Amélioration de l’Accessibilité","titleInlineContent":[{"type":"text","text":"Référentiel Général d’Amélioration de l’Accessibilité"}],"url":"https:\/\/accessibilite.numerique.gouv.fr"},"doc://MISOFoundations/documentation/MISOFoundations/SwiftUICore":{"url":"\/documentation\/misofoundations\/swiftuicore","role":"collection","identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/SwiftUICore","title":"SwiftUICore","type":"topic","kind":"symbol","abstract":[]},"https://system.design.orange.com/0c1af118d/p/2531b9-accessibility-compliance":{"type":"link","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance","title":"the following guidelines","titleInlineContent":[{"type":"text","text":"the following guidelines"}],"url":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"},"doc://MISOFoundations/documentation/MISOFoundations/PostScriptFontNamesMap":{"url":"\/documentation\/misofoundations\/postscriptfontnamesmap","role":"symbol","navigatorTitle":[{"text":"PostScriptFontNamesMap","kind":"identifier"}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundati