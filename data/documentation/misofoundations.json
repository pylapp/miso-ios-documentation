","type":"text"},{"text":" ","type":"text"},{"text":"and 4.5:1 for non-textual elements.","type":"text"},{"text":" ","type":"text"},{"text":"This utility helps to define whether a set of contrast ratio matches AA and AAA or not.","type":"text"},{"text":" ","type":"text"},{"text":"See for example ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/system.design.orange.com\/0c1af118d\/p\/2531b9-accessibility-compliance"}],"type":"topic","title":"MISOWCAG21Ratio","kind":"symbol","navigatorTitle":[{"text":"MISOWCAG21Ratio","kind":"identifier"}],"url":"\/documentation\/misofoundations\/misowcag21ratio","role":"symbol"},"doc://MISOFoundations/documentation/MISOFoundations/iPhoneDevice":{"title":"iPhoneDevice","navigatorTitle":[{"text":"iPhoneDevice","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/misofoundations\/iphonedevice","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"iPhoneDevice"}],"type":"topic","abstract":[{"text":"List some iPhone devices which can use MISO, i.e. supposed to support at least iOS 15.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Helps to define some metrics like tab bar heights."}],"identifier":"doc:\/\/MISOFoundations\/documentation\/MISOFoundations\/iPhoneDevice"}}}