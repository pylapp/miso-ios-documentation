{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISORadioPicker","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Tag","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tag","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Accessibility considerations","level":2,"type":"heading","anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Voice Over"}],"type":"emphasis"},{"type":"text","text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and helper texts and a custom radio trait."},{"type":"text","text":" "},{"type":"text","text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used."},{"type":"text","text":" "},{"type":"text","text":"However if defined in the "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPickerData","type":"reference","isActive":true},{"type":"text","text":" the items inside the picker will have such accessibility identifiers."}]},{"text":"Forbidden by design","level":2,"type":"heading","anchor":"Forbidden-by-design"},{"type":"paragraph","inlineContent":[{"text":"The design system does not allow to have ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem","type":"reference"},{"text":" in both an error situation and a read only state.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The design system does not allow to have "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem"},{"type":"text","text":" in both an error situation and a disabled state."},{"type":"text","text":" "},{"type":"text","text":"The design system does not allow to have "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem"},{"type":"text","text":" in both a read only and a disabled state."}]},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"code":["    \/\/ Define the elements to display in radio buttons using MISORadioPickerData.","    \/\/ This object has the same properties as the MISORadioItem,","    \/\/ and some of them are optional withdefault values set","    var someDataToPopulate: [MISORadioPickerData<String>] {","        [","            MISORadioPickerData<String>(tag: \"Choice_1\",","                                        label: \"Virgin Holy Lava\",","                                        extraLabel: \"Very spicy\",","                                        description: \"No alcohol, only tasty flavors\",","                                        image: MISOImage(asset: Image(systemName: \"flame\")),","","            MISORadioPickerData<String>(tag: \"Choice_2\",","                                        label: \"IPA beer\",","                                        description: \"From Brewdog company\",","                                        image: MISOImage(asset: Image(systemName: \"dog.fill\")),","","            MISORadioPickerData<String>(tag: \"Choice_3\",","                                        label: \"Mineral water\",","                                        image: MISOImage(asset: Image(systemName: \"waterbottle.fill\")),","        ]","    }","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: String = \"Choice_1\"","","    \/\/ Here the picker is vertical","    MISORadioPicker(selection: $selection, radios: someDataToPopulate)","","    \/\/ The picker can apply some settings to all its radio buttons.","    \/\/ It can be also horitzontal with a scroll indicator.","    \/\/ Here all the the radio buttons are in read only mode and use reversed layout.","    MISORadioPicker(selection: $selection,","                    radios: someDataToPopulate,","                    isReversed: true,","                    isReadOnly: true,","                    placement: .horitzontal(true))"],"type":"codeListing","syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 0.14.0","type":"text"}]}],"name":"Since","style":"note"}]}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPicker\/init(selection:radios:placement:isOutlined:isReversed:isError:isReadOnly:hasDivider:itemsSpacing:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPicker\/body"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPicker\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPicker\/View-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"abstract":[{"type":"text","text":"A picker allowing to expose several radio buttons and choose only one within the others."},{"type":"text","text":" "},{"type":"text","text":"Each radio button contains a “tag”, i.e. a supposed to be unique value."},{"type":"text","text":" "},{"type":"text","text":"The picker will expose the choosen value through this “tag”."},{"type":"text","text":" "},{"type":"text","text":"It has also some configur