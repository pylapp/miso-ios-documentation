{"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misoradiopicker"]}],"sections":[],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPicker","interfaceLanguage":"swift"},"abstract":[{"text":"A picker allowing to expose several radio buttons and choose only one within the others.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Each radio button contains a “tag”, i.e. a supposed to be unique value."},{"text":" ","type":"text"},{"type":"text","text":"The picker will expose the choosen value through this “tag”."},{"type":"text","text":" "},{"text":"It has also some configuration elements which will override the one applied to nested ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem","type":"reference"},{"type":"text","text":" (divider, read only and error mode, layout and outlined)"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISORadioPicker"},{"kind":"text","text":"<"},{"text":"Tag","kind":"genericParameter"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Tag"},{"text":" : ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Voice Over"}],"type":"emphasis"},{"text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and helper texts and a custom radio trait.","type":"text"},{"text":" ","type":"text"},{"text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used.","type":"text"},{"text":" ","type":"text"},{"text":"However if defined in the ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPickerData","isActive":true,"type":"reference"},{"text":" the items inside the picker will have such accessibility identifiers.","type":"text"}]},{"type":"heading","level":2,"text":"Forbidden by design","anchor":"Forbidden-by-design"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The design system does not allow to have "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem"},{"type":"text","text":" in both an error situation and a read only state."},{"type":"text","text":" "},{"type":"text","text":"The design system does not allow to have "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem","type":"reference","isActive":true},{"type":"text","text":" in both an error situation and a disabled state."},{"type":"text","text":" "},{"type":"text","text":"The design system does not allow to have "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem","type":"reference","isActive":true},{"type":"text","text":" in both a read only and a disabled state."}]},{"anchor":"Code-samples","level":2,"text":"Code samples","type":"heading"},{"code":["    \/\/ Define the elements to display in radio buttons using MISORadioPickerData.","    \/\/ This object has the same properties as the MISORadioItem,","    \/\/ and some of them are optional withdefault values set","    var someDataToPopulate: [MISORadioPickerData<String>] {","        [","            MISORadioPickerData<String>(tag: \"Choice_1\",","                                        label: \"Virgin Holy Lava\",","                                        extraLabel: \"Very spicy\",","                                        description: \"No alcohol, only tasty flavors\",","                                        image: MISOImage(asset: Image(systemName: \"flame\")),","","            MISORadioPickerData<String>(tag: \"Choice_2\",","                                        label: \"IPA beer\",","                                        description: \"From Brewdog company\",","                                        image: MISOImage(asset: Image(systemName: \"dog.fill\")),","","            MISORadioPickerData<String>(tag: \"Choice_3\",","                                        label: \"Mineral water\",","                                        image: MISOImage(asset: Image(systemName: \"waterbottle.fill\")),","        ]","    }","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: String = \"Choice_1\"","","    \/\/ Here the picker is vertical","    MISORadioPicker(selection: $selection, radios: someDataToPopulate)","","    \/\/ The picker can apply some settings to all its radio buttons.","    \/\/ It can be also horitzontal with a scroll indicator.","    \/\/ Here all the the radio buttons are in read only mode and use reversed layout.","    MISORadioPicker(selection: $selection,","                    radios: someDataToPopulate,","                    isReversed: true,","                    isReadOnly: true,","                    placement: .horitzontal(true))"],"syntax":"swift","type":"codeListing"},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.14.0"}]}],"style":"note","typ