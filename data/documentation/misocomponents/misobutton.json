{"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"metadata":{"externalID":"s:14MISOComponents10MISOButtonV","platforms":[{"beta":false,"unavailable":false,"introducedAt":"15.0","deprecated":false,"name":"iOS"},{"beta":false,"unavailable":false,"introducedAt":"13.0","deprecated":false,"name":"macOS"},{"beta":false,"unavailable":false,"introducedAt":"16.0","deprecated":false,"name":"tvOS"},{"beta":false,"unavailable":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS"},{"beta":false,"unavailable":false,"introducedAt":"11.0","deprecated":false,"name":"watchOS"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"title":"MISOButton","symbolKind":"struct","navigatorTitle":[{"text":"MISOButton","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"Components"}]},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/init(_:tableName:bundle:appearance:style:size:isFullWidth:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/init(_:tableName:bundle:image:appearance:style:size:isFullWidth:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/init(image:appearance:style:size:isFullWidth:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/init(text:appearance:style:size:isFullWidth:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/init(text:image:appearance:style:size:isFullWidth:action:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/body"],"anchor":"Instance-Properties"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/Appearance","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/Size","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/Style"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/View-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOButton"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts","doc:\/\/MISOComponents\/documentation\/MISOComponents\/Actions"]},{"kind":"content","content":[{"text":"Appearances","level":2,"anchor":"Appearances","type":"heading"},{"inlineContent":[{"type":"text","text":"Five appearances are proposed for all layouts:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default (by default)"}]},{"type":"text","text":": Default buttons are used for actions which are not mandatory or essential for the user."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"strong"}]},{"text":": Should be singular and prominent, limited to one per view.","type":"text"},{"text":" ","type":"text"},{"text":"It should be reserved for the most critical action, such as “Next,” “Save,” “Submit,” etc. It is a “call for action”.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"brand"}]},{"type":"text","text":": A brand primary color alternative to the "},{"type":"emphasis","inlineContent":[{"text":"strong","type":"text"}]},{"type":"text","text":" button."},{"type":"text","text":" "},{"type":"text","text":"To be used sparingly for high-value specific actions or to visually anchor a brand moment. Do not use it as the default primary button in your interfaces."},{"type":"text","text":" "},{"type":"text","text":"A button with "},{"type":"codeVoice","code":"MISOButton.Appearance.Brand"},{"type":"text","text":" appearance is not allowed as a direct or indirect child of an "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"minimal","type":"text"}],"type":"strong"},{"text":": Minimal buttons are commonly used for actions that are considered less crucial. They can be used independently or together with a strong button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"negative","type":"text"}]},{"type":"text","text":": Negative buttons should be used sparingly to warn of a destructive action,"},{"type":"text","text":" "},{"type":"text","text":"for example, delete or remove, typically resulting in the opening of a confirmation dialog."},{"type":"text","text":" "},{"type":"text","text":"A button with "},{"type":"codeVoice","code":"MISOButton.Appearance.Negative"},{"type":"text","text":" appearance is not allowed as a direct or indirect child of an "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":"."}]}]}]},{"type":"heading","anchor":"Code-samples","level":2,"text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Icon only with default appearance","    MISOButton(image: MISOImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","    \/\/ Or simpler","    MISOButton(image: MISOImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\") { \/* the action to process *\/ }","    \/\/ With an image to keep raw without tint","    MISOButton(image: MISOImage(asset: Image(\"il_someImage\")), accessibilityLabel: \"Like\", renderingMode: .original) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    MISOButton(text: \"Delete\", appearance: .negative,  style: .default) { \/* the action to process *\/ }","    \/\/ Or simpler","    MISOButton(text: \"Delete\", appearance: .negative) { \/* the action to process *\/ }","","    \/\/ A small loading button with indeterminate progress","    MISOButton(text: \"Delete\", style: .loading(), size: .small) { \/* the action to process *\/ }","","    \/\/ A small loading button with a progress (i.e. percent of progress)","    MISOButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) { \/* the action to process *\/ }","","    \/\/ Text and icon with strong appearance","    MISOButton(text: \"Validate\", image: MISOImage(asset: Image(\"ic_heart\")), appearance: .strong) { \/* the action to process *\/ }","","    \/\/ Text and icon with strong appearance and button taking full width","    MISOButton(text: \"Validate\", image: MISOImage(asset: Image(\"ic_heart\")), appearance: .strong, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ Localizable from bundle can also be used","    MISOButton(LocalizedStringKey(\"validate_button\"), bundle: Bundle.module, appearance: .strong) { }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to flip your icon depending to the layout direction or not (e.g. if RTL mode lose semantics  \/ meanings):"}]},{"type":"codeListing","syntax":"swift","code":["    @Environment(\\.layoutDirection) var layoutDirection","","    MISOButton(text: \"Button\",","               image: MISOImage(asset: Image(systemName: \"figure.handball\"), flipped: layoutDirection == .rightToLeft))"]},{"type":"heading","anchor":"Sizes","level":2,"text":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two sizes of button are proposed for all layouts:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Default"}]},{"text":": This is the default size of the component. This size is used for the vast majority of applications.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"small"}]},{"type":"text","text":": This size can be particularly useful in an information-dense interface or in the construction of"},{"type":"text","text":" "},{"type":"text","text":"a template or component requiring the use of small elements (in an “List item” component, for example)."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Styles","level":2,"text":"Styles"},{"inlineContent":[{"type":"text","text":"Two style are available:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default (by default)"}]},{"type":"text","text":": used in the normal usage of button. The aspect of the button changes for  states "},{"type":"emphasis","inlineContent":[{"text":"disabled","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"text":"pressed","type":"text"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"hovered"}]},{"type":"text","text":" or normal (i.e. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"enabled"}]},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"loading","type":"text"}],"type":"strong"},{"text":": used after button was clicked (and probably data are requested before navigate to a next screen or get updated data, etc.).","type":"text"}]}]}]},{"level":2,"text":"Rounded layout","anchor":"Rounded-layout","type":"heading"},{"inlineContent":[{"type":"text","text":"Buttons can have rounded layouts to be favored in more emotional, immersive contexts or those tied to specific visual identities."},{"type":"text","text":" "},{"type":"text","text":"For standard or business-oriented journeys, keep the default corners."},{"type":"text","text":" "},{"type":"text","text":"This evolution addresses the need for flexibility in adapting the design to some brand contexts."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To activate the rounded button behavior, set to true the "},{"type":"codeVoice","code":"hasRoundedButtons"},{"type":"text","text":" values of the "},{"type":"codeVoice","code":"Tuning"},{"text":" object","type":"text"},{"text":" ","type":"text"},{"text":"in your theme configuration (if the theme exposes this property at init).","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Colored-surface","level":2,"text":"Colored surface"},{"type":"paragraph","inlineContent":[{"text":"If button is placed on colored surface using ","type":"text"},{"code":"MISOColoredSurface","type":"codeVoice"},{"text":", the default colors (content, background and border) are automatically adjusted to switch to monochrome mode.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Remark: Today it is not allowed to place a Negative nor a Brand button on a colored surface.","type":"text"}],"type":"strong"}]},{"type":"heading","anchor":"Specific-behavior","level":2,"text":"Specific behavior"},{"type":"paragraph","inlineContent":[{"text":"For accessibility reasons, if the system settings for reducing motion is enabled, the loading indicator does not move.","type":"text"},{"text":" ","type":"text"},{"text":"For ecodesign reasons, if the device is in low power mode, the loading indicator does not move.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"3.3.0 (Figma component design version)"}],"type":"paragraph"}],"name":"Version","style":"note"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.10.0"}],"type":"paragraph"}],"name":"Since","style":"note"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misobutton"]}],"abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOButton/Size":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton\/Size","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Size","kind":"identifier"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Size","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misobutton\/size","title":"MISOButton.Size","abstract":[{"text":"Defines the size of the button,","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents/MISOButton/init(_:tableName:bundle:appearance:style:size:isFullWidth:action:)":{"abstract":[{"type":"text","text":"Creates a button with a localized text only, looking up the key in the given bundle."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7SwiftUI18LocalizedStringKeyV","text":"LocalizedStringKey","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tableName","kind":"externa