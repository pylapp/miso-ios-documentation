":"codeVoice"},{"type":"text","text":" is always required and always kept in sync, regardless of the OS version."},{"type":"text","text":" "},{"type":"text","text":"For iOS 18 or iOS 26 without Liquid Glass, also pass "},{"code":"count:","type":"codeVoice"},{"type":"text","text":" (the number of tabs) so the selected-tab indicator can be positioned."},{"type":"text","text":" "},{"type":"text","text":"Each "},{"code":"Tab","type":"codeVoice"},{"type":"text","text":" must carry an explicit "},{"code":"value: Int","type":"codeVoice"},{"type":"text","text":" matching the "},{"code":"selectedTab","type":"codeVoice"},{"type":"text","text":" binding."},{"type":"text","text":" "},{"type":"text","text":"For iOS 26+ with Liquid Glass, use "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLiquidGlassTabView","type":"reference","isActive":true},{"type":"text","text":"."}]},{"text":"Appearances","type":"heading","anchor":"Appearances","level":2},{"inlineContent":[{"text":"iOS 26 brings Liquid Glass. The same rules as ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","type":"reference","isActive":true},{"text":" apply:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Background and unselected item colors are applied for iOS lower than 26.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On iOS 26+ with Liquid Glass enabled, only the selected accent color is applied.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The top divider and selected-tab indicator are shown for iOS 18 (portrait iPhone only for"},{"type":"text","text":" "},{"type":"text","text":"the indicator) and hidden under Liquid Glass."}]}]}],"type":"unorderedList"},{"text":"Platform considerations","level":2,"anchor":"Platform-considerations","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent