{"abstract":[{"type":"text","text":"Describes the content of the helper text displayed below the text area."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/HelperText"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HelperText","kind":"identifier"}]}]},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":".textual(_:)","type":"codeVoice"},{"type":"text","text":" for arbitrary helper text (raw, localized or rich), or "},{"type":"codeVoice","code":".charactersMaxCount(_:)"},{"type":"text","text":" to let the"},{"type":"text","text":" "},{"type":"text","text":"component manage a character-count display automatically."},{"type":"text","text":" "},{"type":"text","text":"Pass the "},{"type":"strong","inlineContent":[{"type":"text","text":"maximum allowed length"}]},{"type":"text","text":" — the component computes how many characters remain"},{"type":"text","text":" "},{"type":"text","text":"and displays them in "},{"type":"strong","inlineContent":[{"type":"text","text":"bold"}]},{"type":"text","text":". When the user exceeds the limit the component switches"},{"type":"text","text":" "},{"type":"text","text":"to an error-style sentence showing how many characters are over the limit."}],"type":"paragraph"},{"type":"codeListing","code":["    \/\/ Raw helper text","    MISOTextArea(label: \"Bio\", text: $text, helperText: .textual(\"Maximum 500 characters.\"))","","    \/\/ Localized helper text","    MISOTextArea(label: \"Bio\", text: $text, helperText: .textual(.localiz