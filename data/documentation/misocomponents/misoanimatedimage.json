":"text"}],"type":"strong"},{"type":"text","text":" includes your app\/module target."}]}]},{"content":[{"inlineContent":[{"text":"Load it with ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAnimatedImage\/init(named:withExtension:bundle:)","type":"reference","isActive":true},{"text":", see below.","type":"text"}],"type":"paragraph"}]}]},{"text":"Accessibility and ecodesign","anchor":"Accessibility-and-ecodesign","level":2,"type":"heading"},{"inlineContent":[{"text":"To respect the user’s preferences and save battery, the animation automatically pauses on its first","type":"text"},{"text":" ","type":"text"},{"text":"frame when:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"“Reduce Motion” accessibility setting is enabled, or","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Low Power Mode is enabled."}]}]}],"type":"unorderedList"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Low Power Mode detection relies on ","type":"text"},{"code":"MISOLowPowerModeObserver","type":"codeVoice"},{"text":", injected as an environment","type":"text"},{"text":" ","type":"text"},{"text":"object by ","type":"text"},{"code":"MISOThemeableView","type":"codeVoice"},{"text":". Make sure ","type":"text"},{"code":"MISOAnimatedImage","type":"codeVoice"},{"text":" is used inside a view hierarchy","type":"text"},{"text":" ","type":"text"},{"text":"rooted by ","type":"text"},{"code":"MISOThemeableView","type":"codeVoice"},{"text":" for this behavior to work.","type":"text"}]}],"type":"aside"},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ From a remote URL (downloaded once, then cached)","    MISOAnimatedImage(url: URL(string: \"https:\/\/example.com\/animation.gif\"))","","    \/\/ From a local file bundled with the app (\"loadi