{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices."},{"type":"text","text":" "},{"type":"text","text":"Checkbox that does not show icon or text, provides greater flexibility when creating other components that require a checkbox to be displayed."}],"metadata":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MISOCheckbox"}],"title":"MISOCheckbox","externalID":"s:14MISOComponents12MISOCheckboxV","roleHeading":"Structure","platforms":[{"introducedAt":"15.0","beta":false,"name":"iOS","deprecated":false,"unavailable":false},{"name":"macOS","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false},{"name":"visionOS","unavailable":false,"beta":false,"introducedAt":"1.0","deprecated":false},{"introducedAt":"11.0","unavailable":false,"deprecated":false,"beta":false,"name":"watchOS"}],"modules":[{"name":"Components"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MISOCheckbox"}]},"variants":[{"paths":["\/documentation\/misocomponents\/misocheckbox"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckbox\/init(isOn:accessibilityLabel:isError:isReadOnly:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckbox\/init(isOn:accessibilityLabel:tableName:bundle:isError:is