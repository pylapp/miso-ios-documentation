ph"},{"type":"heading","level":2,"text":"Particular cases","anchor":"Particular-cases"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckbox","isActive":true,"type":"reference"},{"text":" can be related to an error situation, for example troubles for a form librairies.","type":"text"},{"text":" ","type":"text"},{"text":"A dedicated look-and-feel is implemented for that if the ","type":"text"},{"code":"isError","type":"codeVoice"},{"text":" flag is risen.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"inlineContent":[{"type":"text","text":"Note also the component must be instanciated with a string parameter used as accessibility label."},{"text":" ","type":"text"},{"text":"It is a good pratice (at least) to define a label for a component without text for accessibility reasons. This label will be vocalized by ","type":"text"},{"inlineContent":[{"type":"text","text":"Voice Over"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The vocalization tool will also use, after the label, a description of the component (if disabled, if error context), and a fake trait for checkbox.","type":"text"},{"text":" ","type":"text"},{"text":"No accessibility identifier is defined in MISO side as this value remains in the users hands.","type":"text"}],"type":"paragraph"},{"anchor":"Cases-forbidden-by-design","type":"heading","level":2,"text":"Cases forbidden by design"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"The design system does not allow to have both an error or a read only situation and a disabled component.","type":"text"}],"type":"strong"}]},{"anchor":"Code-samples","text":"Code samples","level":2,"type":"heading"},{"type":"codeListing","code":["    \/\/ Supposing we have a selected checkbox","    @Published var isOn: Bool = true","","    \/\/ A simple checkbox, no error, not in read only mode","    MISOCheckbox(isOn: $isOn, accessibilityLabel: \"The cake is a lie\")","","    \/\/ A simple checkbox, but is an error context","    MISOCheckbox(isOn: $isOn, accessibilityLabel: \"The cake is a lie\"), isError: true)","","    \/\/ Never disable an error-related checkbox as it will crash","    \/\/ This is forbidden by design!","    MISOCheckbox(isOn: $isOn, accessibilityLabel: \"The cake is a lie\"), isError: true).disabled(true) \/\/ fatal error"],"syntax":"swift"},{"content":[{"inlineContent":[{"text":"2.4.0 (Figma component design version)","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Version"},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.12.0"}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckbox","interfaceLanguage":"swift"},"references":{"doc://MISOComponents/7SwiftUI4ViewP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View"},"ic_folder_categories.png":{"alt":null,"identifier":"ic_folder_categories.png","type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://MISOComponents/documentation/MISOComponents/MISOCheckbox/init(isOn:accessibilityLabel:isError:isReadOnly:)":{"title":"init(isOn:accessibilityLabel:isError:isReadOnly:)","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckbox\/init(isOn:accessibilityLabel:isError:isReadOnly:)","role":"symbol","abstract":[{"text":"Creates a checkbox with only an indicator.","type":"text"}],"url":"\/documentation\/misocomponents\/misocheckbox\/init(ison:accessibilitylabel:iserror:isreadonly:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"isOn","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdent