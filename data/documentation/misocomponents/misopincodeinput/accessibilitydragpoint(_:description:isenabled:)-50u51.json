,{"type":"text","text":"."}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOPinCodeInput":{"url":"\/documentation\/misocomponents\/misopincodeinput","abstract":[{"type":"text","text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,"},{"type":"text","text":" "},{"type":"text","text":"such as a four, six or eight-digit personal identification number (PIN)."},{"type":"text","text":" "},{"type":"text","text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,"},{"type":"text","text":" "},{"type":"text","text":"while supporting smooth keyboard navigation and secured input masking if needed."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOPinCodeInput"}],"navigatorTitle":[{"kind":"identifier","text":"MISOPinCodeInput"}],"title":"MISOPinCodeInput","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput","type":"topic"},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"alt":null,"type":"image","identifier":"ic_folder_categories.png"},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"url":"\/documentation\/misocomponents","kind":"symbol","title":"Components","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views. These are inherited from OUDS."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOCompon