dh","title":"accessibilityCustomContent(_:_:importance:)"},"doc://MISOComponents/documentation/MISOComponents/MISOPinCodeInput":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOPinCodeInput","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"MISOPinCodeInput","kind":"identifier"}],"abstract":[{"type":"text","text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,"},{"type":"text","text":" "},{"type":"text","text":"such as a four, six or eight-digit personal identification number (PIN)."},{"type":"text","text":" "},{"type":"text","text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,"},{"type":"text","text":" "},{"type":"text","text":"while supporting smooth keyboard navigation and secured input masking if needed."}],"title":"MISOPinCodeInput","url":"\/documentation\/misocomponents\/misopincodeinput"},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","kind":"symbol","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","type":"topic","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"abstract":[{"text":"The catalog of all components provided by MISO. It contains also ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}]}}}