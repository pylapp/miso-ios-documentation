e of contexts — such as tips, general information, or descriptive labels — where"},{"type":"text","text":" "},{"type":"text","text":"no specific feedback or urgency is required. Appropriate for help sections, dashboards, or onboarding flows."}],"title":"MISOAlertStatus.neutral(image:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neutral","kind":"identifier"},{"text":"(","kind":"text"},{"text":"image","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents9MISOImageV","text":"MISOImage","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"},"doc://MISOComponents/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/MISOComponents\/s8SendableP"},"doc://MISOComponents/documentation/MISOComponents/MISOInlineAlert":{"role":"symbol","abstract":[{"text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,","type":"text"},{"text":" ","type":"text"},{"text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional","type":"text"},{"text":" ","type":"text"},{"text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible.","type":"text"}],"type":"topic","title":"MISOInlineAlert","kind":"symbol","url":"\/documentation\/misocomponents\/misoinlinealert","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOInlineAlert","kind":"identifier"}],"navigatorTitle":[{"text":"MISOInlineAlert","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertMessage"}],"title":"MISOAlertMessage","url":"\/documentation\/misocomponents\/misoalertmessage","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOAlertMessage"}],"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"text":" ","type":"text"},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"text":" ","type":"text"},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertStatus","kind":"identifier"}],"navigatorTitle":[{"text":"MISOAlertStatus","kind":"identifier"}],"abstract":[{"text":"The status of the alerts.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","type":"reference","isActive":true},{"text":" background color and its icon color are based on this status.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","type":"reference","isActive":true},{"text":" icon and text color are based on this status.","type":"text"}],"role":"symbol","url":"\/documentation\/misocomponents\/misoalertstatus","type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus","title":"MISOAlertStatus"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/accent(image:)":{"url":"\/documentation\/misocomponents\/misoalertstatus\/accent(image:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Accent status uses brand colours to draw attention to promotional or highlighted information while remaining non-critical. Ideal for marketing content,"},{"type":"text","text":" "},{"type":"text","text":"announcements, or feature highlights, where you want to subtly engage users without introducing functional semantics. Ideal for promotional banners,"},{"text":" ","type":"text"},{"type":"text","text":"product updates, or customer engagement moments."}],"title":"MISOAlertStatus.accent(image:)","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accent","kind":"identifier"},{"text":"(","kind":"text"},{"text":"image","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MISOImage","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents9MISOImageV"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/info":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"info","kind":"identifier"}],"abstract":[{"text":"Info status is used to share neutral system information or service updates that do not require immediate action. Ideal for background processes or status","type":"text"},{"text":" ","type":"text"},{"text":"messages where users simply need to stay informed.","type":"text"},{"text":" ","type":"text"},{"text":"This status displays a dedicated default icon.","type":"text"}],"role":"symbol","url":"\/documentation\/misocomponents\/misoalertstatus\/info","type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","title":"MISOAlertStatus.info"},"ic_folder_categories.png":{"type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png","alt":null},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/warning":{"title":"MISOAlertStatus.warning","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/warning","abstract":[{"type":"text","text":"Used to draw attention to potential issues or upcoming changes that might affect the user’s service or experience. Warnings encourage awareness but"},{"type":"text","text":" "},{"type":"text","text":"typically do not block actions."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"warning","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/misocomponents\/misoalertstatus\/warning"}}}