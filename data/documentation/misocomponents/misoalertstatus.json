{"kind":"symbol","identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Enumeration","role":"symbol","symbolKind":"enum","title":"MISOAlertStatus","externalID":"s:14MISOComponents15MISOAlertStatusO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertStatus","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MISOAlertStatus"}],"modules":[{"name":"Components"}]},"variants":[{"paths":["\/documentation\/misocomponents\/misoalertstatus"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/negative","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/positive","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/warning"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@frozen","kind":"attribute"},{"text":" ","kind":"text"},{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertStatus","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two types of statuses:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Non-functional statuses used for informational or decorative alert messages.","type":"text"},{"text":" ","type":"text"},{"text":"They provide context or highlight content without implying a specific state, system event, or user action.","type":"text"},{"text":" ","type":"text"},{"text":"These alerts are not tied to UX patterns such as success, error, or warning, and may use contextual or brand-related icons to enhance recognition or storytelling.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Functional statuses communicate specific system statuses, results, or user feedback:"},{"type":"text","text":" "},{"type":"text","text":"Each variant conveys a clear semantic meaning and must always be paired with its dedicated functional icon to ensure clarity and accessibility."},{"type":"text","text":" "},{"type":"text","text":"Use functional alerts to inform user about state changes, confirmations, or issues that are directly connected to system logic or user actions."},{"type":"text","text":" "},{"type":"text","text":"These messages carry functional meaning and help guide user response or acknowledgment."}],"type":"paragraph"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","isActive":true,"type":"reference"},{"type":"text","text":" background color and its icon color are based on this status."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","isActive":true,"type":"reference"},{"type":"text","text":" icon and text color are based on this status."}],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/accent(image:)":{"url":"\/documentation\/misocomponents\/