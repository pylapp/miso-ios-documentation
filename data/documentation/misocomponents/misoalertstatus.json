of the alerts."},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage"},{"text":" background color and its icon color are based on this status.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert"},{"text":" icon and text color are based on this status.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MISOAlertStatus"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertStatus"}]},"doc://MISOComponents/documentation/MISOComponents/MISOInlineAlert":{"kind":"symbol","title":"MISOInlineAlert","navigatorTitle":[{"kind":"identifier","text":"MISOInlineAlert"}],"abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"type":"topic","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOInlineAlert"}],"url":"\/documentation\/misocomponents\/misoinlinealert"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/warning":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/warning","title":"MISOAlertStatus.warning","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"warning"}],"url":"\/documentation\/misocomponents\/misoalertstatus\/warning","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Used to draw attention to potential issues or upcoming changes that might affect the user’s service or experience. Warnings encourage awareness but"},{"type":"text","text":" "},{"type":"text","text":"typically do not block actions."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage":{"role":"symbol","type":"topic","kind":"symbol","title":"MISOAlertMessage","url":"\/documentation\/misocomponents\/misoalertmessage","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MISOAlertMessage"}],"navigatorTitle":[{"kind":"identifier","text":"MISOAlertMessage"}],"abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage"}}}