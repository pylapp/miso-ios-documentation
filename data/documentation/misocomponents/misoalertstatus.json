{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus","interfaceLanguage":"swift"},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"text":" ","kind":"text"},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertStatus"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"There are two types of statuses:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Non-functional statuses used for informational or decorative alert messages."},{"text":" ","type":"text"},{"text":"They provide context or highlight content without implying a specific state, system event, or user action.","type":"text"},{"text":" ","type":"text"},{"text":"These alerts are not tied to UX patterns such as success, error, or warning, and may use contextual or brand-related icons to enhance recognition or storytelling.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Functional statuses communicate specific system statuses, results, or user feedback:","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Each variant conveys a clear semantic meaning and must always be paired with its dedicated functional icon to ensure clarity and accessibility."},{"type":"text","text":" "},{"type":"text","text":"Use functional alerts to inform user about state changes, confirmations, or issues that are directly connected to system logic or user actions."},{"type":"text","text":" "},{"text":"These messages carry functional meaning and help guide user response or acknowledgment.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"symbol","metadata":{"symbolKind":"enum","modules":[{"name":"Components"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertStatus"}],"title":"MISOAlertStatus","role":"symbol","roleHeading":"Enumeration","navigatorTitle":[{"text":"MISOAlertStatus","kind":"identifier"}],"externalID":"s:14MISOComponents15MISOAlertStatusO"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"sections":[],"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/negative","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/positive","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/warning"],"generated":true,"anchor":"Enumeration-Cases"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misoalertstatus"]}],"abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","type":"reference","isActive":true},{"type":"text","text":" background color and its icon color are based on this status."},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","type":"reference"},{"text":" icon and text color are based on this status.","type":"text"}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MISOAlertMessage","kind":"identifier"}],"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"type":"text","text":" "},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"type":"text","text":" "},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"kind":"symbol","role":"symbol","title":"MISOAlertMessage","type":"topic","url":"\/documentation\/misocomponents\/misoalertmessage","navigatorTitle":[{"text":"MISOAlertMessage","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/negative":{"role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"negative"}],"type":"topic","url":"\/documentation\/misocomponents\/misoalertstatus\/negative","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/negative","abstract":[{"type":"text","text":"Negative status communicates a critical issue or error that prevents the user from proceeding until it is resolved. These alerts remain visible until"},{"type":"text","text":" "},{"type":"text","text":"the problem is fixed or dismissed by the user."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"title":"MISOAlertStatus.negative","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/neutral(image:)":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)","abstract":[{"type":"text","text":"Neutral status can be used as a generic informative alert without semantic meaning or colour association."},{"type":"text","text":" "},{"type":"text","text":"Suitable for a wide range of contexts — such as tips, general information, or descriptive labels — where"},{"type":"text","text":" "},{"type":"text","text":"no specific feedback or urgency is required. Appropriate for help sections, dashboards, or onboarding flows."}],"title":"MISOAlertStatus.neutral(image:)","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"neutral"},{"kind":"text","text":"("},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents9MISOImageV","text":"MISOImage"},{"kind":"text","text":"?)"}],"kind":"symbol","type":"topic","url":"\/documentation\/misocomponents\/misoalertstatus\/neutral(image:)"},"doc://MISOComponents/s8SendableP":{"identifier":"doc:\/\/MISOComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://MISOComponents/documentation/MISOComponents/MISOInlineAlert":{"navigatorTitle":[{"text":"MISOInlineAlert","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","type":"topic","abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MISOInlineAlert","kind":"identifier"}],"title":"MISOInlineAlert","url":"\/documentation\/misocomponents\/misoinlinealert"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertStatus","kind":"identifier"}],"title":"MISOAlertStatus","abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","isActive":true},{"type":"text","text":" background color and its icon color are based on this status."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert"},{"type":"text","text":" icon and text color are based on this status."}],"navigatorTitle":[{"text":"MISOAlertStatus","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/misocomponents\/misoalertstatus","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus"},"doc://MISOComponents/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/positive":{"title":"MISOAlertStatus.positive","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/positive","type":"topic","abstract":[{"text":"Positive status indicates that a task or process has been completed successfully. These alerts reassure users and confirm that no further action is needed.","type":"text"},{"text":" ","type":"text"},{"text":"This status displays a dedicated default icon.","type":"text"}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"positive","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misoalertstatus\/positive","role":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/info":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"info","kind":"identifier"}],"abstract":[{"type":"text","text":"Info status is used to share neutral system information or service updates that do not require immediate action. Ideal for background processes or status"},{"type":"text","text":" "},{"type":"text","text":"messages where users simply need to stay informed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"title":"MISOAlertStatus.info","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/misocomponents\/misoalertstatus\/info","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/accent(image:)":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)","role":"symbol","kind":"symbol","type":"topic","title":"MISOAlertStatus.accent(image:)","url":"\/documentation\/misocomponents\/misoalertstatus\/accent(image:)","abstract":[{"text":"Accent status uses brand colours to draw attention to promotional or highlighted information while remaining non-critical. Ideal for marketing content,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"announcements, or feature highlights, where you want to subtly engage users without introducing functional semantics. Ideal for promotional banners,"},{"type":"text","text":" "},{"type":"text","text":"product updates, or customer engagement moments."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents9MISOImageV","text":"MISOImage"},{"kind":"text","text":"?)"}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/warning":{"kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/warning","abstract":[{"type":"text","text":"Used to draw attention to potential issues or upcoming changes that might affect the user’s service or experience. Warnings encourage awareness but"},{"text":" ","type":"text"},{"type":"text","text":"typically do not block actions."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"title":"MISOAlertStatus.warning","type":"topic","url":"\/documentation\/misocomponents\/misoalertstatus\/warning","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"warning"}],"role":"symbol"},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"},"ic_folder_categories.png":{"alt":null,"identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image"}}}