ention to potential issues or upcoming changes that might affect the user’s service or experience. Warnings encourage awareness but"},{"type":"text","text":" "},{"type":"text","text":"typically do not block actions."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/info":{"abstract":[{"type":"text","text":"Info status is used to share neutral system information or service updates that do not require immediate action. Ideal for background processes or status"},{"type":"text","text":" "},{"type":"text","text":"messages where users simply need to stay informed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","role":"symbol","title":"MISOAlertStatus.info","type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"info","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misoalertstatus\/info","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/misocomponents","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","title":"Components","role":"collection","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/positive":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/positive","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword"