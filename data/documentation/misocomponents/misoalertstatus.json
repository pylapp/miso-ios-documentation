 displays a dedicated default icon."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"negative"}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/neutral(image:)":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)","title":"MISOAlertStatus.neutral(image:)","type":"topic","url":"\/documentation\/misocomponents\/misoalertstatus\/neutral(image:)","kind":"symbol","abstract":[{"type":"text","text":"Neutral status can be used as a generic informative alert without semantic meaning or colour association."},{"type":"text","text":" "},{"type":"text","text":"Suitable for a wide range of contexts — such as tips, general information, or descriptive labels — where"},{"type":"text","text":" "},{"type":"text","text":"no specific feedback or urgency is required. Appropriate for help sections, dashboards, or onboarding flows."}],"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"neutral","kind":"identifier"},{"text":"(","kind":"text"},{"text":"image","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14MISOComponents9MISOImageV","kind":"typeIdentifier","text":"MISOImage"},{"kind":"text","text":"?)"}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/accent(image:)":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14MISOComponents9MISOImageV","kind":"typeIdentifier","text":"MISOImage"},{"kind":"text","text":"?)"}],"title":"MISOAlertStatus.accent(image:)","role":"symbol","url":"\/documentation\/misocomponents\/misoalertstatus\/accent(image:)","abstract":[{"type":"text","text":"Accent status uses brand colours to draw attention to promotional or highlighted information while remaining non-critical. Ideal for marketing content,"},{"type":"text","text":" "},{"type":"text","text":"announcements, or feature highlights, where you want to subtly engage users without introducing functional semantics. Ideal for promotional banners,"},{"type":"text","text":" "},{"type":"text","text":"product updates, or customer engagement moments."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)","type":"topic","kind":"symbol"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/info":{"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"info"}],"title":"MISOAlertStatus.info","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","abstract":[{"type":"text","text":"Info status is used to share neutral system information or service updates that do not require immediate action. Ideal for background processes or status"},{"type":"text","text":" "},{"type":"text","text":"messages where users simply need to stay informed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"url":"\/documentation\/misocomponents\/misoalertstatus\/info"}}}