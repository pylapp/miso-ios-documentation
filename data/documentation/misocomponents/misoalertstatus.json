{"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misoalertstatus"]}],"sections":[],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage"},{"type":"text","text":" background color and its icon color are based on this status."},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert"},{"type":"text","text":" icon and text color are based on this status."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@frozen","kind":"attribute"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertStatus"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are two types of statuses:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-functional statuses used for informational or decorative alert messages."},{"type":"text","text":" "},{"type":"text","text":"They provide context or highlight content without implying a specific state, system event, or user action."},{"type":"text","text":" "},{"type":"text","text":"These alerts are not tied to UX patterns such as success, error, or warning, and may use contextual or brand-related icons to enhance recognition or storytelling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Functional statuses communicate specific system statuses, results, or user feedback:","type":"text"},{"text":" ","type":"text"},{"text":"Each variant conveys a clear semantic meaning and must always be paired with its dedicated functional icon to ensure clarity and accessibility.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Use functional alerts to inform user about state changes, confirmations, or issues that are directly connected to system logic or user actions."},{"text":" ","type":"text"},{"type":"text","text":"These messages carry functional meaning and help guide user response or acknowledgment."}]}]}]}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"MISOAlertStatus"}],"symbolKind":"enum","externalID":"s:14MISOComponents15MISOAlertStatusO","role":"symbol","roleHeading":"Enumeration","title":"MISOAlertStatus","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertStatus"}],"modules":[{"name":"Components"}]},"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/negative","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/positive","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/warning"],"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/neutral(image:)":{"abstract":[{"text":"Neutral status can be used as a generic informative alert without semantic meaning or colour association.","type":"text"},{"text":" ","type":"text"},{"text":"Suitable for a wide range of contexts — such as tips, general information, or descriptive labels — where","type":"text"},{"text":" ","type":"text"},{"text":"no specific feedback or urgency is required. Appropriate for help sections, dashboards, or onboarding flows.","type":"text"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)","role":"symbol","title":"MISOAlertStatus.neutral(image:)","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"neutral"},{"kind":"text","text":"("},{"kind":"externalParam","text":"image"},{"kind":"text","text":": "},{"text":"MISOImage","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents9MISOImageV"},{"text":"?)","kind":"text"}],"url":"\/documentation\/misocomponents\/misoalertstatus\/neutral(image:)","kind":"symbol"},"doc://MISOComponents/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s8SendableP"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage":{"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"text":" ","type":"text"},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"text":" ","type":"text"},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"url":"\/documentation\/misocomponents\/misoalertmessage","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","navigatorTitle":[{"text":"MISOAlertMessage","kind":"identifier"}],"kind":"symbol","titl