{"abstract":[{"text":"The status of the alerts.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage"},{"text":" background color and its icon color are based on this status.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert"},{"text":" icon and text color are based on this status.","type":"text"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/negative","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/neutral(image:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/positive","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/warning"],"anchor":"Enumeration-Cases","title":"Enumeration Cases"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@frozen"},{"kind":"text","text":" "},{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertStatus"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"text":"There are two types of statuses:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Non-functional statuses used for informational or decorative alert messages."},{"type":"text","text":" "},{"type":"text","text":"They provide context or highlight content without implying a specific state, system event, or user action."},{"type":"text","text":" "},{"type":"text","text":"These alerts are not tied to UX patterns such as success, error, or warning, and may use contextual or brand-related icons to enhance recognition or storytelling."}]}]},{"content":[{"inlineContent":[{"text":"Functional statuses communicate specific system statuses, results, or user feedback:","type":"text"},{"text":" ","type":"text"},{"text":"Each variant conveys a clear semantic meaning and must always be paired with its dedicated functional icon to ensure clarity and accessibility.","type":"text"},{"text":" ","type":"text"},{"text":"Use functional alerts to inform user about state changes, confirmations, or issues that are directly connected to system logic or user actions.","type":"text"},{"text":" ","type":"text"},{"text":"These messages carry functional meaning and help guide user response or acknowledgment.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/misocomponents\/misoalertstatus"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"externalID":"s:14MISOComponents15MISOAlertStatusO","role":"symbol","title":"MISOAlertStatus","roleHeading":"Enumeration","symbolKind":"enum","modules":[{"name":"Components"}],"navigatorTitle":[{"text":"MISOAlertStatus","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertStatus","kind":"identifier"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","a