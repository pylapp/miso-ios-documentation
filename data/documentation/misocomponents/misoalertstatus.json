imply need to stay informed."},{"type":"text","text":" "},{"type":"text","text":"This status displays a dedicated default icon."}],"url":"\/documentation\/misocomponents\/misoalertstatus\/info","title":"MISOAlertStatus.info","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"info","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/info","role":"symbol","type":"topic","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage":{"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"text":" ","type":"text"},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"text":" ","type":"text"},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","kind":"symbol","title":"MISOAlertMessage","role":"symbol","navigatorTitle":[{"text":"MISOAlertMessage","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misoalertmessage","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertMessage","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus":{"title":"MISOAlertStatus","abstract":[{"type":"text","text":"The status of the alerts."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","type":"reference","isActive":true},{"type":"text","text":" background color and its icon color are based on this status."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","type":"reference","isActive":true},{"type":"text","text":" icon and text color are based on this status."}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertStatus","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MISOAlertStatus","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus","type":"topic","url":"\/documentation\/misocomponents\/misoalertstatus"},"doc://MISOComponents/documentation/MISOComponents/MISOInlineAlert":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOInlineAlert","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"MISOInlineAlert","kind":"identifier"}],"title":"MISOInlineAlert","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","url":"\/documentation\/misocomponents\/misoinlinealert","abstract":[{"type":"text","text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,"},{"type":"text","text":" "},{"type":"text","text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional"},{"type":"text","text":" "},{"type":"text","text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible."}],"kind":"symbol","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/accent(image:)":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accent","kind":"identifier"},{"text":"(","kind":"text"},{"text":"image","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents9MISOImageV","text":"MISOImage","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"role":"symbol","title":"MISOAlertStatus.accent(image:)","url":"\/documentation\/misocomponents\/misoalertstatus\/accent(image:)","abstract":[{"type":"text","text":"Accent status uses brand colours to draw attention to promotional or highlighted information while remaining non-critical. Ideal for marketing content,"},{"type":"text","text":" "},{"type":"text","text":"announcements, or feature highlights, where you want to subtly engage users without introducing functional semantics. Ideal for promotional banners,"},{"type":"text","text":" "},{"type":"text","text":"product updates, or customer engagement moments."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/accent(image:)","kind":"symbol","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus/negative":{"url":"\/documentation\/misocomponents\/misoalertstatus\/negative","role":"symbol","abstract":[{"text":"Negative status communicates a critical issue or error that prevents the user from proceeding until it is resolved. These alerts remain visible until","type":"text"},{"text":" ","type":"text"},{"text":"the problem is fixed or dismissed by the user.","type":"text"},{"text":" ","type":"text"},{"text":"This status displays a dedicated default icon.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"negative"}],"title":"MISOAlertStatus.negative","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus\/negative"}}}