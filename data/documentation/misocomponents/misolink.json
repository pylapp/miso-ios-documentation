{"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLink","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts","doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},{"type":"text","text":" proposes layout with text only or text with icon."},{"type":"text","text":" "},{"type":"text","text":"It also proposes layout to navigate forward or backward. The link can be displayed in "},{"type":"codeVoice","code":"small"},{"type":"text","text":" or "},{"type":"codeVoice","code":"default"},{"type":"text","text":" size."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Text only or Text and icon layout","anchor":"Text-only-or-Text-and-icon-layout"},{"inlineContent":[{"text":"This layout is used to open a link or to display a specific feature (like send feedbacks, show more, …)","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Text only in small size, in compact density","    MISOLink(text: \"Feedback\", size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ From a localizable and a bundle","    MISOLink(LocalizedStringKey(\"feedback_link\"), bundle: Bundle.module, size: .small) { }","","    \/\/ Text and icon in default size","    MISOLink(text: \"Feedback\", image: MISOImage(asset: Image(\"ic_heart\")), size: .default) { }","","    \/\/ Text and icon with raw image (not tinted)","    MISOLink(text: \"Feedback\", image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) { }"]},{"level":2,"type":"heading","text":"Navigation layout","anchor":"Navigation-layout"},{"inlineContent":[{"type":"text","text":"This layout is used to navigate backward, forward and outside the app"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Navigate to next page with link in a small size","    MISOLink(text: \"Feedback\", indicator: .next, size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ Navigate to previous page with link in a default size","    MISOLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","    \/\/ Full-width: label stays, chevron anchored to the right \/ left","    MISOLink(text: \"See all\", indicator: .next, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ Full-width: label stays, indicator anchored to the right \/ left","    MISOLink(text: \"See all\", indicator: .external, isFullWidth: true) { \/* the action to process *\/ }"]},{"level":2,"type":"heading","text":"Colored Surface","anchor":"Colored-Surface"},{"inlineContent":[{"type":"text","text":"If link is placed on colored surface using "},{"code":"MISOColoredSurface","type":"codeVoice"},{"type":"text","text":", the default colors (content text and icon or arrow) are automatically adjusted to switch to monochrom."}],"type":"paragraph"},{"type":"aside","name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"2.4.0 (Figma component design version)","type":"text"}]}],"style":"note"},{"type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.11.0"}]}],"style":"note"}]}],"sections":[],"metadata":{"externalID":"s:14MISOComponents8MISOLinkV","platforms":[{"deprecated":false,"beta":false,"unavailable":false,"name":"iOS","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"macOS","introducedAt":"13.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"tvOS","introducedAt":"16.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"watchOS","introducedAt":"11.0"}],"modules":[{"name":"Components"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLink"}],"roleHeading":"Structure","title":"MISOLink","role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MISOLink"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/misocomponents\/misolink"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink\/init(_:tableName:bundle:image:size:density:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink\/init(_:tableName:bundle:indicator:size:density:isFullWidth:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink\/init(text:image:size:den