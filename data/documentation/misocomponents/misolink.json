{"kind":"symbol","sections":[],"metadata":{"platforms":[{"beta":false,"deprecated":false,"introducedAt":"15.0","unavailable":false,"name":"iOS"},{"beta":false,"deprecated":false,"introducedAt":"13.0","unavailable":false,"name":"macOS"},{"beta":false,"deprecated":false,"introducedAt":"16.0","unavailable":false,"name":"tvOS"},{"beta":false,"deprecated":false,"introducedAt":"1.0","unavailable":false,"name":"visionOS"},{"beta":false,"deprecated":false,"introducedAt":"11.0","unavailable":false,"name":"watchOS"}],"roleHeading":"Structure","modules":[{"name":"Components"}],"symbolKind":"struct","title":"MISOLink","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLink","kind":"identifier"}],"externalID":"s:14MISOComponents8MISOLinkV","navigatorTitle":[{"text":"MISOLink","kind":"identifier"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misolink"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLink"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts","doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","type":"reference","isActive":true},{"type":"text","text":" proposes layout with text only or text with icon."},{"type":"text","text":" "},{"type":"text","text":"It also proposes layout to navigate forward or backward. The link can be displayed in "},{"type":"codeVoice","code":"small"},{"type":"text","text":" or "},{"type":"codeVoice","code":"default"},{"type":"text","text":" size."}]},{"type":"heading","level":2,"text":"Text only or Text and icon layout","anchor":"Text-only-or-Text-and-icon-layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This layout is used to open a link or to display a specific feature (like send feedbacks, show more, …)"}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ Text only in small size, in compact density","    MISOLink(text: \"Feedback\", size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ From a localizable and a bundle","    MISOLink(LocalizedStringKey(\"feedback_link\"), bundle: Bundle.module, size: .small) { }","","    \/\/ Text and icon in default size","    MISOLink(text: \"Feedback\", image: MISOImage(asset: Image(\"ic_heart\")), size: .default) { }","","    \/\/ Text and icon with raw image (not tinted)","    MISOLink(text: \"Feedback\", image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) { }"]},{"type":"heading","level":2,"text":"Navigation layout","anchor":"Navigation-layout"},{"type":"paragraph","inlineContent":[{"text":"This layout is used to navigate backward, forward and outside the app","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ Navigate to next page with link in a small size","    MISOLink(text: \"Feedback\", indicator: .next, size: .small, density: .compact) { \/* the action to process *\/ }","","    \/\/ Navigate to previous page with link in a default size","    MISOLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","    \/\/ Full-width: label stays, chevron anchored to the right \/ left","    MISOLink(text: \"See all\", indicator: .next, isFullWidth: true) { \/* the action to process *\/ }","","    \/\/ Full-width: label stays, indicator anchored to the right \/ left","    MISOLink(text: \"See all\", indicator: .external, isFullWidth: true) { \/* the action to process *\/ }"]},{"type":"heading","level":2,"text":"Colored Surface","anchor":"Colored-Surface"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If link is placed on colored surface using "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":", the default colors (content text and icon or arrow) are automatically adjusted to switch to monochrom."}]},{"type":"aside","style":"note","name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"2.4.0 (Figma component design version)","type":"text"}]}]},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.11.0"}]}]}]}],"abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink\/init(_:tableName:bundle:image:size:density:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink\/init(_:tableName:bundle:indicator:size:density:isFullWidth:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/M