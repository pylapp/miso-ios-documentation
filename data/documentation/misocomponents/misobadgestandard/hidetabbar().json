{"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"externalID":"s:7SwiftUI4ViewP14MISOComponentsE10hideTabBarQryF::SYNTHESIZED::s:14MISOComponents17MISOBadgeStandardV","title":"hideTabBar()","role":"symbol","platforms":[{"name":"iOS","beta":false,"introducedAt":"16.0","deprecated":false,"unavailable":false}],"modules":[{"relatedModules":["SwiftUICore"],"name":"Components"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hideTabBar","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"extendedModule":"SwiftUICore","roleHeading":"Instance Method","symbolKind":"method"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"},{"kind":"text","text":"\n"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A view that hides the tab bar and propagates the hidden state to "},{"type":"codeVoice","code":"MISOTabBar"},{"text":" overlay items.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this modifier instead of "},{"type