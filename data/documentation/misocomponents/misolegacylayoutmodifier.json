{"abstract":[{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions."}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/init()"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/body(content:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/ViewModifier-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Structure","title":"MISOLegacyLayoutModifier","externalID":"s:14MISOComponents24MISOLegacyLayoutModifierV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"role":"symbol","symbolKind":"struct","modules":[{"name":"Components"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"],"title":"Conforms To","type":"conformsTo"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misolegacylayoutmodifier"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by MISO.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 26, the ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" flag is read and MISO considers wether or not Liquid Glass is enabled.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The edge case is when the OS version is 27, the flag ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"type":"text","text":" stils exists but the app is compiled with Xcode 26."},{"type":"text","text":" "},{"type":"text","text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and MISO cannot only rely on the OS version."},{"type":"text","text":" "},{"type":"text","text":"Thus, this "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","isActive":true},{"type":"text","text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed."}]},{"inlineContent":[{"type":"text","text":"**You must use this "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" with care, and only if you are using Xcode 26 and  "},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":" to YES **."},{"type":"text","text":" "},{"type":"text","text":"Prefer build with Xcode 27 without the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":"  flag."}],"type":"paragraph"},{"code":["  MISOTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(MISOLegacyLayoutModifier())"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars","type":"text"}]}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}],"style":"note","name":"Since","type":"aside"}]}],"references":{"ic_folder_categories.png":{"type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null,"identifier":"ic_folder_categories.png"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"navigatorTitle":[{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions."}],"type":"topic","url":"\/documentation\/misocomponents\/misolegacylayoutmodifier","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","title":"MISOLegacyLayoutModifier","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier/init()":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"text":"Instanciates the ","type":"text"},{"type":"codeVoice","code":"MISOLegacyLayoutModifier"},{"type":"text","text":" and displays error messages in the standard output"}],"kind":"symbol","role":"symbol","title":"init()","type":"topic","url":"\/documentation\/misocomponents\/misolegacylayoutmodifier\/init()"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier/ViewModifier-Implementations":{"type":"topic","kind":"article","abstract":[],"url":"\/documentation\/misocomponents\/misolegacylayoutmodifier\/viewmodifier-implementations","role":"collectionGroup","title":"ViewModifier Implementations","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/ViewModifier-Implementations"},"doc://MISOComponents/7SwiftUI12ViewModifierP":{"type":"unresolvable","title":"SwiftUICore.ViewModifier","identifier":"doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"},"doc://MISOComponents/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP"},"doc://MISOComponents/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/MISOComponents\/s8SendableP","type":"unresolvable"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier/body(content:)":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/body(content:)","title":"body(content:)","role":"symbol","type":"topic","url":"\/documentation\/misocomponents\/misolegacylayoutmodifier\/body(content:)","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"body"},{"kind":"text","text":"("},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MISOLegacyLayoutModifier","preciseIdentifier":"s:14MISOComponents24MISOLegacyLayoutModifierV"},{"kind":"text","text":"."},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Defines environment variable to precise the legacy tab bar must be forced"}]},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"}}}