{"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier"},"abstract":[{"code":"ViewModifier","type":"codeVoice"},{"text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions.","type":"text"}],"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misolegacylayoutmodifier"]}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/init()"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/body(content:)"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/ViewModifier-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"metadata":{"modules":[{"name":"Components"}],"roleHeading":"Structure","role":"symbol","externalID":"s:14MISOComponents24MISOLegacyLayoutModifierV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"navigatorTitle":[{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"title":"MISOLegacyLayoutModifier","symbolKind":"struct"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLegacyLayoutModifier"}]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by MISO.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 26, the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"text":" flag is read and MISO considers wether or not Liquid Glass is enabled.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The edge case is when the OS version is 27, the flag ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"text":" stils exists but the app is compiled with Xcode 26.","type":"text"},{"text":" ","type":"text"},{"text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and MISO cannot only rely on the OS version.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, this ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier"},{"text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"**You must use this "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" with care, and only if you are using Xcode 26 and  "},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"text":" to YES **.","type":"text"},{"text":" ","type":"text"},{"text":"Prefer build with Xcode 27 without the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"text":"  flag.","type":"text"}],"type":"paragraph"},{"code":["  MISOTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(MISOLegacyLayoutModifier())"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars","type":"text"}]}],"type":"paragraph"},{"style":"note","name":"Since","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}]}],"kind":"content"}],"references":{"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier/body(content:)":{"url":"\/documentation\/misocomponents\/misolegacylayoutmodifier\/body(content:)","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/body(content:)","title":"body(content:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents24MISOLegacyLayoutModifierV","text":"MISOLegacyLayoutModifier","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"type":"topic","abstract":[{"text":"Defines environment variable to precise the legacy tab bar must be forced","type":"text"}],"kind":"symbol"},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"alt":null,"type":"image","identifier":"ic_folder_categories.png"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier/ViewModifier-Implementations":{"url":"\/documentation\/misocomponents\/misolegacylayoutmodifier\/viewmodifier-implementations","role":"collectionGroup","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/ViewModifier-Implementations","title":"ViewModifier Implementations","type":"topic","abstract":[],"kind":"article"},"doc://MISOComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP"},"doc://MISOComponents/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/MISOComponents\/s8SendableP","type":"unresolvable"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier/init()":{"abstract":[{"text":"Instanciates the ","type":"text"},{"code":"MISOLegacyLayoutModifier","type":"codeVoice"},{"text":" and displays error messages in the standard output","type":"text"}],"kind":"symbol","title":"init()","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","url":"\/documentation\/misocomponents\/misolegacylayoutmodifier\/init()","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/init()"},"doc://MISOComponents/documentation/MISOComponents/MISOLegacyLayoutModifier":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"abstract":[{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions."}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misolegacylayoutmodifier","title":"MISOLegacyLayoutModifier"},"doc://MISOComponents/7SwiftUI12ViewModifierP":{"title":"SwiftUICore.ViewModifier","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"}}}