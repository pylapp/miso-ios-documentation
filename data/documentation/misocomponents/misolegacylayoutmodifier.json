{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by MISO."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 26, the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" flag is read and MISO considers wether or not Liquid Glass is enabled."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The edge case is when the OS version is 27, the flag "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" stils exists but the app is compiled with Xcode 26."},{"type":"text","text":" "},{"type":"text","text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and MISO cannot only rely on the OS version."},{"type":"text","text":" "},{"type":"text","text":"Thus, this "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","isActive":true,"type":"reference"},{"type":"text","text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"**You must use this "},{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":" with care, and only if you are using Xcode 26 and  "},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":" to YES **."},{"type":"text","text":" "},{"type":"text","text":"Prefer build with Xcode 27 without the "},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":"  flag."}],"type":"paragraph"},{"syntax":"swift","code":["  MISOTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(MISOLegacyLayoutModifier())"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars","type":"text"}]}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 3.0.0"}]}],"type":"aside","name":"Since"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:14MISOComponents24MISOLegacyLayoutModifierV","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"navigatorTitle":[{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"modules":[{"name":"Components"}],"roleHeading":"Structure","symbolKind":"struct","title":"MISOLegacyLayoutModifier"},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misolegacylayoutmodifier"]}],"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions.