{"abstract":[{"type":"codeVoice","code":"ViewModifier"},{"text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by MISO.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 26, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"text":" flag is read and MISO considers wether or not Liquid Glass is enabled.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The edge case is when the OS version is 27, the flag ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" stils exists but the app is compiled with Xcode 26."},{"type":"text","text":" "},{"type":"text","text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and MISO cannot only rely on the OS version."},{"type":"text","text":" "},{"type":"text","text":"Thus, this "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier"},{"type":"text","text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed."}]},{"inlineContent":[{"type":"text","text":"**You must use this "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" with care, and only if you are using Xcode 26 and  "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" to YES **."},{"type":"text","text":" "},{"type":"text","text":"Prefer build with Xcode 27 without the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":"  flag."}],"type":"paragraph"},{"code":["  MISOTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(MISOLegacyLayoutModifier())"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars"}],"type":"strong"}],"type":"paragraph"},{"name":"Since","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 3.0.0"}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","interfaceLanguage":"swift"},"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"roleHeading":"Structure","title":"MISOLegacyLayoutModifier","externalID":"s:14MISOComponents24MISOLegacyLayoutModifierV","navigatorTitle":[{"text":"MISOLegacyLayoutModifier","kind":"identifier"}],"modules":[{"name":"Components"}],"symbolKind":"struct"},"kind":"symbol","sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12V