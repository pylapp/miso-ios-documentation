{"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/init()"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/body(content:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier\/ViewModifier-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLegacyLayoutModifier"}],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"If an app is compiled with Xcode 27 for iOS 27, Liquid Glass is forced by the system and considered as enabled by MISO.","type":"text"},{"text":" ","type":"text"},{"text":"If an app is compiled with Xcode 26 for iOS 26, the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" flag is read and MISO considers wether or not Liquid Glass is enabled."},{"type":"text","text":" "},{"type":"text","text":"If an app is compiled with Xcode 26 for iOS 18 and lower, Liquid Glass is considered as unavailable, disabled."}],"type":"paragraph"},{"inlineContent":[{"text":"The edge case is when the OS version is 27, the flag ","type":"text"},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"text":" stils exists but the app is compiled with Xcode 26.","type":"text"},{"text":" ","type":"text"},{"text":"This case is extreme: the system does not force Liquid Glass, the flag is here, and MISO cannot only rely on the OS version.","type":"text"},{"text":" ","type":"text"},{"text":"Thus, this ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier"},{"text":"  will define an environment value saying any legacy layout things (appearances, selector, divider) must be displayed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"**You must use this ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":" with care, and only if you are using Xcode 26 and  ","type":"text"},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"text":" to YES **.","type":"text"},{"text":" ","type":"text"},{"text":"Prefer build with Xcode 27 without the ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":"  flag.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["  MISOTabBar(selectedTab: ..., count: ...) { ... )","    .modifier(MISOLegacyLayoutModifier())"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note: You should use this view modifier in your root view because the flag it defines in deeper levels is used for all navigations components like bars"}]}]},{"type":"aside","name":"Since","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}]}],"kind":"content"}],"abstract":[{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" to manage an edge case about Liquid Glass configuration of Apple OS and Xcode versions."}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLegacyLayoutModifier","interfaceLanguage":"swift"},"sections":[],"metad