{"kind":"symbol","abstract":[{"text":"Represents the main content displayed within a list item component such as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misolistitemdata"]}],"sections":[],"metadata":{"roleHeading":"Structure","role":"symbol","title":"MISOListItemData","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOListItemData","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"text":"MISOListItemData","kind":"identifier"}],"modules":[{"name":"Components"}],"platforms":[{"beta":false,"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"15.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"13.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"16.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"},{"beta":false,"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":"11.0"}],"externalID":"s:14MISOComponents16MISOListItemDataV"},"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Slot"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibilityLabel:overline:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:overline:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Label"],"generated":true,"anchor":"Enumerations","title":"Enumerations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOListItemData"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData"},{"text":" groups all the text-based information that a list item can display:","type":"text"},{"text":" ","type":"text"},{"text":"a mandatory label (either a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" or a custom ","type":"text"},{"type":"codeVoice","code":"View"},{"text":"), and optional description, overline,","type":"text"},{"text":" ","type":"text"},{"text":"extra label, and helper text, and slots.","type":"text"}]},{"type":"heading","anchor":"Code-samples","text":"Code samples","level":2},{"type":"codeListing","syntax":"swift","code":["    \/\/ Minimal: label only (String)","    let data = MISOListItemData(label: \"Label\")","","    \/\/ Label with bold style","    let data = MISOListItemData(label: \"Label\", hasBoldLabel: true)","","    \/\/ Custom view as label with accessibility label","    let data = MISOListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content with text label","    let data = MISOListItemData(","        label: \"Label\",","        hasBoldLabel: false,","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Full content with custom view label","    let data = MISOListItemData(","        label: VStack(alignment: .leading) {","            Text(\"Title\").font(.headline)","            Text(\"Subtitle\").font(.caption)","        },","        accessibilityLabel: \"Title, Subtitle\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Overline as a user-styled rich text (AttributedString)","    \/\/ Same \"overline\" parameter name as the String variant, disambiguated by the value's type.","    let data = MISOListItemData(","        label: \"Label\",","        overline: .from(text: \"Overline\",","                        foregroundColor: theme.colors.contentBrandPrimary.color(for: colorScheme),","                        font: someFont)","    )","","    \/\/ Usage with a static list item","    MISOStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    MISONavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: MISOListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"]},{"type":"heading","anchor":"Custom-view-label","text":"Custom view label","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When providing a custom view as label:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"hasBoldLabel"},{"type":"text","text":" property is not applicable; all styling is controlled by the provided view."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You must provide an ","type":"text"},{"code":"accessibilityLabel","type":"codeVoice"},{"text":" parameter so that Voice Over can vocalize the label.","type":"text"},{"text":" ","type":"text"},{"text":"This ","type":"text"},{"code":"accessibilityLabel","type":"codeVoice"},{"text":" is used in the combined accessibility label of the list item text container.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)"}]}]}]},{"type":"heading","anchor":"Small-size-behavior","text":"Small size behavior","level":2},{"type":"paragraph","inlineContent":[{"text":"When the list item is displayed in small size (via the ","type":"text"},{"type":"codeVoice","code":".misoListItemSize(.small)"},{"text":" modifier),","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"overline"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"extraLabel"},{"text":" properties are ","type":"text"},{"type":"strong","inlineContent":[{"text":"automatically hidden","type":"text"}]},{"text":" to ensure a compact layout.","type":"text"},{"text":" ","type":"text"},{"text":"Only the ","type":"text"},{"type":"codeVoice","code":"label"},{"text":", ","type":"text"},{"type":"codeVoice","code":"description"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"helperText"},{"text":" remain visible.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"bottomSlot"},{"type":"text","text":" is also "},{"type":"strong","inlineContent":[{"type":"text","text":"automatically hidden"}]},{"type":"text","text":", but the "},{"type":"codeVoice","code":"textSlot"},{"type":"text","text":" remains displayed."}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    MISOStaticListItem(data: MISOListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .misoListItemSize(.small)"]},{"name":"Since","content":[{"inlineContent":[{"text":"OUDS 3.0.0","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData"},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOListItemData/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)":{"url":"\/documentation\/misocomponents\/misolistitemdata\/init(key:tablename:bundle:hasboldlabe