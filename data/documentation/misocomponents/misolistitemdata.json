{"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"type":"text","text":"Represents the main content displayed within a list item component such as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","isActive":true},{"type":"text","text":"."}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"Components"}],"title":"MISOListItemData","symbolKind":"struct","platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"tvOS","introducedAt":"16.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false},{"name":"watchOS","introducedAt":"11.0","deprecated":false,"unavailable":false,"beta":false}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOListItemData"}],"role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MISOListItemData"}],"externalID":"s:14MISOComponents16MISOListItemDataV"},"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Slot"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibilityLabel:overline:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:overline:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Label"],"title":"Enumerations","generated":true,"anchor":"Enumerations"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misolistitemdata"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOListItemData"}]}],"kind":"declarations"},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData"},{"type":"text","text":" groups all the text-based information that a list item can display:"},{"type":"text","text":" "},{"type":"text","text":"a mandatory label (either a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a custom "},{"type":"codeVoice","code":"View"},{"type":"text","text":"), and optional description, overline,"},{"type":"text","text":" "},{"type":"text","text":"extra label, and helper text, and slots."}]},{"text":"Code samples","type":"heading","level":2,"anchor":"Code-samples"},{"code":["    \/\/ Minimal: label only (String)","    let data = MISOListItemData(label: \"Label\")","","    \/\/ Label with bold style","    let data = MISOListItemData(label: \"Label\", hasBoldLabel: true)","","    \/\/ Custom view as label with accessibility label","    let data = MISOListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content with text label","    let data = MISOListItemData(","        label: \"Label\",","        hasBoldLabel: false,","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Full content with custom view label","    let data = MISOListItemData(","        label: VStack(alignment: .leading) {","            Text(\"Title\").font(.headline)","            Text(\"Subtitle\").font(.caption)","        },","        accessibilityLabel: \"Title, Subtitle\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Overline as a user-styled rich text (AttributedString)","    \/\/ Same \"overline\" parameter name as the String variant, disambiguated by the value's type.","    let data = MISOListItemData(","        label: \"Label\",","        overline: .from(text: \"Overline\",","                        foregroundColor: theme.colors.contentBrandPrimary.color(for: colorScheme),","                        font: someFont)","    )","","    \/\/ Usage with a static list item","    MISOStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    MISONavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: MISOListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"],"syntax":"swift","type":"codeListing"},{"text":"Custom view label","type":"heading","level":2,"anchor":"Custom-view-label"},{"inlineContent":[{"type":"text","text":"When providing a custom view as label:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"hasBoldLabel","type":"codeVoice"},{"type":"text","text":" property is not applicable; all styling is controlled by the provided view."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must provide an "},{"type":"codeVoice","code":"accessibilityLabel"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"type":"codeVoice","code":"accessibilityLabel"},{"type":"text","text":" is used in the combined accessibility label of the list item text container."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)","type":"text"}]}]}]},{"text":"Small size behavior","type":"heading","level":2,"anchor":"Small-size-behavior"},{"inlineContent":[{"text":"When the list item is displayed in small size (via the ","type":"text"},{"type":"codeVoice","code":".misoListItemSize(.small)"},{"type":"text","text":" modifier),"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"overline","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"extraLabel","type":"codeVoice"},{"text":" properties are ","type":"text"},{"inlineContent":[{"type":"text","text":"automatically hidden"}],"type":"strong"},{"text":" to ensure a compact layout.","type":"text"},{"text":" ","type":"text"},{"text":"Only the ","type":"text"},{"code":"label","type":"codeVoice"},{"text":", ","type":"text"},{"code":"description","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" remain visible.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"bottomSlot"},{"type":"text","text":" is also "},{"type":"strong","inlineContent":[{"text":"automatically hidden","type":"text"}]},{"type":"text","text":", but the "},{"type":"codeVoice","code":"textSlot"},{"type":"text","text":" remains displayed."}]},{"code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    MISOStaticListItem(data: MISOListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .misoListItemSize(.small)"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 3.0.0"}]}],"style":"note","type":"aside","name":"Since"}]}],"references":{"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It c