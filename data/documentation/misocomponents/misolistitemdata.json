{"abstract":[{"type":"text","text":"Represents the main content displayed within a list item component such as"},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","type":"reference","isActive":true},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOListItemData","kind":"identifier"}]}],"kind":"declarations"},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"],"kind":"mentions"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData"},{"text":" groups all the text-based information that a list item can display:","type":"text"},{"text":" ","type":"text"},{"text":"a mandatory label (either a ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" or a custom ","type":"text"},{"type":"codeVoice","code":"View"},{"text":"), and optional description, overline,","type":"text"},{"text":" ","type":"text"},{"text":"extra label, and helper text, and slots.","type":"text"}],"type":"paragraph"},{"anchor":"Code-samples","type":"heading","text":"Code samples","level":2},{"code":["    \/\/ Minimal: label only (String)","    let data = MISOListItemData(label: \"Label\")","","    \/\/ Label with bold style","    let data = MISOListItemData(label: \"Label\", hasBoldLabel: true)","","    \/\/ Custom view as label with accessibility label","    let data = MISOListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content with text label","    let data = MISOListItemData(","        label: \"Label\",","        hasBoldLabel: false,","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Full content with custom view label","    let data = MISOListItemData(","        label: VStack(alignment: .leading) {","            Text(\"Title\").font(.headline)","            Text(\"Subtitle\").font(.caption)","        },","        accessibilityLabel: \"Title, Subtitle\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Overline as a user-styled rich text (AttributedString)","    \/\/ Same \"overline\" parameter name as the String variant, disambiguated by the value's type.","    let data = MISOListItemData(","        label: \"Label\",","        overline: .from(text: \"Overline\",","                        foregroundColor: theme.colors.contentBrandPrimary.color(for: colorScheme),","                        font: someFont)","    )","","    \/\/ Usage with a static list item","    MISOStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    MISONavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: MISOListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"],"type":"codeListing","syntax":"swift"},{"anchor":"Custom-view-label","type":"heading","text":"Custom view label","level":2},{"inlineContent":[{"text":"When providing a custom view as label:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"hasBoldLabel","type":"codeVoice"},{"type":"text","text":" property is not applicable; all styling is controlled by the provided view."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must provide an "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" is used in the combined accessibility label of the list item text container."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)"}]}]}],"type":"unorderedList"},{"anchor":"Small-size-behavior","type":"heading","text":"Small size behavior","level":2},{"inlineContent":[{"text":"When the list item is displayed in small size (via the ","type":"text"},{"type":"codeVoice","code":".misoListItemSize(.small)"},{"text":" modifier),","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"overline"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"extraLabel"},{"text":" properties are ","type":"text"},{"inlineContent":[{"text":"automatically hidden","type":"text"}],"type":"strong"},{"text":" to ensure a compact layout.","type":"text"},{"text":" ","type":"text"},{"text":"Only the ","type":"text"},{"type":"codeVoice","code":"label"},{"text":", ","type":"text"},{"type":"codeVoice","code":"description"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"helperText"},{"text":" remain visible.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"bottomSlot"},{"text":" is also ","type":"text"},{"inlineContent":[{"text":"automatically hidden","type":"text"}],"type":"strong"},{"text":", but the ","type":"text"},{"type":"codeVoice","code":"textSlot"},{"text":" remains displayed.","type":"text"}],"type":"paragraph"},{"code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    MISOStaticListItem(data: MISOListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .misoListItemSize(.small)"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"inlineContent":[{"text":"OUDS 3.0.0","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Since"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/misocomponents\/misolistitemdata"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Slot"],"generated":true,"title":"Structures","anchor":"Structures"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibility