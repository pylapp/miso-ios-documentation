{"abstract":[{"text":"Represents the main content displayed within a list item component such as","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData"},"sections":[],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Slot"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:overline:tableName:bundle:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(key:tableName:bundle:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibilityLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:accessibilityLabel:overline:description:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:hasBoldLabel:description:overline:extraLabel:helperText:textSlot:bottomSlot:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/init(label:overline:hasBoldLabel:description:extraLabel:helperText:textSlot:bottomSlot:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Label"],"anchor":"Enumerations","title":"Enumerations","generated":true}],"variants":[{"paths":["\/documentation\/misocomponents\/misolistitemdata"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MISOListItemData","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData"},{"type":"text","text":" groups all the text-based information that a list item can display:"},{"text":" ","type":"text"},{"type":"text","text":"a mandatory label (either a "},{"type":"codeVoice","code":"String"},{"type":"text","text":" or a custom "},{"type":"codeVoice","code":"View"},{"text":"), and optional description, overline,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"extra label, and helper text, and slots."}]},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"code":["    \/\/ Minimal: label only (String)","    let data = MISOListItemData(label: \"Label\")","","    \/\/ Label with bold style","    let data = MISOListItemData(label: \"Label\", hasBoldLabel: true)","","    \/\/ Custom view as label with accessibility label","    let data = MISOListItemData(","        label: HStack {","            Image(systemName: \"star.fill\")","            Text(\"Custom Label\")","        },","        accessibilityLabel: \"Favorite Custom Label\"","    )","","    \/\/ Full content with text label","    let data = MISOListItemData(","        label: \"Label\",","        hasBoldLabel: false,","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Full content with custom view label","    let data = MISOListItemData(","        label: VStack(alignment: .leading) {","            Text(\"Title\").font(.headline)","            Text(\"Subtitle\").font(.caption)","        },","        accessibilityLabel: \"Title, Subtitle\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\",","        helperText: \"Helper text providing guidance\"","    )","","    \/\/ Overline as a user-styled rich text (AttributedString)","    \/\/ Same \"overline\" parameter name as the String variant, disambiguated by the value's type.","    let data = MISOListItemData(","        label: \"Label\",","        overline: .from(text: \"Overline\",","                        foregroundColor: theme.colors.contentBrandPrimary.color(for: colorScheme),","                        font: someFont)","    )","","    \/\/ Usage with a static list item","    MISOStaticListItem(data: data)","","    \/\/ Usage with a navigation list item","    MISONavigationListItem(data: data) {","        \/\/ Navigate to next screen","    }","","    \/\/ With slot (displayed under texts, before helper text)","    let dataWithSlot = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )","","    \/\/ With text slot and bottom slot (bottom slot displayed under text slot, before helper text)","    let dataWithBothSlots = MISOListItemData(","        label: \"Label\",","        textSlot: MISOListItemData.Slot { Text(\"Slot content\") },","        bottomSlot: MISOListItemData.Slot { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )"],"type":"codeListing","syntax":"swift"},{"anchor":"Custom-view-label","text":"Custom view label","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When providing a custom view as label:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"hasBoldLabel","type":"codeVoice"},{"type":"text","text":" property is not applicable; all styling is controlled by the provided view."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must provide an "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" parameter so that Voice Over can vocalize the label."},{"type":"text","text":" "},{"type":"text","text":"This "},{"code":"accessibilityLabel","type":"codeVoice"},{"type":"text","text":" is used in the combined accessibility label of the list item text container."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"You must also check the accessibility of your custom views (navigation with switch control and full keyboard access, dynamic types, contrast ratios)"}],"type":"paragraph"}]}]},{"anchor":"Small-size-behavior","text":"Small size behavior","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the list item is displayed in small size (via the "},{"code":".misoListItemSize(.small)","type":"codeVoice"},{"type":"text","text":" modifier),"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"overline","type":"codeVoice"},{"type":"text","text":" and "},{"code":"extraLabel","type":"codeVoice"},{"type":"text","text":" properties are "},{"type":"strong","inlineContent":[{"text":"automatically hidden","type":"text"}]},{"type":"text","text":" to ensure a compact layout."},{"type":"text","text":" "},{"type":"text","text":"Only the "},{"code":"label","type":"codeVoice"},{"type":"text","text":", "},{"code":"description","type":"codeVoice"},{"type":"text","text":", and "},{"code":"helperText","type":"codeVoice"},{"type":"text","text":" remain visible."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"bottomSlot","type":"codeVoice"},{"type":"text","text":" is also "},{"type":"strong","inlineContent":[{"text":"automatically hidden","type":"text"}]},{"type":"text","text":", but the "},{"code":"textSlot","type":"codeVoice"},{"type":"text","text":" remains displayed."}]},{"code":["    \/\/ overline, extraLabel and bottomSlot will not be displayed","    MISOStaticListItem(data: MISOListItemData(","        label: \"Label\",","        overline: \"Hidden in small\",","        extraLabel: \"Also hidden in small\"","    ))","    .misoListItemSize(.small)"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}],"name":"Since","type":"aside"}]}],"metadata":{"modules":[{"name":"Components"}],"role":"symbol","title":"MISOListItemData","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MISOListItemData"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MISOListItemData","kind":"identifier"}],"externalID":"s:14MISOComponents16MISOListItemDataV","roleHeading":"Structure","platforms":[{"beta":false,"name":"iOS","unavailable":false,"deprecated":false,"introducedAt":"15.0"},{"unavailable":false,"beta":false,"name":"macOS","introducedAt":"13.0","deprecated":false},{"name":"tvOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"16.0"},{"name":"visionOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"1.0"},{"name":"watchOS","unavailable":false,"deprecated":false,"beta":false,"introducedAt":"11.0"}]},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOListItemData/init(label:accessibilityLabel:overline:description:extraLabel:helperText:textSlot:bottomSlot:)":{"url":"\/documentation\/misocomponents\/misolistitemdata\/init(label:accessibilitylabel:overline:descrip