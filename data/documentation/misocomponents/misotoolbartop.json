{"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"text":"The top toolbar (aka ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation bar"}],"type":"emphasis"},{"text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information","type":"text"},{"text":" ","type":"text"},{"text":"and controls related to the current view.","type":"text"},{"text":" ","type":"text"},{"text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions.","type":"text"},{"text":" ","type":"text"},{"text":"It can contain leading, principal (center, single item only), and trailing actions.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarTop","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": If an item is placed in principal position, the subtitle is never displayed (whatever "},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" is), because"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI’s "},{"code":".principal","type":"codeVoice"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"code":".navigationSubtitle()","type":"codeVoice"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"code":"hasLargeTitle","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}],"type":"paragraph"},{"anchor":"Appearances","text":"Appearances","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"But for buttons items they will remain isolated"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The OS can apply another style for the back button"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Globaly the appearence of the * navigation bar* elements is changed by the "},{"code":"misoNavigationBarAppearance","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"helper of "},{"code":"View","type":"codeVoice"},{"type":"text","text":" that must be applyed on the root view of the "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":" for example."}],"type":"paragraph"},{"anchor":"Technical-constraints","text":"Technical constraints","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:"}],"type":"paragraph"},{"code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"type":"codeListing","syntax":"swift"},{"anchor":"Platform-considerations","text":"Platform considerations","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The component is available on iOS, iPadOS, and visionOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}],"type":"paragraph"}]}]},{"anchor":"Badges-uses","text":"Badges uses","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"For iOS 26 with Liquid Glass, the system badge is used because the MISO badge component does not provide a suitable"},{"type":"text","text":" "},{"type":"text","text":"rendering with the glassified effect applied on the top toolbar."},{"type":"text","text":" "},{"type":"text","text":"For iOS until 18 and without Liquid Glass  MISO badge component is always used."}],"type":"paragraph"},{"anchor":"Code-sample","text":"Code sample","type":"heading","level":2},{"code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                MISOToolBarItem(navigation: .back())","            },","            principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","            trailingItems: {","                MISOToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A "},{"code":"View","type":"codeVoice"},{"type":"text","text":" helper can also be used to apply a SwiftUI toolbar configuration."}],"type":"paragraph"},{"code":["    toolBarTop(_:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.1.0 (Figma component design version)"}]}],"type":"aside","name":"Version"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 1.4.0"}]}],"type":"aside","name":"Since"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop"},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo"}],"metadata":{"roleHeading":"Structure","role":"symbol","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOToolBarTop"}],"platforms":[{"name":"iOS","deprecated":false,"beta":false,"introducedAt":"15.0","unavailable":false},{"name":"visionOS","deprecated":false,"beta":false,"introducedAt":"1.0","unavailable":false}],"title":"MISOToolBarTop","navigatorTitle":[{"kind":"identifier","text":"MISOToolBarTop"}],"externalID":"s:14MISOComponents14MISOToolBarTopV","modules":[{"name":"Components"}]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/M