{"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/body(content:)"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/ViewModifier-Implementations"]}],"metadata":{"externalID":"s:14MISOComponents14MISOToolBarTopV","modules":[{"name":"Components"}],"platforms":[{"introducedAt":"15.0","beta":false,"deprecated":false,"unavailable":false,"name":"iOS"},{"introducedAt":"1.0","beta":false,"deprecated":false,"unavailable":false,"name":"visionOS"}],"navigatorTitle":[{"kind":"identifier","text":"MISOToolBarTop"}],"role":"symbol","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOToolBarTop"}],"title":"MISOToolBarTop","roleHeading":"Structure"},"abstract":[{"type":"text","text":"The top toolbar (aka "},{"inlineContent":[{"text":"navigation bar","type":"text"}],"type":"emphasis"},{"type":"text","text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information"},{"type":"text","text":" "},{"type":"text","text":"and controls related to the current view."},{"type":"text","text":" "},{"type":"text","text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions."},{"type":"text","text":" "},{"type":"text","text":"It can contain leading, principal (center, single item only), and trailing actions."}],"variants":[{"paths":["\/documentation\/misocomponents\/misotoolbartop"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarTop","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Warning"}],"type":"strong"},{"text":": If an item is placed in principal position, the subtitle is never displayed (whatever ","type":"text"},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because"},{"text":" ","type":"text"},{"text":"SwiftUI’s ","type":"text"},{"code":".principal","type":"codeVoice"},{"text":" placement only replaces the inline compact bar title, not ","type":"text"},{"code":".navigationSubtitle()","type":"codeVoice"},{"text":" (iOS 26+), which would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (in that case it appears below the bar, in large title mode, not inside it).","type":"text"}],"type":"paragraph"},{"level":2,"text":"Appearances","anchor":"Appearances","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)"}]}]},{"content":[{"inlineContent":[{"text":"But for buttons items they will remain isolated","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The OS can apply another style for the back button","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Globaly the appearence of the * navigation bar* elements is changed by the "},{"type":"codeVoice","code":"misoNavigationBarAppearance"},{"type":"text","text":" "},{"type":"text","text":"helper of "},{"type":"codeVoice","code":"View"},{"type":"text","text":" that must be applyed on the root view of the "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":" for example."}]},{"level":2,"text":"Technical constraints","anchor":"Technical-constraints","type":"heading"},{"inlineContent":[{"text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"]},{"text":"Platform considerations","type":"heading","level":2,"anchor":"Platform-considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The component is available on iOS, iPadOS, and visionOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The component is not available for watchOS, tvOS and macOS","type":"text"}],"type":"paragraph"}]}]},{"text":"Badges uses","level":2,"anchor":"Badges-uses","type":"heading"},{"inlineContent":[{"type":"text","text":"For iOS 26 with Liquid Glass, the system badge is used because the MISO badge component does not provide a suitable"},{"type":"text","text":" "},{"type":"text","text":"rendering with the glassified effect applied on the top toolbar."},{"type":"text","text":" "},{"type":"text","text":"For iOS until 18 and without Liquid Glass  MISO badge component is always used."}],"type":"paragraph"},{"type":"heading","anchor":"Code-sample","level":2,"text":"Code sample"},{"code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                MISOToolBarItem(navigation: .back())","            },","            principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","            trailingItems: {","                MISOToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"View","type":"codeVoice"},{"text":" helper can also be used to apply a SwiftUI toolbar configuration.","type":"text"}]},{"type":"codeListing","code":["    toolBarTop(_:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"syntax":"swift"},{"name":"Version","type":"aside","content":[{"inlineContent":[{"text":"1.1.0 (Figma component design version)","type":"text"}],"type":"paragraph"}],"style":"note"},{"content":[{"inlineContent":[{"type":"text","text":"OUDS 1.4.0"}],"type":"paragraph"}],"name":"Since","style":"note","type":"aside"}]}],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"]}],"references":{"ic_folder_categories.png":{"type":"image","alt":null,"identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://MISOComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"},"doc://MISOComponents/s8SendableP":{"identifier":"doc:\/\/MISOComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://MISOComponents/documentation/MISOComponents/MISOToolBarTop/init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)":{"role":"symbol","title":"init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"title","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kin