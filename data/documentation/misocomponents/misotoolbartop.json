{"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/body(content:)"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/ViewModifier-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"kind":"symbol","variants":[{"paths":["\/documentation\/misocomponents\/misotoolbartop"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop","interfaceLanguage":"swift"},"abstract":[{"text":"The top toolbar (aka ","type":"text"},{"inlineContent":[{"text":"navigation bar","type":"text"}],"type":"emphasis"},{"text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information","type":"text"},{"text":" ","type":"text"},{"text":"and controls related to the current view.","type":"text"},{"text":" ","type":"text"},{"text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions.","type":"text"},{"text":" ","type":"text"},{"text":"It can contain leading, principal (center, single item only), and trailing actions.","type":"text"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarTop","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"text":": If an item is placed in principal position, the subtitle is never displayed (whatever ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" is), because","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI’s ","type":"text"},{"code":".principal","type":"codeVoice"},{"text":" placement only replaces the inline compact bar title, not ","type":"text"},{"code":".navigationSubtitle()","type":"codeVoice"},{"text":" (iOS 26+), which would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if ","type":"text"},{"code":"hasLargeTitle","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (in that case it appears below the bar, in large title mode, not inside it).","type":"text"}],"type":"paragraph"},{"text":"Appearances","anchor":"Appearances","level":2,"type":"heading"},{"inlineContent":[{"text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"But for buttons items they will remain isolated"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The OS can apply another style for the back button"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Globaly the appearence of the * navigation bar* elements is changed by the ","type":"text"},{"code":"misoNavigationBarAppearance","type":"codeVoice"},{"text":" ","type":"text"},{"text":"helper of ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" that must be applyed on the root view of the ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":" for example.","type":"text"}],"type":"paragraph"},{"text":"Technical constraints","anchor":"Technical-constraints","level":2,"type":"heading"},{"inlineContent":[{"text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"type":"codeListing"},{"text":"Platform considerations","anchor":"Platform-considerations","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is available on iOS, iPadOS, and visionOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}]}]}],"type":"unorderedList"},{"text":"Badges uses","anchor":"Badges-uses","level":2,"type":"heading"},{"inlineContent":[{"text":"For iOS 26 with Liquid Glass, the system badge is used because the MISO badge component does not provide a suitable","type":"text"},{"text":" ","type":"text"},{"text":"rendering with the glassified effect applied on the top toolbar.","type":"text"},{"text":" ","type":"text"},{"text":"For iOS until 18 and without Liquid Glass  MISO badge component is always used.","type":"text"}],"type":"paragraph"},{"text":"Code sample","anchor":"Code-sample","level":2,"type":"heading"},{"syntax":"swift","code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                MISOToolBarItem(navigation: .back())","            },","            principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","            trailingItems: {","                MISOToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"type":"codeListing"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" helper can also be used to apply a SwiftUI toolbar configuration.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    toolBarTop(_:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"1.1.0 (Figma component design version)","type":"text"}]}],"name":"Version","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 1.4.0","type":"text"}]}],"name":"Since","style":"note","type":"aside"}]}],"sections":[],"metadata":{"roleHeading":"Structure","title":"MISOToolBarTop","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarTop","kind"