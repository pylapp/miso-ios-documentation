{"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/body(content:)"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/ViewModifier-Implementations"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misotoolbartop"]}],"kind":"symbol","relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"]}],"abstract":[{"type":"text","text":"The top toolbar (aka "},{"type":"emphasis","inlineContent":[{"text":"navigation bar","type":"text"}]},{"type":"text","text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information"},{"type":"text","text":" "},{"type":"text","text":"and controls related to the current view."},{"type":"text","text":" "},{"type":"text","text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions."},{"type":"text","text":" "},{"type":"text","text":"It can contain leading, principal (center, single item only), and trailing actions."}],"metadata":{"platforms":[{"deprecated":false,"unavailable":false,"beta":false,"introducedAt":"15.0","name":"iOS"},{"beta":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"unavailable":false}],"externalID":"s:14MISOComponents14MISOToolBarTopV","role":"symbol","modules":[{"name":"Components"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MISOToolBarTop"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOToolBarTop"}],"title":"MISOToolBarTop","symbolKind":"struct"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarTop","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"text":": If an item is placed in principal position, the subtitle is never displayed (whatever ","type":"text"},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" is), because","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI’s ","type":"text"},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would"},{"type":"text","text":" "},{"type":"text","text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (in that case it appears below the bar, in large title mode, not inside it)."}],"type":"paragraph"},{"anchor":"Appearances","text":"Appearances","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"But for buttons items they will remain isolated","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The text can be truncated if there is not enough remaining space"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The OS can apply another style for the back button","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Globaly the appearence of the * navigation bar* elements is changed by the ","type":"text"},{"code":"misoNavigationBarAppearance","type":"codeVoice"},{"text":" ","type":"text"},{"text":"helper of ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" that must be applyed on the root view of the ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":" for example.","type":"text"}]},{"level":2,"type":"heading","anchor":"Technical-constraints","text":"Technical constraints"},{"type":"paragraph","inlineContent":[{"text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"]},{"level":2,"type":"heading","anchor":"Platform-considerations","text":"Platform considerations"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The component is available on iOS, iPadOS, and visionOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for watchOS, tvOS and macOS"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Badges-uses","text":"Badges uses"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For iOS 26 with Liquid Glass, the system badge is used because the MISO badge component does not provide a suitable"},{"text":" ","type":"text"},{"text":"rendering with the glassified effect applied on the top toolbar.","type":"text"},{"text":" ","type":"text"},{"text":"For iOS until 18 and without Liquid Glass  MISO badge component is always used.","type":"text"}]},{"type":"heading","level":2,"text":"Code sample","anchor":"Code-sample"},{"type":"codeListing","syntax":"swift","code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                MISOToolBarItem(navigation: .back())","            },","            principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","            trailingItems: {","                MISOToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"View"},{"type":"text","text":" helper can also be used to apply a SwiftUI toolbar configuration."}]},{"type":"codeListing","syntax":"swift","code":["    toolBarTop(_:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.1.0 (Figma component design version)"}]}],"style":"note","name":"Version"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 1.4.0"}]}],"style":"note","name":"Since"}],"kind":"content"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop","interfaceLanguage":"swift"},"references":{"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null,"type":"image"},"doc://MISOComponents/7SwiftUI12ViewModifierP":{"title":"SwiftUICore.ViewModifier","identifier":"doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP","type":"unresolvable"},"doc://MISOComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP"},"doc://MISOComponents/documentation/MISOComponents/MISOToolBarTop/ViewModifier-Implementations":{"title":"ViewModifier Implementations","kind":"article","url":"\/documentation\/misocomponents\/misotoolbartop\/viewmodifier-implementations","role":"collectionGroup","type":"topic","abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/ViewModifier-Implementations"},"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","url":"\/documentation\/misocomponents","type":"topic","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"title":"Components"},"doc://MISOComponents/documentation