{"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarTop","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Warning"}],"type":"strong"},{"text":": If an item is placed in principal position, the subtitle is never displayed (whatever ","type":"text"},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" is), because","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI’s ","type":"text"},{"type":"codeVoice","code":".principal"},{"text":" placement only replaces the inline compact bar title, not ","type":"text"},{"type":"codeVoice","code":".navigationSubtitle()"},{"text":" (iOS 26+), which would","type":"text"},{"text":" ","type":"text"},{"text":"otherwise keep rendering next to the item with no visible title next to it. The title itself is displayed only if ","type":"text"},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" (in that case it appears below the bar, in large title mode, not inside it).","type":"text"}]},{"type":"heading","text":"Appearances","level":2,"anchor":"Appearances"},{"type":"paragraph","inlineContent":[{"text":"With Liquid Glass \/ iOS 26+ the OS will change the rendering of the toolbar items depending to the context:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The OS can group the items of same types in one group with kind of rectangle (e.g. views with menus)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"But for buttons items they will remain isolated","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The placement of the title can be leading or centered depending to the length of the text"}]}]},{"content":[{"inlineContent":[{"text":"The text can be truncated if there is not enough remaining space","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The OS can apply another style for the back button","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Without Liquid Glass \/ iOS 18 and lower, the OS won’t change that much the style of the toolbar items, Items won’t be visually grouped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Globaly the appearence of the * navigation bar* elements is changed by the "},{"type":"codeVoice","code":"misoNavigationBarAppearance"},{"type":"text","text":" "},{"type":"text","text":"helper of "},{"type":"codeVoice","code":"View"},{"type":"text","text":" that must be applyed on the root view of the "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" for example."}]},{"level":2,"type":"heading","anchor":"Technical-constraints","text":"Technical constraints"},{"type":"paragraph","inlineContent":[{"text":"To be sure for iOS 18 and lower the back buttton and text have the good color, in your main view apply the following accent color:","type":"text"}]},{"code":["    struct AppMainView: View {","        var body: some View {","            ContentView()","                .accentColor(theme.colors.contentDefault)","        }","    }"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Platform-considerations","text":"Platform considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is available on iOS, iPadOS, and visionOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is not available for watchOS, tvOS and macOS","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Badges-uses","text":"Badges uses"},{"type":"paragraph","inlineContent":[{"text":"For iOS 26 with Liquid Glass, the system badge is used because the MISO badge component does not provide a suitable","type":"text"},{"text":" ","type":"text"},{"text":"rendering with the glassified effect applied on the top toolbar.","type":"text"},{"text":" ","type":"text"},{"text":"For iOS until 18 and without Liquid Glass  MISO badge component is always used.","type":"text"}]},{"level":2,"type":"heading","anchor":"Code-sample","text":"Code sample"},{"code":["    ContentView()","        .toolBarTop(\"Title\",","            leadingItems: {","                MISOToolBarItem(navigation: .back())","            },","            principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","            trailingItems: {","                MISOToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","            }","        )"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"View","type":"codeVoice"},{"text":" helper can also be used to apply a SwiftUI toolbar configuration.","type":"text"}]},{"syntax":"swift","code":["    toolBarTop(_:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"type":"codeListing"},{"name":"Version","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.1.0 (Figma component design version)"}],"type":"paragraph"}],"type":"aside"},{"name":"Since","style":"note","content":[{"inlineContent":[{"text":"OUDS 1.4.0","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"],"type":"conformsTo"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/body(content:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop\/ViewModifier-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"sections":[],"metadata":{"role":"symbol","modules":[{"name":"Components"}],"externalID":"s:14MISOComponents14MISOToolBarTopV","title":"MISOToolBarTop","symbolKind":"struct","navigatorTitle":[{"text":"MISOToolBarTop","kind":"identifier"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarTop","kind":"identifier"}],"platforms":[{"name":"iOS","unavailable":false,"introducedAt":"15.0","deprecated":false,"beta":false},{"name":"visionOS","unavailable":false,"introducedAt":"1.0","deprecated":false,"beta":false}]},"abstract":[{"text":"The top toolbar (aka ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"navigation bar","type":"text"}]},{"text":" on iOS and iPadOS 18 and lower) sits at the top of the screen and provides contextual information","type":"text"},{"text":" ","type":"text"},{"text":"and controls related to the current view.","type":"text"},{"text":" ","type":"text"},{"text":"It typically displays the page title, and may include navigation actions such as “Back” or “Close” as well as supplementary actions.","type":"text"},{"text":" ","type":"text"},{"text":"It can contain leading, principal (center, single item only), and trailing actions.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarTop"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misotoolbartop"]}],"references":{"ic_folder_categories.png":{"type":"image","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"identifier":"ic_folder_categories.png"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/misocomponents","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","title":"Components","role":"collection","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOToolBarTop/init(title:hasLargeTitle:subtitle:leadingItems:principalItem:trailingItems:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"title"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"hasLargeTitle"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"subtitle"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"leadingItems"},{