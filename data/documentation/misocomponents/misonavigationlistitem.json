ntent":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelStrong(String))"},{"type":"text","text":": An emphasized (bold) label"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".text(.labelAndExtraLabel(String, String))","type":"codeVoice"},{"text":": A label with an additional extra label below","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".badge(.count(MISOBadgeCount)"},{"type":"text","text":": A badge with count"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".badge(.standard(MISOBadgeStandard)"},{"type":"text","text":": A badge with standard status"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".tag(MISOTag)","type":"codeVoice"},{"type":"text","text":": A tag for categorization"}]}]},{"content":[{"inlineContent":[{"code":".icon(MISOListItemIcon)","type":"codeVoice"},{"type":"text","text":": A status or custom icon"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".image(MISOListItemImage)"},{"text":":  A static image asset","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".flag(MISOListItemFlag)","type":"codeVoice"},{"text":": A country flag image","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".avatar(MISOListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".custom { ... }","type":"codeVoice"},{"type":"text","text":": Any custom SwiftUI view"}]}]}]},{"level":2,"type":"heading","text":"View modifiers","anchor":"View-modifiers"},{"type":"paragraph","inlineContent":[{"text":"Several view modifiers can be applied to customize the appearance and layout of list items:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOC