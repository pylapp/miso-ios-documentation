ding element is automatically hidden."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".external","type":"codeVoice"}]},{"type":"text","text":": An external link icon indicating that the action opens content outside the app"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a URL in a browser or an external viewer)."}]}]}]},{"type":"heading","level":2,"anchor":"Code-samples","text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Simple navigable list item with forward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Next screen\")","    ) {","        \/\/ Navigate to next screen","    }","","    \/\/ List item with external navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Open website\"),","        indicatorType: .external","    ) {","        openURL(url)","    }","","    \/\/ List item with backward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Go back\"),","        indicatorType: .previous","    ) {","        \/\/ Navigate back","    }","","    \/\/ List item with leading avatar, trailing text, and forward navigation","    let avatar = MISOListItemAvatar(type: .icon, size: .medium)","","    MISONavigationListItem(","        data: MISOListItemData(label: \"Profile\", description: \"View your profile\"),","        leading: .avatar(avatar),","        trailing: .text(.labelMuted(Text(\"Details\")))","    ) {","        \/\/ Navigate to profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    MISONavigationListItem(","        data: MISOListItemData(label: \"SMS credit\"),","        trailing: .custom {","            MISOCircularProgressIndicator(progress: 0.75)","        }","    ) {","        \/\/ Navigate to SMS credit details","    }","","    \/\/ List item with slot (displayed under texts, before helper text)","    MISONa