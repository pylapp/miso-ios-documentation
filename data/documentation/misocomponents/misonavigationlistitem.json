{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A list item component used to display a row of interactive, navigable content within a list.","type":"text"}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISONavigationListItem","kind":"identifier"}],"platforms":["macOS"]}]},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","isActive":true},{"type":"text","text":" is an interactive variant of the list item that triggers an action when tapped."},{"type":"text","text":" "},{"type":"text","text":"It displays a navigation indicator (chevron for next\/previous, or an external link icon)"},{"type":"text","text":" "},{"type":"text","text":"to communicate the type of navigation to the user."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The item typically contains a label, and optionally a description, an overline, an extra label,"},{"type":"text","text":" "},{"type":"text","text":"a text slot, a bottom slot, and a helper text — all provided through "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It can also include an optional leading element (such as an icon, image, avatar, flag or custom view)"},{"type":"text","text":" "},{"type":"text","text":"and an optional trailing element (such as a text, badge, tag, icon, image, avatar, flag or custom view)"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For non-interactive, display-only list items, see "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem","isActive":true},{"type":"text","text":"."}]},{"anchor":"Indicator-types","type":"heading","level":2,"text":"Indicator types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItemIndicatorType","isActive":true},{"type":"text","text":" enum defines the visual indicator and semantic meaning of the navigation:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".next"}],"type":"strong"},{"type":"text","text":" (default): A forward chevron indicating in-app navigation to a next screen."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".previous","type":"codeVoice"}],"type":"strong"},{"text":": A backward chevron indicating in-app navigation to a previous screen.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"When using "},{"type":"codeVoice","code":".previous"},{"text":", the leading element is automatically hidden.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".external"}],"type":"strong"},{"text":": An external link icon indicating that the action opens content outside the app","type":"text"},{"text":" ","type":"text"},{"text":"(e.g. a URL in a browser or an external viewer).","type":"text"}],"type":"paragraph"}]}]},{"text":"Code samples","anchor":"Code-samples","type":"heading","level":2},{"code":["    \/\/ Simple navigable list item with forward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Next screen\")","    ) {","        \/\/ Navigate to next screen","    }","","    \/\/ List item with external navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Open website\"),","        indicatorType: .external","    ) {","        openURL(url)","    }","","    \/\/ List item with backward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Go back\"),","        indicatorType: .previous","    ) {","        \/\/ Navigate back","    }","","    \/\/ List item with leading avatar, trailing text, and forward navigation","    let avatar = MISOListItemAvatar(type: .icon, size: .medium)","","    MISONavigationListItem(","        data: MISOListItemData(label: \"Profile\", description: \"View your profile\"),","        leading: .avatar(avatar),","        trailing: .text(.labelMuted(Text(\"Details\")))","    ) {","        \/\/ Navigate to profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    MISONavigationListItem(","        data: MISOListItemData(label: \"SMS credit\"),","        trailing: .custom {","            MISOCircularProgressIndicator(progress: 0.75)","        }","    ) {","        \/\/ Navigate to SMS credit details","    }","","    \/\/ List item with slot (displayed under texts, before helper text)","    MISONavigationListItem(","        data: MISOListItemData(","            label: \"Settings\",","            textSlot: { Text(\"Configure options\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to settings","    }","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    MISONavigationListItem(","        data: MISOListItemData(","            label: \"Profile\",","            bottomSlot: { Text(\"Additional info\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to profile","    }"],"type":"codeListing","syntax":"swift"},{"text":"Leading elements","anchor":"Leading-elements","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The leading position (before the texts) accepts one optional element via "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemLeading","isActive":true},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".icon(MISOListItemIcon)","type":"codeVoice"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".image(MISOListItemImage)"},{"type":"text","text":": A static image asset"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".flag(MISOListItemFlag)","type":"codeVoice"},{"type":"text","text":": A country flag image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".avatar(MISOListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".custom { ... }"},{"type":"text","text":": Any custom SwiftUI view (e.g. a gauge)"}],"type":"paragraph"}]}]},{"text":"Trailing elements","anchor":"Trailing-elements","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The trailing position (after the texts) accepts one optional element via ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemTrailing","type":"reference","isActive":true},{"text":", like:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.label(String))"},{"type":"text","text":": A default-styled label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelMuted(String))"},{"type":"text","text":": A muted (secondary) label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelStrong(String))"},{"type":"text","text":": An emphasized (bold) label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelAndExtraLabel(String, String))"},{"type":"text","text":": A label with an additional extra label below"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".badge(.count(MISOBadgeCount)"},{"type":"text","text":": A badge with count"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".badge(.standard(MISOBadgeStandard)"},{"type":"text","text":": A badge with standard status"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".tag(MISOTag)"},{"type":"text","text":": A tag for categorization"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".icon(MISOListItemIcon)"},{"type":"text","text":": A status or custom icon"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".image(MISOListItemImage)"},{"type":"text","text":":  A static image asset"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".flag(MISOListItemFlag)"},{"type":"text","text":": A country flag image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".avatar(MISOListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".custom { ... }"},{"type":"text","text":": Any custom SwiftUI view"}],"type":"paragraph"}]}]},{"text":"View modifiers","anchor":"View-modifiers","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Several view modifiers can be applied to customize the appearance and layout of list items:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemSize(_:)","isActive":