d an optional trailing element (such as a text, badge, tag, icon, image, avatar, flag or custom view)"}]},{"type":"paragraph","inlineContent":[{"text":"For non-interactive, display-only list items, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Indicator types","anchor":"Indicator-types"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItemIndicatorType","type":"reference"},{"text":" enum defines the visual indicator and semantic meaning of the navigation:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".next","type":"codeVoice"}]},{"type":"text","text":" (default): A forward chevron indicating in-app navigation to a next screen."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".previous","type":"codeVoice"}]},{"type":"text","text":": A backward chevron indicating in-app navigation to a previous screen."},{"type":"text","text":" "},{"type":"text","text":"When using "},{"type":"codeVoice","code":".previous"},{"type":"text","text":", the leading element is automatically hidden."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".external","type":"codeVoice"}]},{"type":"text","text":": An external link icon indicating that the action opens content outside the app"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a URL in a browser or an external viewer)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Code samples","anchor":"Code-samples","level":2},{"type":"codeListing","syntax":"swift","code":["    \/\/ Simple navigable list item with forward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Next screen\")","    ) {","        \/\/ Navigate to next screen","    }","","    \/\/ List item with external navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Open website\"),","        indicatorType: .external","    ) {","        openURL(url)","    }","","    \/\/ List item with backward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Go back\"),","        indicatorType: .previous","    ) {","        \/\/ Navigate back","    }","","    \/\/ List item with leading avatar, trailing text, and forward navigation","    let avatar = MISOListItemAvatar(type: .icon, size: .medium)","","    MISONavigationListItem(","        data: MISOListItemData(label: \"Profile\", description: \"View your profile\"),","        leading: .avatar(avatar),","        trailing: .text(.labelMuted(Text(\"Details\")))","    ) {","        \/\/ Navigate to profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    MISONavigationListItem(","        data: MISOListItemData(label: \"SMS credit\"),","        trailing: .custom {","            MISOCircularProgressIndicator(progress: 0.75)","        }","    ) {","        \/\/ Navigate to SMS credit details","    }","","    \/\/ List item with slot (displayed under texts, before helper text)","    MISONavigationListItem(","        data: MISOListItemData(","            label: \"Settings\",","            textSlot: { Text(\"Configure options\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to settings","    }","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    MISONavigationListItem(","        data: MISOListItemData(","            label: \"Profile\",","            bottomSlot: { Text(\"Additional info\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to profile","    }"]},{"type"