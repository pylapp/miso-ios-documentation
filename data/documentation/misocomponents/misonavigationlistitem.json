{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misonavigationlistitem"]}],"kind":"symbol","topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem\/init(data:indicatorType:leading:trailing:action:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem\/body"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem\/View-Implementations"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"beta":false,"introducedAt":"15.0"},{"deprecated":false,"name":"macOS","unavailable":false,"beta":false,"introducedAt":"13.0"},{"deprecated":false,"name":"tvOS","unavailable":false,"beta":false,"introducedAt":"16.0"},{"deprecated":false,"name":"visionOS","unavailable":false,"beta":false,"introducedAt":"1.0"},{"deprecated":false,"name":"watchOS","unavailable":false,"beta":false,"introducedAt":"11.0"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISONavigationListItem"}],"navigatorTitle":[{"kind":"identifier","text":"MISONavigationListItem"}],"symbolKind":"struct","roleHeading":"Structure","externalID":"s:14MISOComponents22MISONavigationListItemV","role":"symbol","modules":[{"name":"Components"}],"title":"MISONavigationListItem"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem"},"abstract":[{"type":"text","text":"A list item component used to display a row of interactive, navigable content within a list."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISONavigationListItem"}]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","isActive":true},{"type":"text","text":" is an interactive variant of the list item that triggers an action when tapped."},{"type":"text","text":" "},{"type":"text","text":"It displays a navigation indicator (chevron for next\/previous, or an external link icon)"},{"type":"text","text":" "},{"type":"text","text":"to communicate the type of navigation to the user."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The item typically contains a label, and optionally a description, an overline, an extra label,"},{"type":"text","text":" "},{"type":"text","text":"a text slot, a bottom slot, and a helper text — all provided through "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It can also include an optional leading element (such as an icon, image, avatar, flag or custom view)"},{"type":"text","text":" "},{"type":"text","text":"and an optional trailing element (such as a text, badge, tag, icon, image, avatar, flag or custom view)"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For non-interactive, display-only list items, see "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Indicator-types","type":"heading","level":2,"text":"Indicator types"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItemIndicatorType","isActive":true},{"type":"text","text":" enum defines the visual indicator and semantic meaning of the navigation:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".next"}]},{"type":"text","text":" (default): A forward chevron indicating in-app navigation to a next screen."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".previous"}]},{"type":"text","text":": A backward chevron indicating in-app navigation to a previous screen."},{"type":"text","text":" "},{"type":"text","text":"When using "},{"type":"codeVoice","code":".previous"},{"type":"text","text":", the leading element is automatically hidden."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".external"}]},{"type":"text","text":": An external link icon indicating that the action opens content outside the app"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a URL in a browser or an external viewer)."}]}]}]},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Simple navigable list item with forward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Next screen\")","    ) {","        \/\/ Navigate to next screen","    }","","    \/\/ List item with external navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Open website\"),","        indicatorType: .external","    ) {","        openURL(url)","    }","","    \/\/ List item with backward navigation","    MISONavigationListItem(","        data: MISOListItemData(label: \"Go back\"),","        indicatorType: .previous","    ) {","        \/\/ Navigate back","    }","","    \/\/ List item with leading avatar, trailing text, and forward navigation","    let avatar = MISOListItemAvatar(type: .icon, size: .medium)","","    MISONavigationListItem(","        data: MISOListItemData(label: \"Profile\", description: \"View your profile\"),","        leading: .avatar(avatar),","        trailing: .text(.labelMuted(Text(\"Details\")))","    ) {","        \/\/ Navigate to profile","    }","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    MISONavigationListItem(","        data: MISOListItemData(label: \"SMS credit\"),","        trailing: .custom {","            MISOCircularProgressIndicator(progress: 0.75)","        }","    ) {","        \/\/ Navigate to SMS credit details","    }","","    \/\/ List item with slot (displayed under texts, before helper text)","    MISONavigationListItem(","        data: MISOListItemData(","            label: \"Settings\",","            textSlot: { Text(\"Configure options\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to settings","    }","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    MISONavigationListItem(","        data: MISOListItemData(","            label: \"Profile\",","            bottomSlot: { Text(\"Additional info\") },","            helperText: \"Helper text\"","        )","    ) {","        \/\/ Navigate to profile","    }"]},{"anchor":"Leading-elements","type":"heading","level":2,"text":"Leading elements"},{"inlineContent":[{"type":"text","text":"The leading position (before the texts) accepts one optional element via "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemLeading","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".icon(MISOListItemIcon)"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".image(MISOListItemImage)"},{"type":"text","text":": A static image asset"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".flag(MISOListItemFlag)"},{"type":"text","text":": A country flag image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".avatar(MISOListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".custom { ... }"},{"type":"text","text":": Any custom SwiftUI view (e.g. a gauge)"}]}]}]},{"anchor":"Trailing-elements","type":"heading","level":2,"text":"Trailing elements"},{"inlineContent":[{"type":"text","text":"The trailing position (after the texts) accepts one optional element via "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemTrailing","isActive":true},{"type":"text","text":", like:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".text(.label(String))"},{"type":"text","text":": A default-styled label"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".text(.labelMuted(String))"},{"type":"text","text":": A muted (secondary) label"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".text(.labelStrong(String))"},{"type":"text","text":": An emphasized (bold) label"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".text(.labelAndExtraLabel(String, String))"},{"type":"text","text":": A label with an additional extra label below"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".badge(.count(MISOBadgeCount)"},{"type":"text","text":": A badge with count"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".badge(.standard(MISOBadgeStandard)"},{"type":"text","text":": A badge with standard status"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".tag(MISOTag)"},{"type":"text","text":": A tag for categorization"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".icon(MISOListItemIcon)"},{"type":"text","text":": A status or custom icon"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".image(MISOListItemImage)"},{"type":"text","text":":  A static image asset"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".flag(MISOListItemFlag)"},{"type":"text","text":": A country flag image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".avatar(MISOListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".custom { ... }"},{"type":"text","text":": Any custom SwiftUI view"}]}]}]},{"anchor":"View-modifiers","type":"heading","level":2,"text":"View modifiers"},{"inlineContent":[{"type":"text","text":"Several view modifiers can be applied to customize the appearance and layout of list items:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemSize(_:)","isActive":true},{"type":"text","text":" — Sets the size of the item ("},{"type":"codeVoice","code":".standard"},{"type":"text","text":" or "},{"type":"codeVoice","code":".small"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemContainerAlignment(_:)","isActive":true},{"type":"text","text":" — Aligns leading, trailing, and text containers ("},{"type":"codeVoice","code":".top"},{"type":"text","text":" or "},{"type":"codeVoice","code":".center"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemStyle(divider:background:)","isActive":true},{"type":"text","text":" — Applies a item style with optional divider and background."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListCardStyle(_:)","isActive":true},{"type":"text","text":" — Applies a card style on list items."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemRoundedMedia(_:)","isActive":true},{"type":"text","text":" — Defines whether media (images) should be displayed with rounded corners."}]}]}]},{"type":"codeListing","syntax":"swift","code":["    MISONavigationListItem(","        data: MISOListItemData(label: \"Settings\"),","        indicatorType: .next","    ) {","        \/\/ Navigate to settings","    }","    .misoListItemSize(.small)","    .misoListItemContainerAlignment(.top)","    .misoListCardStyle(.outlined)"]},{"anchor":"Accessibility-considerations","type":"heading","level":2,"text":"Accessibility considerations"},{"inlineContent":[{"type":"text","text":"You should test with Voice Over your "},{"code":"MISONavigationListItem","type":"codeVoice"},{"type":"text","text":" to check which parts are vocalized and if they are well vocalized, specially for"},{"type":"text","text":" "},{"type":"text","text":"the avatars, badges, tags and slot views.  Do not vocalize decorative elements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If flags are used, do not suppose users know the flags and add in the texts parts of the "},{"code":"MISONavigationListItem","type":"codeVoice"},{"type":"text","text":" the country or region name."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Be sure the available texts are enough to explain to the users the navigation depending to its indicator type."}],"type":"paragraph"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.0.0 (Figma component design version)"}]}],"name":"Version"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 3.0.0"}]}],"name":"Since"}]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISONavigationListItemIndicatorType":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISONavigationListItemIndicatorType","kind":"identifier"}],"navigatorTitle":[{"text":"MISONavigationListItemIndicatorType","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misonavigationlistitemindicatortype","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItemIndicatorType","type":"topic","abstract":[{"type":"text","text":"The navigation indicator, describing the type of navigation triggered when the item is tapped."}],"role":"symbol","title":"MISONavigationListItemIndi