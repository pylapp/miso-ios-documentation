{"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"text":"Badge","level":3,"anchor":"Badge","type":"heading"},{"inlineContent":[{"text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface.","type":"text"}],"type":"paragraph"},{"text":"Badge Count","level":4,"anchor":"Badge-Count","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_BlueCoat"}],"type":"paragraph"}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_FoxyRough"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount"},{"text":" displays an integer value.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"anchor":"Badge-Icon","text":"Badge Icon","type":"heading","level":4},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_icon_BlueCoat"}],"type":"paragraph"}],"title":"BlueCoat"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_icon_FoxyRough"}]}],"title":"FoxyRough"}]},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","type":"reference","isActive":true},{"text":" displays only an icon and has specific colors.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"anchor":"Badge-Standard","text":"Badge Standard","type":"heading","level":4},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_BlueCoat","type":"image"}]}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_FoxyRough","type":"image"}]}]}]},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Info badge in medium size without information","MISOBadgeStandard(status: .info, size: .medium)"],"type":"codeListing"},{"anchor":"Progress-Indicators","text":"Progress Indicators","type":"heading","level":3},{"anchor":"Circular-Progress-Indicator","type":"heading","level":4,"text":"Circular Progress Indicator"},{"type":"tabNavigator","tabs":[{"content":[{"identifier":"component_progress_indicator_circular_BlueCoat.video","type":"video"}],"title":"BlueCoat"},{"title":"FoxyRough","content":[{"identifier":"component_progress_indicator_circular_FoxyRough.video","type":"video"}]}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator"},{"text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations.","type":"text"}]},{"syntax":"swift","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","MISOCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","MISOCircularProgressIndicator(status: .accent)"],"type":"codeListing"},{"text":"Linear Progress Indicator","anchor":"Linear-Progress-Indicator","type":"heading","level":4},{"tabs":[{"title":"BlueCoat","content":[{"type":"video","identifier":"component_progress_indicator_linear_BlueCoat.video"}]},{"title":"FoxyRough","content":[{"identifier":"component_progress_indicator_linear_FoxyRough.video","type":"video"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","isActive":true},{"text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations.","type":"text"}]},{"syntax":"swift","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","MISOLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","MISOLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","MISOLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","MISOLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","MISOLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"type":"codeListing"},{"text":"Skeletons","anchor":"Skeletons","type":"heading","level":3},{"tabs":[{"content":[{"identifier":"component_skeleton_BlueCoat.video","type":"video"}],"title":"BlueCoat"},{"content":[{"type":"video","identifier":"component_skeleton_FoxyRough.video"}],"title":"FoxyRough"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A skeleton is a UI element that indicates when content is loading. The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSkeleton"},{"type":"text","text":" enhances user experience by"},{"type":"text","text":" "},{"type":"text","text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the forthcoming content."}]},{"text":"Activate skeleton for MISO components","anchor":"Activate-skeleton-for-MISO-components","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lot of components in MISO library propose their own skeleton representation according to skeleton state set in the SwiftUI environment."},{"type":"text","text":" "},{"type":"text","text":"Apply "},{"code":"showSkeleton(isVisible:isAnimated:)","type":"codeVoice"},{"text":" to update the state on the view and its children","type":"text"},{"text":" ","type":"text"},{"text":"to inform all components in the hierarchy to be displayed in skeleton.","type":"text"}]},{"code":["    @State var isLoading = false","","    var body: some View {","        VStack {","            MISOHeading(\"My header\")","            MISOAlertMessage(label: \"Some text here\", description: \"You should read this text\")","            MISOButton(text: \"Do some action\") { isLoading = true }","        }","        .showSkeleton(isVisible: isLoading) ","    }"],"syntax":"swift","type":"codeListing"},{"text":"Draw skeletons","level":3,"anchor":"Draw-skeletons","type":"heading"},{"inlineContent":[{"text":"It is possible to define a skeleton using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSkeleton","type":"reference"},{"text":" and a frame.","type":"text"}],"type":"paragraph"},{"code":["    VStack {","        \/\/ Heading skeleton","        MISOSkeleton(securityMargin: true).frame(width: 180, height: 48)","","        \/\/ Body skeleton","        MISOSkeleton(securityMargin: true).frame(width: 300, height: 150)","","        \/\/ Footer skeleton","        MISOSkeleton(securityMargin: true).frame(width: 180, height: 54)","    }"],"syntax":"swift","type":"codeListing"},{"text":"Prepare Views for skeleton layout","level":3,"anchor":"Prepare-Views-for-skeleton-layout","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"skeleton","type":"codeVoice"},{"text":" helper applies skeleton on top of a View; the skeleton layout will be rendered with ","type":"text"},{"code":"showSkeleton(isVisible:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["    var body: some View {","        VStack(spacing: 20) {","            Text(\"The title\")","                .skeleton()","            ","            Button {    ","            } label: {","                VStack {","                    Text(\"Title\")","                    Label(\"Subtitle\", systemImage: \"phone\")","                }","            }","            .skeleton()","        }","    }"],"syntax":"swift","type":"codeListing"},{"text":"Tag","level":3,"anchor":"Tag","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tag_BlueCoat"}]}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_FoxyRough","type":"image"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}],"type":"paragraph"},{"code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","MISOTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","MISOTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using MISOImage.flipped","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","MISOTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift","type":"codeListing"},{"text":"Categorical Tag","level":3,"anchor":"Categorical-Tag","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_tag_BlueCoat"}],"type":"paragraph"}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_FoxyRough","type":"image"}]}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCategoricalTag","type":"reference","isActive":true},{"text":" is like an ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag","type":"reference","isActive":true},{"text":" but without appearance notion and with categories instead of statuses.","type":"text"}]},{"syntax":"swift","code":["     \/\/ Text only with category 1, rounded shape, default size","     MISOCategoricalTag(label: \"Label\", category: .category1)","","     \/\/ Text with category 2 and bullet","     MISOCategoricalTag(label: \"Label\", category: .category2, leading: .bullet)","","     \/\/ Text with category 3 and custom icon","     MISOCategoricalTag(label: \"Label\", category: .category3, leading: .icon(MISOImage(asset: Image(decorative: \"ic_heart\"))))","","     \/\/ Small size, square shape","     MISOCategoricalTag(label: \"Label\", category: .category4, shape: .square, size: .small)"],"type":"codeListing"},{"type":"heading","anchor":"Input-Tag","level":3,"text":"Input Tag"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_inputTag_BlueCoat"}]}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"identifier":"component_inputTag_FoxyRough","type":"image"}],"type":"paragraph"}],"title":"FoxyRough"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}]},{"syntax":"swift","code":["\/\/ Create an input tag","MISOInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    MISOInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"type":"codeListing"}],"kind":"content"}],"sections":[],"metadata":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"modules":[{"name":"Components"}],"title":"Indicators","role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/misocomponents\/indicators"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"strong"},{"text":". These are inherited from OUDS.","type":"text"}],"references":{"component_tag_FoxyRough":{"identifier":"component_tag_FoxyRough","alt":"A categorical tag component in light and dark modes with FoxyRough theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tag_FoxyRough.png"}],"type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeCount":{"navigatorTitle":[{"text":"MISOBadgeCount","kind":"identifier"}],"abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","isActive":true},{"type":"text","text":" displays a text, as integer, limited to 99."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeCount","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","role":"symbol","url":"\/documentation\/misocomponents\/misobadgecount","title":"MISOBadgeCount"},"component_tag_BlueCoat":{"identifier":"component_tag_BlueCoat","alt":"A categorical tag component in light and dark modes with BlueCoat theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tag_BlueCoat.png"}]},"doc://MISOComponents/documentation/MISOComponents/MISOLinearProgressIndicator":{"url":"\/documentation\/misocomponents\/misolinearprogressindicator","navigatorTitle":[{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A linear indicator shows the progress of a task using a horizontal line."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"type":"text","text":"Best used inside layouts to show progress."}],"title":"MISOLinearProgressIndicator"},"doc://MISOComponents/documentation/MISOComponents/MISOSkeleton":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSkeleton","title":"MISOSkeleton","navigatorTitle":[{"text":"MISOSkeleton","kind":"identifier"}],"role":"symbol","url":"\/documentation\/misocomponents\/misoskeleton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOSkeleton","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A skeleton is a UI element that indicates when content is loading. The skeleton enhances user experience by","type":"text"},{"text":" ","type":"text"},{"text":"temporarily replacing content with gray areas or animations that simulate the visual structure of the forthcoming","type":"text"},{"text":" ","type":"text"},{"text":"content.","type":"text"}],"type":"topic"},"component_inputTag_BlueCoat":{"identifier":"component_inputTag_BlueCoat","alt":"An input tag component in light and dark modes with BlueCoat theme","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_inputTag_BlueCoat.png"}]},"component_skeleton_FoxyRough.video":{"identifier":"component_skeleton_FoxyRough.video","alt":null,"variants":[{"traits":["1x","light"],"url":"\/videos\/MISOComponents\/component_skeleton_FoxyRough.video.mp4"}],"poster":null,"type":"video"},"doc://MISOComponents/documentation/MISOComponents/MISOTag":{"url":"\/documentation\/misocomponents\/misotag","navigatorTitle":[{"text":"MISOTag","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTag","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Tag is a UI element that allows to display short info like a label, keyword, or category.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Tag helps users quickly find, group, or understand content."}],"title":"MISOTag"},"doc://MISOComponents/documentation/MISOComponents/MISOInputTag":{"navigatorTitle":[{"kind":"identifier","text":"MISOInputTag"}],"abstract":[{"type":"text","text":"Input tag is a UI element that allows to enter multiple values, each represented as a tag."},{"type":"text","text":" "},{"type":"text","text":"As users type and submit values (usually by pressing enter, comma, or tab), each value is transformed into a tag."},{"type":"text","text":" "},{"type":"text","text":"Input tag is often used for adding labels, categories, or participants."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOInputTag"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag","kind":"symbol","type":"topic","role":"symbol","title":"MISOInputTag","url":"\/documentation\/misocomponents\/misoinputtag"},"component_progress_indicator_linear_BlueCoat.video":{"poster":null,"identifier":"component_progress_indicator_linear_BlueCoat.video","alt":null,"type":"video","variants":[{"traits":["1x","light"],"url":"\/videos\/MISOComponents\/component_progress_indicator_linear_BlueCoat.video.mp4"}]},"doc://MISOComponents/documentation/MISOComponents/MISOCategoricalTag":{"navigatorTitle":[{"text":"MISOCategoricalTag","kind":"identifier"}],"abstract":[{"text":"A ","type":"text"},{"code":"MISOCategoricalTag","type":"codeVoice"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It can represent information such as promotions, events, benefits or other locally defined categories."},{"type":"text","text":" "},{"type":"text","text":"It does not communicate functional status or system feedback."},{"type":"text","text":" "},{"type":"text","text":"Use the "},{"type":"codeVoice","code":"MISOTag"},{"type":"text","text":" for success, warning, error, availability or other functional states."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"MISOCategoricalTag"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCategoricalTag","kind":"identifier"}],"type":"topic","kind":"symbol","identifie