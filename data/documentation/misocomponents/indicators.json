{"metadata":{"roleHeading":"Article","modules":[{"name":"Components"}],"role":"article","title":"Indicators","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}]},"kind":"article","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"text":"Badge","anchor":"Badge","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface."}],"type":"paragraph"},{"text":"Badge Count","anchor":"Badge-Count","level":4,"type":"heading"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_BlueCoat"}],"type":"paragraph"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"reference","isActive":true},{"text":" displays an integer value.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"text":"Badge Icon","anchor":"Badge-Icon","level":4,"type":"heading"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_icon_BlueCoat"}],"type":"paragraph"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","type":"reference","isActive":true},{"text":" displays only an icon and has specific colors.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"level":4,"text":"Badge Standard","anchor":"Badge-Standard","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_BlueCoat","type":"image"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Info badge in medium size without information","MISOBadgeStandard(status: .info, size: .medium)"],"type":"codeListing"},{"level":3,"text":"Progress Indicators","anchor":"Progress-Indicators","type":"heading"},{"level":4,"text":"Circular Progress Indicator","anchor":"Circular-Progress-Indicator","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"identifier":"component_progress_indicator_circular_BlueCoat.video","type":"video"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","isActive":true},{"text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","MISOCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","MISOCircularProgressIndicator(status: .accent)"],"type":"codeListing"},{"level":4,"text":"Linear Progress Indicator","anchor":"Linear-Progress-Indicator","type":"heading"},{"tabs":[{"content":[{"type":"video","identifier":"component_progress_indicator_linear_BlueCoat.video"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator"},{"type":"text","text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","MISOLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","MISOLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","MISOLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","MISOLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","MISOLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"type":"codeListing"},{"level":3,"text":"Tag","anchor":"Tag","type":"heading"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tag_BlueCoat"}]}],"title":"BlueCoat"}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","MISOTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","MISOTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using MISOImage.flipped","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","MISOTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"]},{"text":"Input Tag","type":"heading","level":3,"anchor":"Input-Tag"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_inputTag_BlueCoat"}]}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Create an input tag","MISOInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    MISOInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"sections":[],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/indicators"]}],"references":{"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","url":"\/documentation\/misocomponents","type":"topic","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"title":"Components"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeIcon":{"abstract":[{"type":"text","text":"Badge is a UI element t