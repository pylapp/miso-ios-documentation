{"metadata":{"modules":[{"name":"Components"}],"roleHeading":"Article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","title":"Indicators"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"heading","level":3,"text":"Badge","anchor":"Badge"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface."}]},{"type":"heading","anchor":"Badge-Count","level":4,"text":"Badge Count"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_BlueCoat"}],"type":"paragraph"}],"title":"BlueCoat"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_count_FoxyRough"}]}],"title":"FoxyRough"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"reference"},{"type":"text","text":" displays an integer value."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"]},{"type":"heading","level":4,"text":"Badge Icon","anchor":"Badge-Icon"},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_BlueCoat","type":"image"}]}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_icon_FoxyRough"}],"type":"paragraph"}],"title":"FoxyRough"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","isActive":true},{"type":"text","text":" displays only an icon and has specific colors."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"]},{"anchor":"Badge-Standard","level":4,"type":"heading","text":"Badge Standard"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_BlueCoat"}],"type":"paragraph"}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_standard_FoxyRough"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"text":" is an empty badge like a coloured pastille.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Info badge in medium size without information","MISOBadgeStandard(status: .info, size: .medium)"]},{"type":"heading","level":3,"text":"Progress Indicators","anchor":"Progress-Indicators"},{"type":"heading","level":4,"text":"Circular Progress Indicator","anchor":"Circular-Progress-Indicator"},{"tabs":[{"title":"BlueCoat","content":[{"type":"video","identifier":"component_progress_indicator_circular_BlueCoat.video"}]},{"title":"FoxyRough","content":[{"type":"video","identifier":"component_progress_indicator_circular_FoxyRough.video"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","isActive":true},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}]},{"type":"codeListing","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","MISOCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","MISOCircularProgressIndicator(status: .accent)"],"syntax":"swift"},{"level":4,"text":"Linear Progress Indicator","type":"heading","anchor":"Linear-Progress-Indicator"},{"tabs":[{"title":"BlueCoat","content":[{"identifier":"component_progress_indicator_linear_BlueCoat.video","type":"video"}]},{"title":"FoxyRough","content":[{"type":"video","identifier":"component_progress_indicator_linear_FoxyRough.video"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","type":"reference","isActive":true},{"type":"text","text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations."}]},{"type":"codeListing","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","MISOLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","MISOLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","MISOLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","MISOLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","MISOLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"syntax":"swift"},{"level":3,"text":"Tag","type":"heading","anchor":"Tag"},{"tabs":[{"content":[{"inlineContent":[{"identifier":"component_tag_BlueCoat","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_tag_FoxyRough"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag"},{"text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","MISOTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","MISOTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using MISOImage.flipped","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","MISOTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"anchor":"Input-Tag","text":"Input Tag"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_inputTag_BlueCoat"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_inputTag_FoxyRough"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}]},{"code":["\/\/ Create an input tag","MISOInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    MISOInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"type":"text","text":"indicators"}],"type":"strong"},{"type":"text","text":"."}],"kind":"article","variants":[{"paths":["\/documentation\/misocomponents\/indicators"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/document