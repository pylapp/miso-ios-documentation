{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"},"sections":[],"metadata":{"modules":[{"name":"Components"}],"roleHeading":"Article","title":"Indicators","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"role":"article"},"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"type":"text","text":"indicators"}],"type":"strong"},{"type":"text","text":"."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"heading","text":"Badge","anchor":"Badge","level":3},{"inlineContent":[{"type":"text","text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface."}],"type":"paragraph"},{"level":4,"anchor":"Badge-Count","text":"Badge Count","type":"heading"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_count_BlueCoat"}],"type":"paragraph"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"reference","isActive":true},{"text":" displays an integer value.","type":"text"}]},{"code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Badge Icon","anchor":"Badge-Icon","level":4},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_BlueCoat","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","isActive":true},{"type":"text","text":" displays only an icon and has specific colors."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"]},{"level":4,"anchor":"Badge-Standard","type":"heading","text":"Badge Standard"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_badge_standard_BlueCoat","type":"image"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Info badge in medium size without information","MISOBadgeStandard(status: .info, size: .medium)"]},{"level":3,"anchor":"Progress-Indicators","text":"Progress Indicators","type":"heading"},{"type":"heading","text":"Circular Progress Indicator","anchor":"Circular-Progress-Indicator","level":4},{"tabs":[{"title":"BlueCoat","content":[{"identifier":"component_progress_indicator_circular_BlueCoat.video","type":"video"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","type":"reference","isActive":true},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}],"type":"paragraph"},{"code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","MISOCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","MISOCircularProgressIndicator(status: .accent)"],"syntax":"swift","type":"codeListing"},{"anchor":"Linear-Progress-Indicator","level":4,"type":"heading","text":"Linear Progress Indicator"},{"tabs":[{"title":"BlueCoat","content":[{"type":"video","identifier":"component_progress_indicator_linear_BlueCoat.video"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","isActive":true},{"type":"text","text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations."}],"type":"paragraph"},{"code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","MISOLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","MISOLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","MISOLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","MISOLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","MISOLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"syntax":"swift","type":"codeListing"},{"anchor":"Tag","level":3,"type":"heading","text":"Tag"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_tag_BlueCoat"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}],"type":"paragraph"},{"code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","MISOTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","MISOTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using MISOImage.flipped","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","MISOTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift","type":"codeListing"},{"anchor":"Input-Tag","level":3,"type":"heading","text":"Input Tag"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_inputTag_BlueCoat","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}],"type":"paragraph"},{"code":["\/\/ Create an input tag","MISOInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    MISOInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/indicators"]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"MISOBadgeStandard","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeStandard","kind":"identifier"}],"title":"MISOBadgeStandard","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"text":" displays only a colored pastille.","type":"text"}],"url":"\/documentation\/misocomponents\/misobadgestandard"},"component_badge_standard_BlueCoat":{"type":"image","alt":"A standard badge component in light and dark modes with BlueCoat theme","identifier":"component_badge_standard_BlueCoat","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_badge_standard_BlueCoat.png"}]},"doc://MISOComponents/documentation/MISOComponents/MISOTag":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag","title":"MISOTag","type":"topic","navigatorTitle":[{"text":"MISOTag","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misotag","kind":"symbol","abstract":[{"text":"Tag is a UI element that allows to display short info like a label, keyword, or category.","type":"text"},{"text":" ","type":"text"},{"text":"Tag helps users quickly find, group, or understand content.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTag","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOLinearProgressIndicator":{"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"MISOLinearProgressIndicator","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLinearProgressIndicator","kind":"identifier"}],"title":"MISOLinearProgressIndicator","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","abstract":[{"type":"text","text":"A linear indicator shows the progress of a task using a horizontal line."},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (i