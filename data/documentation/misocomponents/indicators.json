{"sections":[],"kind":"article","metadata":{"title":"Indicators","role":"article","modules":[{"name":"Components"}],"roleHeading":"Article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/indicators"]}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators","interfaceLanguage":"swift"},"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"indicators"}]},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"text":"Badge","type":"heading","level":3,"anchor":"Badge"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface."}]},{"text":"Badge Count","type":"heading","level":4,"anchor":"Badge-Count"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_count_BlueCoat","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount"},{"type":"text","text":" displays an integer value."}]},{"type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift"},{"text":"Badge Icon","type":"heading","level":4,"anchor":"Badge-Icon"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_BlueCoat","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon"},{"type":"text","text":" displays only an icon and has specific colors."}]},{"type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift"},{"text":"Badge Standard","type":"heading","level":4,"anchor":"Badge-Standard"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_BlueCoat","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}]},{"type":"codeListing","code":["\/\/ Info badge in medium size without information","MISOBadgeStandard(status: .info, size: .medium)"],"syntax":"swift"},{"text":"Progress Indicators","type":"heading","level":3,"anchor":"Progress-Indicators"},{"text":"Circular Progress Indicator","type":"heading","level":4,"anchor":"Circular-Progress-Indicator"},{"type":"tabNavigator","tabs":[{"content":[{"type":"video","identifier":"component_progress_indicator_circular_BlueCoat.video"}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator"},{"type":"text","text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations."}]},{"type":"codeListing","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","MISOCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","MISOCircularProgressIndicator(status: .accent)"],"syntax":"swift"},{"text":"Linear Progress Indicator","type":"heading","level":4,"anchor":"Linear-Progress-Indicator"},{"type":"tabNavigator","tabs":[{"content":[{"type":"video","identifier":"component_progress_indicator_linear_BlueCoat.video"}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator"},{"type":"text","text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations."}]},{"type":"codeListing","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","MISOLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","MISOLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","MISOLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","MISOLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","MISOLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"syntax":"swift"},{"text":"Tag","type":"heading","level":3,"anchor":"Tag"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tag_BlueCoat","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}]},{"type":"codeListing","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","MISOTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","MISOTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using MISOImage.flipped","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","MISOTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift"},{"text":"Input Tag","type":"heading","level":3,"anchor":"Input-Tag"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_BlueCoat","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}]},{"type":"codeListing","code":["\/\/ Create an input tag","MISOInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    MISOInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"syntax":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"component_tag_BlueCoat":{"type":"image","variants":[{"url":"\/images\/MISOComponents\/component_tag_BlueCoat.png","traits":["1x","light"]}],"identifier":"component_tag_BlueCoat","alt":"A tag component in light and dark modes with BlueCoat theme"},"component_badge_count_BlueCoat":{"type":"image","variants":[{"url":"\/images\/MISOComponents\/component_badge_count_BlueCoat.png","traits":["1x","light"]}],"identifier":"component_badge_count_BlueCoat","alt":"A count badge component in light and dark modes with BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" 