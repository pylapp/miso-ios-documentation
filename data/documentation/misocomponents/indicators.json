{"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"level":3,"anchor":"Badge","text":"Badge","type":"heading"},{"inlineContent":[{"text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface.","type":"text"}],"type":"paragraph"},{"level":4,"anchor":"Badge-Count","text":"Badge Count","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_count_BlueCoat","type":"image"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"reference","isActive":true},{"text":" displays an integer value.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"level":4,"anchor":"Badge-Icon","text":"Badge Icon","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_BlueCoat","type":"image"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","type":"reference","isActive":true},{"text":" displays only an icon and has specific colors.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"type":"codeListing"},{"level":4,"anchor":"Badge-Standard","text":"Badge Standard","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_standard_BlueCoat","type":"image"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" is an empty badge like a coloured pastille."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Info badge in medium size without information","MISOBadgeStandard(status: .info, size: .medium)"],"type":"codeListing"},{"text":"Progress Indicators","type":"heading","level":3,"anchor":"Progress-Indicators"},{"text":"Circular Progress Indicator","type":"heading","level":4,"anchor":"Circular-Progress-Indicator"},{"tabs":[{"title":"BlueCoat","content":[{"identifier":"component_progress_indicator_circular_BlueCoat.video","type":"video"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","isActive":true,"type":"reference"},{"text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations.","type":"text"}]},{"type":"codeListing","code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","MISOCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","MISOCircularProgressIndicator(status: .accent)"],"syntax":"swift"},{"type":"heading","text":"Linear Progress Indicator","level":4,"anchor":"Linear-Progress-Indicator"},{"tabs":[{"title":"BlueCoat","content":[{"identifier":"component_progress_indicator_linear_BlueCoat.video","type":"video"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","isActive":true,"type":"reference"},{"text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations.","type":"text"}]},{"type":"codeListing","code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","MISOLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","MISOLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","MISOLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","MISOLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","MISOLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"syntax":"swift"},{"type":"heading","text":"Tag","level":3,"anchor":"Tag"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_tag_BlueCoat","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag","type":"reference","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}]},{"type":"codeListing","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","MISOTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","MISOTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using MISOImage.flipped","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","MISOTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift"},{"type":"heading","text":"Input Tag","level":3,"anchor":"Input-Tag"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_inputTag_BlueCoat","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag","type":"reference","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}]},{"type":"codeListing","code":["\/\/ Create an input tag","MISOInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    MISOInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"],"syntax":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/indicators"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"},"metadata":{"roleHeading":"Article","role":"article","title":"Indicators","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"modules":[{"name":"Components"}]},"references":{"component_badge_standard_BlueCoat":{"type":"image","identifier":"component_badge_standard_BlueCoat","variants":[{"url":"\/images\/MISOComponents\/component_badge_standard_BlueCoat.png","traits":["1x","light"]}],"alt":"A standard badge component in light and dark modes with BlueCoat theme"},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"url":"\/documentation\/misocomponents\/misobadgestandard","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of 