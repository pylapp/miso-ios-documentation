{"sections":[],"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"indicators","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"metadata":{"roleHeading":"Article","modules":[{"name":"Components"}],"role":"article","title":"Indicators","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"identifier":"ic_folder_categories.png","type":"card"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"level":3,"text":"Badge","anchor":"Badge","type":"heading"},{"inlineContent":[{"type":"text","text":"The badge is a small UI element used to highlight status, notifications, or categorization within an interface."}],"type":"paragraph"},{"level":4,"text":"Badge Count","anchor":"Badge-Count","type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_count_BlueCoat"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"identifier":"component_badge_count_FoxyRough","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"reference","isActive":true},{"text":" displays an integer value.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift"},{"text":"Badge Icon","type":"heading","anchor":"Badge-Icon","level":4},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_badge_icon_BlueCoat","type":"image"}]}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"identifier":"component_badge_icon_FoxyRough","type":"image"}],"type":"paragraph"}],"title":"FoxyRough"}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","isActive":true},{"type":"text","text":" displays only an icon and has specific colors."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Neutral badge in medium size with an image","MISOBadgeIcon(status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), accessibilityLabel: \"Like\"), size: .medium))"],"syntax":"swift"},{"level":4,"type":"heading","anchor":"Badge-Standard","text":"Badge Standard"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_badge_standard_BlueCoat"}]}]},{"content":[{"inlineContent":[{"type":"image","identifier":"component_badge_standard_FoxyRough"}],"type":"paragraph"}],"title":"FoxyRough"}]},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","type":"reference"},{"text":" is an empty badge like a coloured pastille.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Info badge in medium size without information","MISOBadgeStandard(status: .info, size: .medium)"]},{"anchor":"Progress-Indicators","type":"heading","level":3,"text":"Progress Indicators"},{"anchor":"Circular-Progress-Indicator","type":"heading","text":"Circular Progress Indicator","level":4},{"tabs":[{"content":[{"type":"video","identifier":"component_progress_indicator_circular_BlueCoat.video"}],"title":"BlueCoat"},{"title":"FoxyRough","content":[{"identifier":"component_progress_indicator_circular_FoxyRough.video","type":"video"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","type":"reference"},{"text":" is a progress indicator which can be used to display determinate value or indeterminate value with animations.","type":"text"}],"type":"paragraph"},{"code":["\/\/ A circular gauge filled at 75% in neutral color with a track displayed with an animation","MISOCircularProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A circular gauge without defined value and an accent color","MISOCircularProgressIndicator(status: .accent)"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Linear-Progress-Indicator","level":4,"text":"Linear Progress Indicator"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"identifier":"component_progress_indicator_linear_BlueCoat.video","type":"video"}]},{"content":[{"identifier":"component_progress_indicator_linear_FoxyRough.video","type":"video"}],"title":"FoxyRough"}]},{"inlineContent":[{"text":"An ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","type":"reference"},{"text":" is a horizontal progress indicator which can be used to display determinate value or indeterminate value animations.","type":"text"}],"type":"paragraph"},{"code":["\/\/ A horizontal bar filled at 75% in neutral color with a track and reveal animation","MISOLinearProgressIndicator(progress: 0.75, status: .neutral)","","\/\/ A horizontal bar without defined value and an accent color","MISOLinearProgressIndicator(status: .accent)","","\/\/ A horizontal bar with a helper text center aligned, a stop indicator (determinate only) and no animations","MISOLinearProgressIndicator(progress: 0.5, stopIndicator: true, helperText: .description(\"Uploading…\"), animated: false)","","\/\/ A horizontal bar with a helper text with progress information start aligned","\/\/ The percentage rendering (symbol, spacing, position) follows the localized wording key","\/\/ `core_progressIndicator_percent_value` (e.g. \"75%\" in English, \"75 %\" in French, \"٪75\" in Arabic).","MISOLinearProgressIndicator(progress: 0.5, helperText: .percent(description: \"Uploading…\", alignment: .start))","","\/\/ An indeterminate horizontal bar with a helper text start aligned ","MISOLinearProgressIndicator(status: .info, helperText: \"Processing…\", helperTextAlignment: .start)"],"syntax":"swift","type":"codeListing"},{"text":"Tag","anchor":"Tag","type":"heading","level":3},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tag_BlueCoat"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_tag_FoxyRough"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag"},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category. It helps users quickly find, group, or understand content."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","\/\/ Or also","MISOTag(label: \"Label\")","            ","\/\/ Tag with negative status with bullet","MISOTag(label: \"Label\", status: .negative(leading: .bullet)","            ","\/\/ Tag with neutral status with a custom decorative icon","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","\/\/ Flip the icon for RTL layouts using MISOImage.flipped","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","","\/\/ Tag with neutral status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","\/\/ Tag with accent status with a raw image (not tinted)","MISOTag(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","            ","\/\/ Text with neutral status with bullet","MISOTag(label: \"Label\", status: .neutral(bullet: true))","            ","\/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","\/\/ Tag with determinate circular progress indicator, with rounded shape in default size","MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"]},{"level":3,"anchor":"Input-Tag","type":"heading","text":"Input Tag"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_inputTag_BlueCoat"}],"type":"paragraph"}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_inputTag_FoxyRough","type":"image"}]}]}],"type":"tabNavigator"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInputTag","isActive":true},{"type":"text","text":" is a small element that shows short information like a label, keyword, or category, which can be removed or changed on tap."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Create an input tag","MISOInputTag(\"Label\") {","    \/\/ Do something, usually remove itself from a list","}","    ","\/\/ Show in a list and remove when clicked","var names: [String] = [ \"Foo\", \"Bar\", \"Wizz\" ]","    ","ForEach(names, id: \\.self) { name in","    MISOInputTag(label: name) {","        if let index = names.firstIndex(of: name) {","            names.remove(at: index)","        }","    }","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/indicators"]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentati