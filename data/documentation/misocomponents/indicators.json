[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_badge_count_FoxyRough.png"}]},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"url":"\/documentation\/misocomponents\/misobadgestandard","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeStandard","kind":"identifier"}],"navigatorTitle":[{"text":"MISOBadgeStandard","kind":"identifier"}],"title":"MISOBadgeStandard","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","type":"topic"}}}