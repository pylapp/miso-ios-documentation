bottom-trailing corner to indicate status."}],"type":"paragraph"},{"level":2,"text":"Avatar types","anchor":"Avatar-types","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/AvatarType","isActive":true},{"type":"text","text":" enum defines the content displayed inside the avatar:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".icon","type":"codeVoice"}],"type":"strong"},{"text":": A predefined person\/people icon from the current theme’s resource bundle.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".image(_:)","type":"codeVoice"}],"type":"strong"},{"text":": A custom ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" asset that fills the avatar circle.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".initials(_:)","type":"codeVoice"}],"type":"strong"},{"text":": A short text string (2 characters maximum) rendered centered in the avatar.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Sizes","anchor":"Sizes","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/Size","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".medium","type":"codeVoice"}],"type":"strong"},{"text":": The default size, suited for standard list items.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".large","type":"codeVoice"}],"type":"strong"},{"text":": A larger variant for increased visual prominence.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".extraLarge","type":"codeVoice"}],"type":"strong"},{"text":": The largest variant, typically used for profile-like displays.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note:","type":"text"}]},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemSize(_:)","isActive":true},{"type":"text","text":"), the "},{"code":"size","type":"codeVoice"},{"type":"text","text":" parameter is "},{"type":"strong","inlineContent":[{"text":"ignored","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}],"type":"paragraph"},{"level":2,"text":"Badge","anchor":"Badge","type":"heading"},{"inlineContent":[{"type":"text","text":"An optional badge "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","isActive":true},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"code":"controlItem.colorBadgeSafetyArea","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recommended badge sizes per avatar size are:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".medium","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".extraSmall","type":"codeVoice"},{"text":" badge","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".large","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".small","type":"codeVoice"},{"text":" badge","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".extraLarge","type":"codeVoice"},{"text":" avatar → ","type":"text"},{"code":".medium","type":"codeVoice"},{"text":" badge","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"code":["    \/\/ Avatar with predefined icon, medium size","    MISOListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    MISOListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    MISOListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    MISOListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    MISOListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    MISOStaticListItem(","        data: MISOListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(MISOListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    MISOStaticListItem(","        data: MISOListItemData(label: \"Contact\"),","        trailing: .avatar(MISOListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Containers alignment","anchor":"Containers-alignment"