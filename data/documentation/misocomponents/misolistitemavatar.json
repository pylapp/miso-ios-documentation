{"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"metadata":{"externalID":"s:14MISOComponents18MISOListItemAvatarV","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MISOListItemAvatar"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOListItemAvatar"}],"role":"symbol","modules":[{"name":"Components"}],"platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"beta":false,"unavailable":false},{"name":"macOS","introducedAt":"13.0","deprecated":false,"beta":false,"unavailable":false},{"name":"tvOS","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"beta":false,"unavailable":false},{"name":"watchOS","introducedAt":"11.0","deprecated":false,"beta":false,"unavailable":false}],"title":"MISOListItemAvatar","symbolKind":"struct"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"An avatar element that can be used at the leading or trailing position of a list item"},{"type":"text","text":" "},{"type":"text","text":"such as "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem"},{"type":"text","text":"."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOListItemAvatar"}]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar","type":"reference","isActive":true},{"type":"text","text":" displays a circular visual identifier that can represent a user, a contact,"},{"type":"text","text":" "},{"type":"text","text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","type":"reference","isActive":true},{"type":"text","text":" can be attached at the bottom-trailing corner to indicate status."}]},{"anchor":"Avatar-types","type":"heading","text":"Avatar types","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/AvatarType","type":"reference","isActive":true},{"type":"text","text":" enum defines the content displayed inside the avatar:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".icon"}]},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".image(_:)"}]},{"type":"text","text":": A custom "},{"code":"Image","type":"codeVoice"},{"type":"text","text":" asset that fills the avatar circle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}]}]}],"type":"unorderedList"},{"anchor":"Sizes","type":"heading","text":"Sizes","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/Size","type":"reference","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"type":"text","text":": The default size, suited for standard list items."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"type":"text","text":": A larger variant for increased visual prominence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".extraLarge"}]},{"type":"text","text":": The largest variant, typically used for profile-like displays."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemSize(_:)","type":"reference","isActive":true},{"type":"text","text":"), the "},{"code":"size","type":"codeVoice"},{"type":"text","text":" parameter is "},{"type":"strong","inlineContent":[{"type":"text","text":"ignored"}]},{"type":"text","text":" "},{"type":"text","text":"and the avatar is always rendered at its smallest available size."}]},{"anchor":"Badge","type":"heading","text":"Badge","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional badge "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","type":"reference","isActive":true},{"type":"text","text":" can be placed at the"},{"type":"text","text":" "},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"code":"controlItem.colorBadgeSafetyArea","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended badge sizes per avatar size are:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".medium","type":"codeVoice"},{"type":"text","text":" avatar → "},{"code":".extraSmall","type":"codeVoice"},{"type":"text","text":" badge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".large","type":"codeVoice"},{"type":"text","text":" avatar → "},{"code":".small","type":"codeVoice"},{"type":"text","text":" badge"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".extraLarge","type":"codeVoice"},{"type":"text","text":" avatar → "},{"code":".medium","type":"codeVoice"},{"type":"text","text":" badge"}]}]}],"type":"unorderedList"},{"anchor":"Code-samples","type":"heading","text":"Code samples","level":2},{"type":"codeListing","syntax":"swift","code":["    \/\/ Avatar with predefined icon, medium size","    MISOListItemAvatar(type: .icon, size: .medium)","","    \/\/ Avatar with a custom image, large size","    MISOListItemAvatar(type: .image(Image(\"il_placeholder\")), size: .large)","","    \/\/ Avatar with initials, extra large size","    MISOListItemAvatar(type: .initials(\"AB\"), size: .extraLarge)","","    \/\/ Avatar with icon and a notification badge","    let badgeType = .standard(.init(accessibilityLabel: \"Do not disturb\", status: .negative, size: .small))","    MISOListItemAvatar(type: .icon, size: .medium, badgeType: badgeType)","","    \/\/ Avatar with initials and a icon badge with positive status","    let badgeType = .icon(.init(status: .positive, accessibilityLable: \"Online\", size: .small))","    MISOListItemAvatar(type: .initials(\"JD\"), size: .large, badgeType: badgeType)","","    \/\/ Usage as leading element in a list item","    MISOStaticListItem(","        data: MISOListItemData(label: \"John Doe\", description: \"Online\"),","        leading: .avatar(MISOListItemAvatar(type: .icon, size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    MISOStaticListItem(","        data: MISOListItemData(label: \"Contact\"),","        trailing: .avatar(MISOListItemAvatar(type: .initials(\"AB\"), size: .medium))","    )"]},{"anchor":"Containers-alignment","type":"heading","text":"Containers alignment","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The avatar, along with other leading\/trailing elements and the text container, can be"},{"type":"text","text":" "},{"type":"text","text":"vertically aligned using the "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemContainerAlignment(_:)","type":"reference","isActive":true},{"type":"text","text":" view modifier"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":".center","type":"codeVoice"},{"type":"text","text":" by default, or "},{"code":".top","type":"codeVoice"},{"type":"text","text":")."}]},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 3.0.0"}]}],"type":"aside","style":"note"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/misocomponents\/misolistitemavatar"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOC