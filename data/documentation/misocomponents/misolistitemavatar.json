":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".icon"}],"type":"strong"},{"text":": A predefined person\/people icon from the current theme’s resource bundle.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".image(_:)"}],"type":"strong"},{"text":": A custom ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" asset that fills the avatar circle.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".initials(_:)"}],"type":"strong"},{"text":": A short text string (2 characters maximum) rendered centered in the avatar.","type":"text"}]}]}]},{"anchor":"Sizes","type":"heading","text":"Sizes","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/Size"},{"type":"text","text":" enum defines the available sizes for the avatar:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".medium","type":"codeVoice"}]},{"type":"text","text":": The default size, suited for standard list items."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".large","type":"codeVoice"}]},{"type":"text","text":": A larger variant for increased visual prominence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".extraLarge","type":"codeVoice"}]},{"type":"text","text":": The largest variant, typically used for profile-like displays."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" When the avatar is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"identifier":"doc:\