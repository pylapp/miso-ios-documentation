},{"type":"text","text":"or any entity. It supports three content types: a predefined icon, a custom image, or text initials."},{"type":"text","text":" "},{"type":"text","text":"An optional "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon"},{"type":"text","text":" can be attached at the bottom-trailing corner to indicate status."}]},{"level":2,"anchor":"Avatar-types","type":"heading","text":"Avatar types"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/AvatarType","isActive":true,"type":"reference"},{"text":" enum defines the content displayed inside the avatar:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".icon","type":"codeVoice"}]},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".image(_:)","type":"codeVoice"}],"type":"strong"},{"text":": A custom ","type":"text"},{"code":"Image","type":"codeVoice"},{"text":" asset that fills the avatar circle.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Sizes","type":"heading","text":"Sizes"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/Size"},{"text":" enum defines the available sizes for the a