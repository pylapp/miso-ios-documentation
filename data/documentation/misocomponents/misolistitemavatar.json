"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon"},{"text":" can be attached at the bottom-trailing corner to indicate status.","type":"text"}],"type":"paragraph"},{"text":"Avatar types","anchor":"Avatar-types","type":"heading","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/AvatarType","type":"reference"},{"type":"text","text":" enum defines the content displayed inside the avatar:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".icon"}],"type":"strong"},{"type":"text","text":": A predefined person\/people icon from the current theme’s resource bundle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".image(_:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": A custom "},{"type":"codeVoice","code":"Image"},{"type":"text","text":" asset that fills the avatar circle."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".initials(_:)"}]},{"type":"text","text":": A short text string (2 characters maximum) rendered centered in the avatar."}]}]}]},{"type":"heading","level":2,"text":"Sizes","anchor":"Sizes"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemAvatar\/Size","type":"reference","isActive":true},{"type":"text","text":" enum defines the available sizes for the avatar:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"type":"text","text":": The default size, suited for standard list items."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".large"}],"type":"strong"},{"text":": A larger variant for increased visual prominence.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".extraLarge","type":"codeVoice"}],"type":"strong"},{"text":": The largest variant, typically used for profile-like displays.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"text":" When the avatar is embedded in a list item with small size","type":"text"},{"text":" ","type":"text"},{"text":"(via ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/SwiftUICore\/View\/misoListItemSize(_:)","isActive":true,"type":"reference"},{"type":"text","text":"), the "},{"type":"codeVoice","code":"size"},{"type":"text","text":" parameter is "},{"inlineContent":[{"text":"ignored","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"text":"and the avatar is always rendered at its smallest available size.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Badge","anchor":"Badge","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional badge "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeIcon","isActive":true,"type":"reference"},{"type":"text","text":" can be placed at the"},{"text":" ","type":"text"},{"type":"text","text":"bottom-trailing corner of the avatar to convey status information (e.g. online presence, notification count)."},{"type":"text","text":" "},{"type":"text","text":"The badge is rendered with a safety-area border matching the theme’s "},{"type":"codeVoice","code":"controlItem.colorBadgeSafetyArea"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The recommended badge sizes per avatar size are:","type":"text"}]},{"items":[{"content"