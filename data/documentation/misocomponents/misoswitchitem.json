{"abstract":[{"type":"text","text":"Switch item is a UI element that allows to toggle between two states, typically “On” and “Off”, and used to enable or disable features, options or settings."},{"type":"text","text":" "},{"type":"text","text":"Switch Item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."}],"kind":"symbol","topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/init(_:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-1lrtn","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/init(_:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-6rjer","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/init(_:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-88707","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/init(_:tableName:bundle:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-2u8vt","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/init(_:tableName:bundle:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-66et1","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/init(_:tableName:bundle:isOn:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:)-83xfs"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/body"]},{"anchor":"Default-Implementations","generated":true,"title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem\/View-Implementations"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem"},"metadata":{"externalID":"s:14MISOComponents14MISOSwitchItemV","navigatorTitle":[{"kind":"identifier","text":"MISOSwitchItem"}],"modules":[{"name":"Components"}],"platforms":[{"unavailable":false,"introducedAt":"15.0","name":"iOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"13.0","name":"macOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"16.0","name":"tvOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"11.0","name":"watchOS","deprecated":false,"beta":false}],"roleHeading":"Structure","role":"symbol","symbolKind":"struct","title":"MISOSwitchItem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSwitchItem"}]},"variants":[{"paths":["\/documentation\/misocomponents\/misoswitchitem"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MISOSwitchItem"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls"]},{"kind":"content","content":[{"text":"Layouts","anchor":"Layouts","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The component can be rendered as two different layouts:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"text":": the component has a leading indicator, a label and optional texts, and an optional trailing decorative icon","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"inverse"}]},{"type":"text","text":": like the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"text":" layout but with a trailing switch indicator and a leading optional decorative icon","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Indicator states","anchor":"Indicator-states","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The switch indicator has two available states set as a boolean property that determines whether the toggle is on or off.","type":"text"}]},{"anchor":"Particular-cases","type":"heading","level":2,"text":"Particular cases"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem","isActive":true,"type":"reference"},{"text":" can be related to an error situation, for example troubles for a form.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"A dedicated look and feel is implemented for that if the "},{"type":"codeVoice","code":"isError"},{"text":" flag is risen.","type":"text"},{"text":" ","type":"text"},{"text":"In that case if the component displayed an icon, this icon will be replaced automatically by an error icon.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition, the "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSwitchItem","type":"reference","isActive":true},{"type":"text","text":" can be in read only mode, i.e. the user cannot interact with the component yet but this component must not be considered"},{"text":" ","type":"text"},{"type":"text","text":"as disabled."}]},{"level":2,"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Voice Over","type":"text"}]},{"text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and optional texts and a custom switch trait.","type":"text"}],"type":"paragraph"},{"anchor":"Forbidden-by-design","text":"Forbidden by design","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The design system does not allow to have both an error situation and a read only component."}]},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"The design system does not allow to have both an error situation and a disabled component."}]},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"The design system does not allow to have both a read only and a disabled component."}]}]},{"level":2,"type":"heading","text":"Code samples","anchor":"Code-samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Supposing we have an unselected state","    @Published var isOn: Bool = false","","    \/\/ A leading switch with a label.","    MISOSwitchItem(\"Lucy in the Sky with Diamonds\", isOn: $isOn)","","    \/\/ Localizable from bundle can also be used","    MISOSwitchItem(LocalizedStringKey(\"notifications_setting\"), bundle: Bundle.module, isOn: $isOn)","","    \/\/ A leading switch with a label, but in read only mode (user cannot interact yet, but not disabled).","    MISOSwitchItem(\"Lucy in the Sky with Diamonds\", isOn: $isOn, isReadOnly: true)","","    \/\/ A leading switch with a label and a description text.","    MISOSwitchItem(\"Lucy in the Sky with Diamonds\", isOn: $isOn, description: \"The Beatles\")","","    \/\/ A trailing switch with a label, a description and a tinted icon.","    MISOSwitchItem(\"Lucy in the Sky with Diamonds\",","                   isOn: $isOn,","                   description: \"The Beatles\",","                   image: MISOImage(asset: Image(decorative: \"ic_heart\")),","                   isReversed: true)","","    \/\/ A trailing switch with a raw (non-tinted) image.","    MISOSwitchItem(\"Lucy in the Sky with Diamonds\",","                   isOn: $isOn,","                   description: \"The Beatles\",","                   image: MISOImage(asset: Image(decorative: \"il_someImage\"), renderingMode: .original),","                   isReversed: true)","","    \/\/ Flip the icon for RTL layouts using MISOImage.","    MISOSwitchItem(\"Lucy in the Sky with Diamonds\",","                   isOn: $isOn,","                   image: MISOImage(asset: Image(systemName: \"figure.handball\"),","                                   flipped: layoutDirection == .rightToLeft))","","    \/\/ If on error, add an error message to help user understand the error context","    MISOSwitchItem(\"Rescue from this world!\",","                   isOn: $isOn,","                   isError: true,","                   errorText: .raw(\"Something wrong\"),","                   hasDivider: true)","","    \/\/ The error message is an MISOTextualContent: raw (string literal), localized or rich text","    MISOSwitchItem(\"Rescue from this world!\",","                   isOn: $isOn,","                   isError: true,","                   errorText: .localized(\"error_wording\", bundle: Bundle.module))","    MISOSwitchItem(\"Rescue from this world!\",","                   isOn: $isOn,","                   isError: true,","                   errorText: .rich(AttributedString(markdown: \"You **must** enable it\"))) \/\/ Manage in your side errors for init","","    \/\/ A leading switch with a label, but disabled.","    MISOSwitchItem(\"Rescue from this world!\", isOn: $isOn)","        .disabled(true)","","    \/\/ Never disable a read only or an error-related switch as it will crash","    \/\/ This is forbidden by design!","    MISOSwitchItem(\"Kaboom!\", isOn: $isOn, isError: true).disabled(true) \/\/ fatal error","    MISOSwitchItem(\"Kaboom!\", isOn: $isOn, isReadOnly: true).disabled(true) \/\/ fatal error"]},{"level":2,"type":"heading","text":"Rich text","anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can only be used for error messages."},{"type":"text","text":" "},{"type":"text","text":"The error message is an "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent","isActive":true},{"type":"text","text":": a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":" (a string literal is enough), a localized string"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"text":" or a rich text with ","type":"text"},{"type":"codeVoice","code":".rich(_:)"},{"text":" and an ","type":"text"},{"type":"codeVoice","code":"AttributedString"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Prefer ","type":"text"},{"type":"codeVoice","code":".raw(_:)"},{"text":" to a bare string literal for a raw message, so the compiler selects without any doubt the initializer","type":"text"},{"text":" ","type":"text"},{"text":"taking an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent","type":"reference"},{"text":" and does not emit a deprecation warning.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"text":" ","type":"text"},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}],"type":"paragraph"},{"text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"name":"Version","type":"aside","content":[{"inlineContent":[{"text":"1.5.0 (Figma component design version)","type":"text"}],"type":"paragraph"}],"style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.14.0"}]}],"name":"Since","type":"aside","style":"note"}]}],"references":{"doc://MISOComponents/documentation/MISOComponents/Controls":{"type":"topic","title":"Controls","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls","role":"article","kind":"article","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"controls","type":"text"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"inputs","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents\/controls"},"doc://MISOComponents/documentation/MISOComponents/MISOTextualContent":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"MISOTextualContent","kind":"identifier"}],"abstract":[{"text":"A textual value that can be either a plain ","type":"text"},{"code":"String","type":"codeVoice"},{"type":"text","text":" or a styled "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"MISOTextualContent","kind":"identifier"}]