type":"text","text":" displays a status icon (info, warning, positive, negative) with a predefined asset,"},{"type":"text","text":" "},{"type":"text","text":"or a custom neutral icon from a provided image. Each icon type has a semantic color applied automatically"},{"type":"text","text":" "},{"type":"text","text":"based on the current theme."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional notification badge can be attached to neutral icons to indicate additional status."}]},{"type":"heading","anchor":"Status","level":2,"text":"Status"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemIcon\/IconStatus","isActive":true},{"type":"text","text":" enum defines the available icon variants:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".neutral(asset:badge:)"}]},{"text":": A custom icon from a provided ","type":"text"},{"type":"codeVoice","code":"Image"},{"text":" asset, rendered with the default","type":"text"},{"text":" ","type":"text"},{"text":"content color. An optional notification badge (small dot) can be displayed at the top-trailing corner.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".positive"}],"type":"strong"},{"text":": A predefined checkmark\/confirmation icon with a positive (green) semantic color.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".info"}],"type":"strong"},{"type":"text","text":": A predefined information icon with an informational (blue) semantic color."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".warning","type":"codeVoice"}],"type":"strong"},{"text":": A predefined warning icon with a warning (yellow\/orange) semantic color.","type":"text"},{"text":" ","type":"text"},{"text":"This icon uses a two-layer rendering with distinct internal and external shape colors.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".negative"}],"type":"strong"},{"text":": A predefined alert\/important icon with a negative (red) semantic color.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Sizes","type":"heading","level":2,"anchor":"Sizes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemIcon\/Size"},{"type":"text","text":" enum defines the available sizes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".medium"}],"type":"strong"},{"text":": The default size, corresponding to the theme’s ","type":"text"},{"code":"controlItem.sizeAssetMedium","type":"codeVoice"},{"text":" token.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".large"}],"type":"strong"},{"text":": The largest size, corresponding to the theme’s ","type":"text"},{"code":"controlItem.sizeAssetLarge","type":"codeVoice"},{"text":" token.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Note:"}],"type":"strong"},{"type":"text","text":" When the icon is embedded in a list item with small size"},{"type":"text","text":" "},{"type":"text","text":"(via "},{"type":"codeVoice","code":"SwiftUI\/View\/misoListItemSize(_:)"},{"text":"), the icon is always rendered at its smallest size","type":"text"},{"text":" ","type":"text"},{"text":"regardless of the ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" parameter.","type":"text"}]},{"type":"heading","anchor":"Code-samples","level":2,"text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Info icon with medium size (default)","    MISOListItemIcon(status: .info, description: \"Something new\")","","    \/\/ Warning icon with large size","    MISOListItemIcon(status: .warning, description: \"Mobile data almost used\", size: .large)","","    \/\/ Negative icon with medium size","    MISOListItemIcon(status: .negative, description: \"Payment failed\", size: .medium)","","    \/\/ Custom neutral icon without badge","    MISOListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), descritpion: \"Emails\"))","","    \/\/ Custom neutral icon with notification badge","    MISOListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), description: \"New emails received\", badge: true))","","    \/\/ Usage as leading element in a list item","    MISOStaticListItem(","        data: MISOListItemData(label: \"Information\"),","        leading: .icon(MISOListItemIcon(status: .info, description: \"\", size: .medium))","    )","","    \/\/ Usage as trailing element in a list item","    MISOStaticListItem(","        data: MISOListItemData(label: \"Warning\"),","        trailing: .icon(MISOListItemIcon(status: .warning, description: \"\", size: .medium))","    )"]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"OUDS 3.0.0"}],"type":"paragraph"}],"name":"Since"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misolistitemicon"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemIcon"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemIcon\/init(status:description:size:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/