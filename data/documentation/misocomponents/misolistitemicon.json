":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemIcon\/Size","type":"reference"},{"text":" enum defines the available sizes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".medium"}]},{"type":"text","text":": The default size, corresponding to the theme’s "},{"code":"controlItem.sizeAssetMedium","type":"codeVoice"},{"type":"text","text":" token."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".large"}]},{"text":": The largest size, corresponding to the theme’s ","type":"text"},{"code":"controlItem.sizeAssetLarge","type":"codeVoice"},{"text":" token.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note:","type":"text"}]},{"text":" When the icon is embedded in a list item with small size","type":"text"},{"text":" ","type":"text"},{"text":"(via ","type":"text"},{"code":"SwiftUI\/View\/misoListItemSize(_:)","type":"codeVoice"},{"text":"), the icon is always rendered at its smallest size","type":"text"},{"text":" ","type":"text"},{"text":"regardless of the ","type":"text"},{"code":"size","type":"codeVoice"},{"text":" parameter.","type":"text"}],"type":"paragraph"},{"anchor":"Code-samples","text":"Code samples","level":2,"type":"heading"},{"syntax":"swift","code":["    \/\/ Info icon with medium size (default)","    MISOListItemIcon(status: .info, description: \"Something new\")","","    \/\/ Warning icon with large size","    MISOListItemIcon(status: .warning, description: \"Mobile data almost used\", size: .large)","","    \/\/ Negative icon with medium size","    MISOListItemIcon(status: .negative, description: \"Payment failed\", size: .medium)","","    \/\/ Custom neutral icon without badge","    MISOListItemIcon(status: .neutral(asset: Image(decorative: \"ic_heart\"), descritpion: \"Emails\"))","","    \/\/ Cust