status: .negative, size: .medium)))","    )","","    \/\/ List item with avatar as leading and text as trailing","    MISOStaticListItem(","        data: MISOListItemData(label: \"Label\", description: \"Description\"),","        leading: .avatar(.init(type: .icon, size: .medium)),","        trailing: .text(.label(\"Info\"))","    )","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    MISOStaticListItem(","        data: MISOListItemData(label: \"SMS credit\"),","        trailing: .custom {","            MISOCircularProgressIndicator(progress: 0.75)","        }","    )","","    \/\/ List item with slot (displayed under texts, before helper text)","    MISOStaticListItem(","        data: MISOListItemData(","            label: \"Label\",","            textSlot: { Text(\"Additional content\") },","            helperText: \"Helper text\"","        )","    )","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    MISOStaticListItem(","        data: MISOListItemData(","            label: \"Label\",","            bottomSlot: { Text(\"Bottom content\") },","            helperText: \"Helper text\"","        )","    )"],"type":"codeListing","syntax":"swift"},{"text":"Leading elements","level":2,"type":"heading","anchor":"Leading-elements"},{"type":"paragraph","inlineContent":[{"text":"The leading position (before the texts) accepts one optional element via ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemLeading","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".icon(MISOListItemIcon)","type":"codeVoice"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".image(MISOListItemImage)","type":"codeVoice"},{"text":": A static imag