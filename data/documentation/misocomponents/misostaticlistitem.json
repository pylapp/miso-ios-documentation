e":"text"},{"text":"For navigable list items, see ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Code samples","anchor":"Code-samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Simple list item with a label only","    MISOStaticListItem(data: MISOListItemData(label: \"Label\"))","","    \/\/ List item with more textual content","    let data = MISOListItemData(","        label: \"Label\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\"","    )","    MISOStaticListItem(data: data)","","    \/\/ List item with leading icon and trailing badge","    MISOStaticListItem(","        data: MISOListItemData(label: \"Label\"),","        leading: .icon(.init(type: .info, size: .medium)),","        trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))","    )","","    \/\/ List item with avatar as leading and text as trailing","    MISOStaticListItem(","        data: MISOListItemData(label: \"Label\", description: \"Description\"),","        leading: .avatar(.init(type: .icon, size: .medium)),","        trailing: .text(.label(\"Info\"))","    )","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    MISOStaticListItem(","        data: MISOListItemData(label: \"SMS credit\"),","        trailing: .custom {","            MISOCircularProgressIndicator(progress: 0.75)","        }","    )","","    \/\/ List item with slot (displayed under texts, before helper text)","    MISOStaticListItem(","        data: MISOListItemData(","            label: \"Label\",","            textSlot: { Text(\"Additional content\") },","            helperText: \"Helper text\"","        )","    )","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    MISOStaticListItem(","        data: MISOListItemData(","            label: \"Label\",","            bottomSlot: { Text(\"Bottom content\") },","            helperText: \"Helper text\"","        )","    )"]},{"level":2,"type":"heading","text":"Leading elements","anchor":"Leading-elements"},{"type":"paragraph","inlineContent":[{"text":"The leading position (before the texts) accepts one optional element via ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemLeading","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".icon(MISOListItemIcon)","type":"codeVoice"},{"text":": A status or custom icon (neutral, info, warning, negative, positive)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".image(MISOListItemImage)","type":"codeVoice"},{"text":": A static image asset","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".flag(MISOListItemFlag)","type":"codeVoice"},{"text":": A country flag image","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".avatar(MISOListItemAvatar)","type":"codeVoice"},{"text":": An avatar with icon, initials, or image","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".slot { ... }","type":"codeVoice"},{"text":": Any custom SwiftUI view","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Trailing elements","anchor":"Trailing-elements"},{"type":"paragraph","inlineContent":[{"text":"The trailing position (after the texts) accepts one optional element via ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemTrailing","isActive":true},{"text":", like:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.label(String))"},{"type":"text","text":": A default-styled label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelMuted(String))"},{"type":"text","text":": A muted (secondary) label"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".text(.labelStrong(String))"},{"type":"text","text":": An emphasized (bold) label"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".text(.labelAndExtraLabel(String, String))","type":"codeVoice"},{"type":"text","text":": A label with an additional extra label below"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".badge(.count(MISOBadgeCount))"},{"type":"text","text":": A badge with count"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".badge(.standard(MISOBadgeStandard))","type":"codeVoice"},{"text":": A badge with standard status","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".tag(MISOTag)","type":"codeVoice"},{"text":": A tag for categorization","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".icon(MISOListItemIcon)","type":"codeVoice"},{"text":": A status or custom icon","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".image(MISOListItemImage)","type":"codeVoice"},{"text":":  A static image asset","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".flag(MISOListItemFlag)","type":"codeVoice"},{"text":": A country flag image","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".avatar(MISOListItemAvatar)"},{"type":"text","text":": An avatar with icon, initials, or image"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".slot { ... }"},{"type":"text","text":": Any custom SwiftUI view"}]}]}],"type":"unorderedList"},{"anchor":"View-modifiers","text":"View modifiers","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Several vie