{"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem\/init(data:leading:trailing:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOStaticListItem"}]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem","isActive":true},{"type":"text","text":" typically contains a label, and optionally a description, an overline, an extra label,"},{"type":"text","text":" "},{"type":"text","text":"a text slot, a bottom slot, and a helper text — all provided through "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It can also include an optional leading element (such as an icon, image, avatar, flag or custom view)"},{"type":"text","text":" "},{"type":"text","text":"and an optional trailing element (such as a text, badge, tag, icon, image, avatar, flag or custom view)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this component when the list item should only display information without triggering any navigation or action."},{"type":"text","text":" "},{"type":"text","text":"For navigable list items, see "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","isActive":true},{"type":"text","text":"."}]},{"text":"Code samples","anchor":"Code-samples","type":"heading","level":2},{"code":["    \/\/ Simple list item with a label only","    MISOStaticListItem(data: MISOListItemData(label: .textual(\"Label\")))","","    \/\/ List item with more textual content","    let data = MISOListItemData(","        label: \"Label\",","        description: \"Description\",","        overline: \"Overline\",","        extraLabel: \"Extra Label\"","    )","    MISOStaticListItem(data: data)","","    \/\/ List item with leading icon and trailing badge","    MISOStaticListItem(","        data: MISOListItemData(label: .textual(\"Label\")),","        leading: .icon(.init(type: .info, size: .medium)),","        trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))","    )","","    \/\/ List item with avatar as leading and text as trailing","    MISOStaticListItem(","        data: MISOListItemData(label: \"Label\", description: \"Description\"),","        leading: .avatar(.init(type: .icon, size: .medium)),","        trailing: .text(.label(\"Info\"))","    )","","    \/\/ List item with a custom view as trailing, e.g. a gauge showing a remaining SMS credit","    MISOStaticListItem(","        data: MISOListItemData(label: .textual(\"SMS credit\")),","        trailing: .custom {","            MISOCircularProgressIndicator(progress: 0.75)","        }","    )","","    \/\/ List item with slot (displayed under texts, before helper text)","    MISOStaticListItem(","        data: MISOListItemData(","            label: \"Label\",","            textSlot: .init { Text(\"Additional content\") },","            helperText: \"Helper text\"","        )","    )","","    \/\/ List item with bottomSlot (displayed under main content, before helper text)","    MISOStaticListItem(","        data: MISOListItemData(","            label: \"Label\",","            bottomSlot: .init { Text(\"Bottom content\") },","            helperText: \"Helper text\"","        )","    )"],"type":"codeListing","syntax":"swift"},{"text":"Leading elements","anchor":"Leading-elements","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The leading position (before the texts) accepts one optional element via ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemLeading"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".icon(MISOListItemIcon)"},{"type":"text","text":": A status or custom icon (neutral, info, warning, negative, positive)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".image(MISOListItemImage)"},{"text":": A static image asset","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".flag(MISOListItemFlag)","type":"codeVoice"},{"type":"text","text":": A country flag image"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".avatar(MISOListItemAvatar)"},{"text":": An avatar with icon, initials, or image","type":"