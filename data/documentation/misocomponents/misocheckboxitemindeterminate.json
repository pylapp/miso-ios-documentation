{"metadata":{"platforms":[{"introducedAt":"15.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"13.0","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"16.0","name":"tvOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"1.0","name":"visionOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"11.0","name":"watchOS","unavailable":false,"beta":false,"deprecated":false}],"title":"MISOCheckboxItemIndeterminate","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOCheckboxItemIndeterminate"}],"roleHeading":"Structure","modules":[{"name":"Components"}],"navigatorTitle":[{"kind":"identifier","text":"MISOCheckboxItemIndeterminate"}],"role":"symbol","externalID":"s:14MISOComponents29MISOCheckboxItemIndeterminateV"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate"},"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate\/init(_:selection:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:action:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate\/init(_:tableName:bundle:selection:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:action:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate\/body"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate\/View-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misocheckboxitemindeterminate"]}],"abstract":[{"type":"text","text":"Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices."},{"type":"text","text":" "},{"type":"text","text":"Checkbox item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCheckboxItemIndeterminate","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls"],"kind":"mentions"},{"kind":"content","content":[{"level":2,"text":"Layouts","anchor":"Layouts","type":"heading"},{"inlineContent":[{"text":"The component can be rendered as two different layouts:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"text":": the component has a leading indicator, a label and optional helper texts, and an optional trailing decorative icon","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"inverse"}]},{"text":": like the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"text":" layout but with a trailing checkbox indicator and a leading optional image","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Indicator-states","text":"Indicator states"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The checkbox indicator has three available states:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"selected"}],"type":"strong"},{"text":": the checkbox is filled with a tick, the user has made the action to select the checkbox","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"unselected","type":"text"}],"type":"strong"},{"text":": the checkbox is empty, does not contain a tick, the user has made the action to unselect or did not select yet the checkbox","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":": mike a prefilled or preticked checkbox, the user did not do anything on it yet"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"If you need a checkbox with only two states to manage use instead ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"level":2,"text":"Particular cases","anchor":"Particular-cases","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate","type":"reference","isActive":true},{"type":"text","text":" can be related to an error situation, for example troubles for a form."},{"type":"text","text":" "},{"type":"text","text":"A dedicated look and feel is implemented for that if the "},{"type":"codeVoice","code":"isError"},{"type":"text","text":" flag is risen."},{"type":"text","text":" "},{"type":"text","text":"In that case if the component displayed an icon, this icon will be replaced automatically by an error icon."}]},{"type":"paragraph","inlineContent":[{"text":"In addition, the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate","type":"reference"},{"text":" can be in read only mode, i.e. the user cannot interact with the component yet","type":"text"},{"text":" ","type":"text"},{"text":"but this component must not be considered as disabled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component does not follow the right-to-left (RTL) \/ left-to-right (LTR) mode returned by the system as it could have some meaning"},{"type":"text","text":" "},{"type":"text","text":"to have for example the indicator in trailing position for LTR mode and vice versa."},{"type":"text","text":" "},{"type":"text","text":"However, if the component has an icon in leading position (RTL mode) or in trailing position (LTR), the content of the icon is never changed."},{"type":"text","text":" "},{"type":"text","text":"It could lead to a loss of meaning or semantics in the icon. Thus the "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOImage","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"codeVoice","code":"flipped"},{"type":"text","text":" property can be used to flip the icon content"},{"type":"text","text":" "},{"type":"text","text":"whatever the layout direction is, preventing the user from implementing their own rules to flip or not the image."}]},{"level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Voice Over","type":"text"}]},{"text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and helper texts and a custom checkbox trait.","type":"text"}]},{"text":"Forbidden by design","anchor":"Forbidden-by-design","level":2,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"The design system does not allow to have both an error situation and a read only component.","type":"text"}]},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"The design system does not allow to have both an error situation and a disabled component."}]},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"The design system does not allow to have both a read only and a disabled component.","type":"text"}]}],"type":"paragraph"},{"text":"Code samples","anchor":"Code-samples","level":2,"type":"heading"},{"code":["    \/\/ Supposing we have an indeterminate state checkbox","    @Published var selection: MISOCheckboxIndicatorState = .indeterminate","","    \/\/ A leading checkbox with a label.","    MISOCheckboxItemIndeterminate(\"Hello world\", selection: $selection)","","    \/\/ Localizable from bundle can also be used","    MISOCheckboxItemIndeterminate(LocalizedStringKey(\"select_all\"), bundle: Bundle.module, selection: $selection)","","    \/\/ A leading checkbox with a label, but in read only mode.","    MISOCheckboxItemIndeterminate(\"Hello world\", selection: $selection, isReadOnly: true)","","    \/\/ A leading checkbox with a label and a description as helper text.","    MISOCheckboxItemIndeterminate(\"Bazinga!\", selection: $selection, description: \"Doll-Dagga Buzz-Buzz Ziggety-Zag\")","","    \/\/ A trailing checkbox with a label, an helper text and an icon (tinted, default rendering).","    MISOCheckboxItemIndeterminate(\"We live in a fabled world\",","                                  selection: $selection,","                                  description: \"Of dreaming boys and wide-eyed girls\",","                                  image: MISOImage(asset: Image(decorative: \"ic_heart\")),","                                  isReversed: true)","","    \/\/ A trailing checkbox with a raw (non-tinted) image.","    MISOCheckboxItemIndeterminate(\"We live in a fabled world\",","                                  selection: $selection,","                                  description: \"Of dreaming boys and wide-eyed girls\",","                                  image: MISOImage(asset: Image(decorative: \"il_someImage\"), renderingMode: .original),","                                  isReversed: true)","","    \/\/ Flip the icon for RTL layouts using MISOImage.","    MISOCheckboxItemIndeterminate(\"Cocorico !\",","                                  selection: $selection,","                                  image: MISOImage(asset: Image(systemName: \"figure.handball\"),","                                                   flipped: layoutDirection == .rightToLeft),","                                  isReversed: layoutDirection == .rightToLeft)","","    \/\/ If on error, add an error message can help user to understand error context","    MISOCheckboxItemIndeterminate(\"We live in a fabled world\",","                                  selection: $selection,","                                  isError: true,","                                  errorText: \"Something wrong\",","                                  hasDivider: true)","","    \/\/ A leading checkbox with a label, but disabled.","    MISOCheckboxItemIndeterminate(\"Hello world\", selection: $selection)","        .disabled(true)","","    \/\/ Never disable a read only or an error-related checkbox as it will crash","    \/\/ This is forbidden by design!","    MISOCheckboxItemIndeterminate(\"Hello world\", selection: $selection, isError: true).disabled(true) \/\/ fatal error","    MISOCheckboxItemIndeterminate(\"Hello world\", selection: $selection, isReadOnly: true).disabled(true) \/\/ fatal error"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Version","content":[{"inlineContent":[{"type":"text","text":"2.4.0 (Figma component design version)"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.12.0"}],"type":"paragraph"}],"type":"aside"}]}],"references":{"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"type":"topic","title":"Components"},"doc://MISOComponents/documentation/MISOComponents/MISOCheckboxItemIndeterminate/View-Implementations":{"url":"\/documentation\/misocomponents\/misocheckboxitemindeterminate\/view-implementations","kind":"article","role":"collectionGroup","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate\/View-Implementations","type":"topic","title":"View Implementations","abstract":[]},"doc://MISOComponents/documentation/MISOComponents/MISOCheckboxItemIndeterminate/init(_:tableName:bundle:selection:description:image:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:action:)":{"type":"topic","kind":"symbol","url":"\/documentation\/misocomponents\/misocheckboxitemindeterminate\/init(_:tablename:bundle:selection:description:image:isreversed:iserror:errortext:isreadonly:hasdivider:constrainedmaxwidth:action:)","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItemIndeterminate\/init(_:tableName:bundle:selection:description:image:isReversed:isError:errorTe