{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"role":"article","roleHeading":"Article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"modules":[{"name":"Components"}],"title":"Content Display"},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"level":3,"type":"heading","anchor":"Bullet-List","text":"Bullet List"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList","type":"reference"},{"type":"text","text":" is a UI element that helps to display related individual text items grouped together; items usually start with a number or a bullet."}],"type":"paragraph"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_bullet_list_BlueCoat","type":"image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"component_bullet_list_FoxyRough","type":"image"}],"type":"paragraph"}],"title":"FoxyRough"}],"type":"tabNavigator"},{"inlineContent":[{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList","isActive":true,"type":"reference"},{"text":" is also known as ","type":"text"},{"inlineContent":[{"type":"text","text":"Unordered list"}],"type":"emphasis"},{"type":"text","text":" or "},{"inlineContent":[{"type":"text","text":"Ordered list"}],"type":"emphasis"},{"text":" and is not an interactive element by default.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Bare list with 3 items","MISOBulletList(type: .bare) {","    MISOBulletList.Item(\"Label 1\")","    MISOBulletList.Item(\"Label 2\")","    MISOBulletList.Item(\"Label 3\")","}","","\/\/ Item of Unordered list with bullet as tick, a text style","\/\/ body medium and text bold