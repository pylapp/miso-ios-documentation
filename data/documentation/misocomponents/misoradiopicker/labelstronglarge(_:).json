ugh an extension or inside a method.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"labelStrongLarge","kind":"identifier"},{"text":"(","kind":"text"},{"text":"MISOTheme","preciseIdentifier":"s:18MISOThemesContract9MISOThemeC","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISORadioItem":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem","navigatorTitle":[{"kind":"identifier","text":"MISORadioItem"}],"url":"\/documentation\/misocomponents\/misoradioitem","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISORadioItem"}],"title":"MISORadioItem","kind":"symbol","abstract":[{"text":"Radio button item is a UI element that allows to select a single option from a set of mutually exclusive choices.","type":"text"},{"text":" ","type":"text"},{"text":"Radio button item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets.","type":"text"}]},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOTheme":{"url":"\/documentation\/misothemescontract\/misotheme","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","kind":"symbol","title":"MISOTheme","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTheme","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MISOTheme","kind":"identifier"}],"abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as