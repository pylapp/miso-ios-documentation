{"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"sections":[],"abstract":[{"text":"Password input is a UI element that allows to securely and confidentially capture a user’s password.","type":"text"},{"text":" ","type":"text"},{"text":"As it is based on the ","type":"text"},{"type":"codeVoice","code":"MISOTextInput"},{"text":",  it offers same layout and the same elements of configuration.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOPasswordInput"}]}]},{"kind":"content","content":[{"text":"Layout","anchor":"Layout","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Passwords input is based on several configurable UI elements:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"label"}]},{"type":"text","text":": It is used to describe the purpose of the input."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"placeholder","type":"text"}]},{"text":":  A prefix is not common and is discouraged in a Password Input component. In very specific cases, it can provide","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"context or format requirements (e.g., “DEV-” for test accounts, “admin-” as a pattern to define an admin password)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"lock icon"}],"type":"strong"},{"text":": it helps to reinforce the security context.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper text"}]},{"type":"text","text":":  A supporting text conveys additional information about the password field."}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Outlined style","anchor":"Outlined-style"},{"inlineContent":[{"text":"By ","type":"text"},{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look.","type":"text"}],"type":"paragraph"},{"code":["   \/\/ An outlined text input","   MISOPasswordInput(label: \"Your password\", password: $password, isOutlined: true)","","   \/\/ With a localizable from a bundle","   MISOPasswordInput(LocalizedStringKey(\"password_label\"), bundle: Bundle.module, password: $password)"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Rounded layout","anchor":"Rounded-layout"},{"inlineContent":[{"text":"As the","type":"text"},{"code":" MISOTextInput","type":"codeVoice"},{"text":", rounded corners can be enabled or disabled using the ","type":"text"},{"code":"hasRoundedTextInputs","type":"codeVoice"},{"text":" values of the ","type":"text"},{"code":"Tuning","type":"codeVoice"},{"text":" object","type":"text"},{"text":" ","type":"text"},{"text":"in your theme configuration.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Status","anchor":"Status"},{"inlineContent":[{"text":"As ","type":"text"},{"code":"MISOPasswordInput","type":"codeVoice"},{"text":" is based on the","type":"text"},{"code":" MISOTextInput","type":"codeVoice"},{"text":", all the status are the same and have the same behavior available here ","type":"text"},{"type":"codeVoice","code":"MISOTextInput.Status"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"inlineContent":[{"text":"By default no haptics are done by the component for the trailing action.","type":"text"},{"text":" ","type":"text"},{"text":"However you should think about cases wher you will have to make the devices vibrates.","type":"text"},{"text":" ","type":"text"},{"text":"You can refer to the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Rich text","anchor":"Rich-text","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"text":"Code samples","type":"heading","level":2,"anchor":"Code-samples"},{"code":["    \/\/ The password to display and edit","    @State var password: String = \"\"","","    \/\/ A basic password input with label","    MISOPasswordInput(label: \"Password\", password: $password)","","    \/\/ Add a leading icon and helper text to more context","    MISOPasswordInput(label: \"Password\", password: $password, lockIcon: true, helperText: \"Your password must be between 8 and 20 characters long.\")","","    \/\/ Password with prefix","    MISOPasswordInput(label: \"Password\", password: $password, prefix: \"CORP-\")","","    \/\/ Make password visible","    MISOPasswordInput(label: \"Password\", password: $password, isHiddenPassword: .constant(false))"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.3.1 (Figma component design version)"}]}]},{"style":"note","type":"aside","name":"Since","content":[{"inlineContent":[{"typ