{"metadata":{"platforms":[{"deprecated":false,"beta":false,"unavailable":false,"name":"iOS","introducedAt":"15.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"macOS","introducedAt":"13.0"},{"deprecated":false,"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0"}],"navigatorTitle":[{"text":"MISOPasswordInput","kind":"identifier"}],"title":"MISOPasswordInput","modules":[{"name":"Components"}],"roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOPasswordInput","kind":"identifier"}],"role":"symbol","externalID":"s:14MISOComponents17MISOPasswordInputV"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misopasswordinput"]}],"kind":"symbol","relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOPasswordInput"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Layout","type":"heading","level":2,"anchor":"Layout"},{"type":"paragraph","inlineContent":[{"text":"Passwords input is based on several configurable UI elements:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"label"}]},{"type":"text","text":": It is used to describe the purpose of the input."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"placeholder"}]},{"type":"text","text":":  A prefix is not common and is discouraged in a Password Input component. In very specific cases, it can provide"},{"type":"text","text":" "},{"type":"text","text":"context or format requirements (e.g., “DEV-” for test accounts, “admin-” as a pattern to define an admin password)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"lock icon"}]},{"type":"text","text":": it helps to reinforce the security context."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper text"}]},{"type":"text","text":":  A supporting text conveys additional information about the password field."}]}]}]},{"text":"Outlined style","type":"heading","level":2,"anchor":"Outlined-style"},{"type":"paragraph","inlineContent":[{"text":"By ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look.","type":"text"}]},{"type":"codeListing","code":["   \/\/ An outlined text input","   MISOPasswordInput(label: \"Your password\", password: $password, isOutlined: true)","","   \/\/ With a localizable from a bundle","   MISOPasswordInput(LocalizedStringKey(\"password_label\"), bundle: Bundle.module, password: $password)"],"syntax":"swift"},{"text":"Rounded layout","type":"heading","level":3,"anchor":"Rounded-layout"},{"type":"paragraph","inlineContent":[{"text":"As the","type":"text"},{"code":" MISOTextInput","type":"codeVoice"},{"text":", rounded corners can be enabled or disabled using the ","type":"text"},{"code":"hasRoundedTextInputs","type":"codeVoice"},{"text":" values of the ","type":"text"},{"code":"Tuning","type":"codeVoice"},{"text":" object","type":"text"},{"text":" ","type":"text"},{"text":"in your theme configuration.","type":"text"}]},{"text":"Status","type":"heading","level":2,"anchor":"Status"},{"type":"paragraph","inlineContent":[{"text":"As ","type":"text"},{"code":"MISOPasswordInput","type":"codeVoice"},{"text":" is based on the","type":"text"},{"code":" MISOTextInput","type":"codeVoice"},{"text":", all the status are the same and have the same behavior available here ","type":"text"},{"code":"MISOTextInput.Status","type":"codeVoice"}]},{"text":"Accessibility considerations","type":"heading","level":2,"anchor":"Accessibility-considerations"},{"inlineContent":[{"type":"text","text":"By default no haptics are done by the component for the trailing action."},{"type":"text","text":" "},{"type":"text","text":"However you should think about cases wher you will have to make the devices vibrates."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Rich text","type":"heading","level":2,"anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}]},{"text":"Code samples","type":"heading","level":2,"anchor":"Code-samples"},{"syntax":"swift","code":["    \/\/ The password to display and edit","    @State var password: String = \"\"","","    \/\/ A basic password input with label","    MISOPasswordInput(label: \"Password\", password: $password)","","    \/\/ Add a leading icon and helper text to more context","    MISOPasswordInput(label: \"Password\", password: $password, lockIcon: true, helperText: \"Your password must be between 8 and 20 characters long.\")","","    \/\/ Password with prefix","    MISOPasswordInput(label: \"Password\", password: $password, prefix: \"CORP-\")","","    \/\/ Make password visible","    MISOPasswordInput(label: \"Password\", password: $password, isHiddenPassword: .constant(false))"],"type":"codeListing"},{"name":"Version","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"1.3.1 (Figma component design version)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 1.2.0"}]}],"style":"note","name":"Since","type":"aside"}]}],"sections":[],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPasswordInput\/init(_:tableName:bundle:password:isHiddenPassword:placeholder:prefix:lockIcon:helperText:isOutlined:constrainedMaxWidth:status:)-21taz","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPasswordInput\/init(_:tableName:bundle:password:isHiddenPassword:placeholder:prefix:lockIcon:helperText:isOutlined:constrainedMaxWidth:status:)-67shq","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPasswordInput\/init(label:password:isHiddenPassword:placeholder:prefix:lockIcon:helperText:isOutlined:constrainedMaxWidth:status:)-8kt01","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPasswordInput\/init(label:password:isHiddenPassword:placeholder:prefix:lockIcon:helperText:isOutlined:constrainedMaxWidth:status:)-9smbe"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPasswordInput\/body"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPasswordInput\/View-Implem