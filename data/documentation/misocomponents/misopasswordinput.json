 think about cases wher you will have to make the devices vibrates."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","type":"reference"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Rich text","anchor":"Rich-text"},{"type":"paragraph","inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}]},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","code":["    \/\/ The password to display and edit","    @State var password: String = \"\"","","    \/\/ A basic password input with label","    MISOPasswordInput(label: \"Password\", password: $password)","","    \/\/ Add a leading icon and helper text to more context","    MISOPasswordInput(label: \"Password\", password: $password, lockIcon: true, helperText: \"Your password must be between 8 and 20 characters long.\")","","    \/\/ Password with prefix","    MISOPasswordInput(label: \"Password\", password: $password, prefix: \"CORP-\")","","    \/\/ Make password visible","    MISOPasswordInput(label: \"Password\", password: $password, isHiddenPassword: .constant(false))"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"text":"1.3.1 (Figma component design version)","type":"text"}],"type":"paragraph"}],"name":"Version","style":"note"},{"type":"aside","content":[{"inlineContent":[{"text":"OUDS 1.2.0","type":"text"}],"type":"paragraph"}],"name":"Since",