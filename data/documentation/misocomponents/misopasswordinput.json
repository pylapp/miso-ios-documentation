{"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"text":"Password input is a UI element that allows to securely and confidentially capture a user’s password.","type":"text"},{"text":" ","type":"text"},{"text":"As it is based on the ","type":"text"},{"code":"MISOTextInput","type":"codeVoice"},{"text":",  it offers same layout and the same elements of configuration.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOPasswordInput","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Layout","anchor":"Layout"},{"type":"paragraph","inlineContent":[{"text":"Passwords input is based on several configurable UI elements:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"label"}],"type":"strong"},{"text":": It is used to describe the purpose of the input.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"placeholder","type":"text"}]},{"text":":  A prefix is not common and is discouraged in a Password Input component. In very specific cases, it can provide","type":"text"},{"text":" ","type":"text"},{"text":"context or format requirements (e.g., “DEV-” for test accounts, “admin-” as a pattern to define an admin password)","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"lock icon"}],"type":"strong"},{"text":": it helps to reinforce the security context.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Helper text","type":"text"}]},{"text":":  A supporting text conveys additional information about the password field.","type":"text"}]}]}]},{"text":"Outlined style","anchor":"Outlined-style","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"By "},{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look."}],"type":"paragraph"},{"code":["   \/\/ An outlined text input","   MISOPasswordInput(label: \"Your password\", password: $password, isOutlined: true)","","   \/\/ With a localizable from a bundle","   MISOPasswordInput(LocalizedStringKey(\"password_label\"), bundle: Bundle.module, password: $password)"],"syntax":"swift","type":"codeListing"},{"text":"Rounded layout","anchor":"Rounded-layout","type":"heading","level":3},{"inlineContent":[{"text":"As the","type":"text"},{"type":"codeVoice","code":" MISOTextInput"},{"text":", rounded corners can be enabled or disabled using the ","type":"text"},{"type":"codeVoice","code":"hasRoundedTextInputs"},{"text":" values of the ","type":"text"},{"type":"codeVoice","code":"Tuning"},{"text":" object","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in your theme configuration."}],"type":"paragraph"},{"anchor":"Status","level":2,"text":"Status","type":"heading"},{"inlineContent":[{"type":"text","text":"As "},{"type":"codeVoice","code":"MISOPasswordInput"},{"type":"text","text":" is based on the"},{"type":"codeVoice","code":" MISOTextInput"},{"type":"text","text":", all the status are the same and have the same behavior available here "},{"type":"codeVoice","code":"MISOTextInput.Status"}],"type":"paragraph"},{"anchor":"Accessibility-considerations","level":2,"text":"Accessibility considerations","type":"heading"},{"inlineContent":[{"type":"text","text":"By default no haptics are done by the component for the trailing action."},{"type":"text","text":" "},{"type":"text","text":"However you should think about cases wher you will have to make the devices vibrates."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"isActive":true,"type":"reference","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Rich-text","level":2,"text":"Rich text","type":"heading"},{"inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}],"type":"paragraph"},{"anchor":"Code-samples","level":2,"text":"Code samples","type":"heading"},{"syntax":"swift","code":["    \/\/ The password to display and edit","    @State var password: String = \"\"","","    \/\/ A basic password input with label","    MISOPasswordInput(label: \"Password\", password: $password)","","    \/\/ Add a leading icon and helper text to more context","    MISOPasswordInput(label: \"Password\", password: $password, lockIcon: true, helperText: \"Your password must be between 8 and 20 characters long.\")","","    \/\/ Password with prefix","    MISOPasswordInput(label: \"Password\", password: $password, prefix: \"CORP-\")","","    \/\/ Make password visible","    MISOPasswordInput(label: \"Password\", password: $password, isHiddenPassword: .constant(false))"],"type":"codeListing"},{"name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"1.3.1 (Figma component design version)","type":"text"}]}],"style":"note","type":"aside"},{"name":"Since","content":[{"inlineContent":[{"text":"OUDS 1.2.0","type":"text"}],"type":"para