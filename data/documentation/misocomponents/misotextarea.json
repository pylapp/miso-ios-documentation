le":"MISOTextArea.HelperText"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea/View-Implementations":{"title":"View Implementations","kind":"article","type":"topic","abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/View-Implementations","role":"collectionGroup","url":"\/documentation\/misocomponents\/misotextarea\/view-implementations"},"doc://MISOComponents/documentation/MISOComponents/Controls":{"title":"Controls","kind":"article","type":"topic","abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"type":"text","text":"controls"}],"type":"strong"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"inputs"}],"type":"strong"},{"type":"text","text":"."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls","role":"article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"url":"\/documentation\/misocomponents\/controls"},"doc://MISOComponents/7SwiftUI4ViewP":{"title":"SwiftUICore.View","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","type":"unresolvable"},"ic_folder_categories.png":{"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null,"identifier":"ic_folder_categories.png","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea/body":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/body","role":"symbol","abstract":[],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misotextarea\/body","type":"topic","title":"body"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea/Helperlink":{"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Helperlink"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Helperlink"}],"title":"MISOTextArea.Helperlink","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/Helperlink","abstract":[{"text":"Used to describe the helper link below the text area.","type":"text"}],"url":"\/documentation\/misocomponents\/misotextarea\/helperlink"}}}