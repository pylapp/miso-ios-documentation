 "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"constrainedMaxHeight"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents12MISOTextAreaV","text":"MISOTextArea","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14MISOComponents12MISOTextAreaV6StatusO","text":"Status","kind":"typeIdentifier"},{"kind":"text","text":")"}],"kind":"symbol","abstract":[{"type":"text","text":"Creates a text area."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","role":"symbol","title":"init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","url":"\/documentation\/misocomponents\/misotextarea\/init(label:text:placeholder:helpertext:helperlink:isoutlined:constrainedmaxwidth:constrainedmaxheight:status:)","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea/Helperlink":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Helperlink"}],"abstract":[{"type":"text","text":"Used to describe the helper link below the text area."}],"title":"MISOTextArea.Helperlink","navigatorTitle":[{"kind":"identifier","text":"Helperlink"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/Helperlink","kind":"symbol","url":"\/documentation\/misocomponents\/misotextarea\/helperlink","role":"symbol","type":"topic"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/misocomponents","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","title":"Components","role":"collection","type":"topic"},"doc://MISOComponents/7SwiftUI4ViewP":{"title":"SwiftUICore.View","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP"}}}