{"variants":[{"paths":["\/documentation\/misocomponents\/misotextarea"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Structure","platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"unavailable":false,"beta":false},{"name":"macOS","introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false}],"externalID":"s:14MISOComponents12MISOTextAreaV","role":"symbol","title":"MISOTextArea","modules":[{"name":"Components"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MISOTextArea"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTextArea"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTextArea"}],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls"],"kind":"mentions"},{"kind":"content","content":[{"text":"Layout","type":"heading","level":2,"anchor":"Layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Text area is based on several configurable UI elements:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"label","type":"text"}],"type":"strong"},{"text":": It is used to describe the purpose of the text area.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"In some UI contexts, especially when space is limited or when the text area is part of a compact layout, the label can be hidden."},{"type":"text","text":" "},{"type":"text","text":"However, hiding the label should only be done if the purpose remains clear thanks to a placeholder or contextual icon"},{"type":"text","text":" "},{"type":"text","text":"and if the label is still accessible to screen readers."},{"type":"text","text":" "},{"type":"text","text":"Hiding a label is a design choice that must balance visual simplicity and clarity of intent, without compromising inclusiveness or form guidance."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"placeholder","type":"text"}],"type":"strong"},{"text":": If the text of the text area is empty a placeholder provides a hint or guidance inside the field to suggest expected input.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Status","type":"heading","anchor":"Status","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Five status are proposed for all layouts:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"enabled (by default)"}],"type":"strong"},{"text":": Default neutral appearance, whether empty or filled.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to click, focus, and type freely without restrictions.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"error"}]},{"type":"text","text":": The "},{"code":"error","type":"codeVoice"},{"text":" status indicates that the user input does not meet validation rules or","type":"text"},{"text":" ","type":"text"},{"text":"expected formatting. It provides immediate visual feedback, typically through a red border,","type":"text"},{"text":" ","type":"text"},{"text":"an error icon, and a clear, accessible error message positioned below the text area. The error message replaces the helper text.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"loading"}]},{"type":"text","text":": The "},{"type":"codeVoice","code":"loading"},{"type":"text","text":" state indicates that the system is processing or retrieving data"},{"type":"text","text":" "},{"type":"text","text":"related to the text entered. A progress indicator appears to inform the user that an action is in progress."},{"type":"text","text":" "},{"type":"text","text":"The field remains editable while loading."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"readOnly"}]},{"text":": The ","type":"text"},{"code":"readOnly","type":"codeVoice"},{"text":" status lets the text visible but not editable.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"disabled"}],"type":"strong"},{"text":": In ","type":"text"},{"code":"disabled","type":"codeVoice"},{"text":" status, the field is non-interactive and grayed out to indicate it cannot be changed.","type":"text"},{"text":" ","type":"text"},{"text":"Note the SwiftUI ","type":"text"},{"code":"View.disabled()","type":"codeVoice"},{"text":" is ignored.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Helpers","anchor":"Helpers","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper text (plain)"}]},{"type":"text","text":": A supporting text conveys additional information about the text area,"},{"type":"text","text":" "},{"type":"text","text":"such as how it will be used. It should ideally only take up a single line, though may wrap"},{"type":"text","text":" "},{"type":"text","text":"to multiple lines if required, and be either persistently visible or visible only on focus."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Helper text (characters max count)","type":"text"}]},{"type":"text","text":": Uses an internal message displaying the count of remaining characters depending to the given value."},{"type":"text","text":" "},{"type":"text","text":"This is a specific iOS library feature with 1.4.0"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper link"}]},{"text":": If the helper text is not sufficient, it’s possible to offer the user","type":"text"},{"text":" ","type":"text"},{"text":"an additional help link (the link can be external or open a modal).","type":"text"}]}]}]},{"text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"By default no haptics are done by the component."},{"type":"text","text":" "},{"text":"However you should think about cases where you will have to make the devices vibrate.","type":"text"},{"text":" ","type":"text"},{"text":"You can refer to the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Mandatory-field-indication","level":2,"text":"Mandatory field indication","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If all fields are mandatory (several fields present): display the message “All fields are mandatory” at the top of your form."},{"type":"text","text":" "},{"type":"text","text":"Do not use an asterisk at the end of each field label, nor the word “mandatory.”"}]},{"type":"paragraph","inlineContent":[{"text":"If not all fields are mandatory (several fields present): display the message “All fields marked with an * are mandatory” at the top of your form.","type":"text"},{"text":" ","type":"text"},{"text":"Use an asterisk (*) at the end of each mandatory field label, and ensures this is well vocalized.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"UI rendering of the asterisk must be done with ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"bold font weight","type":"text"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"negative content color","type":"text"}]},{"type":"text","text":" (red on light backgrounds)."}]},{"inlineContent":[{"type":"text","text":"Use the mention “(optional)” at the end of each optional field label. Note that this rule is not systematic, it remains an option, to be used if needed."}],"type":"paragraph"},{"inlineContent":[{"text":"If there is only one field in the form, or if the mandatory nature is obvious,","type":"text"},{"text":" ","type":"text"},{"text":"no mention is necessary since the fields are essential to the form’s functionality.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Outlined-style","type":"heading","text":"Outlined style"},{"inlineContent":[{"type":"text","text":"By "},{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":", the text area uses a subtle background fill and a bottom border only, creating a softer and more contained look."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When "},{"type":"strong","inlineContent":[{"text":"outlined","type":"text"}]},{"type":"text","text":", the text area uses a transparent background and a visible stroke on all four sides."},{"type":"text","text":" "},{"type":"text","text":"This style may be appropriate for contexts where inputs need to feel lightweight and unobtrusive,"},{"type":"text","text":" "},{"type":"text","text":"for example inside a card, a dialog, or a filtering panel."}],"type":"paragraph"},{"syntax":"swift","code":["    \/\/ An outlined text area","    MISOTextArea(label: \"Comments\", text: $text, isOutlined: true)"],"type":"codeListing"},{"level":2,"anchor":"Fixed-height","type":"heading","text":"Fixed height"},{"inlineContent":[{"type":"text","text":"By "},{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"type":"text","text":", the text area grows vertically as the user types, up to a maximum height defined by the"},{"type":"text","text":" "},{"type":"text","text":"design system (token "},{"code":"sizeMaxHeightInput","type":"codeVoice"},{"type":"text","text":"). Once that height is reached, the content becomes scrollable."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"constrainedMaxHeight","type":"codeVoice"},{"type":"text","text":" is set to "},{"code":"true","type":"codeVoice"},{"text":", the maximum height is capped to the ","type":"text"},{"type":"strong","inlineContent":[{"text":"minimum","type":"text"}]},{"type":"text","text":" height"},{"type":"text","text":" "},{"type":"text","text":"(token "},{"code":"sizeMinHeightInput","type":"codeVoice"},{"text":"), keeping the component at a fixed, compact size at all times.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The content is immediately scrollable from the first overflow line."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful in dense layouts — forms, filter panels, chat composers — where vertical space is at a premium."}]},{"type":"codeListing","code":["    \/\/ Height is fixed to the minimum (no vertical growth)","    MISOTextArea(label: \"Comments\", text: $text, constrainedMaxHeight: true)"],"syntax":"swift"},{"type":"heading","anchor":"Rich-text","level":2,"text":"Rich text"},{"type":"paragraph","inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}]},{"type":"heading","anchor":"Code-samples","level":2,"text":"Code samples"},{"type":"codeListing","code":["    \/\/ The text to display and edit","    @State var text: String = \"\"","","    \/\/ Empty text and no placeholder","    MISOTextArea(label: \"Comments\", text: $text)","","    \/\/ Empty text with placeholder","    MISOTextArea(label: \"Comments\", text: $text, placeholder: \"Describe your issue in detail\")","","    \/\/ With a plain helper text","    MISOTextArea(label: \"Comments\",","                 text: $text,","                 placeholder: \"Describe your issue in detail\",","                 helperText: .plain(\"Maximum 500 characters.\"))","","    \/\/ With a maximum character count — the component shows \"X characters remaining\" (bold)","    \/\/ and switches to an error style when exceeded.","    MISOTextArea(label: \"Comments\",","                 text: $text,","                 helperText: .charactersMaxCount(500))","","    \/\/ With helper link","    @Environment(\\.openURL) private var openUrl","","    let helperLink = MISOTextArea.Helperlink(text: \"Helper Link\") {","       openUrl.callAsFunction(url)","    }","","    MISOTextArea(label: \"Comments\", text: $text, placeholder: \"Placeholder\", helperLink: helperLink)","","    \/\/ With error status","    MISOTextArea(label: \"Comments\", text: $text, status: .error(message: \"This field can't be empty.\"))","","    \/\/ Outlined style","    MISOTextArea(label: \"Comments\", text: $text, isOutlined: true)","","    \/\/ Fixed height — no vertical growth","    MISOTextArea(label: \"Comments\", text: $text, constrainedMaxHeight: true)"],"syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.1 (Figma component design version)","type":"text"}]}],"type":"aside","name":"Version"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 1.4.0"}]}],"type":"aside","name":"Since"}]}],"topicSections":[{"generated":true,"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/Helperlink"]},{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/init(_:tableName:bundle:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/body"]},{"generated":true,"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/HelperText","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/Status"]},{"generated":true,"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/View-Implementations"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Text area is a UI element that allows to type, edit, or select longer blocks of textual data, such as comments, messages or descriptions;","type":"text"},{"text":" ","type":"text"},{"text":"by expanding vertically and offering more space to input text.","type":"text"},{"text":" ","type":"text"},{"text":"It provides a visual and interactive affordance f