ents/documentation/MISOComponents/MISOTextArea/HelperText":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HelperText","kind":"identifier"}],"abstract":[{"text":"Describes the content of the helper text displayed below the text area.","type":"text"}],"title":"MISOTextArea.HelperText","navigatorTitle":[{"text":"HelperText","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/HelperText","kind":"symbol","url":"\/documentation\/misocomponents\/misotextarea\/helpertext","role":"symbol","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea":{"navigatorTitle":[{"kind":"identifier","text":"MISOTextArea"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea","type":"topic","title":"MISOTextArea","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTextArea"}],"url":"\/documentation\/misocomponents\/misotextarea","abstract":[{"text":"Text area is a UI element that allows to type, edit, or select longer blocks of textual data, such as comments, messages or descriptions;","type":"text"},{"text":" ","type":"text"},{"text":"by expanding vertically and offering more space to input text.","type":"text"},{"text":" ","type":"text"},{"text":"It provides a visual and interactive affordance for multiline text entry while supporting labels, placeholders, descriptions, and validation feedback.","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents/Controls":{"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"controls","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"inputs"}]},{"type":"text","text":"."}],"title":"Controls","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","typ