entifier"},{"text":", ","kind":"text"},{"text":"constrainedMaxHeight","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MISOTextArea","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV"},{"text":".","kind":"text"},{"text":"Status","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV6StatusO"},{"text":")","kind":"text"}]}}}