{"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"symbol","externalID":"s:14MISOComponents12MISOTextAreaV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTextArea","kind":"identifier"}],"navigatorTitle":[{"text":"MISOTextArea","kind":"identifier"}],"platforms":[{"introducedAt":"15.0","name":"iOS","unavailable":false,"deprecated":false,"beta":false},{"introducedAt":"13.0","name":"macOS","unavailable":false,"deprecated":false,"beta":false},{"introducedAt":"1.0","name":"visionOS","unavailable":false,"deprecated":false,"beta":false}],"modules":[{"name":"Components"}],"roleHeading":"Structure","symbolKind":"struct","title":"MISOTextArea"},"abstract":[{"text":"Text area is a UI element that allows to type, edit, or select longer blocks of textual data, such as comments, messages or descriptions;","type":"text"},{"text":" ","type":"text"},{"text":"by expanding vertically and offering more space to input text.","type":"text"},{"text":" ","type":"text"},{"text":"It provides a visual and interactive affordance for multiline text entry while supporting labels, placeholders, descriptions, and validation feedback.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTextArea","kind":"identifier"}]}]},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls"],"kind":"mentions"},{"kind":"content","content":[{"anchor":"Layout","level":2,"text":"Layout","type":"heading"},{"inlineContent":[{"text":"Text area is based on several configurable UI elements:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"label","type":"text"}],"type":"strong"},{"type":"text","text":": It is used to describe the purpose of the text area."},{"type":"text","text":" "},{"type":"text","text":"In some UI contexts, especially when space is limited or when the text area is part of a compact layout, the label can be hidden."},{"type":"text","text":" "},{"type":"text","text":"However, hiding the label should only be done if the purpose remains clear thanks to a placeholder or contextual icon"},{"type":"text","text":" "},{"type":"text","text":"and if the label is still accessible to screen readers."},{"type":"text","text":" "},{"type":"text","text":"Hiding a label is a design choice that must balance visual simplicity and clarity of intent, without compromising inclusiveness or form guidance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"placeholder","type":"text"}],"type":"strong"},{"type":"text","text":": If the text of the text area is empty a placeholder provides a hint or guidance inside the field to suggest expected input."}]}]}],"type":"unorderedList"},{"anchor":"Status","level":2,"text":"Status","type":"heading"},{"inlineContent":[{"text":"Five status are proposed for all layouts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"enabled (by default)","type":"text"}],"type":"strong"},{"type":"text","text":": Default neutral appearance, whether empty or filled."},{"type":"text","text":" "},{"type":"text","text":"It allows users to click, focus, and type freely without restrictions."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"error","type":"text"}],"type":"strong"},{"type":"text","text":": The "},{"code":"error","type":"codeVoice"},{"type":"text","text":" status indicates that the user input does not meet validation rules or"},{"type":"text","text":" "},{"type":"text","text":"expected formatting. It provides immediate visual feedback, typically through a red border,"},{"type":"text","text":" "},{"type":"text","text":"an error icon, and a clear, accessible error message positioned below the text area. The error message replaces the helper text."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"loading","type":"text"}],"type":"strong"},{"type":"text","text":": The "},{"code":"loading","type":"codeVoice"},{"type":"text","text":" state indicates that the system is processing or retrieving data"},{"type":"text","text":" "},{"type":"text","text":"related to the text entered. A progress indicator appears to inform the user that an action is in progress."},{"type":"text","text":" "},{"type":"text","text":"The field remains editable while loading."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"readOnly","type":"text"}],"type":"strong"},{"type":"text","text":": The "},{"code":"readOnly","type":"codeVoice"},{"type":"text","text":" status lets the text visible but not editable."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"disabled","type":"text"}],"type":"strong"},{"type":"text","text":": In "},{"code":"disabled","type":"codeVoice"},{"type":"text","text":" status, the field is non-interactive and grayed out to indicate it cannot be changed."},{"type":"text","text":" "},{"type":"text","text":"Note the SwiftUI "},{"code":"View.disabled()","type":"codeVoice"},{"type":"text","text":" is ignored."}]}]}],"type":"unorderedList"},{"anchor":"Helpers","level":2,"text":"Helpers","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Helper text (plain)","type":"text"}],"type":"strong"},{"type":"text","text":": A supporting text conveys additional information about the text area,"},{"type":"text","text":" "},{"type":"text","text":"such as how it will be used. It should ideally only take up a single line, though may wrap"},{"type":"text","text":" "},{"type":"text","text":"to multiple lines if required, and be either persistently visible or visible only on focus."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Helper text (characters max count)","type":"text"}],"type":"strong"},{"type":"text","text":": Uses an internal message displaying the count of remaining characters depending to the given value."},{"type":"text","text":" "},{"type":"text","text":"This is a specific iOS library feature with 1.4.0"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Helper link","type":"text"}],"type":"strong"},{"type":"text","text":": If the helper text is not sufficient, it’s possible to offer the user"},{"type":"text","text":" "},{"type":"text","text":"an additional help link (the link can be external or open a modal)."}]}]}],"type":"unorderedList"},{"anchor":"Accessibility-considerations","level":2,"text":"Accessibility considerations","type":"heading"},{"inlineContent":[{"text":"By default no haptics are done by the component.","type":"text"},{"text":" ","type":"text"},{"text":"However you should think about cases where you will have to make the devices vibrate.","type":"text"},{"text":" ","type":"text"},{"text":"You can refer to the ","type":"text"},{"isActive":true,"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Mandatory-field-indication","level":2,"text":"Mandatory field indication","type":"heading"},{"inlineContent":[{"text":"If all fields are mandatory (several fields present): display the message “All fields are mandatory” at the top of your form.","type":"text"},{"text":" ","type":"text"},{"text":"Do not use an asterisk at the end of each field label, nor the word “mandatory.”","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If not all fields are mandatory (several fields present): display the message “All fields marked with an * are mandatory” at the top of your form.","type":"text"},{"text":" ","type":"text"},{"text":"Use an asterisk (*) at the end of each mandatory field label, and ensures this is well vocalized.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"UI rendering of the asterisk must be done with ","type":"text"},{"inlineContent":[{"type":"text","text":"bold font weight"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"negative content color"}],"type":"emphasis"},{"text":" (red on light backgrounds).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use the mention “(optional)” at the end of each optional field label. Note that this rule is not systematic, it remains an option, to be used if needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If there is only one field in the form, or if the mandatory nature is obvious,","type":"text"},{"text":" ","type":"text"},{"text":"no mention is necessary since the fields are essential to the form’s functionality.","type":"text"}],"type":"paragraph"},{"anchor":"Outlined-style","level":2,"text":"Outlined style","type":"heading"},{"inlineContent":[{"text":"By ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"text":", the text area uses a subtle background fill and a bottom border only, creating a softer and more contained look.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When ","type":"text"},{"inlineContent":[{"type":"text","text":"outlined"}],"type":"strong"},{"text":", the text area uses a transparent background and a visible stroke on all four sides.","type":"text"},{"text":" ","type":"text"},{"text":"This style may be appropriate for contexts where inputs need to feel lightweight and unobtrusive,","type":"text"},{"text":" ","type":"text"},{"text":"for example inside a card, a dialog, or a filtering panel.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ An outlined text area","    MISOTextArea(label: \"Comments\", text: $text, isOutlined: true)"]},{"anchor":"Fixed-height","level":2,"text":"Fixed height","type":"heading"},{"inlineContent":[{"text":"By ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"text":", the text area grows vertically as the user types, up to a maximum height defined by the","type":"text"},{"text":" ","type":"text"},{"text":"design system (token ","type":"text"},{"code":"sizeMaxHeightInput","type":"codeVoice"},{"text":"). Once that height is reached, the content becomes scrollable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"constrainedMaxHeight","type":"codeVoice"},{"text":" is set to ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", the maximum height is capped to the ","type":"text"},{"inlineContent":[{"type":"text","text":"minimum"}],"type":"strong"},{"text":" height","type":"text"},{"text":" ","type":"text"},{"text":"(token ","type":"text"},{"code":"sizeMinHeightInput","type":"codeVoice"},{"text":"), keeping the component at a fixed, compact size at all times.","type":"text"},{"text":" ","type":"text"},{"text":"The content is immediately scrollable from the first overflow line.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This is useful in dense layouts — forms, filter panels, chat composers — where vertical space is at a premium.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Height is fixed to the minimum (no vertical growth)","    MISOTextArea(label: \"Comments\", text: $text, constrainedMaxHeight: true)"]},{"anchor":"Rich-text","level":2,"text":"Rich text","type":"heading"},{"inlineContent":[{"text":"Rich text can be used for error and helper texts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}],"type":"paragraph"},{"anchor":"Code-samples","level":2,"text":"Code samples","type":"heading"},{"type":"codeListing","syntax":"swift","code":["    \/\/ The text to display and edit","    @State var text: String = \"\"","","    \/\/ Empty text and no placeholder","    MISOTextArea(label: \"Comments\", text: $text)","","    \/\/ Empty text with placeholder","    MISOTextArea(label: \"Comments\", text: $text, placeholder: \"Describe your issue in detail\")","","    \/\/ With a plain helper text","    MISOTextArea(label: \"Comments\",","                 text: $text,","                 placeholder: \"Describe your issue in detail\",","                 helperText: .plain(\"Maximum 500 characters.\"))","","    \/\/ With a maximum character count — the component shows \"X characters remaining\" (bold)","    \/\/ and switches to an error style when exceeded.","    MISOTextArea(label: \"Comments\",","                 text: $text,","                 helperText: .charactersMaxCount(500))","","    \/\/ With helper link","    @Environment(\\.openURL) private var openUrl","","    let helperLink = MISOTextArea.Helperlink(text: \"Helper Link\") {","       openUrl.callAsFunction(url)","    }","","    MISOTextArea(label: \"Comments\", text: $text, placeholder: \"Placeholder\", helperLink: helperLink)","","    \/\/ With error status","    MISOTextArea(label: \"Comments\", text: $text, status: .error(message: \"This field can't be empty.\"))","","    \/\/ Outlined style","    MISOTextArea(label: \"Comments\", text: $text, isOutlined: true)","","    \/\/ Fixed height — no vertical growth","    MISOTextArea(label: \"Comments\", text: $text, constrainedMaxHeight: true)"]},{"name":"Version","content":[{"inlineContent":[{"type":"text","text":"1.2.1 (Figma component design version)"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Since","content":[{"inlineContent":[{"type":"text","text":"OUDS 1.4.0"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/misocomponents\/misotextarea"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/Helperlink"],"generated":true},{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/init(_:tableName:bundle:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/body"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/HelperText","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/Status"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/View-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMeta