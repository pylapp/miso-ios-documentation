ord","text":"enum"},{"kind":"text","text":" "},{"text":"MISOTextualContent","kind":"identifier"}],"abstract":[{"text":"A textual value that can be either a plain ","type":"text"},{"code":"String","type":"codeVoice"},{"type":"text","text":" or a styled "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"MISOTextualContent","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misotextualcontent","title":"MISOTextualContent","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent","type":"topic","role":"symbol"},"doc://MISOComponents/documentation/MISOComponents/Controls":{"type":"topic","title":"Controls","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls","role":"article","kind":"article","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"controls","type":"text"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"inputs","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents\/controls"},"https://developer.apple.com/design/human-interface-guidelines/playing-haptics":{"titleInlineContent":[{"type":"text","text":"Human Interface Guidelines of Apple"}],"url":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","type":"link","identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","title":"Human Interface Guidelines of Apple"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea/Status":{"url":"\/documentation\/misocomponents\/misotextarea\/status","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Status"}],"kind":"symbol","identifier":"doc:\/\/MISOCompo