t"},{"text":"MISOTextArea","kind":"identifier"}],"role":"symbol","title":"MISOTextArea","navigatorTitle":[{"text":"MISOTextArea","kind":"identifier"}],"type":"topic","url":"\/documentation\/misocomponents\/misotextarea","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea","abstract":[{"type":"text","text":"Text area is a UI element that allows to type, edit, or select longer blocks of textual data, such as comments, messages or descriptions;"},{"type":"text","text":" "},{"type":"text","text":"by expanding vertically and offering more space to input text."},{"type":"text","text":" "},{"text":"It provides a visual and interactive affordance for multiline text entry while supporting labels, placeholders, descriptions, and validation feedback.","type":"text"}],"kind":"symbol"},"doc://MISOComponents/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"ic_folder_categories.png":{"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","alt":null,"identifier":"ic_folder_categories.png"},"doc://MISOComponents/7SwiftUI4ViewP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View"},"doc://MISOComponents/documentation/MISOComponents/Controls":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"text":"controls","type":"text"}]},{"text":" and ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"inputs"}]},{"text":".","type":"text"}],"type":"topic","title":"Controls","url":"\/documentation\/misocomponents\/controls","role":"article","kind":"article","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls"},"doc://MISOComponents/documentation/MIS