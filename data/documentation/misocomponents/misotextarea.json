us","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Status","kind":"identifier"}],"title":"MISOTextArea.Status","abstract":[{"type":"text","text":"Define all available status for the text area"}],"kind":"symbol","navigatorTitle":[{"text":"Status","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/Controls":{"abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"type":"text","text":"controls"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"inputs"}],"type":"strong"},{"text":".","type":"text"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls","title":"Controls","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"kind":"article","role":"article","url":"\/documentation\/misocomponents\/controls","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea/body":{"url":"\/documentation\/misocomponents\/misotextarea\/body","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/body","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"body","role":"symbol","abstract":[],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOTextArea/init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)":{"url":"\/documentation\/misocomponents\/misotextarea\/init(label:text:placeholder:helpertext:helperlink:isoutlined:constrainedmaxwidth:constrainedmaxheight:status:)","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextArea\/init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"label","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">, ","kind":"text"},{"text":"placeholder","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"helperText","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MISOTextArea","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV"},{"text":".","kind":"text"},{"text":"HelperText","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV10HelperTextO"},{"text":"?, ","kind":"text"},{"text":"helperLink","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MISOTextArea","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV"},{"text":".","kind":"text"},{"text":"Helperlink","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV10HelperlinkV"},{"text":"?, ","kind":"text"},{"text":"isOutlined","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"constrainedMaxWidth","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"constrainedMaxHeight","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MISOTextArea","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV"},{"text":".","kind":"text"},{"text":"Status","kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents12MISOTextAreaV6StatusO"},{"text":")","kind":"text"}],"title":"init(label:text:placeholder:helperText:helperLink:isOutlined:constrainedMaxWidth:constrainedMaxHeight:status:)","role":"symbol","abstract":[{"text":"Creates a text area.","type":"text"}],"kind":"symbol"}}}