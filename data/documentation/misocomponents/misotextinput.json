{"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MISOTextInput"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"Layout","type":"heading","text":"Layout","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Text input is based on several configurable UI elements:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"label"}]},{"type":"text","text":": It is used to describe the purpose of the input."},{"type":"text","text":" "},{"type":"text","text":"In some UI contexts, especially when space is limited or when the input is part of a compact layout (search bars, filters, inline forms), the label can be hidden."},{"type":"text","text":" "},{"type":"text","text":"However, hiding the label should only be done if the purpose of the input remains clear thanks to a placeholder or contextual icon"},{"type":"text","text":" "},{"type":"text","text":"and if the label is still accessible to screen readers"},{"type":"text","text":" "},{"type":"text","text":"Hiding a label is a design choice that must balance visual simplicity and clarity of intent, without compromising inclusiveness or form guidance."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"placeholder","type":"text"}]},{"type":"text","text":": if the text of the text input is empty a placeholder provides a hint or guidance inside the field to suggest expected input."},{"type":"text","text":" "},{"type":"text","text":"A prefix and a suffix can be added to give more context."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"leading icon"}]},{"type":"text","text":": it helps indicate the purpose of the input (magnifying glass for search, envelope for email, phone device for phone number)."},{"type":"text","text":" "},{"type":"text","text":"Only use a leading icon if it adds clear functional or contextual value."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"trailing action","type":"text"}],"type":"strong"},{"text":": it is used to provide actions related to the field: clear input, toggle password visibility, open a date picker, etc.","type":"text"},{"text":" ","type":"text"},{"text":"Can also indicate status or feedback (error checkmark, loading spinner).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Outlined style","level":2,"anchor":"Outlined-style"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By "},{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":", the input is with a subtle background fill and invisible bottom border, creating a softer and more contained look."},{"type":"text","text":" "},{"type":"text","text":"Best suited for dense layouts or to enhance visibility."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"strong","inlineContent":[{"type":"text","text":"outlined"}]},{"type":"text","text":", the text input is a minimalist design with a transparent background and a visible stroke outlining the field."},{"type":"text","text":" "},{"type":"text","text":"This style may be interesting for contexts other than form pages:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When inputs need to feel lightweight and unobtrusive"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In a header (search field)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In a selection\/filtering feature in a product catalog"}]}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["   \/\/ An outlined text input","   MISOTextInput(label: \"Label\", text: $text, isOutlined: true)","","   \/\/ With a localizable and a bundle","   MISOTextInput(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module, text: $text)"]},{"anchor":"Rounded-layout","type":"heading","level":3,"text":"Rounded layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Text input can have rounded layouts to be favored in more emotional, immersive contexts or those tied to specific visual identities."},{"type":"text","text":" "},{"type":"text","text":"For standard or business-oriented journeys, keep the default corners."},{"type":"text","text":" "},{"type":"text","text":"This evolution addresses the need for flexibility in adapting the design to some brand contexts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To activate the rounded corner behavior, set to true the "},{"type":"codeVoice","code":"hasRoundedTextInputs"},{"type":"text","text":" values of the "},{"type":"codeVoice","code":"Tuning"},{"type":"text","text":" object"},{"type":"text","text":" "},{"type":"text","text":"in your theme configuration (if the theme exposes this property at init)."},{"type":"text","text":" "},{"type":"text","text":"Some themes do not have this flexibility, like "},{"code":"BlueCoatTheme","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Status","type":"heading","text":"Status","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Five status are proposed for all layouts:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"default (by default)","type":"text"}],"type":"strong"},{"text":": Default neutral appearance, whether empty or filled.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to click, focus, and type freely without restrictions.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"error"}],"type":"strong"},{"text":": The ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" status indicates that the user input does not meet validation rules or","type":"text"},{"text":" ","type":"text"},{"text":"expected formatting. It provides immediate visual feedback, typically through a red border,","type":"text"},{"text":" ","type":"text"},{"text":"error icon, and a clear, accessible error message positioned below the input. The error messages replaces the helper text.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"loading","type":"text"}]},{"type":"text","text":": The "},{"code":"loading","type":"codeVoice"},{"text":" state indicates that the system is processing or retrieving data","type":"text"},{"type":"text","text":" "},{"text":"related to the text entered. A progress indicator appears to inform the user that an action is in progress.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"readOnly"}]},{"type":"text","text":" :The"},{"type":"codeVoice","code":"readOnly"},{"type":"text","text":", lets the text visible but not editable"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"disabled","type":"text"}]},{"type":"text","text":": In "},{"type":"codeVoice","code":"disabled"},{"type":"text","text":" status, the field is non-interactive and grayed out to indicate it cannot be changed."},{"type":"text","text":" "},{"type":"text","text":"Note the SwiftUI "},{"code":"View.disabled()","type":"codeVoice"},{"type":"text","text":" is ignored."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Helpers","type":"heading","text":"Helpers","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper text"}]},{"type":"text","text":":  A supporting text conveys additional information about the input field,"},{"type":"text","text":" "},{"type":"text","text":"such as how it will be used. It should ideally only take up a single line, though may wrap"},{"type":"text","text":" "},{"type":"text","text":"to multiple lines if required, and be either persistently visible or visible only on focus."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Helper link"}]},{"type":"text","text":": If the helper text is not sufficient, it’s possible to offer the user"},{"type":"text","text":" "},{"type":"text","text":"an additional help link (the link can be external or open a modal)."}]}]}],"type":"unorderedList"},{"text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations","type":"heading"},{"inlineContent":[{"type":"text","text":"By default no haptics are done by the component for the trailing action."},{"type":"text","text":" "},{"type":"text","text":"However you should think about cases wher you will have to make the devices vibrates."},{"type":"text","text":" "},{"type":"text","text":"You can refer to the "},{"identifier":"https:\/\/developer.apple.com\/design\/human-interface-guidelines\/playing-haptics","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Mandatory field indication","level":2,"anchor":"Mandatory-field-indication","type":"heading"},{"inlineContent":[{"type":"text","text":"If all fields are mandatory (several fields present): display the message “All fields are mandatory” at the top of your form."},{"type":"text","text":" "},{"type":"text","text":"Do not use an asterisk at the end of each field label, nor the word “mandatory.”"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If not all fields are mandatory (several fields present): display the message “All fields marked with an * are mandatory” at the top of your form."},{"type":"text","text":" "},{"type":"text","text":"Use an asterisk (*) at the end of each mandatory field label, and ensures this is well vocalized."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"UI rendering of the asterisk must be done with "},{"type":"emphasis","inlineContent":[{"type":"text","text":"bold font weight"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"negative content color"}]},{"type":"text","text":" (red on light backgrounds)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the mention “(optional)” at the end of each optional field label. Note that this rule is not systematic, it remains an option, to be used if needed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If there is only one field in the form, or if the mandatory nature is obvious (such as login\/password),"},{"type":"text","text":" "},{"type":"text","text":"no mention is necessary since the fields are essential to the form’s functionality."}],"type":"paragraph"},{"text":"Rich text","level":2,"anchor":"Rich-text","type":"heading"},{"inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"syntax":"swift","code":["    \/\/ The text to display and edit","    @State var text: String = \"\"","","    \/\/ Empty text and no placeholder","    MISOTextInput(label: \"Email\", text: $text)","","    \/\/ Empty text with placeholder and suffix","    MISOTextInput(label: \"Email\", text: $text, placeholder: \"firstName.lastName\", suffix: \"@orange.com\")","","    \/\/ Empty text with prefix and suffix","    MISOTextInput(label: \"Email\", text: $text, prefix: \"Distance\", suffix: \"km\")","","    \/\/ Add a leading icon for more context","    MISOTextInput(label: \"Email\", text: $text, placeholder: \"firstName.lastName\", suffix: \"@orange.com\",","                  leadingImage: MISOImage(asset: Image(systemName: \"envelope\")))","","    \/\/ Add a leading icon displayed as raw image (not tinted)","    MISOTextInput(label: \"Brand\", text: $text,","                  leadingImage: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original))","","    \/\/ Flip the leading icon for RTL layouts using MISOImage.flipped","    MISOTextInput(label: \"Label\", text: $text,","                  leadingImage: MISOImage(asset: Image(\"ic_arrow\"), flipped: layoutDirection == .rightToLeft))","","    \/\/ Add a trailing button with local image named \"ic_cross\" for additional action","    let trailingAction = MISOTextInput.TrailingAction(image: MISOImage(asset: Image(\"ic_cross\")), actionHint: \"Delete\") { text = \"\" }","    MISOTextInput(label: \"Email\", text: $text, trailingAction: trailingAction)","","    \/\/ With helper text","    MISOTextInput(label: \"Email\",","                  text: $text,","                  placeholder: \"firstName.lastName\",","                  suffix: \"@orange.com\",","                  helperText: \"The email will be automatically completed with @orange.com\")","","    \/\/ With helper link","    @Environment(\\.openURL) private var openUrl","","    let helperLink = MISOTextInput.HelperLink(text: \"Helper Link\") {","       openUrl.callAsFunction(url)","    }","","    MISOTextInput(label: \"Label\", text: $text, placeholder: \"Placeholder\", helperLink: helperLink)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to flip your leading icon for RTL, use the "},{"code":"flipped","type":"codeVoice"},{"type":"text","text":" property of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOImage"},{"type":"text","text":":"}]},{"code":["    @Environment(\\.layoutDirection) var layoutDirection","","    MISOTextInput(label: \"Label\", text: $text,","                  leadingImage: MISOImage(asset: Image(\"ic_arrow\"), flipped: layoutDirection == .rightToLeft))"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.4.1 (Figma component design version)"}]}],"type":"aside"},{"name":"Since","type":"aside","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.20.0"}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTextInput"}],"navigatorTitle":[{"text":"MISOTextInput","kind":"identifier"}],"platforms":[{"introducedAt":"15.0","unavailable":false,"name":"iOS","beta":false,"deprecated":false},{"introducedAt":"13.0","unavailable":false,"name":"macOS","beta":false,"deprecated":false},{"introducedAt":"1.0","unavailable":false,"name":"visionOS","beta":false,"deprecated":false}],"symbolKind":"struct","modules":[{"name":"Components"}],"role":"symbol","externalID":"s:14MISOComponents13MISOTextInputV","roleHeading":"Structure","title":"MISOTextInput"},"abstract":[{"text":"Text input is a UI element that allows to enter, edit, or select single-line textual data.","type":"text"},{"type":"text","text":" "},{"text":"Text input is one of the most fundamental form elements used to capture user input such as names, emails, passwords, or search queries.","type":"text"},{"text":" ","type":"text"},{"text":"It provides a visual and interactive affordance for text entry while supporting labels, placeholders, icons, descriptions, and validation feedback.","type":"text"}],"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/Helperlink","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/TrailingAction"],"generated":true,"title":"Structures"},{"anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-3rr11","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-72xdt","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/init(label:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-6fuf2","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/init(label:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-6g04k"],"generated":true,"title":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/body"],"generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/Status"],"generated":true,"anchor":"Enumerations","title":"Enumerations"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/View-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8S