ext","text":")"}]},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://MISOComponents/documentation/MISOComponents/MISOImage":{"url":"\/documentation\/misocomponents\/misoimage","abstract":[{"type":"text","text":"Use to provide an asset to miso in order to be added in some components."},{"type":"text","text":" "},{"type":"text","text":"The icon can be flipped for RTL consideration and an associated "},{"code":"acessibilityLabel","type":"codeVoice"},{"type":"text","text":"must be provided"},{"type":"text","text":" "},{"type":"text","text":"if the icon is not decorative."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOImage","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOImage"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOImage"}],"title":"MISOImage"},"doc://MISOComponents/documentation/MISOComponents/MISOTextInput/Status":{"navigatorTitle":[{"text":"Status","kind":"identifier"}],"role":"symbol","kind":"symbol","title":"MISOTextInput.Status","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/Status","url":"\/documentation\/misocomponents\/misotextinput\/status","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Status"}],"abstract":[{"type":"text","text":"Define all available status for the text input"}]},"doc://MISOComponents/s8SendableP":{"identifier":"doc:\/\/MISOComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://MISOComponents/documentation/MISOComponents/MISOTextInput/body":{"url":"\/documentation\/misocomponents\/misotextinput\/body","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/body","abstract":[],"kind":"symbol