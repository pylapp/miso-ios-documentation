 a text input with a rich attributed helper text."}],"role":"symbol","type":"topic","title":"init(label:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput\/init(label:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-6fuf2"},"doc://MISOComponents/documentation/MISOComponents/MISOImage":{"title":"MISOImage","kind":"symbol","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOImage","abstract":[{"text":"Use to provide an asset to miso in order to be added in some components.","type":"text"},{"text":" ","type":"text"},{"text":"The icon can be flipped for RTL consideration and an associated ","type":"text"},{"code":"acessibilityLabel","type":"codeVoice"},{"text":"must be provided","type":"text"},{"text":" ","type":"text"},{"text":"if the icon is not decorative.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOImage"}],"url":"\/documentation\/misocomponents\/misoimage","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOImage"}]},"doc://MISOComponents/documentation/MISOComponents/MISOTextInput":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput","title":"MISOTextInput","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MISOTextInput"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misotextinput","abstract":[{"text":"Text input is a UI element that allows to enter, edit, or select single-line textual data.","type":"text"},{"text":" ","type":"text"},{"text":"Text input is one of the most fundamental form elements used to capture user input such as names, emails, passwords, or search queries.","type":"text"},{"text":" ","type":"text"},{"text":"It provides a visual and interactive affordance for text entry while supporting labels, placeholders, icons, descriptions, and validation feedback.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTextInput"}]},"doc://MISOComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://MISOComponents/documentation/MISOComponents/MISOTextInput/init(_:tableName:bundle:text:placeholder:prefix:suffix:leadingImage:trailingAction:helperText:helperLink:isOutlined:constrainedMaxWidth:status:)-72xdt":{"url":"\/documentation\/misocomponents\/misotextinput\/init(_:tablename:bundle:text:placeholder:prefix:suffix:leadingimage:trailingaction:helpertext:helperlink:isoutlined:constrainedmaxwidth:status:)-72xdt","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7SwiftUI18LocalizedStringKeyV","text":"LocalizedStringKey","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tableName","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"bundle","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSBundle","text":"Bundle","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"text","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"placeholder","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"prefix","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kin