or are based on this status."}]},"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage":{"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"text":" ","type":"text"},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"text":" ","type":"text"},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"url":"\/documentation\/misocomponents\/misoalertmessage","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","navigatorTitle":[{"text":"MISOAlertMessage","kind":"identifier"}],"kind":"symbol","title":"MISOAlertMessage","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertMessage","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOInlineAlert":{"navigatorTitle":[{"text":"MISOInlineAlert","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","type":"topic","title":"MISOInlineAlert","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOInlineAlert","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misoinlinealert","abstract":[{"text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,","type":"text"},{"text":" ","type":"text"},{"text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional","type":"text"},{"text":" ","type":"text"},{"text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible.","type":"text"}]}}}