 ","type":"text"},{"text":"includes a close button, allowing the user to dismiss it when he has acknowledged the message.  Some alerts must remain visible to ensure","type":"text"},{"text":" ","type":"text"},{"text":"user is aware of important information; others can be closed to reduce visual clutter.","type":"text"}],"type":"paragraph"}],"name":"onClose"}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"View\/disabled(_:)","type":"codeVoice"},{"text":" method to have component in disabled state.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["    MISOAlertMessage(label: \"Success! Your form was submitted.\",","                     status: .positive,","                     description: AttributedString(markdown: \"This is **an important notice**\")) \/\/ Manage in your side errors for init"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misoalertmessage\/init(label:status:description:bulletlist:link:onclose:)-4nkpd"]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage"]]},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage\/init(label:status:description:bulletList:link:onClose:)-4nkpd","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"platforms":[{"introducedAt":"15.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"13.0","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"beta":false,"deprecated":false,"name":"tvOS","introducedAt":"16.0","unavailable":false},{"beta":false,"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false}],"externalID":"s:14MISOComponents16MISOAlertMessageV5label6status11description10bulletList4link7onCloseACSS_AA0B6S