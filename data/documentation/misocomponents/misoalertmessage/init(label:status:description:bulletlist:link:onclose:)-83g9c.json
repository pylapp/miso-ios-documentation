sible to ensure","type":"text"},{"text":" ","type":"text"},{"text":"user is aware of important information; others can be closed to reduce visual clutter.","type":"text"}]}]}]},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"View\/disabled(_:)"},{"text":" method to have component in disabled state.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["    MISOAlertMessage(label: \"Success! Your form was submitted.\",","                     status: .positive,","                     description: AttributedString(markdown: \"This is **an important notice**\") \/\/ Manage in your side errors for init","                     bulletList: [","                        AttributedString(\"First thing\"),","                        AttributedString(markdown: \"One **more thing**\"), \/\/ Manage in your side errors for init","                     ])"],"syntax":"swift"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage"]]},"kind":"symbol","metadata":{"platforms":[{"name":"iOS","introducedAt":"15.0","deprecated":false,"beta":false,"unavailable":false},{"name":"macOS","introducedAt":"13.0","deprecated":false,"beta":false,"unavailable":false},{"name":"tvOS","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"beta":false,"unavailable":false}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"label","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents15MISOAlertStatusO","text