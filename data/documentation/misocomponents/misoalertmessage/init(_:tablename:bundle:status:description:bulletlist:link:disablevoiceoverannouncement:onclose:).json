ing","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For this initializer, prefer ","type":"text"},{"type":"codeVoice","code":".raw(_:)"},{"type":"text","text":" to a bare string literal for the "},{"type":"codeVoice","code":"description"},{"type":"text","text":", so the compiler selects without any doubt"},{"type":"text","text":" "},{"type":"text","text":"the initializer taking an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent"},{"type":"text","text":" and does not emit a deprecation warning."}]},{"type":"codeListing","syntax":"swift","code":["    MISOAlertMessage(LocalizedStringKey(\"error_message\"), bundle: Bundle.module, status: .negative)","","    MISOAlertMessage(LocalizedStringKey(\"error_message\"),","                     bundle: Bundle.module,","                     status: .negative,","                     description: .rich(AttributedString(markdown: \"This is **an important notice**\")), \/\/ Manage in your side errors for init","                     bulletList: [","                        \"First thing\",","                        .rich(AttributedString(markdown: \"One **more thing**\")), \/\/ Manage in your side errors for init","                     ])"]},{"type":"aside","name":"Since","content":[{"inlineContent":[{"type":"text","text":"3.2.0"}],"type":"paragraph"}],"style":"note"}]}],"abstract":[{"type":"text","text":"Creates an alert message with a localized label, looking up the key in the given bundle."}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage":{"url":"\/documentation\/misocomponents\/misoalertmessage","abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"type":"text","text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertMessage","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MISOAlertMessage"}],"title":"MISOAlertMessage","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOInlineAlert":{"url":"\/documentation\/misocomponents\/misoinlinealert","type":"topic","abstract":[{"text":"Inline alert is a lightweight UI element, placed in the content flow, that displays information, system feedback,","type":"text"},{"text":" ","type":"text"},{"text":"status changes throughout short, prominent, persistent and non actionable communication. Inline alert includes functional","type":"text"},{"type":"text","text":" "},{"text":"icon and semantic colour, and does not include a close button and\/or action link. Inline alert does not disappear and remains visible.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOInlineAlert"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOInlineAlert"}],"title":"MISOInlineAlert","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOInlineAlert","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOAlertStatus":{"type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"MISOAlertStatus","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misoalertstatus","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertStatus","role":"symbol","title":"MISOAlertStatus","abstra