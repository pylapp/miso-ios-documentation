{"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"text":"Links","type":"heading","level":3,"anchor":"Links"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_link_BlueCoat","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},{"type":"text","text":" proposes layout with text only or text with icon."},{"type":"text","text":" "},{"type":"text","text":"It also proposes layout to navigate forward, backward and outside the app."},{"type":"text","text":" "},{"type":"text","text":"The link can be displayed in "},{"type":"codeVoice","code":"small"},{"type":"text","text":" or "},{"type":"codeVoice","code":"default"},{"type":"text","text":" size."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Text in small size, with next indicator","MISOLink(text: \"Feedback\", indicator: .next, size: .small) { \/* the action to process *\/ }","","\/\/ Text and icon in default size","MISOLink(text: \"Feedback\", image: MISOImage(asset: Image(\"ic_heart\")), size: .default) {}","","\/\/ Text and raw icon (not tinted)","MISOLink(text: \"Brand\", image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) {}","","\/\/ Navigate to previous page with link in a default size","MISOLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","\/\/ Navigate to outside the app with link in a default size","MISOLink(text: \"Open outside\", indicator: .external, size: .default) { \/* the action to process *\/ }"]},{"text":"List items","type":"heading","level":3,"anchor":"List-items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem"},{"text":" displays a non-interactive row of information, while ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","isActive":true,"type":"reference"},{"text":" adds tap interaction and a navigation affordance indicator (chevron or external link icon).","type":"text"}]},{"inlineContent":[{"type":"text","text":"Both components use an "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData","isActive":true},{"type":"text","text":" model for their textual content, and accept optional leading and trailing elements."}],"type":"paragraph"},{"text":"Static list item","type":"heading","anchor":"Static-list-item","level":4},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem","type":"reference"},{"text":" when the row is display-only and should not trigger any action or navigation.","type":"text"}],"type":"paragraph"},{"tabs":[{"content":[{"inlineContent":[{"identifier":"component_static_list_item_BlueCoat","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"syntax":"swift","type":"codeListing","code":["\/\/ Simple list item with a label only","MISOStaticListItem(data: MISOListItemData(label: \"Label\"))","","\/\/ List item with full textual content","MISOStaticListItem(data: MISOListItemData(","    label: \"Label\",","    hasBoldLabel: true,","    description: \"Description\",","    overline: \"Overline\",","    extraLabel: \"Extra label\",","    helperText: \"Helper text providing guidance\"","))","","\/\/ List item with a leading icon and a trailing badge","let icon = MISOListItemIcon(status: .info, description: \"\", size: .medium)","","MISOStaticListItem(","    data: MISOListItemData(label: \"Notifications\"),","    leading: .icon(icon),","    trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))",")","","\/\/ List item with a leading image (static asset)","MISOStaticListItem(","    data: MISOListItemData(label: \"Product\"),","    leading: .image(MISOListItemImage(asset: Image(\"product_thumb\"), size: .medium))",")","","\/\/ List item with a leading async image (from URL)","MISOStaticListItem(","    data: MISOListItemData(label: \"Remote Product\"),","    leading: .image(MISOListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")), description: \"Product image\", size: .medium))",")","","\/\/ List item with async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","MISOStaticListItem(","    data: MISOListItemData(label: \"Loading Product\"),","    leading: .image(MISOListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product image\", size: .medium))",")","","\/\/ List item with a trailing image","MISOStaticListItem(","    data: MISOListItemData(label: \"Status\"),","    trailing: .image(MISOListItemImage(asset: Image(\"status_icon\"), size: .small))",")","","\/\/ List item with slot (displayed under texts, before helper text)","MISOStaticListItem(","    data: MISOListItemData(","        label: \"With slot\",","        textSlot: .init { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )",")","","\/\/ List item with bottom slot (displayed under main content, before helper text)","MISOStaticListItem(","    data: MISOListItemData(","        label: \"With bottom slot\",","        bottomSlot: .init { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",")","","\/\/ List item with both slot and bottomSlot","MISOStaticListItem(","    data: MISOListItemData(","        label: \"Label\",","        textSlot: .init { Text(\"Slot content\") },","        bottomSlot: .init { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",")"]},{"text":"Navigable list item","type":"heading","anchor":"Navigable-list-item","level":4},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","type":"reference"},{"text":" when tapping the row should trigger an action. The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItemIndicatorType","type":"reference"},{"text":" defines the visual indicator shown:","type":"text"}],"type":"paragraph"},{"tabs":[{"content":[{"inlineContent":[{"type":"image","identifier":"component_navigation_list_item_BlueCoat"}],"type":"paragraph"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"syntax":"swift","type":"codeListing","code":["\/\/ Forward navigation (default)","MISONavigationListItem(","    data: MISOListItemData(label: \"Next screen\")",") {","    \/\/ Navigate to next screen","}","","\/\/ External navigation","MISONavigationListItem(","    data: MISOListItemData(label: \"Open website\"),","    indicatorType: .external",") {","    openURL(url)","}","","\/\/ Backward navigation","MISONavigationListItem(","    data: MISOListItemData(label: \"Go back\"),","    indicatorType: .previous",") {","    \/\/ Navigate back","}","","\/\/ With a leading avatar and a trailing text","let avatar = MISOListItemAvatar(type: .icon, size: .medium)","","MISONavigationListItem(","    data: MISOListItemData(label: \"Profile\", description: \"View your profile\"),","    leading: .avatar(avatar),","    trailing: .text(.labelMuted(\"Details\"))",") {","    \/\/ Navigate to profile","}","","\/\/ With a leading async image loaded from URL","MISONavigationListItem(","    data: MISOListItemData(label: \"Product\", description: \"View product details\"),","    leading: .image(MISOListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")), description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}","","\/\/ With async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","MISONavigationListItem(","    data: MISOListItemData(label: \"Loading Product\", description: \"View product details\"),","    leading: .image(MISOListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}","","\/\/ List item with slot (displayed under texts, before helper text)","MISONavigationListItem(","    data: MISOListItemData(","        label: \"Settings\",","        textSlot: .init { Text(\"Configure options\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to settings","}","","\/\/ List item with bottomSlot (displayed under main content, before helper text)","MISONavigationListItem(","    data: MISOListItemData(","        label: \"Profile\",","        bottomSlot: .init { Text(\"Additional info\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to profile","}","","\/\/ List item with both slot and bottomSlot","MISONavigationListItem(","    data: MISOListItemData(","        label: \"Settings\",","        textSlot: { Text(\"Slot content\") },","        bottomSlot: { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to settings","}"]},{"text":"Tab bars","type":"heading","anchor":"Tab-bars","level":3},{"tabs":[{"title":"BlueCoat (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_BlueCoat_light","type":"image"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_BlueCoat_light"},{"text":" ","type":"text"},{"identifier":"component_tabBar_BlueCoat_dark","type":"image"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","type":"reference","isActive":true},{"text":" provides a native SwiftUI ","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":" with use of MISO effects and styles.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","type":"reference","isActive":true},{"text":" lets users define their own hierarchy of views associated to tab items.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Use the MISO tab bar to wrap tab bar items and associated views.","\/\/ Declare a @State to hold the selected tab index, then pass it as a binding.","@State private var selectedTab = 0","","MISOTabBar(selectedTab: $selectedTab, count: 3) {","        ","    \/\/ Add the views with the SwiftUI tab item and labels","    \/\/ No need to define colors, everything is done inside MISOTabBar","    SomeView()","        .tabItem {","            Label(\"Label 1\", image: \"image_1\")","        }","        .tag(0)","    OtherView()","        .tabItem {","            Label(\"Label 2\", image: \"image_2\")","        }","        .tag(1)","    LastView()","        .tabItem {","            Label(\"Label 3\", image: \"image_3\")","        }","        .tag(2)","}"]},{"anchor":"Tab-views","type":"heading","text":"Tab views","level":3},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"MISOTabView","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"MISOLiquidGlassTabView","type":"codeVoice"},{"text":" use the native SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" API with MISO styles.","type":"text"},{"text":" ","type":"text"},{"text":"They are complementary to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","type":"reference"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MISOTabView"},{"text":" — iOS 18+ \/ macOS 15+ \/ visionOS 2+, exposes a ","type":"text"},{"type":"codeVoice","code":"Binding<Int>"},{"text":" for programmatic selection, requires an explicit ","type":"text"},{"type":"codeVoice","code":"value: Int"},{"text":" on every ","type":"text"},{"type":"codeVoice","code":"Tab"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MISOLiquidGlassTabView"},{"type":"text","text":" — iOS 26+ \/ macOS 26+ \/ visionOS 26+ only, accepts "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" without "},{"type":"codeVoice","code":"value:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Tab(role: .search)"},{"type":"text","text":", selection is managed natively."}]}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ MISOTabView — iOS 18+","\/\/ Every Tab must carry an explicit value: Int matching the selectedTab binding","@State private var selectedTab = 0","","MISOTabView(selectedTab: $selectedTab, count: 4) {","    Tab(\"Label 1\", image: \"image_1\", value: 0) { FirstView() }","    Tab(\"Label 2\", image: \"image_2\", value: 1) { SecondView() }","    Tab(\"Label 3\", image: \"image_3\", value: 2) { ThirdView() }","    Tab(value: 3, role: .search) { SearchView() }","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ MISOLiquidGlassTabView — iOS 26+ only","\/\/ Supports Tab without value: and Tab(role: .search), no selection binding","MISOLiquidGlassTabView {","    Tab(\"Label 1\", image: \"image_1\") { FirstView() }","    Tab(\"Label 2\", image: \"image_2\") { SecondView() }","    Tab(\"Label 3\", image: \"image_3\") { ThirdView() }","    Tab(role: .search) { SearchView() }","}"]},{"text":"Toolbars","type":"heading","level":3,"anchor":"Toolbars"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The toolbars components provide top and bottom navigation bars. They rely on SwiftUI toolbars and expose MISO styles."},{"type":"text","text":" "},{"type":"text","text":"Top toolbars provide a title and optional subtitle, while bottom toolbars focus on actions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"There are different style depending to Liquid Glass (iOS 26+) or not (iOS 18 and older)."}]},{"text":"Top toolbar","type":"heading","level":4,"anchor":"Top-toolbar"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_BlueCoat_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_BlueCoat_dark"}]}],"title":"BlueCoat (Liquid Glass)"}]},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarTop_BlueCoat_dark","type":"image"}]}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Principal item","type":"text"}],"type":"strong"},{"type":"text","text":": at most one item can be placed in the principal (center) position with "},{"type":"codeVoice","code":"principalItem:"},{"type":"text","text":". When a "},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" "},{"type":"text","text":"is set, the subtitle is "},{"type":"strong","inlineContent":[{"text":"never","type":"text"}]},{"type":"text","text":" displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces"},{"type":"text","text":" "},{"type":"text","text":"the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"type":"text","text":" (iOS 26+), which would otherwise keep floating with no visible title next"},{"type":"text","text":" "},{"type":"text","text":"to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", in which case it appears below the bar (large title mode)."}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Apply once on the root NavigationStack to style the system navigation bar","NavigationStack {","    SomeView()","        .toolBarTop(\"Title\",","                    leadingItems: {","                        \/\/ Back button — system dismiss is automatic, no closure needed","                        MISOToolBarItem(navigation: .back())","                    },","                    principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","                    trailingItems: {","                        MISOToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                        MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","                    })","}",".misoNavigationBarAppearance() \/\/ required — apply on the NavigationStack, not on the child view","","\/\/ Principal item + hasLargeTitle: title is displayed below the bar (large mode), subtitle is never displayed","SomeView()","    .toolBarTop(\"Title\",","                hasLargeTitle: true,","                subtitle: \"This subtitle will never be shown because a principalItem is set\",","                principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { })","","\/\/ Principal item without hasLargeTitle: neither title nor subtitle are displayed","SomeView()","    .toolBarTop(\"Title\", principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { })","","\/\/ Close button — .close takes NO closure, dismiss is handled automatically","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    MISOToolBarItem(navigation: .close)","                })","","\/\/ Back button with a visible label (label text is ignored on iOS 26+ \/ Liquid Glass)","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    MISOToolBarItem(navigation: .back(label: \"Cancel\"))","                })","","\/\/ Back button with custom action executed before automatic dismiss","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    MISOToolBarItem(navigation: .back(label: \"Back\") { saveDraft() })","                })","","\/\/ On iOS ≤ 18, add on the root view to color the system back-button chevron correctly",".accentColor(theme.colors.contentDefault)"]},{"level":4,"anchor":"Bottom-toolbar","type":"heading","text":"Bottom toolbar"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat (Liquid Glass)","content":[{"inlineContent":[{"identifier":"component_toolBarBottom_LiquidGlass_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarBottom_LiquidGlass_BlueCoat_dark","type":"image"}],"type":"paragraph"}]}]},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarBottom_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarBottom_BlueCoat_dark","type":"image"}]}],"title":"BlueCoat"}]},{"syntax":"swift","code":["\/\/ Leading + trailing split — works on all supported OS versions","SomeView()","    .toolBarBottom(leadingItems: {","        MISOToolBarItem(label: \"Some label\") { \/* Action to process *\/ }","    }, trailingItems: {","        MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","    })","","\/\/ Grouped \/ centered — meaningful on iOS 26+ (Liquid Glass) only","\/\/ On earlier OS versions the system splits the items into leading\/trailing positions.","SomeView()","    .toolBarBottom(groupedItems: {","        MISOToolBarItem(label: \"Save\") { \/* Action to process *\/ }","        MISOToolBarItem(icon: Image(decorative: \"ic_delete\"), accessibilityLabel: \"Delete\") { \/* Action to process *\/ }","    })"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"modules":[{"name":"Components"}],"roleHeading":"Article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"title":"Navigations","role":"article"},"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"navigation"}]},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/navigations"]}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISONavigationListItem":{"navigatorTitle":[{"text":"MISONavigationListItem","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","type":"topic","kind":"symbol","title":"MISONavigationListItem","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISONavigationListItem","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misonavigationlistitem","abstract":[{"type":"text","text":"A list item component used to display a row of interactive, navigable content within a list."}]},"component_tabBar_LiquidGlass_BlueCoat_dark":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_dark.png"}],"identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","alt":"A tab bar component with Liquid Glass in dark mode with BlueCoat theme"},"component_tabBar_BlueCoat_dark":{"identifier":"component_tabBar_BlueCoat_dark","type":"image","alt":"A tab bar component without Liquid Glass in dark mode with BlueCoat theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_dark.png"}]},"component_tabBar_LiquidGlass_BlueCoat_light":{"identifier":"component_tabBar_LiquidGlass_BlueCoat_light","type":"image","alt":"A tab bar component with Liquid Glass in light mode with BlueCoat theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_light.png"}]},"component_toolBarBottom_BlueCoat_light":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_toolBarBottom_BlueCoat_light.png"}],"identifier":"component_toolBarBottom_BlueCoat_light","alt":"A toolbar bottom component with Liquid Glass in light mode with BlueCoat theme"},"component_static_list_item_BlueCoat":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_static_list_item_BlueCoat.png"}],"identifier":"component_static_list_item_BlueCoat","alt":"A list item component in light and dark modes with BlueCoat theme"},"component_toolBarTop_BlueCoat_light":{"identifier":"component_toolBarTop_BlueCoat_light","type":"image","alt":"A toolbar top component with Liquid Glass in light mode with BlueCoat theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_toolBarTop_BlueCoat_light.png"}]},"doc://MISOComponents/documentation/MISOCompo