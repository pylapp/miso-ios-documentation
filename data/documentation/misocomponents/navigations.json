{"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations","interfaceLanguage":"swift"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"role":"article","modules":[{"name":"Components"}],"images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"title":"Navigations","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/navigations"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"anchor":"Links","level":3,"text":"Links","type":"heading"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"component_link_BlueCoat","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_link_FoxyRough"}],"type":"paragraph"}],"title":"FoxyRough"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","isActive":true},{"type":"text","text":" proposes layout with text only or text with icon."},{"type":"text","text":" "},{"type":"text","text":"It also proposes layout to navigate forward, backward and outside the app."},{"type":"text","text":" "},{"type":"text","text":"The link can be displayed in "},{"type":"codeVoice","code":"small"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"default"},{"text":" size.","type":"text"}]},{"syntax":"swift","code":["\/\/ Text in small size, with next indicator","MISOLink(text: \"Feedback\", indicator: .next, size: .small) { \/* the action to process *\/ }","","\/\/ Text and icon in default size","MISOLink(text: \"Feedback\", image: MISOImage(asset: Image(\"ic_heart\")), size: .default) {}","","\/\/ Text and raw icon (not tinted)","MISOLink(text: \"Brand\", image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original), size: .default) {}","","\/\/ Navigate to previous page with link in a default size","MISOLink(text: \"Back\", indicator: .previous, size: .default) { \/* the action to process *\/ }","","\/\/ Navigate to outside the app with link in a default size","MISOLink(text: \"Open outside\", indicator: .external, size: .default) { \/* the action to process *\/ }"],"type":"codeListing"},{"type":"heading","anchor":"List-items","level":3,"text":"List items"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem"},{"text":" displays a non-interactive row of information, while ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem"},{"type":"text","text":" adds tap interaction and a navigation affordance indicator (chevron or external link icon)."}]},{"type":"paragraph","inlineContent":[{"text":"Both components use an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData","type":"reference"},{"text":" model for their textual content, and accept optional leading and trailing elements.","type":"text"}]},{"level":4,"anchor":"Static-list-item","type":"heading","text":"Static list item"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOStaticListItem"},{"type":"text","text":" when the row is display-only and should not trigger any action or navigation."}],"type":"paragraph"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_static_list_item_BlueCoat"}]}],"title":"BlueCoat"},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_static_list_item_FoxyRough","type":"image"}]}],"title":"FoxyRough"}]},{"code":["\/\/ Simple list item with a label only","MISOStaticListItem(data: MISOListItemData(label: .textual(\"Label\")))","","\/\/ List item with full textual content","MISOStaticListItem(data: MISOListItemData(","    label: .textual(\"Label\", isBold: true),","    description: \"Description\",","    overline: \"Overline\",","    extraLabel: \"Extra label\",","    helperText: \"Helper text providing guidance\"","))","","\/\/ List item with a leading icon and a trailing badge","let icon = MISOListItemIcon(status: .info, description: \"\", size: .medium)","","MISOStaticListItem(","    data: MISOListItemData(label: .textual(\"Notifications\")),","    leading: .icon(icon),","    trailing: .badge(.count(.init(3, accessibilityLabel: \"3 notifications\", status: .negative, size: .medium)))",")","","\/\/ List item with a leading image (static asset)","MISOStaticListItem(","    data: MISOListItemData(label: .textual(\"Product\")),","    leading: .image(MISOListItemImage(asset: Image(\"product_thumb\"), size: .medium))",")","","\/\/ List item with a leading async image (from URL)","MISOStaticListItem(","    data: MISOListItemData(label: .textual(\"Remote Product\")),","    leading: .image(MISOListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")), description: \"Product image\", size: .medium))",")","","\/\/ List item with async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/image.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","MISOStaticListItem(","    data: MISOListItemData(label: .textual(\"Loading Product\")),","    leading: .image(MISOListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product image\", size: .medium))",")","","\/\/ List item with a trailing image","MISOStaticListItem(","    data: MISOListItemData(label: .textual(\"Status\")),","    trailing: .image(MISOListItemImage(asset: Image(\"status_icon\"), size: .small))",")","","\/\/ List item with slot (displayed under texts, before helper text)","MISOStaticListItem(","    data: MISOListItemData(","        label: \"With slot\",","        textSlot: .init { Text(\"Additional content\") },","        helperText: \"Helper text\"","    )",")","","\/\/ List item with bottom slot (displayed under main content, before helper text)","MISOStaticListItem(","    data: MISOListItemData(","        label: \"With bottom slot\",","        bottomSlot: .init { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",")","","\/\/ List item with both slot and bottomSlot","MISOStaticListItem(","    data: MISOListItemData(","        label: \"Label\",","        textSlot: .init { Text(\"Slot content\") },","        bottomSlot: .init { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",")"],"type":"codeListing","syntax":"swift"},{"text":"Rich text content","anchor":"Rich-text-content","type":"heading","level":5},{"inlineContent":[{"type":"text","text":"Every textual field ("},{"code":"label","type":"codeVoice"},{"type":"text","text":", "},{"code":"description","type":"codeVoice"},{"type":"text","text":", "},{"code":"overline","type":"codeVoice"},{"type":"text","text":", "},{"code":"extraLabel","type":"codeVoice"},{"type":"text","text":", "},{"code":"helperText","type":"codeVoice"},{"type":"text","text":") accepts"},{"type":"text","text":" "},{"type":"text","text":"a raw "},{"type":"codeVoice","code":"String"},{"type":"text","text":", a localized string or an "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":". The optional fields use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".raw"},{"text":" \/ ","type":"text"},{"code":".localized","type":"codeVoice"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".rich"},{"type":"text","text":") while the label uses "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOListItemData\/Label"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".textual"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".custom"},{"type":"text","text":", the "},{"type":"codeVoice","code":".text"},{"type":"text","text":" case being deprecated since 3.2.0)."}],"type":"paragraph"},{"inlineContent":[{"text":"String literals are accepted thanks to ","type":"text"},{"type":"codeVoice","code":"ExpressibleByStringLiteral"},{"text":" on both types, so plain","type":"text"},{"text":" ","type":"text"},{"text":"text call sites remain concise: ","type":"text"},{"type":"codeVoice","code":"label: \"Label\", description: \"Description\""},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A bare literal label with no textual field (","type":"text"},{"code":"MISOListItemData(label: \"Label\")","type":"codeVoice"},{"text":", or with only ","type":"text"},{"code":"textSlot","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"bottomSlot"},{"text":") may select a","type":"text"},{"text":" ","type":"text"},{"text":"deprecated initializer and emit a deprecation warning. Write ","type":"text"},{"type":"codeVoice","code":"label: .textual(\"Label\")"},{"text":" in that case.","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"code":["\/\/ Fully styled label and overline (user controls fonts, colors, markdown…)","let styledLabel = AttributedString.from(text: \"Premium\",","                                        foregroundColor: .orange,","                                        font: .headline)","let styledOverline = AttributedString.from(text: \"FEATURED\",","                                           foregroundColor: .purple,","                                           font: .caption)","","MISOStaticListItem(data: MISOListItemData(","    label: .textual(.rich(styledLabel)),","    description: \"Plain description via string literal\",","    overline: .rich(styledOverline),","    extraLabel: .localized(\"extra.label.key\"),","    helperText: .rich(AttributedString(\"A rich helper\"))","))"],"syntax":"swift","type":"codeListing"},{"level":4,"anchor":"Navigable-list-item","text":"Navigable list item","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItem","isActive":true,"type":"reference"},{"type":"text","text":" when tapping the row should trigger an action. The "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISONavigationListItemIndicatorType","isActive":true},{"type":"text","text":" defines the visual indicator shown:"}]},{"tabs":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"component_navigation_list_item_BlueCoat","type":"image"}]}],"title":"BlueCoat"},{"content":[{"inlineContent":[{"type":"image","identifier":"component_navigation_list_item_FoxyRough"}],"type":"paragraph"}],"title":"FoxyRough"}],"type":"tabNavigator"},{"code":["\/\/ Forward navigation (default)","MISONavigationListItem(","    data: MISOListItemData(label: .textual(\"Next screen\"))",") {","    \/\/ Navigate to next screen","}","","\/\/ External navigation","MISONavigationListItem(","    data: MISOListItemData(label: .textual(\"Open website\")),","    indicatorType: .external",") {","    openURL(url)","}","","\/\/ Backward navigation","MISONavigationListItem(","    data: MISOListItemData(label: .textual(\"Go back\")),","    indicatorType: .previous",") {","    \/\/ Navigate back","}","","\/\/ With a leading avatar and a trailing text","let avatar = MISOListItemAvatar(type: .icon, size: .medium)","","MISONavigationListItem(","    data: MISOListItemData(label: \"Profile\", description: \"View your profile\"),","    leading: .avatar(avatar),","    trailing: .text(.labelMuted(\"Details\"))",") {","    \/\/ Navigate to profile","}","","\/\/ With a leading async image loaded from URL","MISONavigationListItem(","    data: MISOListItemData(label: \"Product\", description: \"View product details\"),","    leading: .image(MISOListItemImage(asyncImage: AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")), description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}","","\/\/ With async image and custom placeholder","let asyncImageWithPlaceholder = AsyncImage(url: URL(string: \"https:\/\/example.com\/product.png\")) { image in","    image.resizable()","} placeholder: {","    ProgressView()","}","","MISONavigationListItem(","    data: MISOListItemData(label: \"Loading Product\", description: \"View product details\"),","    leading: .image(MISOListItemImage(asyncImage: asyncImageWithPlaceholder, description: \"Product thumbnail\", size: .medium))",") {","    \/\/ Navigate to product","}","","\/\/ List item with slot (displayed under texts, before helper text)","MISONavigationListItem(","    data: MISOListItemData(","        label: \"Settings\",","        textSlot: .init { Text(\"Configure options\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to settings","}","","\/\/ List item with bottomSlot (displayed under main content, before helper text)","MISONavigationListItem(","    data: MISOListItemData(","        label: \"Profile\",","        bottomSlot: .init { Text(\"Additional info\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to profile","}","","\/\/ List item with both slot and bottomSlot","MISONavigationListItem(","    data: MISOListItemData(","        label: \"Settings\",","        textSlot: .init { Text(\"Slot content\") },","        bottomSlot: .init { Text(\"Bottom content\") },","        helperText: \"Helper text\"","    )",") {","    \/\/ Navigate to settings","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Tab-bars","text":"Tab bars","level":3,"type":"heading"},{"tabs":[{"title":"BlueCoat (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark"}]}]},{"title":"FoxyRough (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_LiquidGlass_FoxyRough_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_FoxyRough_dark","type":"image"}]}]}],"type":"tabNavigator"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_tabBar_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_BlueCoat_dark","type":"image"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"image","identifier":"component_tabBar_FoxyRough_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_FoxyRough_dark"}],"type":"paragraph"}],"title":"FoxyRough"}],"type":"tabNavigator"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","isActive":true,"type":"reference"},{"text":" provides a native SwiftUI ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" with use of MISO effects and styles.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","isActive":true,"type":"reference"},{"text":" lets users define their own hierarchy of views associated to tab items.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Use the MISO tab bar to wrap tab bar items and associated views.","\/\/ Declare a @State to hold the selected tab index, then pass it as a binding.","@State private var selectedTab = 0","","MISOTabBar(selectedTab: $selectedTab, count: 3) {","        ","    \/\/ Add the views with the SwiftUI tab item and labels","    \/\/ No need to define colors, everything is done inside MISOTabBar","    SomeView()","        .tabItem {","            Label(\"Label 1\", image: \"image_1\")","        }","        .tag(0)","    OtherView()","        .tabItem {","            Label(\"Label 2\", image: \"image_2\")","        }","        .tag(1)","    LastView()","        .tabItem {","            Label(\"Label 3\", image: \"image_3\")","        }","        .tag(2)","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Tab views","anchor":"Tab-views","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"MISOTabView"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"MISOLiquidGlassTabView"},{"text":" use the native SwiftUI ","type":"text"},{"type":"codeVoice","code":"Tab"},{"text":" API with MISO styles.","type":"text"},{"text":" ","type":"text"},{"text":"They are complementary to ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MISOTabView","type":"codeVoice"},{"text":" — iOS 18+ \/ macOS 15+ \/ visionOS 2+, exposes a ","type":"text"},{"type":"codeVoice","code":"Binding<Int>"},{"type":"text","text":" for programmatic selection, requires an explicit "},{"type":"codeVoice","code":"value: Int"},{"type":"text","text":" on every "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MISOLiquidGlassTabView"},{"type":"text","text":" — iOS 26+ \/ macOS 26+ \/ visionOS 26+ only, accepts "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" without "},{"type":"codeVoice","code":"value:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Tab(role: .search)"},{"type":"text","text":", selection is managed natively."}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/ MISOTabView — iOS 18+","\/\/ Every Tab must carry an explicit value: Int matching the selectedTab binding","@State private var selectedTab = 0","","MISOTabView(selectedTab: $selectedTab, count: 4) {","    Tab(\"Label 1\", image: \"image_1\", value: 0) { FirstView() }","    Tab(\"Label 2\", image: \"image_2\", value: 1) { SecondView() }","    Tab(\"Label 3\", image: \"image_3\", value: 2) { ThirdView() }","    Tab(value: 3, role: .search) { SearchView() }","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ MISOLiquidGlassTabView — iOS 26+ only","\/\/ Supports Tab without value: and Tab(role: .search), no selection binding","MISOLiquidGlassTabView {","    Tab(\"Label 1\", image: \"image_1\") { FirstView() }","    Tab(\"Label 2\", image: \"image_2\") { SecondView() }","    Tab(\"Label 3\", image: \"image_3\") { ThirdView() }","    Tab(role: .search) { SearchView() }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Toolbars","text":"Toolbars"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The toolbars components provide top and bottom navigation bars. They rely on SwiftUI toolbars and expose MISO styles."},{"type":"text","text":" "},{"type":"text","text":"Top toolbars provide a title and optional subtitle, while bottom toolbars focus on actions."}]},{"type":"paragraph","inlineContent":[{"text":"There are different style depending to Liquid Glass (iOS 26+) or not (iOS 18 and older).","type":"text"}]},{"level":4,"type":"heading","anchor":"Top-toolbar","text":"Top toolbar"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarTop_LiquidGlass_BlueCoat_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_toolBarTop_LiquidGlass_BlueCoat_dark","type":"image"}]}]},{"title":"FoxyRough (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_LiquidGlass_FoxyRough_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_LiquidGlass_FoxyRough_dark"}]}]}]},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarTop_BlueCoat_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarTop_BlueCoat_dark"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarTop_FoxyRough_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarTop_FoxyRough_dark"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Principal item"}]},{"type":"text","text":": at most one item can be placed in the principal (center) position with "},{"type":"codeVoice","code":"principalItem:"},{"type":"text","text":". When a "},{"type":"codeVoice","code":"principalItem"},{"type":"text","text":" "},{"type":"text","text":"is set, the subtitle is "},{"type":"strong","inlineContent":[{"text":"never","type":"text"}]},{"type":"text","text":" displayed (whatever "},{"type":"codeVoice","code":"hasLargeTitle"},{"type":"text","text":" is), because SwiftUI’s "},{"type":"codeVoice","code":".principal"},{"type":"text","text":" placement only replaces"},{"type":"text","text":" "},{"type":"text","text":"the inline compact bar title, not "},{"type":"codeVoice","code":".navigationSubtitle()"},{"text":" (iOS 26+), which would otherwise keep floating with no visible title next","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to it. The title itself is displayed only if "},{"type":"codeVoice","code":"hasLargeTitle"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", in which case it appears below the bar (large title mode).","type":"text"}]}],"type":"aside"},{"code":["\/\/ Apply once on the root NavigationStack to style the system navigation bar","NavigationStack {","    SomeView()","        .toolBarTop(\"Title\",","                    leadingItems: {","                        \/\/ Back button — system dismiss is automatic, no closure needed","                        MISOToolBarItem(navigation: .back())","                    },","                    principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { \/* Action to process *\/ },","                    trailingItems: {","                        MISOToolBarItem(label: \"Label\") { \/* Action to process *\/ }","                        MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","                    })","}",".misoNavigationBarAppearance() \/\/ required — apply on the NavigationStack, not on the child view","","\/\/ Principal item + hasLargeTitle: title is displayed below the bar (large mode), subtitle is never displayed","SomeView()","    .toolBarTop(\"Title\",","                hasLargeTitle: true,","                subtitle: \"This subtitle will never be shown because a principalItem is set\",","                principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { })","","\/\/ Principal item without hasLargeTitle: neither title nor subtitle are displayed","SomeView()","    .toolBarTop(\"Title\", principalItem: MISOToolBarItem(icon: Image(decorative: \"search\"), accessibilityLabel: \"Search\") { })","","\/\/ Close button — .close takes NO closure, dismiss is handled automatically","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    MISOToolBarItem(navigation: .close)","                })","","\/\/ Back button with a visible label (label text is ignored on iOS 26+ \/ Liquid Glass)","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    MISOToolBarItem(navigation: .back(label: \"Cancel\"))","                })","","\/\/ Back button with custom action executed before automatic dismiss","SomeView()","    .toolBarTop(\"Title\",","                leadingItems: {","                    MISOToolBarItem(navigation: .back(label: \"Back\") { saveDraft() })","                })","","\/\/ On iOS ≤ 18, add on the root view to color the system back-button chevron correctly",".accentColor(theme.colors.contentDefault)"],"type":"codeListing","syntax":"swift"},{"text":"Bottom toolbar","type":"heading","level":4,"anchor":"Bottom-toolbar"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat (Liquid Glass)","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_BlueCoat_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_BlueCoat_dark"}]}]},{"title":"FoxyRough (Liquid Glass)","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_FoxyRough_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_toolBarBottom_LiquidGlass_FoxyRough_dark"}],"type":"paragraph"}]}]},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_toolBarBottom_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_toolBarBottom_BlueCoat_dark","type":"image"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_toolBarBottom_FoxyRough_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_toolBarBottom_FoxyRough_dark"}],"type":"paragraph"}]}]},{"code":["\/\/ Leading + trailing split — works on all supported OS version