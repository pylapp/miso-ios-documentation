{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/Status"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/init(_:tableName:bundle:status:appearance:shape:size:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/init(label:status:appearance:shape:size:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/init(loadingKey:tableName:bundle:progress:shape:size:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/init(loadingLabel:progress:shape:size:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/body"],"generated":true,"anchor":"Instance-Properties","title":"Instance Properties"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/Appearance","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/Shape","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/Size"],"generated":true,"anchor":"Enumerations","title":"Enumerations"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/View-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Tag is a UI element that allows to display short info like a label, keyword, or category."},{"type":"text","text":" "},{"type":"text","text":"Tag helps users quickly find, group, or understand content."}],"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misotag"]}],"metadata":{"externalID":"s:14MISOComponents7MISOTagV","roleHeading":"Structure","platforms":[{"introducedAt":"15.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"13.0","name":"macOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"16.0","name":"tvOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"1.0","name":"visionOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"11.0","name":"watchOS","deprecated":false,"unavailable":false,"beta":false}],"modules":[{"name":"Components"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTag"}],"role":"symbol","title":"MISOTag","navigatorTitle":[{"kind":"identifier","text":"MISOTag"}],"symbolKind":"struct"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTag","kind":"identifier"}]}]},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"],"kind":"mentions"},{"kind":"content","content":[{"text":"Appearances","anchor":"Appearances","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Tags have two appearances so as to highlight or not their content:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"emphasized"}],"type":"strong"},{"type":"text","text":": A tag with a solid, high-contrast background. Used to draw strong attention to important"},{"type":"text","text":" "},{"type":"text","text":"labels or categories. Emphasized tags stand out prominently against the interface and are ideal for"},{"type":"text","text":" "},{"type":"text","text":"primary or high-priority information."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"muted"}],"type":"strong"},{"type":"text","text":": A tag with a subtle, light, or semi-transparent background. Used for secondary or"},{"type":"text","text":" "},{"type":"text","text":"less prominent information. Muted tags blend more with the background, providing a softer visual"},{"type":"text","text":" "},{"type":"text","text":"emphasis compared to emphasized tags."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Status","anchor":"Status","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Tags have seven status depending on the context of the information they represent. Each state is designed","type":"text"},{"text":" ","type":"text"},{"text":"to convey a specific meaning and ensure clarity in communication.","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Neutral"}],"type":"strong"},{"type":"text","text":": Default or inactive state. Used for standard labels, categories, or when no specific"},{"type":"text","text":" "},{"type":"text","text":"status needs to be communicated."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Accent","type":"text"}]},{"type":"text","text":": Used to draw attention to new features, recommendations, or content suggestions."},{"type":"text","text":" "},{"type":"text","text":"Invites users to explore and engage with new offerings, creating an exciting and engaging experience."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Positive"}],"type":"strong"},{"type":"text","text":": Indicates success, confirmation, or a positive status. Commonly used to highlight"},{"type":"text","text":" "},{"type":"text","text":"completed actions or approved items."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": Signals caution or a potentially risky situation. Used to draw attention to items"},{"type":"text","text":" "},{"type":"text","text":"requiring user awareness or intervention."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Negative"}],"type":"strong"},{"type":"text","text":": Represents errors, critical issues, or urgent attention needed. Used to highlight"},{"type":"text","text":" "},{"type":"text","text":"problems or failed actions."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Info","type":"text"}]},{"type":"text","text":": Conveys informational messages or supplementary details. Used for neutral, helpful,"},{"type":"text","text":" "},{"type":"text","text":"or contextual information."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Disabled"}],"type":"strong"},{"type":"text","text":": Shows that the tag is inactive and cannot be interacted with. Appears faded or greyed out. This is not"},{"type":"text","text":" "},{"type":"text","text":"allowed when loader is activated."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Shape","type":"heading","level":2,"text":"Shape"},{"inlineContent":[{"type":"text","text":"Tags can have two shapes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Rounded","type":"text"}]},{"type":"text","text":": A tag with fully rounded corners, creating a pill-shaped appearance. Rounded"},{"type":"text","text":" "},{"type":"text","text":"tags offer a softer and more approachable look, suitable for most modern interfaces."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Square","type":"text"}]},{"type":"text","text":": A tag with sharp, square corners. Squared tags provide a more formal, structured, or"},{"type":"text","text":" "},{"type":"text","text":"technical feel. They are often used in business contexts to label promotions, offers, or important notices."}]}]}],"type":"unorderedList"},{"anchor":"Size","type":"heading","level":2,"text":"Size"},{"inlineContent":[{"type":"text","text":"Tags can have two sizes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Default","type":"text"}]},{"type":"text","text":": The standard tag size, suitable for most use cases and offering good readability."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Small","type":"text"}]},{"type":"text","text":": A compact tag with reduced height and font size. Used when saving space is important or"},{"type":"text","text":" "},{"type":"text","text":"when grouping elements visually."}]}]}],"type":"unorderedList"},{"anchor":"Layout","type":"heading","level":2,"text":"Layout"},{"inlineContent":[{"type":"text","text":"There are four available layouts for tags:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"-"},{"type":"strong","inlineContent":[{"type":"text","text":"Text only"}]},{"type":"text","text":": A tag that displays only text. Used for simple labels, categories, or keywords without additional visual"},{"type":"text","text":" "},{"type":"text","text":"elements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"-"},{"type":"strong","inlineContent":[{"type":"text","text":"Text + Bullet"}]},{"type":"text","text":": A tag with a small indicator (dot) alongside the text. Used to show status, presence, or activity"},{"type":"text","text":" "},{"type":"text","text":"next to the label."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"-"},{"type":"strong","inlineContent":[{"type":"text","text":"Text + Icon"}]},{"type":"text","text":": A tag that includes an icon before the text. Used to visually reinforce the meaning of the tag,"},{"type":"text","text":" "},{"type":"text","text":"such as status, type, or action."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Text + Loader","type":"text"}]},{"type":"text","text":": A tag that combines a loading spinner (or progress indicator) with text. Used to indicate that"},{"type":"text","text":" "},{"type":"text","text":"a process or action related to the tag is in progress."}]}]}],"type":"unorderedList"},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"code":["    \/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","    MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","    \/\/ Or also","    MISOTag(label: \"Label\")","    \/\/ Or from a localizale and a bundle","    MISOTag(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","    \/\/ Tag with neutral status with bullet","    MISOTag(label: \"Label\", status: .neutral(leading: .bullet)","","    \/\/ Tag with neutral status with a custom decorative icon","    MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","    \/\/ If your layout is in RTL mode but your tag has an icon with another meaning because of bad orientation,","    \/\/ you can flip the icon using MISOImage.flipped","    MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","    \/\/ If you want to display a raw image (not tinted), use renderingMode: .original","    MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","    \/\/ Text with neutral status with bullet","    MISOTag(label: \"Label\", status: .neutral(bullet: true))","","    \/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","    MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","    \/\/ Tag with determinate circular progress indicator, with rounded shape in default size","    MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.5.0 (Figma component design version)"}]}],"name":"Version"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.18.0"}]}],"name":"Since"}]}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOTag/init(_:tableName:bundle:status:appearance:shape:size:)":{"url":"\/documentation\/misocomponents\/misotag\/init(_:tablename:bundle:status:appearance:shape:size:)","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTag\/init(_:tableName:bundle:status:appearance:shape:size:)","abstract":[{"type":"text","text":"Creates a tag with a localized label, looking up the key in the given bundle."}],"type":"topic","kind":"symbol","title":"init(_:tableName:bundle:status:appearance:shape:size:)","role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"preciseIdentifier":"s:7SwiftUI18LocalizedStringKeyV","kind":"typeIdentifier","text":"LocalizedStringKey"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tableName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"bundle"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)NSBundle","kind":"typeIdentifier","text":"Bundle"},{"kind":"text","text":", "},{"kind":"externalParam","text