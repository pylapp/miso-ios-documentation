{"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTag"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"]},{"kind":"content","content":[{"type":"heading","text":"Appearances","anchor":"Appearances","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tags have two appearances so as to highlight or not their content:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"emphasized","type":"text"}]},{"text":": A tag with a solid, high-contrast background. Used to draw strong attention to important","type":"text"},{"text":" ","type":"text"},{"text":"labels or categories. Emphasized tags stand out prominently against the interface and are ideal for","type":"text"},{"text":" ","type":"text"},{"text":"primary or high-priority information.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"muted","type":"text"}]},{"type":"text","text":": A tag with a subtle, light, or semi-transparent background. Used for secondary or"},{"type":"text","text":" "},{"type":"text","text":"less prominent information. Muted tags blend more with the background, providing a softer visual"},{"type":"text","text":" "},{"type":"text","text":"emphasis compared to emphasized tags."}]}]}]},{"level":2,"text":"Status","type":"heading","anchor":"Status"},{"inlineContent":[{"type":"text","text":"Tags have seven status depending on the context of the information they represent. Each state is designed"},{"type":"text","text":" "},{"type":"text","text":"to convey a specific meaning and ensure clarity in communication."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Neutral","type":"text"}]},{"type":"text","text":": Default or inactive state. Used for standard labels, categories, or when no specific"},{"type":"text","text":" "},{"type":"text","text":"status needs to be communicated."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Accent"}]},{"type":"text","text":": Used to draw attention to new features, recommendations, or content suggestions."},{"type":"text","text":" "},{"type":"text","text":"Invites users to explore and engage with new offerings, creating an exciting and engaging experience."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Positive","type":"text"}],"type":"strong"},{"type":"text","text":": Indicates success, confirmation, or a positive status. Commonly used to highlight"},{"type":"text","text":" "},{"type":"text","text":"completed actions or approved items."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Warning","type":"text"}],"type":"strong"},{"type":"text","text":": Signals caution or a potentially risky situation. Used to draw attention to items"},{"text":" ","type":"text"},{"text":"requiring user awareness or intervention.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Negative"}]},{"type":"text","text":": Represents errors, critical issues, or urgent attention needed. Used to highlight"},{"type":"text","text":" "},{"type":"text","text":"problems or failed actions."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Info","type":"text"}],"type":"strong"},{"text":": Conveys informational messages or supplementary details. Used for neutral, helpful,","type":"text"},{"text":" ","type":"text"},{"text":"or contextual information.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Disabled","type":"text"}]},{"type":"text","text":": Shows that the tag is inactive and cannot be interacted with. Appears faded or greyed out. This is not"},{"type":"text","text":" "},{"type":"text","text":"allowed when loader is activated."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Shape","text":"Shape"},{"type":"paragraph","inlineContent":[{"text":"Tags can have two shapes:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Rounded"}],"type":"strong"},{"type":"text","text":": A tag with fully rounded corners, creating a pill-shaped appearance. Rounded"},{"type":"text","text":" "},{"type":"text","text":"tags offer a softer and more approachable look, suitable for most modern interfaces."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Square"}],"type":"strong"},{"type":"text","text":": A tag with sharp, square corners. Squared tags provide a more formal, structured, or"},{"type":"text","text":" "},{"type":"text","text":"technical feel. They are often used in business contexts to label promotions, offers, or important notices."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Size","text":"Size"},{"inlineContent":[{"text":"Tags can have two sizes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Default","type":"text"}],"type":"strong"},{"type":"text","text":": The standard tag size, suitable for most use cases and offering good readability."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Small","type":"text"}],"type":"strong"},{"text":": A compact tag with reduced height and font size. Used when saving space is important or","type":"text"},{"text":" ","type":"text"},{"text":"when grouping elements visually.","type":"text"}]}]}]},{"text":"Layout","anchor":"Layout","level":2,"type":"heading"},{"inlineContent":[{"text":"There are four available layouts for tags:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"-","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Text only"}]},{"text":": A tag that displays only text. Used for simple labels, categories, or keywords without additional visual","type":"text"},{"text":" ","type":"text"},{"text":"elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"-","type":"text"},{"inlineContent":[{"text":"Text + Bullet","type":"text"}],"type":"strong"},{"text":": A tag with a small indicator (dot) alongside the text. Used to show status, presence, or activity","type":"text"},{"type":"text","text":" "},{"type":"text","text":"next to the label."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"-"},{"inlineContent":[{"type":"text","text":"Text + Icon"}],"type":"strong"},{"text":": A tag that includes an icon before the text. Used to visually reinforce the meaning of the tag,","type":"text"},{"text":" ","type":"text"},{"text":"such as status, type, or action.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Text + Loader"}]},{"type":"text","text":": A tag that combines a loading spinner (or progress indicator) with text. Used to indicate that"},{"type":"text","text":" "},{"type":"text","text":"a process or action related to the tag is in progress."}]}]}],"type":"unorderedList"},{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"code":["    \/\/ Text only with neutral status, for emphasized appearance with rounded shape in default size","    MISOTag(label: \"Label\",  status: .neutral(), appearance: .emphasized, shape: .rounded, size: .default)","    \/\/ Or also","    MISOTag(label: \"Label\")","    \/\/ Or from a localizale and a bundle","    MISOTag(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","    \/\/ Tag with neutral status with bullet","    MISOTag(label: \"Label\", status: .neutral(leading: .bullet)","","    \/\/ Tag with neutral status with a custom decorative icon","    MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"))))","    \/\/ If your layout is in RTL mode but your tag has an icon with another meaning because of bad orientation,","    \/\/ you can flip the icon using MISOImage.flipped","    MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(decorative: \"ic_heart\"), flipped: true)))","    \/\/ If you want to display a raw image (not tinted), use renderingMode: .original","    MISOTag(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_brand\"), renderingMode: .original)))","","    \/\/ Text with neutral status with bullet","    MISOTag(label: \"Label\", status: .neutral(bullet: true))","","    \/\/ Tag with indeterminate circular progress indicator, with rounded shape in small size","    MISOTag(loadingLabel: \"Processing...\", shape: .rounded, size: .small)","","    \/\/ Tag with determinate circular progress indicator, with rounded shape in default size","    MISOTag(loadingLabel: \"Processing...\", progress: 0.75)"],"syntax":"swift","type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.5.0 (Figma component design version)"}]}],"name":"Version","type":"aside"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.18.0"}],"type":"paragraph"}],"name":"Since","type":"aside"}]}],"metadata":{"role":"symbol","title":"MISOTag","navigatorTitle":[{"text":"MISOTag","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTag","kind":"identifier"}],"modules":[{"name":"Components"}],"platforms":[{"name":"iOS","introducedAt":"15.