"},{"text":">","kind":"text"}],"title":"accessibilityCustomContent(_:_:importance:)","abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/accessibilityCustomContent(_:_:importance:)-6wsh6","url":"\/documentation\/misocomponents\/misosuggestionchip\/accessibilitycustomcontent(_:_:importance:)-6wsh6"},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip":{"title":"MISOSuggestionChip","kind":"symbol","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"type":"text","text":" "},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}],"url":"\/documentation\/misocomponents\/misosuggestionchip","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOSuggestionChip","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","title":"Components","type":"topic","kind":"symbol","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of a