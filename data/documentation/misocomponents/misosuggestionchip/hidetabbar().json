pe":"text"},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"whenever a view inside a ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":" embedded in an ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" needs to hide","type":"text"},{"text":" ","type":"text"},{"text":"the tab bar. Without this modifier, ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" cannot detect the visibility change","type":"text"},{"text":" ","type":"text"},{"text":"and its overlay elements remain visible on top of the content. This helper must be used for","type":"text"},{"text":" ","type":"text"},{"text":"apps with nested views and tab bars.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Otherwise for simple app ","type":"text"},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"text":" is enough.","type":"text"}]},{"syntax":"swift","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"],"type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misosuggestionchip\/hidetabbar()"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/hideTabBar()"},"abstract":[{"text":"Hides the native tab bar ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" signals "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"references":{"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","kind":"symbol","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","type":"topic","imag