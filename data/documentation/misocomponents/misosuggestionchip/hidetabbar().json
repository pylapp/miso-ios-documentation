l":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"A view that hides the tab bar and propagates the hidden state to ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"text":" overlay items.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this modifier instead of "},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"whenever a view inside a "},{"code":"NavigationStack","type":"codeVoice"},{"type":"text","text":" embedded in an "},{"code":"MISOTabBar","type":"codeVoice"},{"type":"text","text":" needs to hide"},{"type":"text","text":" "},{"type":"text","text":"the tab bar. Without this modifier, "},{"code":"MISOTabBar","type":"codeVoice"},{"type":"text","text":" cannot detect the visibility change"},{"type":"text","text":" "},{"type":"text","text":"and its overlay elements remain visible on top of the content. This helper must be used for"},{"type":"text","text":" "},{"type":"text","text":"apps with nested views and tab bars."}]},{"type":"paragraph","inlineContent":[{"text":"Otherwise for simple app ","type":"text"},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"text":" is enough.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/hideTabBar()","interfaceLanguage":"swift"},"references":{"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/misocomponents","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","title":"Components","role":"collection","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip":{"url":"\/documentation\/misocomponents\/misosuggestionchip","title":"MISOSuggestionChip","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}],"abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}]},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","type":"image","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}]},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/hideTabBar()":{"identifier":"doc:\/\/MISOComponents\/document