bstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/misocomponents\/misosuggestionchip","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}]},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/hideTabBar()":{"kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/hideTabBar()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hideTabBar","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"title":"hideTabBar()","type":"topic","abstract":[{"type":"text","text":"Hides the native tab bar "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" signals "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"url":"\/documentation\/misocomponents\/misosuggest