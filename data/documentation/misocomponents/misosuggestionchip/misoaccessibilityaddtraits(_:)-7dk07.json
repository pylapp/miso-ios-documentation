":"\/documentation\/misocomponents\/misosuggestionchip","title":"MISOSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"text":"MISOSuggestionChip","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip"},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/misoAccessibilityAddTraits(_:)-7dk07":{"url":"\/documentation\/misocomponents\/misosuggestionchip\/misoaccessibilityaddtraits(_:)-7dk07","type":"topic","abstract":[{"type":"text","text":"Adds one accessibility trait to add to any compatible MISO components in the view subtree."}],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"misoAccessibilityAddTraits","kind":"identifier"},{"text":"(","kind":"text"},{"text":"AccessibilityTraits","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI19AccessibilityTraitsV"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier