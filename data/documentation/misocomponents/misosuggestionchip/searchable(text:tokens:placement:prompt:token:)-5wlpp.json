 elements.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"text":"MISOSuggestionChip","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip"}}}