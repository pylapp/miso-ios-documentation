nce Method","externalID":"s:7SwiftUI4ViewP14MISOComponentsE15bodyStrongLargeyQr18MISOThemesContract9MISOThemeCF::SYNTHESIZED::s:14MISOComponents18MISOSuggestionChipV","title":"bodyStrongLarge(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bodyStrongLarge","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:18MISOThemesContract9MISOThemeC","text":"MISOTheme","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}]},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip"]]},"abstract":[{"type":"text","text":"Modifies the current "},{"type":"codeVoice","code":"View"},{"type":"text","text":" to apply a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"body strong large"}]},{"text":" typography.","type":"text"},{"text":" ","type":"text"},{"text":"The current ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"text":" must be given in parameter because ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" property cannot be accessed through an extension or inside a method."}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/bodyStrongLarge(_:)":{"url":"\/documentation\/misocomponents\/misosuggestionchip\/bodystronglarge(_:)","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/bodyStrongLarge(_:)","kind":"symbol","title":"bodyStrongLarge(_:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"bodyStrongLarge"},{"kind":"text","text":"("},{"text":"MISOTheme","kind":"typeIdentifier","preciseIdentifier":"s:18MISOThemesContract9MISOThemeC"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"abstract":[{"type":"text","text":"Modifies the current "},{"code":"View","type":"codeVoice"},{"type":"text","text":" to apply a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"body strong large"}]},{"type":"text","text":" typography."},{"type":"text","text":" "},{"type":"text","text":"The current "},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":" must be given in parameter because "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" property cannot be accessed through an extension or inside a method."}]},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip":{"title":"MISOSuggestionChip","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/misocomponents\/misosuggestionchip","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}]},"doc://MISOThemesCon