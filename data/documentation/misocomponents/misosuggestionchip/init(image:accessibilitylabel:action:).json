e area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/misocomponents\/misosuggestionchip","role":"symbol","navigatorTitle":[{"text":"MISOSuggestionChip","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOSuggestionChip","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOImage":{"kind":"symbol","url":"\/documentation\/misocomponents\/misoimage","title":"MISOImage","abstract":[{"text":"Use to provide an asset to miso in order to be added in some components.","type":"text"},{"text":" ","type":"text"},{"text":"The icon can be flipped for RTL consideration and an associated ","type":"text"},{"code":"acessibilityLabel","type":"codeVoice"},{"text":"must be provided","type":"text"},{"text":" ","type":"text"},{"text":"if the icon is not decorative.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOImage"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOImage"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOImage","type":"topic"},"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","url":"\/documentation\/misocomponents","type":"topic","role":"collection","images":[{"identifier":"ic_folde