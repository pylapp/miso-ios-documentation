OSuggestionChip":{"title":"MISOSuggestionChip","kind":"symbol","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"type":"text","text":" "},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}],"url":"\/documentation\/misocomponents\/misosuggestionchip","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOSuggestionChip","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/dynamicTypeSize(_:)-3i9yb":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"dynamicTypeSize"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP","text":"View"}],"title":"dynamicTypeSize(_:)","role":"symbol","url":"\/documentation\/misocomponents\/misosuggestionchip\/dynamictypesize(_:)-3i9yb","abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/d