"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misosuggestionchip\/body"]}],"sections":[],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/body":{"abstract":[],"title":"body","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"url":"\/documentation\/misocomponents\/misosuggestionchip\/body","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/body","role":"symbol","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip":{"url":"\/documentation\/misocomponents\/misosuggestionchip","title":"MISOSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"text":"and is commonly used to capture filtering decisions.","type":"text"},{"text":" ","type":"text"},{"text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"text":" ","type":"text"},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"text":"MISOSuggestionChip","kind":"identifier"}],"identifier":"doc:\/\/MI