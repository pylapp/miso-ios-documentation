","type":"image","alt":null},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip":{"kind":"symbol","title":"MISOSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/misocomponents\/misosuggestionchip","role":"symbol","navigatorTitle":[{"text":"MISOSuggestionChip","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOSuggestionChip","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOImage":{"kind":"symbol","url":"\/documentation\/misocomponents\/misoimage","title":"MISOImage","abstract":[{"text":"Use to provide an asset to miso in order to be added in some components.","type":"text"},{"text":" ","type":"text"},{"text":"The icon can be flipped for RTL consideration and an associated ","type":"text"},{"code":"acessibilityLabel","type":"codeVoice"},{"text":"must be provided","type":"text"},{"text":" ","type":"text"},{"text":"if the icon is not decorative.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOImage"}],"fragments":[{"kind":"keyword","text":"struct"}