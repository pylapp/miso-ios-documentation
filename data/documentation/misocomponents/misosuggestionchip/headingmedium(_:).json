ng input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/misocomponents\/misosuggestionchip","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}]},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/headingMedium(_:)":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/headingMedium(_:)","type":"topic","role":"symbol","title":"headingMedium(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"headingMedium"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"MISOTheme","preciseIdentifier":"s:18MISOThemesContract9MISOThemeC"},{"text":") -> ","kind":"text"},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"}],"url":"\/documentation\/misocomponents\/misosuggestionchip\/headingmedium(_:)","abstract":[{"type":"text","text":"Modifies the current "},{"type":"codeVoice","code":"View"},{"type":"text","text":" to apply a "},{"type":"emphasis","inlineContent":[{"text":"heading medium","type":"text"}]},{"type":"text","text":" typography."},{"text":" ","type":"text"},{"type":"text","text":"The current "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" must be given in parameter because "},{"type":"codeVoice","code":"@Environment"},{"text":" property cannot be accessed through an extension or inside a method.","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOTheme":{"url":"\/documentation\/misothemescontract\/misotheme","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","kind":"symbol","title":"MISOTheme","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTheme","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MISOTheme","kind":"identifier"}],"abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"object oriented paradigm"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme contract"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"final"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}]}}}