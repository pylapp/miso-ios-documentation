ity.","type":"text"},{"text":" ","type":"text"},{"text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts.","type":"text"},{"type":"text","text":" "},{"text":"Best suited for category-based filters that do not require additional visual elements.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}],"url":"\/documentation\/misocomponents\/misosuggestionchip","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOSuggestionChip","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/headingXLarge(_:)":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/headingXLarge(_:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Modifies the current "},{"code":"View","type":"codeVoice"},{"type":"text","text":" to apply a "},{"inlineContent":[{"type":"text","text":"heading x large"}],"type":"emphasis"},{"type":"text","text":" typography."},{"type":"text","text":" "},{"type":"text","text":"The current "},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":" must be given in parameter because "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" property cannot be accessed through an extension or inside a method."}],"title":"headingXLarge(_:)","url":"\/documentation\/misocomponents\/misosuggestionchip\/headingxlarge(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"headingXLarge"},{"kind":"text","text":"("},{"preciseIdentifier":"s:18MISOThemesContract9MISOThemeC","kind":"typeIdentifier","text":"MISOTheme"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}]},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","title":"Components","type":"topic","kind":"symbol","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}]},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOTheme":{"title":"MISOTheme","kind":"symbol","type":"topic","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"text":"to implement all tokens.","type":"text"},{"type":"text","text":" "},{"text":"Any properties of an overridable theme should be defined so as to provide defaults values.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","type":"reference","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"text":"object oriented paradigm","type":"text"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"text":"theme contract","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"code