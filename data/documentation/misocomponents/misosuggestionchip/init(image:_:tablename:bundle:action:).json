d to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/misocomponents\/misosuggestionchip","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}]},"doc://MISOComponents/documentation/MISOComponents/MISOImage":{"role":"symbol","url":"\/documentation\/misocomponents\/misoimage","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOImage","kind":"identifier"}],"title":"MISOImage","navigatorTitle":[{"text":"MISOImage","kind":"identifier"}],"abstract":[{"text":"Use to provide an asset to miso in order to be added in some components.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"The icon can be flipped for RTL consideration and an associated "},{"code":"acessibilityLabel","type":"codeVoice"},{"type":"text","text":"must be provided"},{"type":"text","text":" "},{"type":"text","text":"if the icon is not decorative."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOImage","type":"topic"},"ic_folder_categories.png":{"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","identifier":"ic_folder_categories.png","alt":null}}}