MISOSuggestionChip":{"kind":"symbol","title":"MISOSuggestionChip","abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}],"url":"\/documentation\/misocomponents\/misosuggestionchip","role":"symbol","navigatorTitle":[{"text":"MISOSuggestionChip","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOSuggestionChip","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip/accessibilityRepresentation(representation:)":{"kind":"symbol","title":"accessibilityRepresentation(representation:)","url":"\/documentation\/misocomponents\/misosuggestionchip\/accessibilityrepresentation(representation:)","role":"symbol","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip\/accessibilityRepresentation(representation:)","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibilityRepresentation","kind":"identifier"},{"text":"<","kind":"text"},{"text":"V","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"representation","kind":"externalParam"},{"tex