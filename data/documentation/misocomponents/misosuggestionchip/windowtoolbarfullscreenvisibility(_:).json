ocumentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/misocomponents","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","title":"Components","role":"collection","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOSuggestionChip":{"url":"\/documentation\/misocomponents\/misosuggestionchip","title":"MISOSuggestionChip","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOSuggestionChip","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOSuggestionChip"}],"navigatorTitle":[{"kind":"identifier","text":"MISOSuggestionChip"}],"abstract":[{"type":"text","text":"Suggestion chip is a UI element that allows to present recommended or predictive options based on user’s input or context,"},{"type":"text","text":" "},{"type":"text","text":"and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Suggestion chip is typically non-selected by default and can be tapped or clicked to apply the suggestion, streamlining input and enhancing usability."},{"type":"text","text":" "},{"type":"text","text":"Chips can show multiple interactive elements together in the same area, such as a list of selectable movie times, or a serie of email contacts."},{"type":"text","text":" "},{"type":"text","text":"Best suited for category-based filters that do not require additional visual elements."}]}}}