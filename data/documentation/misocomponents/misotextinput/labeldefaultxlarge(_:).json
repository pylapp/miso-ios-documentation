","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"text":" ","type":"text"},{"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","type":"reference","isActive":true},{"text":" can be seen as a kind of “abstract class” in ","type":"text"},{"inlineContent":[{"type":"text","text":"object oriented paradigm"}],"type":"emphasis"},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme contract"}]},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"final"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}],"title":"MISOTheme","url":"\/documentation\/misothemescontract\/misotheme","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","navigatorTitle":[{"kind":"identifier","text":"MISOTheme"}]},"doc://MISOComponents/documentation/MISOComponents/MISOTextInput":{"navigatorTitle":[{"text":"MISOTextInput","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextInput","title":"MISOTextInput","abstract":[{"type":"text","text":"Text input is a UI element that allows to enter, edit, or select single-line textual data."},{"type":"text","text":" "},{"type":"text","text":"Text input is one of the most fundamental form elements used to capture user input such as names, emails, passwords, or search queries."},{"type":"text","text":" "},{"type":"text","text":"It provides a visual and interactive affordance for text entry while supporting labels, placeholders, icons, descriptions, and validation feedback."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MISOTextInput","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misotextinput","kind":"symbol","type":"topic","role":"symbol"},"ic_folder_categories.png":{"type":"image","alt":null,"identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]}}}