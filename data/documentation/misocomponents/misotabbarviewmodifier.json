{"variants":[{"paths":["\/documentation\/misocomponents\/misotabbarviewmodifier"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI12ViewModifierP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"abstract":[{"text":"Defines the look and feel the tab bar must have by applying the MISO tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Changes only colors and typgraphies, and does not add additional items like indicator of selected tab or divider.","type":"text"},{"text":" ","type":"text"},{"text":"To use these elements in your tab view, use instead ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBarViewModifier","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"externalID":"s:14MISOComponents22MISOTabBarViewModifierV","title":"MISOTabBarViewModifier","modules":[{"name":"Components"}],"role":"symbol","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBarViewModifier","kind":"identifier"}],"symbolKind":"struct","platforms":[{"beta":false,"introducedAt":"15.0","name":"iOS","deprecated":false,"unavailable":false}],"navigatorTitle":[{"text":"MISOTabBarViewModifier","kind":"identifier"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBarViewModifier\/init()"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBarViewModifier\/body(content:)"],"a