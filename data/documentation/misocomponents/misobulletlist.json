{"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Bullet list is a UI element that helps to view in related individual text items grouped together; items usually starting with a number or a bullet."},{"type":"text","text":" "},{"type":"text","text":"Bullet list is also known as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Unordered list"}]},{"type":"text","text":" or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Ordered list"}]},{"type":"text","text":" and is not an interactive element by default."}],"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/Item"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/init(type:textStyle:isBold:items:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/body"],"generated":true},{"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/TextStyle","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/Type","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/UnorderedAsset"],"generated":true},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/View-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOBulletList"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/ContentDisplay"],"kind":"mentions"},{"content":[{"text":"Types","anchor":"Types","level":2,"type":"heading"},{"inlineContent":[{"text":"Three types are proposed:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Unordered (by default)","type":"text"}],"type":"strong"},{"type":"text","text":": Collects related items that don’t need to be in a specific order or sequence."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Ordered"}],"type":"strong"},{"text":": Collects related items with numeric order or sequence.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Bare"}]},{"type":"text","text":": An unordered list without any bullets or alphanumeric sequence."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Types can be mixed in list, but must be identical for the same "},{"type":"codeVoice","code":"MISOBulletList.NestedLevel"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Levels","type":"heading","anchor":"Levels","level":2},{"type":"paragraph","inlineContent":[{"text":"Lists can include nested items to indicate hierarchy or subcategories, with indentation distinguishing each level.","type":"text"},{"text":" ","type":"text"},{"text":"Arrange ordered list items logically, such as ranking by importance, highest to lowest values, or in alphabetical \/ numeric order.","type":"text"},{"text":" ","type":"text"},{"text":"Three levels are maximum.","type":"text"}]},{"text":"Text Style","type":"heading","anchor":"Text-Style","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"List can be used with different font sizes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Body Large"}],"type":"strong"},{"text":": If the text accompanying the list component is the Body Large text. This variant is designed for more visual, engaging experiences.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Body Medium"}],"type":"strong"},{"text":": If the text accompanying the list component is the Body Medium text. This variant is best suited for functional, task-oriented experiences.","type":"text"}]}]}]},{"type":"heading","anchor":"Cases-forbidden-by-design","level":2,"text":"Cases forbidden by design"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"it is not allowed to have a depth of items greater than 3"}],"type":"strong"}],"type":"paragraph"},{"type":"heading","anchor":"Internationalisation-considerations","level":2,"text":"Internationalisation considerations"},{"inlineContent":[{"type":"text","text":"For latin-based speaking countries, like France, Spain, United Kingdom or Belgium, the european “arabic” numbers are used for the first level of depth"},{"type":"text","text":" "},{"type":"text","text":"of the ordered bullet list. For the second and third levels, the european alphabets are used with upper and lower case values."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"However for countries speaking arabic, these rules can’t be applied. Indeed, there is no notion of upper and lower case characters in arabic alphabet."},{"type":"text","text":" "},{"type":"text","text":"In addition, the numbers in use (i.e. the european “arabic” numbers like “1, 2, 3”) are accepted in arabic countries, even if the “true arabic” numbers (like “ ٢ ٣ ١”) are used"},{"type":"text","text":" "},{"type":"text","text":"in middle-east arabic countries and for official documents."},{"type":"text","text":" "},{"type":"text","text":"Thus the MISO ordered bullet list will use “european” numbers for first level, and arabic alphabets for second and third levels."}]},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","code":["       \/\/ 1. Unordered list with bullets","       MISOBulletList {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 1.1. Item of Unordered list with bullet as tick, a text style","       \/\/ body medium and text bold","       MISOBulletList(type: .unordered(asset: .tick),","                      textStyle: .bodyMedium,","                      isBold: true)  {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 2. Bare list with 3 items","       MISOBulletList(type: .bare) {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 3. Ordered list with 3 items","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 3.1. Ordered list with 3 items in first level,","       \/\/ and one item as sub item (second level),","       \/\/ and 2 items as sub item in (third level)","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\") {","               MISOBulletList.Item(\"Label 1.1\") {","                   MISOBulletList.Item(\"Label 1.1.1\")","                   MISOBulletList.Item(\"Label 1.1.2\")","               }","           }","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 4. Items with localized or rich texts, through `MISOTextualContent`","       MISOBulletList {","           MISOBulletList.Item(\"Raw text\") \/\/ Same as .raw(\"Raw text\")","           MISOBulletList.Item(.localized(\"item_label\", bundle: Bundle.module))","           MISOBulletList.Item(.rich(AttributedString(markdown: \"A **rich** text\"))) \/\/ Manage in your side errors for init","       }","","       \/\/ Same Bullet list but items in third level with free icon as bullet","       let icon = Image(decorative: \"ic_heart\")","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\") {","               MISOBulletList.Item(\"Label 1.1\", subListType: .unordered(asset: .icon(icon))) {","                   MISOBulletList.Item(\"Label 1.1.1\")","                   MISOBulletList.Item(\"Label 1.1.2\")","               }","           }","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }"],"syntax":"swift"},{"type":"heading","level":2,"text":"Rich text recommendations","anchor":"Rich-text-recommendations"},{"type":"paragraph","inlineContent":[{"text":"The text of an item is an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent","type":"reference"},{"text":": a raw ","type":"text"},{"code":"String","type":"codeVoice"},{"text":" (a string literal is enough), a localized","type":"text"},{"text":" ","type":"text"},{"text":"string with ","type":"text"},{"code":".localized(_:tableName:bundle:)","type":"codeVoice"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"code":"AttributedString","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Rich text can be applied for bullet list whatever the ","type":"text"},{"code":"isBold","type":"codeVoice"},{"text":" flag is.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly within alert messages to highlight key information."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"Underlined links must be bold."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}]},{"type":"heading","level":2,"anchor":"Accessibility-considerations","text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.1.0 (Figma component design version)"}]}],"type":"aside","name":"Version","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 1.2.0","type":"text"}]}],"type":"aside","name":"Since","style":"note"}],"kind":"content"}],"metadata":{"title":"MISOBulletList","externalID":"s:14MISOComponents14MISOBulletListV","role":"symbol","symbolKind":"struct","modules":[{"name":"Components"}],"navigatorTitle":[{"text":"MISOBulletList","kind":"identifier"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBulletList","kind":"identifier"}],"platforms":[{"deprecated":false,"name":"iOS","unavailable":false,"beta":fals