{"topicSections":[{"title":"Structures","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/Item"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/init(type:textStyle:isBold:items:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/body"],"anchor":"Instance-Properties","generated":true},{"title":"Enumerations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/TextStyle","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/Type","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/UnorderedAsset"],"anchor":"Enumerations","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/View-Implementations"],"anchor":"Default-Implementations","generated":true}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBulletList","kind":"identifier"}]}]},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/ContentDisplay"],"kind":"mentions"},{"content":[{"level":2,"anchor":"Types","type":"heading","text":"Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three types are proposed:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Unordered (by default)","type":"text"}]},{"type":"text","text":": Collects related items that don’t need to be in a specific order or sequence."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ordered","type":"text"}],"type":"strong"},{"type":"text","text":": Collects related items with numeric order or sequence."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Bare","type":"text"}]},{"type":"text","text":": An unordered list without any bullets or alphanumeric sequence."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Types can be mixed in list, but must be identical for the same "},{"type":"codeVoice","code":"MISOBulletList.NestedLevel"},{"type":"text","text":"."}]},{"level":2,"anchor":"Levels","type":"heading","text":"Levels"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lists can include nested items to indicate hierarchy or subcategories, with indentation distinguishing each level."},{"type":"text","text":" "},{"type":"text","text":"Arrange ordered list items logically, such as ranking by importance, highest to lowest values, or in alphabetical \/ numeric order."},{"text":" ","type":"text"},{"text":"Three levels are maximum.","type":"text"}]},{"level":2,"anchor":"Text-Style","type":"heading","text":"Text Style"},{"type":"paragraph","inlineContent":[{"text":"List can be used with different font sizes:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body Large"}]},{"type":"text","text":": If the text accompanying the list component is the Body Large text. This variant is designed for more visual, engaging experiences."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body Medium"}]},{"type":"text","text":": If the text accompanying the list component is the Body Medium text. This variant is best suited for functional, task-oriented experiences."}]}]}],"type":"unorderedList"},{"text":"Cases forbidden by design","level":2,"type":"heading","anchor":"Cases-forbidden-by-design"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"it is not allowed to have a depth of items greater than 3"}]}]},{"text":"Internationalisation considerations","level":2,"type":"heading","anchor":"Internationalisation-considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For latin-based speaking countries, like France, Spain, United Kingdom or Belgium, the european “arabic” numbers are used for the first level of depth"},{"type":"text","text":" "},{"type":"text","text":"of the ordered bullet list. For the second and third levels, the european alphabets are used with upper and lower case values."}]},{"type":"paragraph","inlineContent":[{"text":"However for countries speaking arabic, these rules can’t be applied. Indeed, there is no notion of upper and lower case characters in arabic alphabet.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, the numbers in use (i.e. the european “arabic” numbers like “1, 2, 3”) are accepted in arabic countries, even if the “true arabic” numbers (like “ ٢ ٣ ١”) are used","type":"text"},{"text":" ","type":"text"},{"text":"in middle-east arabic countries and for official documents.","type":"text"},{"text":" ","type":"text"},{"text":"Thus the MISO ordered bullet list will use “european” numbers for first level, and arabic alphabets for second and third levels.","type":"text"}]},{"text":"Code samples","level":2,"type":"heading","anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["       \/\/ 1. Unordered list with bullets","       MISOBulletList {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 1.1. Item of Unordered list with bullet as tick, a text style","       \/\/ body medium and text bold","       MISOBulletList(type: .unordered(asset: .tick),","                      textStyle: .bodyMedium,","                      isBold: true)  {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 2. Bare list with 3 items","       MISOBulletList(type: .bare) {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 3. Ordered list with 3 items","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 3.1. Ordered list with 3 items in first level,","       \/\/ and one item as sub item (second level),","       \/\/ and 2 items as sub item in (third level)","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\") {","               MISOBulletList.Item(\"Label 1.1\") {","                   MISOBulletList.Item(\"Label 1.1.1\")","                   MISOBulletList.Item(\"Label 1.1.2\")","               }","           }","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ Same Bullet list but items in third level with free icon as bullet","       let icon = Image(decorative: \"ic_heart\")","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\") {","               MISOBulletList.Item(\"Label 1.1\", subListType: .unordered(asset: .icon(icon))) {","                   MISOBulletList.Item(\"Label 1.1.1\")","                   MISOBulletList.Item(\"Label 1.1.2\")","               }","           }","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }"]},{"type":"heading","anchor":"Rich-text-recommendations","level":2,"text":"Rich text recommendations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be applied for bullet list whatever the "},{"code":"isBold","type":"codeVoice"},{"type":"text","text":" flag is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly within alert messages to highlight key information."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"Underlined links must be bold."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}]},{"type":"heading","anchor":"Accessibility-considerations","level":2,"text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"type":"aside","name":"Version","style":"note","content":[{"inlineContent":[{"type":"text","text":"1.1.0 (Figma component design version)"}],"type":"paragraph"}]},{"type":"aside","name":"Since","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 1.2.0","type":"text"}]}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/misocomponents\/misobulletlist"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"MISOBulletList"}],"fragments":[{"kind":"keyword","text":"struct"},{