{"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/Item"],"generated":true,"title":"Structures"},{"anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/init(type:textStyle:isBold:items:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/body"],"generated":true,"title":"Instance Properties"},{"anchor":"Enumerations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/TextStyle","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/Type","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/UnorderedAsset"],"generated":true,"title":"Enumerations"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList\/View-Implementations"],"generated":true,"title":"Default Implementations"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo","title":"Conforms To"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBulletList","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","sections":[],"abstract":[{"text":"Bullet list is a UI element that helps to view in related individual text items grouped together; items usually starting with a number or a bullet.","type":"text"},{"text":" ","type":"text"},{"text":"Bullet list is also known as ","type":"text"},{"inlineContent":[{"text":"Unordered list","type":"text"}],"type":"emphasis"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"Ordered list","type":"text"}],"type":"emphasis"},{"text":" and is not an interactive element by default.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBulletList","kind":"identifier"}]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/ContentDisplay"]},{"kind":"content","content":[{"text":"Types","type":"heading","level":2,"anchor":"Types"},{"inlineContent":[{"text":"Three types are proposed:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Unordered (by default)","type":"text"}]},{"text":": Collects related items that don’t need to be in a specific order or sequence.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ordered","type":"text"}]},{"text":": Collects related items with numeric order or sequence.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Bare","type":"text"}]},{"text":": An unordered list without any bullets or alphanumeric sequence.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Types can be mixed in list, but must be identical for the same ","type":"text"},{"code":"MISOBulletList.NestedLevel","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Levels","type":"heading","level":2,"anchor":"Levels"},{"inlineContent":[{"text":"Lists can include nested items to indicate hierarchy or subcategories, with indentation distinguishing each level.","type":"text"},{"text":" ","type":"text"},{"text":"Arrange ordered list items logically, such as ranking by importance, highest to lowest values, or in alphabetical \/ numeric order.","type":"text"},{"text":" ","type":"text"},{"text":"Three levels are maximum.","type":"text"}],"type":"paragraph"},{"text":"Text Style","type":"heading","level":2,"anchor":"Text-Style"},{"inlineContent":[{"text":"List can be used with different font sizes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Body Large"}],"type":"strong"},{"type":"text","text":": If the text accompanying the list component is the Body Large text. This variant is designed for more visual, engaging experiences."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Body Medium"}]},{"type":"text","text":": If the text accompanying the list component is the Body Medium text. This variant is best suited for functional, task-oriented experiences."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Cases forbidden by design","type":"heading","level":2,"anchor":"Cases-forbidden-by-design"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"it is not allowed to have a depth of items greater than 3","type":"text"}],"type":"strong"}]},{"text":"Internationalisation considerations","level":2,"type":"heading","anchor":"Internationalisation-considerations"},{"type":"paragraph","inlineContent":[{"text":"For latin-based speaking countries, like France, Spain, United Kingdom or Belgium, the european “arabic” numbers are used for the first level of depth","type":"text"},{"text":" ","type":"text"},{"text":"of the ordered bullet list. For the second and third levels, the european alphabets are used with upper and lower case values.","type":"text"}]},{"inlineContent":[{"text":"However for countries speaking arabic, these rules can’t be applied. Indeed, there is no notion of upper and lower case characters in arabic alphabet.","type":"text"},{"text":" ","type":"text"},{"text":"In addition, the numbers in use (i.e. the european “arabic” numbers like “1, 2, 3”) are accepted in arabic countries, even if the “true arabic” numbers (like “ ٢ ٣ ١”) are used","type":"text"},{"text":" ","type":"text"},{"text":"in middle-east arabic countries and for official documents.","type":"text"},{"text":" ","type":"text"},{"text":"Thus the MISO ordered bullet list will use “european” numbers for first level, and arabic alphabets for second and third levels.","type":"text"}],"type":"paragraph"},{"text":"Code samples","level":2,"type":"heading","anchor":"Code-samples"},{"syntax":"swift","type":"codeListing","code":["       \/\/ 1. Unordered list with bullets","       MISOBulletList {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 1.1. Item of Unordered list with bullet as tick, a text style","       \/\/ body medium and text bold","       MISOBulletList(type: .unordered(asset: .tick),","                      textStyle: .bodyMedium,","                      isBold: true)  {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 2. Bare list with 3 items","       MISOBulletList(type: .bare) {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 3. Ordered list with 3 items","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\")","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ 3.1. Ordered list with 3 items in first level,","       \/\/ and one item as sub item (second level),","       \/\/ and 2 items as sub item in (third level)","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\") {","               MISOBulletList.Item(\"Label 1.1\") {","                   MISOBulletList.Item(\"Label 1.1.1\")","                   MISOBulletList.Item(\"Label 1.1.2\")","               }","           }","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }","","       \/\/ Same Bullet list but items in third level with free icon as bullet","       let icon = Image(decorative: \"ic_heart\")","       MISOBulletList(type: .ordered) {","           MISOBulletList.Item(\"Label 1\") {","               MISOBulletList.Item(\"Label 1.1\", subListType: .unordered(asset: .icon(icon))) {","                   MISOBulletList.Item(\"Label 1.1.1\")","                   MISOBulletList.Item(\"Label 1.1.2\")","               }","           }","           MISOBulletList.Item(\"Label 2\")","           MISOBulletList.Item(\"Label 3\")","       }"]},{"text":"Rich text recommendations","anchor":"Rich-text-recommendations","level":2,"type":"heading"},{"inlineContent":[{"text":"Rich text can be applied for bullet list whatever the ","type":"text"},{"code":"isBold","type":"codeVoice"},{"text":" flag is.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly within alert messages to highlight key information.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be used for emphasis, as it is commonly associated with links.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined links must be bold.","type":"text"},{"text":" ","type":"text"},{"text":"If a hyperlink is needed within the content, the underlined style should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Italic should be used with care, some brands do not allow it.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"}],"type":"paragraph"},{"text":"Accessibility considerations","level":2,"type":"heading","anchor":"Accessibility-considerations"},{"inlineContent":[{"text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization.","type":"text"}],"type":"paragraph"},{"name":"Version","content":[{"inlineContent":[{"text":"1.1.0 (Figma component design version)","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Since","content":[{"inlineContent":[{"text":"OUDS 1.2.0","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misobulletlist"]}],"metadata":{"externalID":"s:14MISOComponents14MISOBulletListV","navigatorTitle":[{"text":"MISOBulletList","kind":"identifier"}],"roleHeading":"Structure","modules":[{"name":"Components"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBulletList","kind":"identifier"}],"role":"symbol","title":"MISOBulletList","symbolKind":"struct","platforms":[{"deprecated":false,"name":"iOS","introducedAt":"15.0","beta":false,"unavailable":false},{"deprecated":false,"name":"macOS","introducedAt":"13.0","beta":false,"unavailable":false},{"deprecated":false,"name":"tvOS","introducedAt":"16.0","beta":false,"unavailable":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","beta":false,"unavailable":false},{"deprecated":false,"name":"watchOS","introducedAt":"11.0","beta":false,"unavailable":false}]},"references":{"doc://MISOComponents/documentation/MISOComponents/ContentDisplay":{"type":"topic","kind":"article","url":"\/documentation\/misocomponents\/contentdisplay","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"content display","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/ContentDisplay","title":"Content Display","role":"article","images":[{"type":"icon","identifier":"ic_folder_c