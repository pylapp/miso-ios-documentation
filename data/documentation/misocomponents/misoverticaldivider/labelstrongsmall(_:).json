ontent":[{"type":"text","text":"final"}]},{"text":" class, its type cannot be seen as ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}]},"doc://MISOComponents/documentation/MISOComponents/MISOVerticalDivider":{"url":"\/documentation\/misocomponents\/misoverticaldivider","kind":"symbol","title":"MISOVerticalDivider","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOVerticalDivider","kind":"identifier"}],"navigatorTitle":[{"text":"MISOVerticalDivider","kind":"identifier"}],"abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"type":"codeVoice","code":"HStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."}]}}}