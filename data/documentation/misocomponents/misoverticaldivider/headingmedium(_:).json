ization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"code":"HStack","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","isActive":true,"type":"reference"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/misocomponents\/misoverticaldivider","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOVerticalDivider","kind":"identifier"}],"role":"symbol"},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOTheme":{"title":"MISOTheme","abstract":[{"text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor.","type":"text"},{"text":" ","type":"text"},{"text":"A Swift ","type":"text"},{"type":"codeVoice","code":"class"},{"text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers","type":"text"},{"text":" ","type":"text"},{"text":"to implement all tokens.","type":"text"},{"text":" ","type":"text"},{"text":"Any properties of an overridable theme should be defined so as to provide defaults values.","type":"text"},{"text":" ","type":"text"},{"text":"We allow this theme to be derivated and be overridden.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","type":"reference"},{"text":" can be seen as a kind of “abstract class” in ","type":"text"},{"inlineContent":[{"text":"object oriented paradigm","type":"text"}],"type":"emphasis"},{"text":", or ","type":"text"},{"inlineContent":[{"type":"text","text":"theme contract"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"type":"codeVoice","code":"MISOTheme"},{"text":" is not a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"final","type":"text"}]},{"text":" class, its type cannot be seen as ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTheme"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOTheme"}],"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","type":"topic","url":"\/documentation\/misothemescontract\/misotheme"},"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","url":"\/documentation\/misocomponents","type":"topic","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"title":"Components"}}}