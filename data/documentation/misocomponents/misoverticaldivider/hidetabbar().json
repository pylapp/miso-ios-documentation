e a heading or a container would.","type":"text"},{"text":" ","type":"text"},{"text":"A vertical Divider is used to separate content laid out side by side (","type":"text"},{"type":"codeVoice","code":"HStack"},{"text":").","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"text":" colors.","type":"text"},{"type":"text","text":" "},{"text":"The thickness (width) is fixed by dedicated token from ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MISOVerticalDivider","kind":"identifier"}],"title":"MISOVerticalDivider","url":"\/documentation\/misocomponents\/misoverticaldivider"},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"}}}