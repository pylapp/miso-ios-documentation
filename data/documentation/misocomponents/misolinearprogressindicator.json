{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"title":"MISOLinearProgressIndicator","platforms":[{"deprecated":false,"beta":false,"name":"iOS","introducedAt":"15.0","unavailable":false},{"deprecated":false,"beta":false,"name":"macOS","introducedAt":"13.0","unavailable":false},{"deprecated":false,"beta":false,"name":"tvOS","introducedAt":"16.0","unavailable":false},{"deprecated":false,"beta":false,"name":"visionOS","introducedAt":"1.0","unavailable":false},{"deprecated":false,"beta":false,"name":"watchOS","introducedAt":"11.0","unavailable":false}],"symbolKind":"struct","externalID":"s:14MISOComponents27MISOLinearProgressIndicatorV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"roleHeading":"Structure","role":"symbol","modules":[{"name":"Components"}]},"abstract":[{"text":"A linear indicator shows the progress of a task using a horizontal line.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Best used inside layouts to show progress.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"platforms":["macOS"]}]},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"],"kind":"mentions"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Variants","text":"Variants"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two variants are provided:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": the caller provides a "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" value in "},{"code":"[0, 1]","type":"codeVoice"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and"},{"type":"text","text":" "},{"type":"text","text":"reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate"},{"type":"text","text":" "},{"type":"text","text":"completion time or percentage."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"text":": no ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" is provided and the indicator loops continuously.","type":"text"},{"text":" ","type":"text"},{"text":"Shows that a process is active without indicating exact progress.","type":"text"},{"text":" ","type":"text"},{"text":"Used when the system cannot determine how long the task will take.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"text":"the interface is frozen.","type":"text"},{"text":" ","type":"text"},{"text":"For long loading times (over 5 seconds), additional context must be provided.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Statuses","anchor":"Statuses"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Neutral","type":"text"}]},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic"},{"type":"text","text":" "},{"type":"text","text":"loading, processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Accent","type":"text"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations,"},{"type":"text","text":" "},{"type":"text","text":"onboarding)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Positive"}]},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Info","type":"text"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data"},{"type":"text","text":" "},{"type":"text","text":"retrieval)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be"},{"text":" ","type":"text"},{"text":"monitored.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Negative","type":"text"}]},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","anchor":"Gap-size","text":"Gap size","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"text":": standard gap between the bar and the track (base Android Material 3 specification).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"type":"text","text":": reduced gap for a more compact appearance."}]}]}]},{"type":"heading","anchor":"Track","text":"Track","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs","type":"text"},{"text":" ","type":"text"},{"text":"a clear structure. The track helps define the full range of progress and makes the value easier to","type":"text"},{"text":" ","type":"text"},{"text":"read.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"false","type":"codeVoice"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Stop-indicator-determinate-only","text":"Stop indicator (determinate only)","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" (default): no stop indicator is drawn."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to","type":"text"},{"text":" ","type":"text"},{"text":"identify the end of the range easily. Required by accessibility criteria when the track has a","type":"text"},{"text":" ","type":"text"},{"text":"contrast below 3:1 with its container or the surface behind the container.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stop indicator is only available on the determinate variant, matching the Android Material 3"},{"type":"text","text":" "},{"type":"text","text":"specification: the indeterminate variant has no meaningful end position for it."}]},{"type":"heading","level":2,"text":"Helper text","anchor":"Helper-text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional text displayed below the progress bar to provide context or additional information."}]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"text":" mode, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/HelperTextType"},{"text":" which offers two variants:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".description(_:)"}]},{"text":": Displays a simple description text without the progress percentage.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" parameter controls horizontal alignment ("},{"type":"codeVoice","code":".center"},{"type":"text","text":", "},{"type":"codeVoice","code":".start"},{"type":"text","text":", or "},{"type":"codeVoice","code":".end"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".percent(description:alignment:)"}],"type":"strong"},{"text":": Displays the progress percentage with an optional description.","type":"text"},{"text":" ","type":"text"},{"text":"The percentage value and its ","type":"text"},{"code":"%","type":"codeVoice"},{"text":" symbol are assembled through the localized wording key","type":"text"},{"text":" ","type":"text"},{"code":"core_progressIndicator_percent_value","type":"codeVoice"},{"text":", so the symbol, its spacing and its position follow the","type":"text"},{"text":" ","type":"text"},{"text":"typographic rules of the current language (e.g. ","type":"text"},{"code":"\"75%\"","type":"codeVoice"},{"text":" in English, ","type":"text"},{"code":"\"75 %\"","type":"codeVoice"},{"text":" in French, ","type":"text"},{"code":"\"٪75\"","type":"codeVoice"},{"text":" in Arabic).","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".center"},{"type":"text","text":" (default), only the percentage is shown, centered."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".start"},{"type":"text","text":", the percentage is at the leading edge and the description (if provided) at the trailing edge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"alignment","type":"codeVoice"},{"type":"text","text":" is "},{"code":".end","type":"codeVoice"},{"type":"text","text":", the description (if provided) is at the leading edge and the percentage at the trailing edge."}]}]}]}]}]},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"text":" mode, the ","type":"text"},{"type":"codeVoice","code":"helperText"},{"text":" parameter is a simple ","type":"text"},{"type":"codeVoice","code":"String?"},{"text":" with a separate ","type":"text"},{"type":"codeVoice","code":"helperTextAlignment"},{"text":" parameter:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".center"}]},{"type":"text","text":" (default): The text is centered under the progress bar."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".start","type":"codeVoice"}]},{"text":": The text is aligned to the leading edge.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".end"}]},{"type":"text","text":": The text is aligned to the trailing edge."}]}]}]},{"type":"heading","anchor":"Animation","level":2,"text":"Animation"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Determinate"}],"type":"strong"},{"text":": when ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (default), the indicator progressively fills from ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to the target ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" on first display and animates any subsequent change of ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(based on Android Material 3 specifications). When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", the indicator is displayed instantly at its target value with no animation.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter on the indeterminate initializer.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled and a static bar filled at 70% is displayed when either"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or Low Power Mode is enabled."}]},{"type":"heading","level":2,"anchor":"Code-samples","text":"Code samples"},{"type":"heading","level":3,"anchor":"Determinate-Basic-usage","text":"Determinate — Basic usage"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    MISOLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    MISOLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    MISOLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    MISOLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    MISOLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    MISOLinearProgressIndicator(status: .info)","    MISOLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    MISOLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    MISOLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    MISOLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    MISOLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"]},{"type":"heading","level":2,"anchor":"Accessibility-considerations","text":"Accessibility considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" parameter to provide a custom name and state for VoiceOver:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}],"type":"paragraph"}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}],"type":"strong"},{"type":"text","text":". Example: "},{"inlineContent":[{"type":"text","text":"“download bar. downloading. 75 percent”"}],"type":"emphasis"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, the view exposes the current progress as an accessibility value (percentage)","type":"text"},{"text":" ","type":"text"},{"text":"so that Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"text":"“75 percent”","type":"text"}],"type":"emphasis"},{"text":", and is marked with the ","type":"text"},{"code":".updatesFrequently","type":"codeVoice"},{"text":" trait so that","type":"text"},{"text":" ","type":"text"},{"text":"assistive technologies know the value is changing. If a ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" is provided, it is exposed as the","type":"text"},{"text":" ","type":"text"},{"text":"accessibility label (Voice Over reads e.g. ","type":"text"},{"inlineContent":[{"text":"“Uploading. 75 percent”","type":"text"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The indicator never captures ","type":"text"},{"inlineContent":[{"type":"text","text":"Full Keyboard Access"}],"type":"strong"},{"text":" focus, as no interaction is possible on a","type":"text"},{"text":" ","type":"text"},{"text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".isStaticText"},{"text":" trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"type":"text","text":" mode without helper text, the view is hidden from Voice Over"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"type":"text","text":") — and therefore also excluded from Full Keyboard Access navigation:"},{"type":"text","text":" "},{"type":"text","text":"there is no readable value to expose. When a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, the helper text is exposed"},{"type":"text","text":" "},{"type":"text","text":"as accessibility label so the user still understands the context."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled."}]}]}]},{"level":2,"text":"Colored surfaces","anchor":"Colored-surfaces","type":"heading"},{"inlineContent":[{"type":"text","text":"When placed on an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface"},{"type":"text","text":", the indicator switches to a "},{"inlineContent":[{"text":"monochrome","type":"text"}],"type":"strong"},{"type":"text","text":" rendering, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is ignored."}],"type":"paragraph"},{"name":"Version","style":"note","content":[{"inlineContent":[{"text":"1.2.0 (Figma component design version)","type":"text"}],"type":"paragraph"}],"type":"aside"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}],"type":"aside","name":"Since"}]}],"variants":[{"paths":["\/documentation\/misocomponents\/misolinearprogressindicator"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator"},"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/init(progress:status:track:stopIndicator:helperTe