{"sections":[],"abstract":[{"text":"A linear indicator shows the progress of a task using a horizontal line.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Best used inside layouts to show progress.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","interfaceLanguage":"swift"},"metadata":{"externalID":"s:14MISOComponents27MISOLinearProgressIndicatorV","roleHeading":"Structure","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"navigatorTitle":[{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"modules":[{"name":"Components"}],"title":"MISOLinearProgressIndicator","role":"symbol","platforms":[{"deprecated":false,"name":"iOS","introducedAt":"15.0","unavailable":false,"beta":false},{"deprecated":false,"name":"macOS","introducedAt":"13.0","unavailable":false,"beta":false},{"deprecated":false,"name":"tvOS","introducedAt":"16.0","unavailable":false,"beta":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false},{"deprecated":false,"name":"watchOS","introducedAt":"11.0","unavailable":false,"beta":false}]},"relationshipsSections":[{"identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"paths":["\/documentation\/misocomponents\/misolinearprogressindicator"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLinearProgressIndicator","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"],"kind":"mentions"},{"content":[{"type":"heading","text":"Variants","anchor":"Variants","level":2},{"inlineContent":[{"text":"Two variants are provided:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"text":": the caller provides a ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" value in ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":". Values outside this range are coerced.","type":"text"},{"text":" ","type":"text"},{"text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%.","type":"text"},{"text":" ","type":"text"},{"text":"Provides clear and measurable feedback, helping users understand how long the task will take and","type":"text"},{"text":" ","type":"text"},{"text":"reducing uncertainty.","type":"text"},{"text":" ","type":"text"},{"text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g.","type":"text"},{"text":" ","type":"text"},{"text":"when the progress value is known (file upload, installation, data sync) or when the system can estimate","type":"text"},{"text":" ","type":"text"},{"text":"completion time or percentage.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Indeterminate"}],"type":"strong"},{"type":"text","text":": no "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking"},{"type":"text","text":" "},{"type":"text","text":"the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."}]}]}]},{"type":"heading","level":2,"text":"Statuses","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Neutral"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic"},{"type":"text","text":" "},{"type":"text","text":"loading, processing, synchronization or background tasks."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Accent"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations,"},{"type":"text","text":" "},{"type":"text","text":"onboarding)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Positive"}],"type":"strong"},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Info"}],"type":"strong"},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data"},{"type":"text","text":" "},{"type":"text","text":"retrieval)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be"},{"type":"text","text":" "},{"type":"text","text":"monitored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Negative"}],"type":"strong"},{"text":": indicates progress related to an error, recovery, cancellation or failure.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Gap-size","type":"heading","level":2,"text":"Gap size"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":": standard gap between the bar and the track (base Android Material 3 specification)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"small"}],"type":"strong"},{"text":": reduced gap for a more compact appearance.","type":"text"}]}]}]},{"anchor":"Track","type":"heading","level":2,"text":"Track"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs","type":"text"},{"text":" ","type":"text"},{"text":"a clear structure. The track helps define the full range of progress and makes the value easier to","type":"text"},{"text":" ","type":"text"},{"text":"read.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}],"type":"paragraph"}]}]},{"text":"Stop indicator (determinate only)","anchor":"Stop-indicator-determinate-only","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"false","type":"codeVoice"},{"text":" (default): no stop indicator is drawn.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":": a small square (or dot if the theme uses rounded caps) is drawn at the end of the track to"},{"type":"text","text":" "},{"type":"text","text":"identify the end of the range easily. Required by accessibility criteria when the track has a"},{"type":"text","text":" "},{"type":"text","text":"contrast below 3:1 with its container or the surface behind the container."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The stop indicator is only available on the determinate variant, matching the Android Material 3","type":"text"},{"text":" ","type":"text"},{"text":"specification: the indeterminate variant has no meaningful end position for it.","type":"text"}],"type":"paragraph"},{"text":"Helper text","anchor":"Helper-text","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An optional text displayed below the progress bar to provide context or additional information."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, use "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/HelperTextType","type":"reference","isActive":true},{"type":"text","text":" which offers two variants:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".description(_:)","type":"codeVoice"}]},{"type":"text","text":": Displays a simple description text without the progress percentage."},{"type":"text","text":" "},{"type":"text","text":"The "},{"code":"alignment","type":"codeVoice"},{"text":" parameter controls horizontal alignment (","type":"text"},{"code":".center","type":"codeVoice"},{"text":", ","type":"text"},{"code":".start","type":"codeVoice"},{"text":", or ","type":"text"},{"code":".end","type":"codeVoice"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".percent(description:alignment:)","type":"codeVoice"}],"type":"strong"},{"text":": Displays the progress percentage with an optional description.","type":"text"},{"text":" ","type":"text"},{"text":"The percentage value and its ","type":"text"},{"type":"codeVoice","code":"%"},{"text":" symbol are assembled through the localized wording key","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"text":", so the symbol, its spacing and its position follow the","type":"text"},{"text":" ","type":"text"},{"text":"typographic rules of the current language (e.g. ","type":"text"},{"type":"codeVoice","code":"\"75%\""},{"text":" in English, ","type":"text"},{"type":"codeVoice","code":"\"75 %\""},{"text":" in French, ","type":"text"},{"type":"codeVoice","code":"\"٪75\""},{"text":" in Arabic).","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".center"},{"text":" (default), only the percentage is shown, centered.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"When ","type":"text"},{"code":"alignment","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".start","type":"codeVoice"},{"text":", the percentage is at the leading edge and the description (if provided) at the trailing edge.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"alignment"},{"type":"text","text":" is "},{"type":"codeVoice","code":".end"},{"type":"text","text":", the description (if provided) is at the leading edge and the percentage at the trailing edge."}]}]}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" parameter is a simple "},{"type":"codeVoice","code":"String?"},{"type":"text","text":" with a separate "},{"type":"codeVoice","code":"helperTextAlignment"},{"type":"text","text":" parameter:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".center","type":"codeVoice"}],"type":"strong"},{"text":" (default): The text is centered under the progress bar.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".start"}],"type":"strong"},{"text":": The text is aligned to the leading edge.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".end"}]},{"type":"text","text":": The text is aligned to the trailing edge."}]}]}]},{"anchor":"Animation","type":"heading","level":2,"text":"Animation"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Determinate","type":"text"}]},{"type":"text","text":": when "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" (default), the indicator progressively fills from "},{"code":"0","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to the target "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" on first display and animates any subsequent change of "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(based on Android Material 3 specifications). When "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":", the indicator is displayed instantly at its target value with no animation."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Indeterminate"}]},{"type":"text","text":": the Android Material 3 two-line animation is intrinsic to the mode and cannot be disabled from the call site; there is no "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" "},{"text":"parameter on the indeterminate initializer.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled and a static bar filled at 70% is displayed when either"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or Low Power Mode is enabled."}]},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"heading","level":3,"text":"Determinate — Basic usage","anchor":"Determinate-Basic-usage"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Determinate — default (neutral, with track, default gap, reveal animation)","    MISOLinearProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status, no track and a helper text","    MISOLinearProgressIndicator(progress: 0.5,","                                status: .accent,","                                track: false,","                                helperText: .description(\"Uploading…\"))","","    \/\/ Description aligned to the end","    MISOLinearProgressIndicator(progress: 0.5, helperText: .description(\"Uploading...\", alignment: .end))","","    \/\/ Percentage centered (default)","    MISOLinearProgressIndicator(progress: 0.75, helperText: .percent())","","    \/\/ Percentage with description at start (percentage leading, description trailing)","    MISOLinearProgressIndicator(progress: 0.75,","                                helperText: .percent(description: \"of 100 MB\", alignment: .start))","","    \/\/ Indeterminate","    MISOLinearProgressIndicator(status: .info)","    MISOLinearProgressIndicator(status: .accent, helperText: \"Processing…\")","","    \/\/ Helper text aligned to the end","    MISOLinearProgressIndicator(status: .info,","                                helperText: \"Loading data…\",","                                helperTextAlignment: .end)","","    \/\/ Determinate with accessibility name and state for VoiceOver","    MISOLinearProgressIndicator(progress: 0.75,","                                accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    MISOLinearProgressIndicator(progress: 0.5,","                                accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate with accessibility","    MISOLinearProgressIndicator(status: .info,","                                accessibility: .init(name: \"loading\", state: \"processing\"))"]},{"type":"heading","level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":"accessibility","type":"codeVoice"},{"type":"text","text":" parameter to provide a custom name and state for VoiceOver:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"type":"strong","inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}]},{"text":". Example: ","type":"text"},{"inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}],"type":"emphasis"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage)"},{"type":"text","text":" "},{"type":"text","text":"so that Voice Over reads e.g. "},{"type":"emphasis","inlineContent":[{"text":"“75 percent”","type":"text"}]},{"type":"text","text":", and is marked with the "},{"type":"codeVoice","code":".updatesFrequently"},{"type":"text","text":" trait so that"},{"type":"text","text":" "},{"type":"text","text":"assistive technologies know the value is changing. If a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, it is exposed as the"},{"type":"text","text":" "},{"type":"text","text":"accessibility label (Voice Over reads e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Uploading. 75 percent”"}]},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The indicator never captures ","type":"text"},{"inlineContent":[{"type":"text","text":"Full Keyboard Access"}],"type":"strong"},{"text":" focus, as no interaction is possible on a","type":"text"},{"text":" ","type":"text"},{"text":"progress indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic","type":"text"},{"text":" ","type":"text"},{"code":".isStaticText","type":"codeVoice"},{"text":" trait is used.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode without helper text, the view is hidden from Voice Over"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"type":"text","text":") — and therefore also excluded from Full Keyboard Access navigation:"},{"type":"text","text":" "},{"type":"text","text":"there is no readable value to expose. When a "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" is provided, the helper text is exposed"},{"type":"text","text":" "},{"type":"text","text":"as accessibility label so the user still understands the context."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled."}]}]}]},{"text":"Colored surfaces","anchor":"Colored-surfaces","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When placed on an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface"},{"type":"text","text":", the indicator switches to a "},{"type":"strong","inlineContent":[{"type":"text","text":"monochrome"}]},{"type":"text","text":" rendering, the"},{"type":"text","text":" "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is ignored."}],"type":"paragraph"},{"name":"Version","type":"aside","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}],"style":"note"},{"name":"Since","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 3.0.0"}]}],"style":"note"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/init(progress:status:track:stopIndicator:helperText:gapSize:animated:accessibility:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/init(status:track:helperText:helperTextAlignment:gapSize:accessibility:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/body"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/HelperTextAlignment","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/HelperTextType"],"anchor":"Enumerations","title":"Enumerations","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOLinearProgressIndicator":{"navigatorTitle":[{"kind":"identifier","text":"MISOLinearProgressIndicator"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLinearProgressIndicator","title":"MISOLinearProgressIndicator","abstract":[{"type":"text","text":"A linear indicator shows the progress of a task using a horizontal line."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"type":"text","text":"Best used inside layouts to show progress."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text"