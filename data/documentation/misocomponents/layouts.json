{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"text":"layouts","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"level":3,"anchor":"Colored-Surface","type":"heading","text":"Colored Surface"},{"tabs":[{"content":[{"inlineContent":[{"identifier":"component_coloredSurface_BlueCoat","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"inlineContent":[{"text":"Colored backgrounds use surface colors to maximize the contrast with content.","type":"text"},{"text":" ","type":"text"},{"text":"The colors of several MISO components (for instance ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","type":"reference"},{"text":") are automatically adjusted if they are placed on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To do so, some tokens associated with these specific colors can be customized and are identified with the ","type":"text"},{"inlineContent":[{"type":"text","text":"Mono"}],"type":"emphasis"},{"text":" suffix (for instance ","type":"text"},{"inlineContent":[{"type":"text","text":"colorBgDefaultEnabledMono"}],"type":"emphasis"},{"text":" of ","type":"text"},{"inlineContent":[{"type":"text","text":"BlueCoatThemeButtonComponentTokensProvider"}],"type":"emphasis"},{"text":").","type":"text"}],"type":"paragraph"},{"level":4,"anchor":"How-it-works","type":"heading","text":"How it works"},{"inlineContent":[{"text":"According to the color, the ","type":"text"},{"code":"MISOColoredSurface","type":"codeVoice"},{"text":" component adds in SwiftUI environment two flags:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"misoUseMonochrome"},{"type":"text","text":": to inform a component that needs to use mono version of tokens"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"misoOnColoredSurface"},{"type":"text","text":": to inform a component it is placed on colored surface even if the mono is off"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":4,"anchor":"How-to-use","type":"heading","text":"How to use"},{"syntax":"swift","code":["    \/\/ The folowing view has a colored background \"onStatusPositiveEmphasized\" with","    \/\/ - a text with the color adapted according to the adjusted colorScheme      ","    \/\/ - a button that uses the mono version of tokens","","    \/\/ As view","    MISOColoredSurface(color: theme.colorModes.onStatusPositiveEmphasized) {","        VStack {","            Text(\"Status Positive Emphasized\")","            .foregroundColor(theme.colors.contentDefault)","","            MISOButton(text: \"Button\") {}","        }","    }","","    \/\/ As view modifier","","    VStack {","        Text(\"Status Positive Emphasized\")","        .foregroundColor(theme.colors.contentDefault)","","        MISOButton(text: \"Button\") {}","    }","    .coloredSurface(theme.colorModes.onStatusPositiveEmphasized)"],"type":"codeListing"},{"level":4,"anchor":"Debuging-contrast-ratios","type":"heading","text":"Debuging contrast ratios"},{"inlineContent":[{"text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services.","type":"text"},{"text":" ","type":"text"},{"text":"This is for example the case for France with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","type":"reference"},{"text":", also named “RGAA”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is highly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for texts and 4.5:1 for non-textual elements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Some components like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton"},{"type":"text","text":" or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},{"type":"text","text":" can be used on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface"},{"text":" ; thus in that case we can know the surface color for a given component on it, and compute the contrast ratio, and in the end display or not warnings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To do that, some steps must be followed in your component implementation:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Rise the flag to allow debugging (e.g. i #DEBUG mode)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Get the environment variable defined by the colored surface containing the applied color","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the component implementation, add a line of code comparing the color to test and that surface","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Then keep an eye on your logs ; warnings will be added there if WCAG 2.1 3:1, 4.5:1 or 7:1 ratios are not reached, depending to the methods you call"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["\/\/ Rise the flag","#if DEBUG","MISOWCAG21Ratios.misoDebugWCAG21Colors = true","#endif","","\/\/ Supposing we are in your component View \/ ViewModifer struct","","\/\/ Get the applied surface color","@Environment(\\.misoSurfaceColor) var surfaceColor","","\/\/ In the function defining the color to apply, add the line below","\/\/ where colorTokenToApply is the color to apply from a theme:","","\/\/ Non-textual components, in AA","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ Textual components and AAA to check","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"],"syntax":"swift"},{"type":"heading","text":"Divider","anchor":"Divider","level":3},{"type":"heading","text":"How it works","anchor":"How-it-works","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"A divider is used to separate content elements in a view. Two kinds of divider are proposed:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","type":"reference","isActive":true},{"type":"text","text":": to separate elements stacked vertically (e.g. in "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","type":"reference","isActive":true},{"type":"text","text":": to separate elements stacked horizontally (e.g. in `HStack)"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A divider can be colored using color enumerated in the "},{"type":"codeVoice","code":"MISODividerColor"},{"text":".","type":"text"}]},{"text":"Horizontal","type":"heading","anchor":"Horizontal","level":5},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_horizontalDivider_BlueCoat"}],"type":"paragraph"}]}]},{"type":"heading","level":5,"text":"Vertical","anchor":"Vertical"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_verticalDivider_BlueCoat"}],"type":"paragraph"}]}]},{"type":"heading","level":4,"text":"How to use","anchor":"How-to-use"},{"type":"codeListing","syntax":"swift","code":["\/\/ Add a vertical divider between items","HStack {","    Text(\"Hello world!\")","    MISOVerticalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}","","\/\/ Add an horizontal divider between items","VStack {","    Text(\"Hello world!\")","    MISOHorizontalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}"]}]}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts","interfaceLanguage":"swift"},"metadata":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"modules":[{"name":"Components"}],"roleHeading":"Article","role":"article","title":"Layouts"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/layouts"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"url":"\/documentation\/misocomponents\/misobutton","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOButton"}],"title":"MISOButton","abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}]},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null,"type":"image"},"https://accessibilite.numerique.gouv.fr/":{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","url":"https:\/\/accessibilite.numerique.gouv.fr\/","title":"Référentiel Général d’Amélioration de l’Accessibilité","titleInlineContent":[{"text":"Référentiel Général d’Amélioration de l’Accessibilité","type":"text"}],"type":"link"},"doc://MISOComponents/documentation/MISOComponents/MISOHorizontalDivider":{"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MISOHorizontalDivider","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"MISOHorizontalDivider","kind":"identifier"}],"abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A horizontal Divider is used to separate content laid out one under the other ("},{"code":"VStack","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","isActive":true},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (height) is fixed by dedicated token from "},{"code":"MISOTheme","type":"codeVoice"},{"text":".","type":"text"}],"title":"MISOHorizontalDivider","url":"\/documentation\/misocomponents\/misohorizontaldivider"},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","kind":"symbol","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","type":"topic","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"abstract":[{"text":"The catalog of all components provided by MISO. It contains also ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}]},"component_horizontalDivider_BlueCoat":{"identifier":"component_horizontalDivider_BlueCoat","variants":[{"url":"\/images\/MISOComponents\/component_horizontalDivider_BlueCoat.png","traits":["1x","light"]}],"alt":"An horizontal divider in light and dark modes with BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOVerticalDivider":{"url":"\/documentation\/misocomponents\/misoverticaldivider","abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"type":"codeVoice","code":"HStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."}],"role":"symbol","title":"MISOVerticalDivider","type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","navigatorTitle":[{"kind":"identifier","text":"MISOVerticalDivider"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOVerticalDivider"}]},"component_verticalDivider_BlueCoat":{"identifier":"component_verticalDivider_BlueCoat","variants":[{"url":"\/images\/MISOComponents\/component_verticalDivider_BlueCoat.png","traits":["1x","light"]}],"alt":"An vertical divider in light and dark modes with BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOColoredSurface"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOColoredSurface"}],"abstract":[{"text":"Used to define if a content is used on a colored surface.","type":"text"}],"title":"MISOColoredSurface","url":"\/documentation\/misocomponents\/misocoloredsurface"},"doc://MISOComponents/documentation/MISOComponents/MISOLink":{"url":"\/documentation\/misocomponents\/misolink","abstract":[{"type":"text","text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,"},{"type":"text","text":" "},{"type":"text","text":"or to an external resource."},{"type":"text","text":" "},{"type":"text","text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically."}],"role":"symbol","title":"MISOLink","type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","navigatorTitle":[{"kind":"identifier","text":"MISOLink"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLink"}]},"component_coloredSurface_BlueCoat":{"identifier":"component_coloredSurface_BlueCoat","variants":[{"url":"\/images\/MISOComponents\/component_coloredSurface_BlueCoat.png","traits":["1x","light"]}],"alt":"A colored surface with text, button and link in light and dark modes with BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISODividerColor":{"url":"\/documentation\/misocomponents\/misodividercolor","abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"MISOVerticalDivider"},{"type":"text","text":")"}],"role":"symbol","title":"MISODividerColor","type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","navigatorTitle":[{"kind":"identifier","text":"MISODividerColor"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISODividerColor"}]}}}