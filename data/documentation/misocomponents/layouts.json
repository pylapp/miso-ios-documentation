{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/layouts"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"text":"Colored Surface","anchor":"Colored-Surface","type":"heading","level":3},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_coloredSurface_BlueCoat"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_coloredSurface_FoxyRough"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Colored backgrounds use surface colors to maximize the contrast with content."},{"text":" ","type":"text"},{"text":"The colors of several MISO components (for instance ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},{"text":") are automatically adjusted if they are placed on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To do so, some tokens associated with these specific colors can be customized and are identified with the ","type":"text"},{"inlineContent":[{"text":"Mono","type":"text"}],"type":"emphasis"},{"text":" suffix (for instance ","type":"text"},{"inlineContent":[{"text":"colorBgDefaultEnabledMono","type":"text"}],"type":"emphasis"},{"text":" of ","type":"text"},{"inlineContent":[{"type":"text","text":"BlueCoatThemeButtonComponentTokensProvider"}],"type":"emphasis"},{"text":").","type":"text"}]},{"text":"How it works","level":4,"type":"heading","anchor":"How-it-works"},{"type":"paragraph","inlineContent":[{"type":"text","text":"According to the color, the "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":" component adds in SwiftUI environment two flags:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"misoUseMonochrome"},{"text":": to inform a component that needs to use mono version of tokens","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"misoOnColoredSurface","type":"codeVoice"},{"text":": to inform a component it is placed on colored surface even if the mono is off","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":4,"anchor":"How-to-use","text":"How to use","type":"heading"},{"syntax":"swift","code":["    \/\/ The folowing view has a colored background \"onStatusPositiveEmphasized\" with","    \/\/ - a text with the color adapted according to the adjusted colorScheme      ","    \/\/ - a button that uses the mono version of tokens","","    \/\/ As view","    MISOColoredSurface(color: theme.colorModes.onStatusPositiveEmphasized) {","        VStack {","            Text(\"Status Positive Emphasized\")","            .foregroundColor(theme.colors.contentDefault)","","            MISOButton(text: \"Button\") {}","        }","    }","","    \/\/ As view modifier","","    VStack {","        Text(\"Status Positive Emphasized\")","        .foregroundColor(theme.colors.contentDefault)","","        MISOButton(text: \"Button\") {}","    }","    .coloredSurface(theme.colorModes.onStatusPositiveEmphasized)"],"type":"codeListing"},{"type":"heading","text":"Debuging contrast ratios","level":4,"anchor":"Debuging-contrast-ratios"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"text":"This is for example the case for France with the ","type":"text"},{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","isActive":true,"type":"reference"},{"text":", also named “RGAA”.","type":"text"}]},{"inlineContent":[{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"text":" ","type":"text"},{"text":"However it is highly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for texts and 4.5:1 for non-textual elements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Some components like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},{"type":"text","text":" can be used on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface"},{"type":"text","text":" ; thus in that case we can know the surface color for a given component on it, and compute the contrast ratio, and in the end display or not warnings."}],"type":"paragraph"},{"inlineContent":[{"text":"To do that, some steps must be followed in your component implementation:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Rise the flag to allow debugging (e.g. i #DEBUG mode)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Get the environment variable defined by the colored surface containing the applied color","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the component implementation, add a line of code comparing the color to test and that surface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then keep an eye on your logs ; warnings will be added there if WCAG 2.1 3:1, 4.5:1 or 7:1 ratios are not reached, depending to the methods you call"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["\/\/ Rise the flag","#if DEBUG","MISOWCAG21Ratios.misoDebugWCAG21Colors = true","#endif","","\/\/ Supposing we are in your component View \/ ViewModifer struct","","\/\/ Get the applied surface color","@Environment(\\.misoSurfaceColor) var surfaceColor","","\/\/ In the function defining the color to apply, add the line below","\/\/ where colorTokenToApply is the color to apply from a theme:","","\/\/ Non-textual components, in AA","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ Textual components and AAA to check","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"],"type":"codeListing"},{"type":"heading","level":3,"anchor":"Divider","text":"Divider"},{"type":"heading","level":4,"anchor":"How-it-works","text":"How it works"},{"inlineContent":[{"text":"A divider is used to separate content elements in a view. Two kinds of divider are proposed:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","isActive":true},{"type":"text","text":": to separate elements stacked vertically (e.g. in "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider"},{"text":": to separate elements stacked horizontally (e.g. in `HStack)","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A divider can be colored using color enumerated in the "},{"code":"MISODividerColor","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Horizontal","anchor":"Horizontal","type":"heading","level":5},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_horizontalDivider_BlueCoat","type":"image"}],"type":"paragraph"}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_horizontalDivider_FoxyRough"}]}]}],"type":"tabNavigator"},{"text":"Vertical","anchor":"Vertical","type":"heading","level":5},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_verticalDivider_BlueCoat","type":"image"}],"type":"paragraph"}]},{"title":"FoxyRough","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_verticalDivider_FoxyRough"}]}]}],"type":"tabNavigator"},{"text":"How to use","anchor":"How-to-use","type":"heading","level":4},{"syntax":"swift","code":["\/\/ Add a vertical divider between items","HStack {","    Text(\"Hello world!\")","    MISOVerticalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}","","\/\/ Add an horizontal divider between items","VStack {","    Text(\"Hello world!\")","    MISOHorizontalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}"],"type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts"},"kind":"article","metadata":{"modules":[{"name":"Components"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","title":"Layouts","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"text":"layouts","type":"text"}]},{"text":".","type":"text"}],"references":{"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"type":"topic","title":"Components"},"doc://MISOComponents/documentation/MISOComponents/MISOLink":{"navigatorTitle":[{"kind":"identifier","text":"MISOLink"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLink"}],"kind":"symbol","title":"MISOLink","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","type":"topic","abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"role":"symbol","url":"\/documentation\/misocomponents\/misolink"},"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","type":"topic","role":"symbol","url":"\/documentation\/misocomponents\/misocoloredsurface","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOColoredSurface","kind":"identifier"}],"navigatorTitle":[{"text":"MISOColoredSurface","kind":"identifier"}],"title":"MISOColoredSurface","abstract":[{"text":"Used to define if a content is used on a colored surface.","type":"text"}]},"component_horizontalDivider_FoxyRough":{"identifier":"component_horizontalDivider_FoxyRough","alt":"An horizontal divider in light and dark modes with FoxyRough theme","type":"image","variants":[{"url":"\/images\/MISOComponents\/component_horizontalDivider_FoxyRough.png","traits":["1x","light"]}]},"doc://MISOComponents/documentation/MISOComponents/MISOVerticalDivider":{"abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"text":" ","type":"text"},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"type":"codeVoice","code":"HStack"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"The divider can be colored using dedicated ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"type":"text","text":" colors."},{"text":" ","type":"text"},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"code":"MISOTheme","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"MISOVerticalDivider","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misoverticaldivider","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MISOVerticalDivider"}],"title":"MISOVerticalDivider"},"component_horizontalDivider_BlueCoat":{"identifier":"component_horizontalDivider_BlueCoat","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_horizontalDivider_BlueCoat.png"}],"alt":"An horizontal divider in light and dark modes with BlueCoat theme","type":"image"},"component_verticalDivider_BlueCoat":{"type":"image","alt":"An vertical divider in light and dark modes with BlueCoat theme","variants":[{"url":"\/images\/MISOComponents\/component_verticalDivider_BlueCoat.png","traits":["1x","light"]}],"identifier":"component_verticalDivider_BlueCoat"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"kind":"symbol","title":"MISOButton","navigatorTitle":[{"text":"MISOButton","kind":"identifier"}],"abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"type":"topic","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misobutton"},"component_verticalDivider_FoxyRough":{"identifier":"component_verticalDivider_FoxyRough","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_verticalDivider_FoxyRough.png"}],"alt":"An vertical divider in light and dark modes with FoxyRough theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISODividerColor":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISODividerColor"}],"role":"symbol","title":"MISODividerColor","navigatorTitle":[{"kind":"identifier","text":"MISODividerColor"}],"type":"topic","url":"\/documentation\/misocomponents\/misodividercolor","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","kind":"symbol","abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" or "},{"code":"MISOVerticalDivider","type":"codeVoice"},{"type":"text","text":")"}]},"component_coloredSurface_FoxyRough":{"type":"image","alt":"A colored surface with text, button and link in light and dark modes with FoxyRough theme","variants":[{"url":"\/images\/MISOComponents\/component_coloredSurface_FoxyRough.png","traits":["1x","light"]}],"identifier":"component_coloredSurface_FoxyRough"},"https://accessibilite.numerique.gouv.fr/":{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","title":"Référentiel Général d’Amélioration de l’Accessibilité","titleInlineContent":[{"text":"Référentiel Général d’Amélioration de l’Accessibilité","type":"text"}],"url":"https:\/\/accessibilite.numerique.gouv.fr\/","type":"link"},"component_coloredSurface_BlueCoat":{"identifier":"component_coloredSurface_BlueCoat","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_coloredSurface_BlueCoat.png"}],"alt":"A colored surface with text, button and link in light and dark modes with BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOHorizontalDivider":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","kind":"symbol","abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A horizontal Divider is used to separate content laid out one under the other ("},{"code":"VStack","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"text":"The thickness (height) is fixed by dedicated token from ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MISOHorizontalDivider","kind":"identifier"}],"title":"MISOHorizontalDivider","navigatorTitle":[{"text":"MISOHorizontalDivider","kind":"identifier"}],"role":"symbol","url":"\/documentation\/misocomponents\/misohorizontaldivider","type":"topic"}}}