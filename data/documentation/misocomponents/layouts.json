{"metadata":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"roleHeading":"Article","modules":[{"name":"Components"}],"title":"Layouts","role":"article"},"sections":[],"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"layouts"}]},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/misocomponents\/layouts"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"anchor":"Colored-Surface","type":"heading","text":"Colored Surface","level":3},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_coloredSurface_BlueCoat"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"text":"Colored backgrounds use surface colors to maximize the contrast with content.","type":"text"},{"text":" ","type":"text"},{"text":"The colors of several MISO components (for instance ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","type":"reference"},{"text":") are automatically adjusted if they are placed on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To do so, some tokens associated with these specific colors can be customized and are identified with the ","type":"text"},{"inlineContent":[{"text":"Mono","type":"text"}],"type":"emphasis"},{"text":" suffix (for instance ","type":"text"},{"inlineContent":[{"text":"colorBgDefaultEnabledMono","type":"text"}],"type":"emphasis"},{"text":" of ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"BlueCoatThemeButtonComponentTokensProvider","type":"text"}]},{"text":").","type":"text"}]},{"level":4,"type":"heading","text":"How it works","anchor":"How-it-works"},{"type":"paragraph","inlineContent":[{"type":"text","text":"According to the color, the "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":" component adds in SwiftUI environment two flags:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"misoUseMonochrome"},{"type":"text","text":": to inform a component that needs to use mono version of tokens"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"misoOnColoredSurface"},{"text":": to inform a component it is placed on colored surface even if the mono is off","type":"text"}]}]}]},{"level":4,"type":"heading","text":"How to use","anchor":"How-to-use"},{"code":["    \/\/ The folowing view has a colored background \"onStatusPositiveEmphasized\" with","    \/\/ - a text with the color adapted according to the adjusted colorScheme      ","    \/\/ - a button that uses the mono version of tokens","","    \/\/ As view","    MISOColoredSurface(color: theme.colorModes.onStatusPositiveEmphasized) {","        VStack {","            Text(\"Status Positive Emphasized\")","            .foregroundColor(theme.colors.contentDefault)","","            MISOButton(text: \"Button\") {}","        }","    }","","    \/\/ As view modifier","","    VStack {","        Text(\"Status Positive Emphasized\")","        .foregroundColor(theme.colors.contentDefault)","","        MISOButton(text: \"Button\") {}","    }","    .coloredSurface(theme.colorModes.onStatusPositiveEmphasized)"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","text":"Debuging contrast ratios","anchor":"Debuging-contrast-ratios"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services."},{"type":"text","text":" "},{"type":"text","text":"This is for example the case for France with the "},{"type":"reference","isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/"},{"type":"text","text":", also named “RGAA”."}]},{"type":"paragraph","inlineContent":[{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"text":" ","type":"text"},{"text":"However it is highly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for texts and 4.5:1 for non-textual elements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some components like "},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","type":"reference"},{"type":"text","text":" can be used on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface"},{"type":"text","text":" ; thus in that case we can know the surface color for a given component on it, and compute the contrast ratio, and in the end display or not warnings."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To do that, some steps must be followed in your component implementation:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Rise the flag to allow debugging (e.g. i #DEBUG mode)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Get the environment variable defined by the colored surface containing the applied color"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the component implementation, add a line of code comparing the color to test and that surface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Then keep an eye on your logs ; warnings will be added there if WCAG 2.1 3:1, 4.5:1 or 7:1 ratios are not reached, depending to the methods you call","type":"text"}]}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Rise the flag","#if DEBUG","MISOWCAG21Ratios.misoDebugWCAG21Colors = true","#endif","","\/\/ Supposing we are in your component View \/ ViewModifer struct","","\/\/ Get the applied surface color","@Environment(\\.misoSurfaceColor) var surfaceColor","","\/\/ In the function defining the color to apply, add the line below","\/\/ where colorTokenToApply is the color to apply from a theme:","","\/\/ Non-textual components, in AA","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ Textual components and AAA to check","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"]},{"type":"heading","level":3,"text":"Divider","anchor":"Divider"},{"type":"heading","level":4,"text":"How it works","anchor":"How-it-works"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A divider is used to separate content elements in a view. Two kinds of divider are proposed:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider"},{"type":"text","text":": to separate elements stacked vertically (e.g. in "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider"},{"text":": to separate elements stacked horizontally (e.g. in `HStack)","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A divider can be colored using color enumerated in the ","type":"text"},{"type":"codeVoice","code":"MISODividerColor"},{"text":".","type":"text"}]},{"level":5,"type":"heading","anchor":"Horizontal","text":"Horizontal"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_horizontalDivider_BlueCoat","type":"image"}]}]}],"type":"tabNavigator"},{"level":5,"type":"heading","anchor":"Vertical","text":"Vertical"},{"tabs":[{"content":[{"inlineContent":[{"identifier":"component_verticalDivider_BlueCoat","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"}],"type":"tabNavigator"},{"level":4,"type":"heading","anchor":"How-to-use","text":"How to use"},{"code":["\/\/ Add a vertical divider between items","HStack {","    Text(\"Hello world!\")","    MISOVerticalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}","","\/\/ Add an horizontal divider between items","VStack {","    Text(\"Hello world!\")","    MISOHorizontalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}"],"type":"codeListing","syntax":"swift"}]}],"kind":"article","references":{"doc://MISOComponents/documentation/MISOComponents/MISOVerticalDivider":{"url":"\/documentation\/misocomponents\/misoverticaldivider","kind":"symbol","title":"MISOVerticalDivider","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOVerticalDivider","kind":"identifier"}],"navigatorTitle":[{"text":"MISOVerticalDivider","kind":"identifier"}],"abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"type":"codeVoice","code":"HStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."}]},"https://accessibilite.numerique.gouv.fr/":{"url":"https:\/\/accessibilite.numerique.gouv.fr\/","identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","title":"Référentiel Général d’Amélioration de l’Accessibilité","type":"link","titleInlineContent":[{"text":"Référentiel Général d’Amélioration de l’Accessibilité","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents/MISOLink":{"abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"url":"\/documentation\/misocomponents\/misolink","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","navigatorTitle":[{"text":"MISOLink","kind":"identifier"}],"kind":"symbol","title":"MISOLink","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOLink","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"navigatorTitle":[{"text":"MISOButton","kind":"identifier"}],"abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"title":"MISOButton","url":"\/documentation\/misocomponents\/misobutton","kind":"symbol","role":"symbol","type":"topic"},"ic_folder_categories.png":{"alt":null,"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","identifier":"ic_folder_categories.png"},"component_horizontalDivider_BlueCoat":{"identifier":"component_horizontalDivider_BlueCoat","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_horizontalDivider_BlueCoat.png"}],"alt":"An horizontal divider in light and dark modes with BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOHorizontalDivider":{"abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A horizontal Divider is used to separate content laid out one under the other ("},{"type":"codeVoice","code":"VStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","isActive":true,"type":"reference"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (height) is fixed by dedicated token from "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."}],"url":"\/documentation\/misocomponents\/misohorizontaldivider","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","navigatorTitle":[{"text":"MISOHorizontalDivider","kind":"identifier"}],"kind":"symbol","title":"MISOHorizontalDivider","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOHorizontalDivider","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/misocomponents","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","title":"Components","role":"collection","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISODividerColor":{"abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"MISOVerticalDivider"},{"type":"text","text":")"}],"url":"\/documentation\/misocomponents\/misodividercolor","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","navigatorTitle":[{"text":"MISODividerColor","kind":"identifier"}],"kind":"symbol","title":"MISODividerColor","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISODividerColor","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"navigatorTitle":[{"kind":"identifier","text":"MISOColoredSurface"}],"abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOColoredSurface"}],"url":"\/documentation\/misocomponents\/misocoloredsurface","title":"MISOColoredSurface","kind":"symbol","role":"symbol","type":"topic"},"component_verticalDivider_BlueCoat":{"type":"image","identifier":"component_verticalDivider_BlueCoat","alt":"An vertical divider in light and dark modes with BlueCoat theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_verticalDivider_BlueCoat.png"}]},"component_coloredSurface_BlueCoat":{"alt":"A colored surface with text, button and link in light and dark modes with BlueCoat theme","type":"image","variants":[{"url":"\/images\/MISOComponents\/component_coloredSurface_BlueCoat.png","traits":["1x","light"]}],"identifier":"component_coloredSurface_BlueCoat"}}}