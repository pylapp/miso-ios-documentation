{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/layouts"]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"article","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"layouts","type":"text"}]},{"type":"text","text":"."}],"metadata":{"modules":[{"name":"Components"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"roleHeading":"Article","role":"article","title":"Layouts"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"heading","text":"Colored Surface","level":3,"anchor":"Colored-Surface"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_coloredSurface_BlueCoat"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Colored backgrounds use surface colors to maximize the contrast with content."},{"type":"text","text":" "},{"type":"text","text":"The colors of several MISO components (for instance "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},{"type":"text","text":") are automatically adjusted if they are placed on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"To do so, some tokens associated with these specific colors can be customized and are identified with the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Mono"}]},{"type":"text","text":" suffix (for instance "},{"type":"emphasis","inlineContent":[{"text":"colorBgDefaultEnabledMono","type":"text"}]},{"type":"text","text":" of "},{"type":"emphasis","inlineContent":[{"type":"text","text":"BlueCoatThemeButtonComponentTokensProvider"}]},{"text":").","type":"text"}]},{"text":"How it works","type":"heading","level":4,"anchor":"How-it-works"},{"type":"paragraph","inlineContent":[{"type":"text","text":"According to the color, the "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":" component adds in SwiftUI environment two flags:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"misoUseMonochrome"},{"type":"text","text":": to inform a component that needs to use mono version of tokens"}]}]},{"content":[{"inlineContent":[{"code":"misoOnColoredSurface","type":"codeVoice"},{"text":": to inform a component it is placed on colored surface even if the mono is off","type":"text"}],"type":"paragraph"}]}]},{"text":"How to use","type":"heading","level":4,"anchor":"How-to-use"},{"syntax":"swift","code":["    \/\/ The folowing view has a colored background \"onStatusPositiveEmphasized\" with","    \/\/ - a text with the color adapted according to the adjusted colorScheme      ","    \/\/ - a button that uses the mono version of tokens","","    \/\/ As view","    MISOColoredSurface(color: theme.colorModes.onStatusPositiveEmphasized) {","        VStack {","            Text(\"Status Positive Emphasized\")","            .foregroundColor(theme.colors.contentDefault)","","            MISOButton(text: \"Button\") {}","        }","    }","","    \/\/ As view modifier","","    VStack {","        Text(\"Status Positive Emphasized\")","        .foregroundColor(theme.colors.contentDefault)","","        MISOButton(text: \"Button\") {}","    }","    .coloredSurface(theme.colorModes.onStatusPositiveEmphasized)"],"type":"codeListing"},{"text":"Debuging contrast ratios","type":"heading","level":4,"anchor":"Debuging-contrast-ratios"},{"type":"paragraph","inlineContent":[{"text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services.","type":"text"},{"text":" ","type":"text"},{"text":"This is for example the case for France with the ","type":"text"},{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","isActive":true,"type":"reference"},{"text":", also named “RGAA”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron)."},{"type":"text","text":" "},{"type":"text","text":"However it is highly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for texts and 4.5:1 for non-textual elements."}]},{"type":"paragraph","inlineContent":[{"text":"Some components like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"reference"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink"},{"type":"text","text":" can be used on "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","isActive":true,"type":"reference"},{"text":" ; thus in that case we can know the surface color for a given component on it, and compute the contrast ratio, and in the end display or not warnings.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To do that, some steps must be followed in your component implementation:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Rise the flag to allow debugging (e.g. i #DEBUG mode)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Get the environment variable defined by the colored surface containing the applied color","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"In the component implementation, add a line of code comparing the color to test and that surface"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Then keep an eye on your logs ; warnings will be added there if WCAG 2.1 3:1, 4.5:1 or 7:1 ratios are not reached, depending to the methods you call"}],"type":"paragraph"}]}]},{"code":["\/\/ Rise the flag","#if DEBUG","MISOWCAG21Ratios.misoDebugWCAG21Colors = true","#endif","","\/\/ Supposing we are in your component View \/ ViewModifer struct","","\/\/ Get the applied surface color","@Environment(\\.misoSurfaceColor) var surfaceColor","","\/\/ In the function defining the color to apply, add the line below","\/\/ where colorTokenToApply is the color to apply from a theme:","","\/\/ Non-textual components, in AA","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ Textual components and AAA to check","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"],"type":"codeListing","syntax":"swift"},{"text":"Divider","type":"heading","anchor":"Divider","level":3},{"text":"How it works","type":"heading","anchor":"How-it-works","level":4},{"type":"paragraph","inlineContent":[{"text":"A divider is used to separate content elements in a view. Two kinds of divider are proposed:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider"},{"type":"text","text":": to separate elements stacked vertically (e.g. in "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","type":"reference"},{"text":": to separate elements stacked horizontally (e.g. in `HStack)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A divider can be colored using color enumerated in the ","type":"text"},{"code":"MISODividerColor","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Horizontal","text":"Horizontal","level":5,"type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_horizontalDivider_BlueCoat"}]}]}],"type":"tabNavigator"},{"anchor":"Vertical","text":"Vertical","level":5,"type":"heading"},{"tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"identifier":"component_verticalDivider_BlueCoat","type":"image"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"anchor":"How-to-use","text":"How to use","level":4,"type":"heading"},{"syntax":"swift","code":["\/\/ Add a vertical divider between items","HStack {","    Text(\"Hello world!\")","    MISOVerticalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}","","\/\/ Add an horizontal divider between items","VStack {","    Text(\"Hello world!\")","    MISOHorizontalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}"],"type":"codeListing"}],"kind":"content"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts","interfaceLanguage":"swift"},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"title":"MISOColoredSurface","abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOColoredSurface"}],"kind":"symbol","navigatorTitle":[{"text":"MISOColoredSurface","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","type":"topic","url":"\/documentation\/misocomponents\/misocoloredsurface"},"ic_folder_categories.png":{"type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null,"identifier":"ic_folder_categories.png"},"component_coloredSurface_BlueCoat":{"variants":[{"url":"\/images\/MISOComponents\/component_coloredSurface_BlueCoat.png","traits":["1x","light"]}],"alt":"A colored surface with text, button and link in light and dark modes with BlueCoat theme","type":"image","identifier":"component_coloredSurface_BlueCoat"},"doc://MISOComponents/documentation/MISOComponents/MISOHorizontalDivider":{"kind":"symbol","url":"\/documentation\/misocomponents\/misohorizontaldivider","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOHorizontalDivider","kind":"identifier"}],"navigatorTitle":[{"text":"MISOHorizontalDivider","kind":"identifier"}],"title":"MISOHorizontalDivider","abstract":[{"text":"Divider is a UI element that allows to structure the content by visually separating the content zones.","type":"text"},{"text":" ","type":"text"},{"text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would.","type":"text"},{"text":" ","type":"text"},{"text":"A horizontal Divider is used to separate content laid out one under the other (","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"The divider can be colored using dedicated ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","type":"reference","isActive":true},{"text":" colors.","type":"text"},{"text":" ","type":"text"},{"text":"The thickness (height) is fixed by dedicated token from ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"component_verticalDivider_BlueCoat":{"variants":[{"url":"\/images\/MISOComponents\/component_verticalDivider_BlueCoat.png","traits":["1x","light"]}],"identifier":"component_verticalDivider_BlueCoat","alt":"An vertical divider in light and dark modes with BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISODividerColor":{"title":"MISODividerColor","abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"MISOVerticalDivider"},{"type":"text","text":")"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISODividerColor","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MISODividerColor","kind":"identifier"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","type":"topic","url":"\/documentation\/misocomponents\/misodividercolor"},"doc://MISOComponents/documentation/MISOComponents/MISOLink":{"navigatorTitle":[{"kind":"identifier","text":"MISOLink"}],"abstract":[{"type":"text","text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,"},{"type":"text","text":" "},{"text":"or to an external resource.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLink"}],"type":"topic","url":"\/documentation\/misocomponents\/misolink","role":"symbol","title":"MISOLink"},"component_horizontalDivider_BlueCoat":{"type":"image","variants":[{"url":"\/images\/MISOComponents\/component_horizontalDivider_BlueCoat.png","traits":["1x","light"]}],"alt":"An horizontal divider in light and dark modes with BlueCoat theme","identifier":"component_horizontalDivider_BlueCoat"},"https://accessibilite.numerique.gouv.fr/":{"url":"https:\/\/accessibilite.numerique.gouv.fr\/","title":"Référentiel Général d’Amélioration de l’Accessibilité","titleInlineContent":[{"text":"Référentiel Général d’Amélioration de l’Accessibilité","type":"text"}],"type":"link","identifier":"https:\/\/accessibilite.numerique.gouv.fr\/"},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"navigatorTitle":[{"kind":"identifier","text":"MISOButton"}],"url":"\/documentation\/misocomponents\/misobutton","role":"symbol","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOButton"}],"title":"MISOButton","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton"},"doc://MISOComponents/documentation/MISOComponents/MISOVerticalDivider":{"navigatorTitle":[{"text":"MISOVerticalDivider","kind":"identifier"}],"title":"MISOVerticalDivider","type":"topic","abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A vertical Divider is used to separate content laid out side by side ("},{"code":"HStack","type":"codeVoice"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","isActive":true,"type":"reference"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (width) is fixed by dedicated token from "},{"code":"MISOTheme","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","url":"\/documentation\/misocomponents\/misoverticaldivider","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOVerticalDivider","kind":"identifier"}],"role":"symbol"},"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","url":"\/documentation\/misocomponents","type":"topic","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"title":"Components"}}}