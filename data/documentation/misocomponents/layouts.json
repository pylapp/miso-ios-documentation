{"variants":[{"paths":["\/documentation\/misocomponents\/layouts"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Layouts"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"heading","level":3,"text":"Colored Surface","anchor":"Colored-Surface"},{"tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_coloredSurface_BlueCoat","type":"image"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_coloredSurface_FoxyRough"}],"type":"paragraph"}]}],"type":"tabNavigator"},{"inlineContent":[{"text":"Colored backgrounds use surface colors to maximize the contrast with content.","type":"text"},{"text":" ","type":"text"},{"text":"The colors of several MISO components (for instance ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","isActive":true,"type":"reference"},{"text":") are automatically adjusted if they are placed on ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"To do so, some tokens associated with these specific colors can be customized and are identified with the ","type":"text"},{"inlineContent":[{"type":"text","text":"Mono"}],"type":"emphasis"},{"text":" suffix (for instance ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"colorBgDefaultEnabledMono","type":"text"}]},{"type":"text","text":" of "},{"type":"emphasis","inlineContent":[{"text":"BlueCoatThemeButtonComponentTokensProvider","type":"text"}]},{"type":"text","text":")."}],"type":"paragraph"},{"level":4,"anchor":"How-it-works","text":"How it works","type":"heading"},{"inlineContent":[{"text":"According to the color, the ","type":"text"},{"code":"MISOColoredSurface","type":"codeVoice"},{"text":" component adds in SwiftUI environment two flags:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"misoUseMonochrome"},{"type":"text","text":": to inform a component that needs to use mono version of tokens"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"misoOnColoredSurface"},{"text":": to inform a component it is placed on colored surface even if the mono is off","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"How to use","type":"heading","anchor":"How-to-use","level":4},{"code":["    \/\/ The folowing view has a colored background \"onStatusPositiveEmphasized\" with","    \/\/ - a text with the color adapted according to the adjusted colorScheme      ","    \/\/ - a button that uses the mono version of tokens","","    \/\/ As view","    MISOColoredSurface(color: theme.colorModes.onStatusPositiveEmphasized) {","        VStack {","            Text(\"Status Positive Emphasized\")","            .foregroundColor(theme.colors.contentDefault)","","            MISOButton(text: \"Button\") {}","        }","    }","","    \/\/ As view modifier","","    VStack {","        Text(\"Status Positive Emphasized\")","        .foregroundColor(theme.colors.contentDefault)","","        MISOButton(text: \"Button\") {}","    }","    .coloredSurface(theme.colorModes.onStatusPositiveEmphasized)"],"type":"codeListing","syntax":"swift"},{"text":"Debuging contrast ratios","type":"heading","anchor":"Debuging-contrast-ratios","level":4},{"type":"paragraph","inlineContent":[{"text":"Some countries set up new laws so as to force companies to have a better accessibility of their digital services.","type":"text"},{"text":" ","type":"text"},{"text":"This is for example the case for France with the ","type":"text"},{"isActive":true,"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","type":"reference"},{"text":", also named “RGAA”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The WCAG specifications, for AA level, defines a contrast ratio of 4.5:1 for textual elements (i.e. texts), and 3:1 for non-textual elements (i.e. link’s chevron).","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"However it is highly recommended for mobile devices to reach AAA level because of the screen sizes and luminosity issues, i.e. 7:1 for texts and 4.5:1 for non-textual elements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Some components like "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","isActive":true,"type":"reference"},{"type":"text","text":" can be used on "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","isActive":true,"type":"reference"},{"type":"text","text":" ; thus in that case we can know the surface color for a given component on it, and compute the contrast ratio, and in the end display or not warnings."}]},{"type":"paragraph","inlineContent":[{"text":"To do that, some steps must be followed in your component implementation:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Rise the flag to allow debugging (e.g. i #DEBUG mode)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Get the environment variable defined by the colored surface containing the applied color","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the component implementation, add a line of code comparing the color to test and that surface","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Then keep an eye on your logs ; warnings will be added there if WCAG 2.1 3:1, 4.5:1 or 7:1 ratios are not reached, depending to the methods you call","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["\/\/ Rise the flag","#if DEBUG","MISOWCAG21Ratios.misoDebugWCAG21Colors = true","#endif","","\/\/ Supposing we are in your component View \/ ViewModifer struct","","\/\/ Get the applied surface color","@Environment(\\.misoSurfaceColor) var surfaceColor","","\/\/ In the function defining the color to apply, add the line below","\/\/ where colorTokenToApply is the color to apply from a theme:","","\/\/ Non-textual components, in AA","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .nonTextual)","","\/\/ Textual components and AAA to check","MISOWCAG21Ratio.debugContrastRatio(colorToApply, surfaceColor, .AAA)"],"type":"codeListing"},{"text":"Divider","level":3,"anchor":"Divider","type":"heading"},{"text":"How it works","level":4,"anchor":"How-it-works","type":"heading"},{"inlineContent":[{"text":"A divider is used to separate content elements in a view. Two kinds of divider are proposed:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","type":"reference","isActive":true},{"type":"text","text":": to separate elements stacked vertically (e.g. in "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider"},{"text":": to separate elements stacked horizontally (e.g. in `HStack)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A divider can be colored using color enumerated in the ","type":"text"},{"type":"codeVoice","code":"MISODividerColor"},{"text":".","type":"text"}]},{"type":"heading","level":5,"anchor":"Horizontal","text":"Horizontal"},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"component_horizontalDivider_BlueCoat","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_horizontalDivider_FoxyRough"}]}],"title":"FoxyRough"}]},{"type":"heading","text":"Vertical","anchor":"Vertical","level":5},{"type":"tabNavigator","tabs":[{"content":[{"inlineContent":[{"identifier":"component_verticalDivider_BlueCoat","type":"image"}],"type":"paragraph"}],"title":"BlueCoat"},{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_verticalDivider_FoxyRough"}]}],"title":"FoxyRough"}]},{"type":"heading","text":"How to use","anchor":"How-to-use","level":4},{"type":"codeListing","syntax":"swift","code":["\/\/ Add a vertical divider between items","HStack {","    Text(\"Hello world!\")","    MISOVerticalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}","","\/\/ Add an horizontal divider between items","VStack {","    Text(\"Hello world!\")","    MISOHorizontalDivider(color: .brandPrimary)","    Text(\"Happy to see you\")","}"]}]}],"sections":[],"metadata":{"roleHeading":"Article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"modules":[{"name":"Components"}],"title":"Layouts","role":"article"},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"type":"text","text":"layouts"}]},{"type":"text","text":". These are inherited from OUDS."}],"references":{"component_verticalDivider_FoxyRough":{"identifier":"component_verticalDivider_FoxyRough","variants":[{"url":"\/images\/MISOComponents\/component_verticalDivider_FoxyRough.png","traits":["1x","light"]}],"type":"image","alt":"An vertical divider in light and dark modes with FoxyRough theme"},"doc://MISOComponents/documentation/MISOComponents/MISOHorizontalDivider":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","title":"MISOHorizontalDivider","navigatorTitle":[{"kind":"identifier","text":"MISOHorizontalDivider"}],"role":"symbol","url":"\/documentation\/misocomponents\/misohorizontaldivider","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOHorizontalDivider"}],"kind":"symbol","abstract":[{"text":"Divider is a UI element that allows to structure the content by visually separating the content zones.","type":"text"},{"text":" ","type":"text"},{"text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would.","type":"text"},{"text":" ","type":"text"},{"text":"A horizontal Divider is used to separate content laid out one under the other (","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":").","type":"text"},{"text":" ","type":"text"},{"text":"The divider can be colored using dedicated ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"text":" colors.","type":"text"},{"text":" ","type":"text"},{"text":"The thickness (height) is fixed by dedicated token from ","type":"text"},{"code":"MISOTheme","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISODividerColor":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","title":"MISODividerColor","navigatorTitle":[{"kind":"identifier","text":"MISODividerColor"}],"role":"symbol","url":"\/documentation\/misocomponents\/misodividercolor","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISODividerColor"}],"kind":"symbol","abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"MISOVerticalDivider"},{"type":"text","text":")"}],"type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misobutton","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","role":"symbol","title":"MISOButton","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"navigatorTitle":[{"text":"MISOButton","kind":"identifier"}]},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"alt":null},"doc://MISOComponents/documentation/MISOComponents/MISOLink":{"navigatorTitle":[{"kind":"identifier","text":"MISOLink"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOLink"}],"kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOLink","abstract":[{"text":"Link is a UI element that allows to navigate from one location to another, either within the same page or across different pages in the same resource,","type":"text"},{"text":" ","type":"text"},{"text":"or to an external resource.","type":"text"},{"text":" ","type":"text"},{"text":"Link’s primary function is navigation and it communicates its interactive nature visually and semantically.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/misocomponents\/misolink","title":"MISOLink"},"component_coloredSurface_BlueCoat":{"identifier":"component_coloredSurface_BlueCoat","type":"image","variants":[{"url":"\/images\/MISOComponents\/component_coloredSurface_BlueCoat.png","traits":["1x","light"]}],"alt":"A colored surface with text, button and link in light and dark modes with BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents/MISOVerticalDivider":{"abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would.","type":"text"},{"type":"text","text":" "},{"text":"A vertical Divider is used to separate content laid out side by side (","type":"text"},{"type":"codeVoice","code":"HStack"},{"text":").","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor"},{"text":" colors.","type":"text"},{"text":" ","type":"text"},{"text":"The thickness (width) is fixed by dedicated token from ","type":"text"},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOVerticalDivider","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MISOVerticalDivider","kind":"identifier"}],"title":"MISOVerticalDivider","url":"\/documentation\/misocomponents\/misoverticaldivider","navigatorTitle":[{"text":"MISOVerticalDivider","kind":"identifier"}],"role":"symbol"},"component_horizontalDivider_FoxyRough":{"identifier":"component_horizontalDivider_FoxyRough","variants":[{"url":"\/images\/MISOComponents\/component_horizontalDivider_FoxyRough.png","traits":["1x","light"]}],"type":"image","alt":"An horizontal divider in light and dark modes with FoxyRough theme"},"component_verticalDivider_BlueCoat":{"identifier":"component_verticalDivider_BlueCoat","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_verticalDivider_BlueCoat.png"}],"alt":"An vertical divider in light and dark modes with BlueCoat theme"},"component_horizontalDivider_BlueCoat":{"identifier":"component_horizontalDivider_BlueCoat","type":"image","variants":[{"url":"\/images\/MISOComponents\/component_horizontalDivider_BlueCoat.png","traits":["1x","light"]}],"alt":"An horizontal divider in light and dark modes with BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"url":"\/documentation\/misocomponents","kind":"symbol","title":"Components","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views. These are inherited from OUDS."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","type":"topic"},"https://accessibilite.numerique.gouv.fr/":{"identifier":"https:\/\/accessibilite.numerique.gouv.fr\/","title":"Référentiel Général d’Amélioration de l’Accessibilité","type":"link","titleInlineContent":[{"text":"Référentiel Général d’Amélioration de l’Accessibilité","type":"text"}],"url":"https:\/\/accessibilite.numerique.gouv.fr\/"},"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","title":"MISOColoredSurface","navigatorTitle":[{"text":"MISOColoredSurface","kind":"identifier"}],"role":"symbol","url":"\/documentation\/misocomponents\/misocoloredsurface","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOColoredSurface","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Used to define if a content is used on a colored surface.","type":"text"}],"type":"topic"},"component_coloredSurface_FoxyRough":{"identifier":"component_coloredSurface_FoxyRough","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_coloredSurface_FoxyRough.png"}],"alt":"A colored surface with text, button and link in light and dark modes with FoxyRough theme"}}}