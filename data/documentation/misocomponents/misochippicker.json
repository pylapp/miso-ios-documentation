lineContent":[{"text":"filter chips","type":"text"}]},{"type":"text","text":" and proposing single or multiple selections."}],"metadata":{"platforms":[{"introducedAt":"15.0","name":"iOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"13.0","name":"macOS","deprecated":false,"beta":false,"unavailable":false},{"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false,"unavailable":false}],"externalID":"s:14MISOComponents14MISOChipPickerV","role":"symbol","modules":[{"name":"Components"}],"roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"MISOChipPicker"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOChipPicker"}],"title":"MISOChipPicker","symbolKind":"struct"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOChipPicker","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Tag","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tag","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Each chip contains a “tag”, i.e. a supposed to be unique value."},{"type":"text","text":" "},{"type":"text","text":"The picker will expose choosen values through this “tag”."},{"type":"text","text":" "},{"type":"text","text":"It has also some configuration elements which will override the one applied to nested "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOFilterChip"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations","type":"heading"},{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Voice Over"}]},{"type":"text","text":" will use several elements to describe the component."},{"type":"text","text":" "},{"type":"text","text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used."},{"type":"text","text":" "},{"type":"text","text":"However if defined in the "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPickerData","type":"reference","isActive":true},{"type":"text","text":" the items inside the picker will have such accessibility identifiers."}],"type":"paragraph"},{"level":2,"text":"Code samples","anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Define the elements to display in filter chip using MISOChipPickerData.","    enum Drink: String, CaseIterable {","        case virginHolyLava, ipaBeer, mineralWater","    }","","    var someDataToPopulate: [MISOChipPickerData<Drink>] {","        [","            MISOChipPickerData(tag: Drink.virginHolyLava,","                               layout: .textAndImage(\"Virgin Holy Lava\", image: MISOImage(asset: Image(systemName: \"flame\")))),","","            MISOChipPickerData(tag: Drink.ipaBeer,","                               layout: .textAndImage(\"IPA Beer\", image: MISOImage(asset: Image(systemName: \"dog.fill\")))),","","            MISOChipPickerData(tag: Drink.mineralWater,","                               layout: .textAndImage(\"Mineral water\", image: MISOImage(asset: Image(systemName: \"waterbottle.fill\")))),","        ]","    }","","    \/\/\/ Single selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: Drink = .mineralWater","","    \/\/ Here the picker with title, selection and data","    MISOChipPicker(title: \"Select a drink\", selection: $selection, chips: someDataToPopulate)","","    \/\/\/ Multiple selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [Drink] = [.mineralWater]","","    \/\/ Here the picker with title, selection and data","    MISOChipPicker(title: \"Select a drink\", selections: $selections, chips: someDataToPopulate)"],"type":"codeListing"},{"name":"Since","style":"note","content":[{"inlineContent":[{"text":"OUDS 0.17.0","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://MISOComponents/documentation/MISOComponents/MISOChipPicker/View-Implementations":{"kind":"article","role":"collectionGroup","type":"topic","url":"\/documentation\/misocomponents\/misochippicker\/view-implementations","abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/View-Implementations","title":"View Implementations"},"doc://MISOComponents/documentation/MISOComponents/MISOFilterChip":{"title":"MISOFilterChip","abstract":[{"type":"text","text":"Filter chip is a UI element that allows to select or deselect an option within a series, and is commonly used to capture filtering decisions."},{"type":"text","text":" "},{"type":"text","text":"Filter chip allows to filter content by being selected or deselected."},{"type":"text","text":" "},{"type":"text","text":"It can be toggled “On” or “Off” to refine displayed results, and selected Filter Chips remain visually distinct to indicate active filters."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOFilterChip","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"MISOFilterChip","kind":"identifier