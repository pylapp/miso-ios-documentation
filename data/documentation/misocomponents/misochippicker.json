,"type":"text"},{"text":"It has also some configuration elements which will override the one applied to nested ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOFilterChip","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations"},{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"Voice Over"}]},{"text":" will use several elements to describe the component.","type":"text"},{"text":" ","type":"text"},{"text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used.","type":"text"},{"text":" ","type":"text"},{"text":"However if defined in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPickerData","type":"reference"},{"text":" the items inside the picker will have such accessibility identifiers.","type":"text"}]},{"type":"heading","text":"Code samples","level":2,"anchor":"Code-samples"},{"type":"codeListing","code":["    \/\/ Define the elements to display in filter chip using MISOChipPickerData.","    enum Drink: String, CaseIterable {","        case virginHolyLava, ipaBeer, mineralWater","    }","","    var someDataToPopulate: [MISOChipPickerData<Drink>] {","        [","            MISOChipPickerData(tag: Drink.virginHolyLava,","                               layout: .textAndImage(\"Virgin Holy Lava\", image: MISOImage(asset: Image(systemName: \"flame\")))),","","            MISOChipPickerData(tag: Drink.ipaBeer,","                               layout: .textAndImage(\"IPA Beer\", image: MISOImage(asset: Image(systemName: \"dog.fill\")))),","","            MISOChipPickerData(tag: Drink.mineralWater,","                               layout: .textAndImage(\"Mineral water\", image: MISOImage(asset: Image(systemName: \"waterbottle.fill\")))),","        ]","    }","","    \/\/\/ Single selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: Drink = .mineralWater","","    \/\/ Here the picker with title, selection and data","    MISOChipPicker(title: \"Select a drink\", selection: $selection, chips: someDataToPopulate)","","    \/\/\/ Multiple selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [Drink] = [.mineralWater]","","    \/\/ Here the picker with title, selection and data","    MISOChipPicker(title: \"Select a drink\", selections: $selections, chips: someDataToPopulate)"],"syntax":"swift"},{"type":"aside","style":"note","name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 0.17.0"}]}]}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misochippicker"]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/init(title:selection:chips:itemsSpacing:)-31j3k","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/init(title:selection:chips:itemsSpacing:)-8fuc0","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/init(title:selections:chips:itemsSpacing:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/init(title:tableName:bundle:selection:chips:itemsSpacing:)-1lbr4","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/init(title:tableName:bundle:selection:chips:itemsSpacing:)-9jopu","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/init(title:tableName:bundle:selections:chips:it