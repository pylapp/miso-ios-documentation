OComponents\/MISOChipPicker\/body"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker\/View-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPicker"},"kind":"symbol","abstract":[{"text":"A picker allowing to expose several ","type":"text"},{"inlineContent":[{"type":"text","text":"filter chips"}],"type":"emphasis"},{"text":" and proposing single or multiple selections.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOChipPicker"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Tag"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Tag"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Each chip contains a “tag”, i.e. a supposed to be unique value."},{"type":"text","text":" "},{"type":"text","text":"The picker will expose choosen values through this “tag”."},{"type":"text","text":" "},{"type":"text","text":"It has also some configuration elements which will override the one applied to nested "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOFilterChip","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Accessibility considerations","level":2,"anchor":"Accessibility-considerations","type":"heading"},{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Voice Over","type":"text"}]},{"text":" will use several elements to describe the component.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used."},{"type":"text","text":" "},{"type":"text","text":"However if defined in the "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOChipPickerData","isActive":true},{"type":"text","text":" the items inside the picker will have such accessibility identifiers."}],"type":"paragraph"},{"text":"Code samples","level":2,"anchor":"Code-samples","type":"heading"},{"syntax":"swift","code":["    \/\/ Define the elements to display in filter chip using MISOChipPickerData.","    enum Drink: String, CaseIterable {","        case virginHolyLava, ipaBeer, mineralWater","    }","","    var someDataToPopulate: [MISOChipPickerData<Drink>] {","        [","            MISOChipPickerData(tag: Drink.virginHolyLava,","                               layout: .textAndImage(\"Virgin Holy Lava\", image: MISOImage(asset: Image(systemName: \"flame\")))),","","            MISOChipPickerData(tag: Drink.ipaBeer,","                               layout: .textAndImage(\"IPA Beer\", image: MISOImage(asset: Image(systemName: \"dog.fill\")))),","","            MISOChipPickerData(tag: Drink.mineralWater,","                               layout: .textAndImage(\"Mineral water\", image: MISOImage(asset: Image(systemName: \"waterbottle.fill\")))),","        ]","    }","","    \/\/\/ Single selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selection: Drink = .mineralWater","","    \/\/ Here the picker with title, selection and data","    MISOChipPicker(title: \"Select a drink\", selection: $selection, chips: someDataToPopulate)","","    \/\/\/ Multiple selection case","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [Drink] = [.mineralWater]","","    \/\/ Here the picker with title, selection and data","    MISOChipPicker(title: \"Select a drink\", selections: $selections, chips: someDataToPopulate)"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 0.17.0","type":"text"}]}],"style":"note","name":"Since","type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"references":{"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"alt":null},"doc://MISOComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOChipPicker":{"title":"MISOChipPicker","navigatorTitle":[{"text":"MISOChipPicker","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/misocompo