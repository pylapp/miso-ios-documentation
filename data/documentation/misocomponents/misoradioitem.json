{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem\/init(_:isOn:extraLabel:description:image:isOutlined:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:action:)-2rpv4","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem\/init(_:isOn:extraLabel:description:image:isOutlined:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:action:)-320wv","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem\/init(_:tableName:bundle:isOn:extraLabel:description:image:isOutlined:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:action:)-4v8ig","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem\/init(_:tableName:bundle:isOn:extraLabel:description:image:isOutlined:isReversed:isError:errorText:isReadOnly:hasDivider:constrainedMaxWidth:action:)-qas1"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem\/body"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem\/View-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misoradioitem"]}],"abstract":[{"type":"text","text":"Radio button item is a UI element that allows to select a single option from a set of mutually exclusive choices."},{"type":"text","text":" "},{"type":"text","text":"Radio button item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISORadioItem","kind":"identifier"}]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Controls"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Layouts","anchor":"Layouts"},{"type":"paragraph","inlineContent":[{"text":"The component can be rendered as two different layouts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"type":"text","text":": the component has a leading indicator, a label and optional texts, and an optional trailing decorative icon"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"reversed","type":"text"}],"type":"strong"},{"type":"text","text":": like the "},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"type":"text","text":" layout but with a trailing radio indicator and a leading optional decorative icon"}]}]}]},{"text":"Indicator states","level":2,"type":"heading","anchor":"Indicator-states"},{"inlineContent":[{"type":"text","text":"The radio indicator has two available states:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"selected","type":"text"}],"type":"strong"},{"text":": the radio is filled with a filled circle, the user has made the action to select the radio","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"unselected"}]},{"type":"text","text":": the radio is empty, does not contain anything, the user has made the action to unselect or did not select yet the radio"}]}]}],"type":"unorderedList"},{"text":"Particular cases","level":2,"type":"heading","anchor":"Particular-cases"},{"inlineContent":[{"type":"text","text":"An "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem"},{"type":"text","text":" can be related to an error situation, for example troubles for a form."},{"type":"text","text":" "},{"type":"text","text":"A dedicated look and feel is implemented for that if the "},{"type":"codeVoice","code":"isError"},{"text":" flag is risen.","type":"text"},{"text":" ","type":"text"},{"text":"In that case if the component displayed an icon, this icon will be replaced automatically by an error icon.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In addition, the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem","type":"reference"},{"text":" can be in read only mode, i.e. the user cannot interact with the component yet but this component must not be considered","type":"text"},{"text":" ","type":"text"},{"text":"as disabled.","type":"text"},{"text":" ","type":"text"},{"text":"The radio can be also outlined in some cases.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The component does not follow the right-to-left (RTL) \/ left-to-right (LTR) mode returned by the system as it could have some meaning","type":"text"},{"text":" ","type":"text"},{"text":"to have for example the indicator in trailing position for LTR mode and vice versa.","type":"text"},{"text":" ","type":"text"},{"text":"However, if the component has an icon in leading position (RTL mode) or in trailing position (LTR), the content of the icon is never changed.","type":"text"},{"text":" ","type":"text"},{"text":"It could lead to a loss of meaning or semantics in the icon. Thus the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOImage"},{"text":" ","type":"text"},{"code":"flipped","type":"codeVoice"},{"text":" property can be used to flip the icon content","type":"text"},{"text":" ","type":"text"},{"text":"whatever the layout direction is, preventing the user from implementing their own rules to flip or not the image.","type":"text"}],"type":"paragraph"},{"anchor":"Rich-text","type":"heading","text":"Rich text","level":2},{"inlineContent":[{"type":"text","text":"Rich text can only be used for error messages."}],"type":"paragraph"},{"inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users.","type":"text"}],"type":"paragraph"},{"anchor":"Accessibility-considerations","type":"heading","text":"Accessibility considerations","level":2},{"inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Voice Over"}],"type":"emphasis"},{"text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and optional texts and a custom radio trait.","type":"text"},{"text":" ","type":"text"},{"text":"No accessibility identifier is defined in MISO side as this value remains in the users hands.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Forbidden-by-design","level":2,"text":"Forbidden by design"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"The design system does not allow to have both an error situation and a read only component."}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"The design system does not allow to have both an error situation and a disabled component.","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"The design system does not allow to have both a read only and a disabled component.","type":"text"}],"type":"strong"}]},{"type":"heading","anchor":"Code-samples","level":2,"text":"Code samples"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioItem"},{"text":" can be used outside a dedicated picker, thus it does not need any tag and associated type.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ Supposing we have an unselected state","    @Published var selection: Bool = false","","    \/\/ A leading radio with a label.","    MISORadioItem(\"Lucy in the Sky with Diamonds\", isOn: $selection)","","    \/\/ Localizable from bundle can also be used","    MISORadioItem(LocalizedStringKey(\"option_label\"), bundle: Bundle.module, isOn: $selection)","","    \/\/ A leading radio with a label, but in read only mode (user cannot interact yet, but not disabled).","    MISORadioItem(\"Lucy in the Sky with Diamonds\", isOn: $selection, isReadOnly: true)","","    \/\/ A leading radio with an additional label and a description.","    MISORadioItem(\"Lucy in the Sky with Diamonds\", isOn: $selection,","                  extraLabel: \"The Beatles\", description: \"1967\")","","    \/\/ A trailing radio with a label, a description, a tinted icon, a divider and an error.","    MISORadioItem(\"Rescue from this world!\",","                  isOn: $selection,","                  description: \"Put your hand in mine\",","                  image: MISOImage(asset: Image(decorative: \"ic_heart\")),","                  isReversed: true,","                  isError: true,","                  hasDivider: true)","","    \/\/ A trailing radio with a raw (non-tinted) image.","    MISORadioItem(\"Rescue from this world!\",","                  isOn: $selection,","                  description: \"Put your hand in mine\",","                  image: MISOImage(asset: Image(decorative: \"il_someImage\"), renderingMode: .original),","                  isReversed: true,","                  isError: true,","                  hasDivider: true)","","    \/\/ Flip the icon for RTL layouts using MISOImage.","    MISORadioItem(\"Cocorico !\",","                  isOn: $selection,","                  image: MISOImage(asset: Image(systemName: \"figure.handball\"),","                                  flipped: layoutDirection == .rightToLeft),","                  isReversed: layoutDirection == .rightToLeft)","","    \/\/ If on error, add an error message can help user to understand error context","    MISORadioItem(\"Rescue from this world!\",","                  isOn: $selection,","                  isError: true,","                  errorText: \"Something wrong\",","                  hasDivider: true)","","    \/\/ A leading radio with a label, but disabled.","    MISORadioItem(\"Rescue from this world!\", isOn: $selection)","        .disabled(true)","","    \/\/ Never disable a read only or an error-related radio as it will crash","    \/\/ This is forbidden by design!","    MISORadioItem(\"Kaboom!\", isOn: $selection, isError: true).disabled(true) \/\/ fatal error","    MISORadioItem(\"Kaboom!\", isOn: $selection, isReadOnly: true).disabled(true) \/\/ fatal error"]},{"type":"aside","name":"Version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.4.0 (Figma component design version)"}]}],"style":"note"},{"type":"aside","name":"Since","content":[{"inlineContent":[{"text":"OUDS 0.12.0","type":"text"}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","hierarchy":{"paths":[["d