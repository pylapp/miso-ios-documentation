,"anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use this modifier instead of "},{"type":"codeVoice","code":".toolbar(.hidden, for: .tabBar)"},{"type":"text","text":" "},{"type":"text","text":"whenever a view inside a "},{"type":"codeVoice","code":"NavigationStack"},{"type":"text","text":" embedded in an "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" needs to hide"},{"type":"text","text":" "},{"type":"text","text":"the tab bar. Without this modifier, "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" cannot detect the visibility change"},{"type":"text","text":" "},{"type":"text","text":"and its overlay elements remain visible on top of the content. This helper must be used for"},{"type":"text","text":" "},{"type":"text","text":"apps with nested views and tab bars."}],"type":"paragraph"},{"inlineContent":[{"text":"Otherwise for simple app ","type":"text"},{"code":".toolbar(.hidden, for: .tabBar)","type":"codeVoice"},{"text":" is enough.","type":"text"}],"type":"paragraph"},{"code":["struct DetailView: View {","    var body: some View {","        Text(\"Detail\")","            .hideTabBar()","    }","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"type":"text","text":"Hides the native tab bar "},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"type":"text","text":" signals "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"variants":[{"paths":["\/documentation\/misocomponents\/misohorizontaldivider\/hidetabbar()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISODividerColor":{"abstract":[{"type":"text","text":"List of colors available for dividers (i.e. "},{"type":"codeVoice","code":"MISOHorizontalDivider"},{"type":"text","text":" or "},{"type":"codeVoice","code":"MISOVerticalDivider"},{"type":"text","text":")"}],"url":"\/documentation\/misocomponents\/misodividercolor","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","navigatorTitle":[{"text":"MISODividerColor","kind":"identifier"}],"kind":"symbol","title":"MISODividerColor","role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISODividerColor","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"url":"\/documentation\/misocomponents","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"kind":"symbol","title":"Components","role":"collection","type":"topic"},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}]},"doc://MISOComponents/documentation/MISOComponents/MISOHorizontalDivider":{"abstract":[{"type":"text","text":"Divider is a UI element that allows to structure the content by visually separating the content zones."},{"type":"text","text":" "},{"type":"text","text":"Divider improves readability and content organization without introducing a stronger visual hierarchy like a heading or a container would."},{"type":"text","text":" "},{"type":"text","text":"A horizontal Divider is used to separate content laid out one under the other ("},{"type":"codeVoice","code":"VStack"},{"type":"text","text":")."},{"type":"text","text":" "},{"type":"text","text":"The divider can be colored using dedicated "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISODividerColor","isActive":true,"type":"reference"},{"type":"text","text":" colors."},{"type":"text","text":" "},{"type":"text","text":"The thickness (height) is fixed by dedicated token from "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":"."}],"url":"\/documentation\/misocomponents\/misohorizontaldivider","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider","navigatorTitle":[{"text":"MISOHorizontalDivider","kind":"identifier"}],"kind":"symbol","title":"MISOHorizontalDivider","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOHorizontalDivider","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOHorizontalDivider/hideTabBar()":{"url":"\/documentation\/misocomponents\/misohorizontaldivider\/hidetabbar()","type":"topic","abstract":[{"type":"text","text":"Hides the native tab bar "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" signals "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" to hide its overlay elements"},{"type":"text","text":" "},{"type":"text","text":"(selected tab indicator and top divider) in sync."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hideTabBar"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"title":"hideTabBar()","kind":"symbol","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHorizontalDivider\/hideTabBar()"}}}