{"abstract":[{"type":"text","text":"Text component used to structure the hierarchy of a screen."},{"type":"text","text":" "},{"type":"text","text":"Four sizes are available; the largest ("},{"code":".large","type":"codeVoice"},{"type":"text","text":") can optionally display a "},{"inlineContent":[{"type":"text","text":"marker"}],"type":"strong"},{"type":"text","text":", i.e. a small brand-coloured"},{"type":"text","text":" "},{"type":"text","text":"rectangle rendered below the text (when the current theme declares it supports one)."}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOHeading","kind":"identifier"}]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Foundations"]},{"kind":"content","content":[{"anchor":"Sizes","type":"heading","text":"Sizes","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"XLarge"}]},{"type":"text","text":": The largest heading, useful for page titles."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Large (by default)"}]},{"type":"text","text":": The default heading. Only this size supports the marker and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"colored substring"}]},{"type":"text","text":" feature."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Medium"}]},{"type":"text","text":": A medium heading, typically used for section titles."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Small"}]},{"type":"text","text":": The smallest heading, used for subsection titles."}]}]}],"type":"unorderedList"},{"anchor":"Marker","type":"heading","text":"Marker","level":2},{"inlineContent":[{"type":"text","text":"Some themes (like "},{"type":"emphasis","inlineContent":[{"text":"BlueCoat","type":"text"}]},{"type":"text","text":") declare that a "},{"type":"emphasis","inlineContent":[{"text":"large","type":"text"}]},{"type":"text","text":" heading is decorated with a small"},{"type":"text","text":" "},{"type":"text","text":"coloured rectangle below the text, i.e. the "},{"type":"strong","inlineContent":[{"text":"marker","type":"text"}]},{"type":"text","text":". Other themes may not use a marker at all but something else."}],"type":"paragraph"},{"anchor":"Coloring-a-substring","type":"heading","text":"Coloring a substring","level":2},{"inlineContent":[{"type":"text","text":"A dedicated initializer accepts a "},{"type":"codeVoice","code":"coloredText"},{"type":"text","text":" sub-string instead of a marker."},{"type":"text","text":" "},{"type":"text","text":"This is useful to emphasize a specific word inside a heading (for example a brand name). This feature is only"},{"type":"text","text":" "},{"type":"text","text":"meaningful for "},{"type":"codeVoice","code":"size == .large"},{"type":"text","text":"; on other sizes a warning is logged and the text is rendered plain."}],"type":"paragraph"},{"style":"warning","name":"Warning","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Not all themes provide a valid ","type":"text"},{"type":"codeVoice","code":"theme.colors.contentBrandSecondary"},{"text":" (some themes may mark","type":"text"},{"text":" ","type":"text"},{"text":"the token as forbidden). When the token is forbidden the coloring is skipped.","type":"text"}]}]},{"anchor":"Code-samples","type":"heading","text":"Code samples","level":2},{"code":["    \/\/ Simple raw string","    MISOHeading(text: \"Title\")","","    \/\/ Large heading with a marker (rendered only when the theme supports it)","    MISOHeading(text: \"Section title\", size: .large, hasMarker: true)","","    \/\/ Smaller heading (marker parameter would be ignored here)","    MISOHeading(text: \"Sub-section\", size: .medium)","","    \/\/ Heading with a brand-coloured word","    MISOHeading(text: \"Welcome to MISO\", coloredText: \"MISO\")","","    \/\/ Localizable from a bundle","    MISOHeading(LocalizedStringKey(\"section_title\"), bundle: Bundle.module, size: .large)"],"type":"codeListing","syntax":"swift"},{"anchor":"Accessibility","type":"heading","text":"Accessibility","level":2},{"inlineContent":[{"type":"text","text":"The component adds the "},{"type":"codeVoice","code":".isHeader"},{"type":"text","text":" accessibility trait so that assistive technologies (like "},{"type":"emphasis","inlineContent":[{"text":"VoiceOver","type":"text"}]},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"announce the text as a header. When a marker is drawn, it is hidden from assistive technologies (decorative)."}],"type":"paragraph"},{"style":"note","name":"Version","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}]}]},{"style":"note","name":"Since","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misoheading"]}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHeading\/init(_:tableName:bundle:coloredText:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOHeading\/init(_:tableName