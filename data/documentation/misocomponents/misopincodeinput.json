{"sections":[],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"Components"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOPinCodeInput","kind":"identifier"}],"roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"text":"MISOPinCodeInput","kind":"identifier"}],"externalID":"s:14MISOComponents16MISOPinCodeInputV","platforms":[{"unavailable":false,"deprecated":false,"introducedAt":"15.0","beta":false,"name":"iOS"},{"unavailable":false,"deprecated":false,"introducedAt":"1.0","beta":false,"name":"visionOS"}],"title":"MISOPinCodeInput"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-10o29","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7psh2","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:hiddenCharacters:helperText:isOutlined:status:autofocus:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/body"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/obfuscationCharacter","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/placeholderCharacter"],"title":"Type Properties","anchor":"Type-Properties","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/Length","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/Status"],"title":"Enumerations","anchor":"Enumerations","generated":true},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/View-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOPinCodeInput"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Layouts","anchor":"Layouts"},{"inlineContent":[{"type":"text","text":"The component can be rendered as two different layouts:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"outlined"}],"type":"emphasis"},{"type":"text","text":" layout: A minimalist input with a transparent background and a visible stroke outlining the field."},{"type":"text","text":" "},{"type":"text","text":"This style may be interesting for contexts other than form pages, e.g. when inputs need to feel lightweight and unobtrusive,"},{"type":"text","text":" "},{"type":"text","text":"in a header (search field), or in a selection\/filtering feature in a product catalog"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"not outlined"}]},{"text":" (default): An input with a subtle background fill and visible bottom border, creating a softer and more contained look.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for dense layouts or to enhance visibility.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The component provides 3 layouts for the input: 4 boxes, 6 boxes or 8 boxes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A helper text can be used to support text to convey additional information about the input field, such as how it will be used."},{"type":"text","text":" "},{"type":"text","text":"It should ideally only take up a single line, though may wrap to multiple lines if required, and be either persistently visible or visible only on focus."}],"type":"paragraph"},{"level":2,"anchor":"Error-status","type":"heading","text":"Error status"},{"inlineContent":[{"text":"The Error status indicates that the user input does not meet validation rules or expected formatting.","type":"text"},{"text":" ","type":"text"},{"text":"It provides immediate visual feedback, typically through a red border, error icon, and a clear, accessible error message positioned below the input (mandatory).","type":"text"},{"type":"text","text":" "},{"type":"text","text":"This state helps users quickly identify and correct mistakes by explaining what went wrong and, when possible, how to fix it."},{"type":"text","text":" "},{"type":"text","text":"The input remains editable, encouraging users to revise their input without starting over."},{"type":"text","text":" "},{"type":"text","text":"The error state must be triggered by an explicit validation (submission, API response), and not in real time with each keystroke."},{"type":"text","text":" "},{"type":"text","text":"This can occur either because the entered code does not match the expected code, because the user entered an expired or already used code,"},{"type":"text","text":" "},{"type":"text","text":"or finally if the maximum number of attempts has been exceeded."}],"type":"paragraph"},{"level":2,"anchor":"Specific-design-guidelines","text":"Specific design guidelines","type":"heading"},{"inlineContent":[{"text":"In the context of a PIN code input, in addition to the input’s “Error” UI rendering, it is essential to also include an “Alert” component","type":"text"},{"text":" ","type":"text"},{"text":"(also in its “Error” status) in the interface.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Particular-cases","text":"Particular cases","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput"},{"type":"text","text":" component supports autofill feature of values like OTP code."},{"type":"text","text":" "},{"type":"text","text":"For example if the user receives a message with inside a code the system can extract, the keyboard can suggest to the user to fill it."},{"type":"text","text":" "},{"type":"text","text":"If the digits fits the component, it will be filled."},{"type":"text","text":" "},{"type":"text","text":"If the digits are longer, they will be truncated."},{"type":"text","text":" "},{"type":"text","text":"If the digits are shorter, they will be filled, letting other fields empty."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The copy\/paste feature is also available and has the same behavior.","type":"text"}]},{"level":2,"anchor":"Technical-considerations","text":"Technical considerations","type":"heading"},{"inlineContent":[{"type":"text","text":"For some cases, on phones screens or with 8 boxes in iPhone, you may need to use a "},{"type":"codeVoice","code":"ScrollView"},{"type":"text","text":" to embed the component and let user move it."}],"type":"paragraph"},{"syntax":"swift","code":["ScrollView(.horizontal) {","    MISOPinCodeInput($value,","                     length: .eight,","                     helperText: \"Enter your secret code sent to your phone\")","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"Note also the exposed ","type":"text"},{"inlineContent":[{"type":"text","text":"value"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":" will be updated when all digits are written.","type":"text"}],"type":"strong"}],"type":"paragraph"},{"level":2,"anchor":"Accessibility-considerations","text":"Accessibility considerations","type":"heading"},{"inlineContent":[{"text":"The content of the fields is vocalized by Voice Over; the placeholders (defined in ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/obfuscationCharacter","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/placeholderCharacter","isActive":true,"type":"reference"},{"text":")","type":"text"},{"type":"text","text":" "},{"type":"text","text":"are not vocalized to let users know what they wrote."}],"type":"paragraph"},{"inlineContent":[{"text":"The component gets only numeric values, not letters or symbols, only numbers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Depending on the component configuration, autofocus can still be used when the component appears, and focus is moved to the next field as digits are entered.","type":"text"},{"text":" ","type":"text"},{"text":"For example if Voice Over is enavled, the autoficus is disabled.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The component and its digit fields are vocalized with internal wording.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When using the error status, provide a clear, concise error message explaining what went wrong and, when possible, how to fix it"},{"type":"text","text":" "},{"type":"text","text":"(for example: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“The code you entered is invalid. Try again.”"}]},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"Use helper text to communicate additional guidance (for example: ","type":"text"},{"inlineContent":[{"type":"text","text":"“Check the 6‑digit code sent by SMS”"}],"type":"emphasis"},{"text":"), and keep this text short so it remains easy to vocalize","type":"text"},{"text":" ","type":"text"},{"text":"and understand.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Rich-text","type":"heading","text":"Rich text"},{"inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."},{"type":"text","text":" "},{"type":"text","text":"The helper text and the error message are "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent","type":"reference","isActive":true},{"type":"text","text":" values: a raw "},{"code":"String","type":"codeVoice"},{"text":", a localized string","type":"text"},{"type":"text","text":" "},{"text":"with ","type":"text"},{"type":"codeVoice","code":".localized(_:tableName:bundle:)"},{"text":" or a rich text with ","type":"text"},{"code":".rich(_:)","type":"codeVoice"},{"text":" and an ","type":"text"},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Prefer "},{"code":".raw(_:)","type":"codeVoice"},{"type":"text","text":" to a bare string literal for a raw helper text, so the compiler selects without any doubt the initializer"},{"type":"text","text":" "},{"type":"text","text":"taking an "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent","isActive":true},{"type":"text","text":" and does not emit a deprecation warning."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly to highlight key information within the content."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"anchor":"Code-samples","type":"heading","text":"Code samples","level":2},{"code":["    \/\/ The value with the code","    @State private var pinCode: String = \"\"","","    \/\/ By default, the PIN code input displays only 6 boxes","    MISOPinCodeInput($pinCode)","","    \/\/ It can have also up 4 or 8 boxes, with an helper text","    MISOPinCodeInput($pinCode, length: .eight, helperText: \"Enter your 8 secret digits\")","","    \/\/ The component can be used in error contexts","    MISOPinCodeInput($pinCode, length: .six, status: .textualError(message: \"The OTP code you entered is not correct\"))","","    \/\/ The helper text and the error message can be localized or rich texts","    MISOPinCodeInput($pinCode, helperText: .localized(\"pin_helper\", bundle: Bundle.module))","    MISOPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     helperText: .rich(AttributedString(markdown: \"Enter the **one-time code** sent to your device\")))","    MISOPinCodeInput($pinCode,","                     \/\/ Manage in your side errors for init","                     status: .textualError(message: .rich(AttributedString(markdown: \"The code is **not correct**\"))))","","    \/\/ Show the written characters","    MISOPinCodeInput($pinCode, hiddenCharacters: false)"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"text":"1.3.0 (Figma component design version)","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note","name":"Version"},{"content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 1.4.0","type":"text"}]}],"type":"aside","style":"note","name":"Since"}],"kind":"content"}],"abstract":[{"text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,","type":"text"},{"text":" ","type":"text"},{"text":"such as a four, six or eight-digit personal identification number (PIN).","type":"text"},{"text":" ","type":"text"},{"text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,","type":"text"},{"text":" ","type":"text"},{"text":"while supporting smooth keyboard navigation and secured input masking if needed.","type":"text"}],"variants":[{"paths":["\/documentation\/misocomponents\/misopincodeinput"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOPinCodeInput/View-Implementations":{"title":"View Implementations","url":"\/documentation\/misocomponents\/misopincodeinput\/view-implementations","abstract":[],"type":"topic","kind":"article","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/View-Implementations","role":"collectionGroup"},"doc://MISOComponents/documentation/MISOComponents/MISOTextualContent":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"MISOTextualContent","kind":"identifier"}],"abstract":[{"text":"A textual value that can be either a plain ","type":"text"},{"code":"String","type":"codeVoice"},{"type":"text","text":" or a styled "},{"type":"codeVoice","code":"AttributedString"},{"type":"text","text":"."}],"navigatorTitle":[{"text":"MISOTextualContent","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misotextualcontent","title":"MISOTextualContent","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTextualContent","type":"topic","role":"symbol"},"doc://MISOComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier