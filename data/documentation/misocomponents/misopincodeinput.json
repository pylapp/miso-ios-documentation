{"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-10o29","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:helperText:isOutlined:status:autofocus:)-7psh2","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/body"],"generated":true},{"title":"Type Properties","generated":true,"anchor":"Type-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/obfuscationCharacter","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/placeholderCharacter"]},{"title":"Enumerations","generated":true,"anchor":"Enumerations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/Length","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/Status"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/View-Implementations"]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOPinCodeInput"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"Layouts","level":2,"text":"Layouts","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The component can be rendered as two different layouts:"}]},{"items":[{"content":[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"outlined","type":"text"}]},{"text":" layout: A minimalist input with a transparent background and a visible stroke outlining the field.","type":"text"},{"text":" ","type":"text"},{"text":"This style may be interesting for contexts other than form pages, e.g. when inputs need to feel lightweight and unobtrusive,","type":"text"},{"text":" ","type":"text"},{"text":"in a header (search field), or in a selection\/filtering feature in a product catalog","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"not outlined"}],"type":"emphasis"},{"text":" (default): An input with a subtle background fill and visible bottom border, creating a softer and more contained look.","type":"text"},{"text":" ","type":"text"},{"text":"Best suited for dense layouts or to enhance visibility.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The component provides 3 layouts for the input: 4 boxes, 6 boxes or 8 boxes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A helper text can be used to support text to convey additional information about the input field, such as how it will be used."},{"type":"text","text":" "},{"type":"text","text":"It should ideally only take up a single line, though may wrap to multiple lines if required, and be either persistently visible or visible only on focus."}],"type":"paragraph"},{"text":"Error status","anchor":"Error-status","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The Error status indicates that the user input does not meet validation rules or expected formatting."},{"type":"text","text":" "},{"type":"text","text":"It provides immediate visual feedback, typically through a red border, error icon, and a clear, accessible error message positioned below the input (mandatory)."},{"type":"text","text":" "},{"type":"text","text":"This state helps users quickly identify and correct mistakes by explaining what went wrong and, when possible, how to fix it."},{"type":"text","text":" "},{"type":"text","text":"The input remains editable, encouraging users to revise their input without starting over."},{"type":"text","text":" "},{"type":"text","text":"The error state must be triggered by an explicit validation (submission, API response), and not in real time with each keystroke."},{"type":"text","text":" "},{"type":"text","text":"This can occur either because the entered code does not match the expected code, because the user entered an expired or already used code,"},{"type":"text","text":" "},{"type":"text","text":"or finally if the maximum number of attempts has been exceeded."}],"type":"paragraph"},{"anchor":"Specific-design-guidelines","level":2,"type":"heading","text":"Specific design guidelines"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the context of a PIN code input, in addition to the input’s “Error” UI rendering, it is essential to also include an “Alert” component"},{"type":"text","text":" "},{"type":"text","text":"(also in its “Error” status) in the interface."}]},{"anchor":"Particular-cases","level":2,"type":"heading","text":"Particular cases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput"},{"type":"text","text":" component supports autofill feature of values like OTP code."},{"type":"text","text":" "},{"type":"text","text":"For example if the user receives a message with inside a code the system can extract, the keyboard can suggest to the user to fill it."},{"type":"text","text":" "},{"type":"text","text":"If the digits fits the component, it will be filled."},{"type":"text","text":" "},{"type":"text","text":"If the digits are longer, they will be truncated."},{"type":"text","text":" "},{"type":"text","text":"If the digits are shorter, they will be filled, letting other fields empty."}]},{"type":"paragraph","inlineContent":[{"text":"The copy\/paste feature is also available and has the same behavior.","type":"text"}]},{"anchor":"Technical-considerations","level":2,"type":"heading","text":"Technical considerations"},{"type":"paragraph","inlineContent":[{"text":"For some cases, on phones screens or with 8 boxes in iPhone, you may need to use a ","type":"text"},{"code":"ScrollView","type":"codeVoice"},{"text":" to embed the component and let user move it.","type":"text"}]},{"type":"codeListing","code":["ScrollView(.horizontal) {","    MISOPinCodeInput($value,","                     length: .eight,","                     helperText: \"Enter your secret code sent to your phone\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note also the exposed "},{"type":"emphasis","inlineContent":[{"type":"text","text":"value"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" will be updated when all digits are written."}]}]},{"type":"heading","level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"inlineContent":[{"type":"text","text":"The content of the fields is vocalized by Voice Over; the placeholders (defined in "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/obfuscationCharacter","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/placeholderCharacter","isActive":true},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"are not vocalized to let users know what they wrote."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The component gets only numeric values, not letters or symbols, only numbers."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the component configuration, autofocus can still be used when the component appears, and focus is moved to the next field as digits are entered."},{"text":" ","type":"text"},{"text":"For example if Voice Over is enavled, the autoficus is disabled.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The component and its digit fields are vocalized with internal wording.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When using the error status, provide a clear, concise error message explaining what went wrong and, when possible, how to fix it"},{"type":"text","text":" "},{"type":"text","text":"(for example: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“The code you entered is invalid. Try again.”"}]},{"text":").","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use helper text to communicate additional guidance (for example: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"“Check the 6‑digit code sent by SMS”"}]},{"type":"text","text":"), and keep this text short so it remains easy to vocalize"},{"type":"text","text":" "},{"type":"text","text":"and understand."}]},{"type":"heading","level":2,"anchor":"Rich-text","text":"Rich text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rich text can be used for error and helper texts."}]},{"type":"paragraph","inlineContent":[{"text":"Strong text can be used sparingly to highlight key information within the content.","type":"text"},{"text":" ","type":"text"},{"text":"No other text styles should be used.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Underlined text must not be applied manually (e.g. in error message), as it is commonly associated with hyperlinks and may mislead users."}]},{"type":"heading","level":2,"anchor":"Code-samples","text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ The value with the code","    @State private var pinCode: String = \"\"","","    \/\/ By default, the PIN code input displays only 6 boxes","    MISOPinCodeInput($pinCode)","","    \/\/ It can have also up 4 or 8 boxes, with an helper text","    MISOPinCodeInput($pinCode, length: .eight, helperText: \"Enter your 8 secret digits\")","","    \/\/ The component can be used in error contexts","    MISOPinCodeInput($pinCode, length: .six, status: .error(message: \"The OTP code you entered is not correct\"))"]},{"style":"note","name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"1.3.0 (Figma component design version)","type":"text"}]}],"type":"aside"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"OUDS 1.4.0"}],"type":"paragraph"}],"style":"note","name":"Since"}]}],"abstract":[{"text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,","type":"text"},{"text":" ","type":"text"},{"text":"such as a four, six or eight-digit personal identification number (PIN).","type":"text"},{"text":" ","type":"text"},{"text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"while supporting smooth keyboard navigation and secured input masking if needed."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput"},"sections":[],"metadata":{"externalID":"s:14MISOComponents16MISOPinCodeInputV","roleHeading":"Structure","role":"symbol","platforms":[{"introducedAt":"15.0","deprecated":false,"unavailable":false,"name":"iOS","beta":false},{"introducedAt":"1.0","deprecated":fa