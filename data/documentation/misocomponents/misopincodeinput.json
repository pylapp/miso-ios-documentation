:"MISOPinCodeInput","kind":"identifier"}],"title":"MISOPinCodeInput","abstract":[{"type":"text","text":"PIN code input is a UI element that allows to capture short, fixed-length numeric codes, typically for authentication or confirmation purposes,"},{"type":"text","text":" "},{"type":"text","text":"such as a four, six or eight-digit personal identification number (PIN)."},{"type":"text","text":" "},{"type":"text","text":"PIN code input is presented as a series of individual input fields or boxes, each representing a single digit, to enhance readability and encourage accurate input,"},{"type":"text","text":" "},{"type":"text","text":"while supporting smooth keyboard navigation and secured input masking if needed."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput","kind":"symbol"},"doc://MISOComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://MISOComponents/s8SendableP":{"identifier":"doc:\/\/MISOComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://MISOComponents/documentation/MISOComponents/MISOPinCodeInput/placeholderCharacter":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/placeholderCharacter","title":"placeholderCharacter","type":"topic","url":"\/documentation\/misocomponents\/misopincodeinput\/placeholdercharacter","kind":"symbol","abstract":[{"text":"The symbol used as a placeholder for a digit not yet filled.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"placeholderCharacter","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}]},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","title":"Components","type":"topic","kind":"symbol","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}]},"doc://MISOComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","type":"unresolvable","title":"SwiftUICore.View"},"doc://MISOComponents/documentation/MISOComponents/MISOPinCodeInput/init(_:length:helperText:isOutlined:status:autofocus:)-7psh2":{"url":"\/documentation\/misocomponents\/misopincodeinput\/init(_:length:helpertext:isoutlined:status:autofocus:)-7psh2","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"length","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents16MISOPinCodeInputV","text":"MISOPinCodeInput","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:14MISOComponents16MISOPinCodeInputV6LengthO","text":"Length","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"helperText","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation16AttributedStringV","text":"AttributedString","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"isOutlined","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"status","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents16M