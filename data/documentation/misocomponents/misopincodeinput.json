ntifier":"s:Sb"},{"text":")","kind":"text"}],"url":"\/documentation\/misocomponents\/misopincodeinput\/init(_:length:helpertext:tablename:bundle:isoutlined:status:autofocus:)","role":"symbol","title":"init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/init(_:length:helperText:tableName:bundle:isOutlined:status:autofocus:)"},"doc://MISOComponents/documentation/MISOComponents/MISOPinCodeInput/body":{"kind":"symbol","role":"symbol","abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/body","type":"topic","title":"body","url":"\/documentation\/misocomponents\/misopincodeinput\/body","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}]},"doc://MISOComponents/documentation/MISOComponents/MISOPinCodeInput/Length":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOPinCodeInput\/Length","url":"\/documentation\/misocomponents\/misopincodeinput\/length","abstract":[{"type":"text","text":"The type of layout to apply to the "},{"inlineContent":[{"type":"text","text":"pin code input"}],"type":"emphasis"},{"type":"text","text":" to define the size of the input"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Length"}],"title":"MISOPinCodeInput.Length","type":"topic","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Length"}],"kind":"symbol"}}}