{"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"anchor":"Initializers","title":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)"]},{"anchor":"Instance-Properties","title":"Instance Properties","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body"]},{"anchor":"Default-Implementations","title":"Default Implementations","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Appearances","anchor":"Appearances"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars."},{"type":"text","text":" "},{"type":"text","text":"Because today the MISO tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"background color of tab bar can be changed for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar does not change since iOS 26"}]}]},{"content":[{"inlineContent":[{"text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount"},{"type":"text","text":", the native API is used instead."}]},{"inlineContent":[{"type":"text","text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before."},{"type":"text","text":" "},{"type":"text","text":"However if an app is built with Xcode 26 and the flag "},{"inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}],"type":"emphasis"},{"type":"text","text":" set to "},{"inlineContent":[{"text":"YES","type":"text"}],"type":"emphasis"},{"type":"text","text":", then Liquid Glass won’t be applied but the alternative layout."},{"type":"text","text":" "},{"type":"text","text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use SF Symbols for images, if they exist their "},{"type":"emphasis","inlineContent":[{"type":"text","text":"fill"}]},{"type":"text","text":" variant will be automatically used in the tab bar (native behaviour)."}]},{"level":2,"type":"heading","text":"Platform considerations","anchor":"Platform-considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"This component is tailored for iOS","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"On iPadOS the tabs do not apply the fonts since iPadOS 18"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for watchOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for tvOS"}]}]}]},{"level":2,"type":"heading","text":"Guidelines","anchor":"Guidelines"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MISO guidelines recommends to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"limit when possible the number of items to 5"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"use both images and texts in tab bar items"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"use badges only when needed to avoid to have heavy tab bar","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if decorative images are used for tab bar item, apply "},{"inlineContent":[{"type":"text","text":"template"}],"type":"emphasis"},{"type":"text","text":" rendering mode on it to apply color on tabs"}]}]}]},{"text":"Accessibility considerations","type":"heading","anchor":"Accessibility-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"by using accessibiltiy value"}]}]}]},{"syntax":"swift","type":"codeListing","code":["    MISOTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""]},{"anchor":"Selection-of-tabs","type":"heading","level":2,"text":"Selection of tabs"},{"inlineContent":[{"type":"text","text":"For iOS lower than 26, a selected tab indicator is displayed in the "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" ; the "},{"type":"codeVoice","code":"count"},{"type":"text","text":" parameter must be defined (to the number of tabs in the component),"},{"type":"text","text":" "},{"type":"text","text":"and if the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding value is equal to a given tag associated to a tab item."},{"type":"text","text":" "},{"type":"text","text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator."},{"type":"text","text":" "},{"type":"text","text":"This rule is only applied if selected tab indicator must be displayed."},{"type":"text","text":" "},{"type":"text","text":"When the user taps a tab, the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding is updated automatically, keeping the parent view in sync."}],"type":"paragraph"},{"anchor":"Technical-considerations","type":"heading","level":2,"text":"Technical considerations"},{"inlineContent":[{"type":"text","text":"In order to improve the Developer eXperience the current "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" implementation lets users define their own tab items."},{"type":"text","text":" "},{"type":"text","text":"MISO applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"picker"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Thus users will need to add their own accessiiblity label if badges are used or also apply ","type":"text"},{"inlineContent":[{"text":"template","type":"text"}],"type":"emphasis"},{"text":" rendering mode on images if needed.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You must use in your tab bar items images with ","type":"text"},{"type":"strong","inlineContent":[{"text":"a size of 26 x 26","type":"text"}]},{"text":", otherwise rendering could be unaligned with Figma specifications","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,","type":"text"},{"text":" ","type":"text"},{"text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer "},{"code":"hideTabBar()","type":"codeVoice"},{"type":"text","text":" from "},{"code":"View","type":"codeVoice"},{"type":"text","text":" to hide the tab bar"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"TabView","type":"codeVoice"},{"type":"text","text":" and overlay items) with Liquid Glass is disabled or not available, or also "},{"code":"tabBar(isHidden:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"type":"codeListing","code":["    \/\/ Use the MISO tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    MISOTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside MISOTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"],"syntax":"swift"},{"type":"heading","level":2,"text":"Alternative components","anchor":"Alternative-components"},{"type":"paragraph","inlineContent":[{"text":"If you want to use SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" View with or without rules, use instead ","type":"text"},{"code":"MISOTabView","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you target apps with Liquid Glass enabled and need ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" or rules, use instead ","type":"text"},{"type":"codeVoice","code":"MISOLiquidGlassTabView"},{"type":"text","text":"."}]},{"text":"Design documentation","level":2,"anchor":"Design-documentation","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","type":"reference"}],"type":"paragraph"},{"text":"Themes rendering","level":2,"anchor":"Themes-rendering","type":"heading"},{"text":"Liquid Glass","level":3,"anchor":"Liquid-Glass","type":"heading"},{"text":"BlueCoat","level":4,"anchor":"BlueCoat","type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark"}],"type":"paragraph"},{"text":"Without Liquid Glass","level":3,"anchor":"Without-Liquid-Glass","type":"heading"},{"text":"BlueCoat","level":4,"anchor":"BlueCoat","type":"heading"},{"inlineContent":[{"identifier":"component_tabBar_BlueCoat_light","type":"image"},{"type":"text","text":" "},{"identifier":"component_tabBar_BlueCoat_dark","type":"image"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}]}],"name":"Version","type":"aside"},{"style":"note","content":[{"inlineContent":[{"text":"OUDS 1.0.0","type":"text"}],"type":"paragraph"}],"name":"Since","type":"aside"}]}],"sections":[],"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar"},"variants":[{"paths":["\/documentation\/misocomponents\/misotabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Structure","role":"symbol","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"}],"externalID":"s:14MISOComponents10MISOTabBarV","title":"MISOTabBar","navigatorTitle":[{"text":"MISOTabBar","kind":"identifier"}],"modules":[{"name":"Components"}],"platforms":[{"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"15.0","beta":false},{"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"13.0","beta":false},{"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0","beta":false}]},"kind":"symbol","references":{"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"type":"topic","title":"Components"},"component_tabBar_BlueCoat_light":{"alt":"A  tab bar component in light mode without Liquid Glass effect and BlueCoat theme","identifier":"component_tabBar_BlueCoat_light","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_light.png"}]},"component_tabBar_BlueCoat_dark":{"variants":[{"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_BlueCoat_dark","alt":"A  tab bar component in dark mode without Liquid Glass effect and BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(content:)":{"title":"init(content:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","role":"symbol","url":"\/documentation\/misocomponents\/misotabbar\/init(content:)","abstract":[{"text":"Defines the tab bar component with given tab bar items.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS lower than 26, prefer instead ","type":"text"},{"type":"codeVoice","code":"MISOTabBar(selectedTab:count:content:)"}]},"doc://MISOComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s8SendableP","title":"Swift.Sendable"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"type":"text","text":" displays only a colored pastille."}],"type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOBadgeStandard"}],"url":"\/documentation\/misocomponents\/misobadgestandard","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOBadgeStandard"}],"title":"MISOBadgeStandard"},"component_tabBar_LiquidGlass_BlueCoat_dark":{"alt":"A  tab bar component in dark mode with Liquid Glass effect and BlueCoat theme","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_dark.png","traits":["1x","light"]}],"identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","type":"image"},"component_tabBar_LiquidGlass_BlueCoat_light":{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_light","alt":"A  tab bar component in light mode with Liquid Glass effect and BlueCoat theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_light.png"}]},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/body":{"abstract":[{"text":"Uses a native SwiftUI ","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":" populated with the given content where ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"tab item","type":"text"}]},{"text":" elements are defined.","type":"text"},{"text":" ","type":"text"},{"text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts.","type":"text"}],"url":"\/documentation\/misocomponents\/misotabbar\/body","title":"body","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body","kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}]},"doc://MISOComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar":{"role":"symbol","type":"topic","url":"\/documentation\/misocomponents\/misotabbar","kind":"symbol","title":"MISOTabBar","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTabBar"}],"navigatorTitle":[{"text":"MISOTabBar","kind":"identifier"}],"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"text":" ","type":"text"},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar"},"ic_folder_categories.png":{"alt":null,"identifier":"ic_folder_categories.png","type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://MISOComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View","type":"unresolvable"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(selectedTab:count:content:)":{"title":"init(selectedTab:count:content:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"selectedTab"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"count"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s5UInt8V","kind":"typeIdentifier","text":"UInt8"},{"kind":"text","text":", "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":")"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)","role":"symbol","url":"\/documentation\/misocomponents\/misotabbar\/init(selectedtab:count:content:)","abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items and a two-way binding to the selected tab index."},{"type":"text","text":" "},{"type":"text","text":"Number of tabs and selected tab are needed to compute the selected tab indicator for iOS lower than 26."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS 26+ or other platform, prefer instead "},{"code":"MISOTabBar(content:)","type":"codeVoice"},{"type":"text","text":"."}]},"https://r.orange.fr/r/S-miso-doc-ios-tab-bar":{"title":"unified-design-system.orange.com","type":"link","identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","titleInlineContent":[{"text":"unified-design-system.orange.com","type":"text"}],"url":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar"},"doc://MISOComponents/documentation/MISOComponents/Navigations":{"url":"\/documentation\/misocomponents\/navigations","title":"Navigations","role":"article","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations","kind":"article","abstract":[{"text":"Some components can be used for ","type":"text"},{"inlineContent":[{"text":"navigation","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/View-Implementations":{"abstract":[],"url":"\/documentation\/misocomponents\/misotabbar\/view-implementations","title":"View Implementations","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","kind":"article","type":"topic","role":"collectionGroup"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeCount":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOBadgeCount"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misobadgecount","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"text":" ","type":"text"},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","isActive":true,"type":"reference"},{"type":"text","text":" displays a text, as integer, limited to 99."}],"title":"MISOBadgeCount","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MISOBadgeCount"}]}}}