{"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"abstract":[{"text":"The Tab bar is a system navigation component with a position which can vary depending to the OS.","type":"text"},{"text":" ","type":"text"},{"text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to switch between the sections of an app.","type":"text"},{"text":" ","type":"text"},{"text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"variants":[{"paths":["\/documentation\/misocomponents\/misotabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"MISOTabBar","role":"symbol","modules":[{"name":"Components"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTabBar"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"MISOTabBar"}],"roleHeading":"Structure","platforms":[{"unavailable":false,"beta":false,"introducedAt":"15.0","name":"iOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"13.0","name":"macOS","deprecated":false},{"unavailable":false,"beta":false,"introducedAt":"1.0","name":"visionOS","deprecated":false}],"externalID":"s:14MISOComponents10MISOTabBarV"},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MISOTabBar","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"content":[{"type":"heading","text":"Appearances","level":2,"anchor":"Appearances"},{"inlineContent":[{"text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars.","type":"text"},{"text":" ","type":"text"},{"text":"Because today the MISO tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"background color of tab bar can be changed for iOS lower than 26","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"background color of tab bar does not change since iOS 26","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}]}]}]},{"inlineContent":[{"text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","isActive":true},{"type":"text","text":", the native API is used instead."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before."},{"type":"text","text":" "},{"type":"text","text":"However if an app is built with Xcode 26 and the flag "},{"type":"emphasis","inlineContent":[{"text":"UIDesignRequiresCompatibility","type":"text"}]},{"type":"text","text":" set to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"YES"}]},{"type":"text","text":", then Liquid Glass won’t be applied but the alternative layout."},{"type":"text","text":" "},{"type":"text","text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is."}]},{"type":"paragraph","inlineContent":[{"text":"If you use SF Symbols for images, if they exist their ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"fill","type":"text"}]},{"text":" variant will be automatically used in the tab bar (native behaviour).","type":"text"}]},{"anchor":"Platform-considerations","type":"heading","text":"Platform considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This component is tailored for iOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"On iPadOS the tabs do not apply the fonts since iPadOS 18","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified"}]}]},{"content":[{"inlineContent":[{"text":"The component is not available for watchOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The component is not available for tvOS","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Guidelines","type":"heading","text":"Guidelines","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"MISO guidelines recommends to:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"limit when possible the number of items to 5"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"use both images and texts in tab bar items"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"use badges only when needed to avoid to have heavy tab bar"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"if decorative images are used for tab bar item, apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"template"}]},{"type":"text","text":" rendering mode on it to apply color on tabs"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Accessibility-considerations","type":"heading","text":"Accessibility considerations","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"If your tabs embedded in the "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)","type":"text"},{"text":" ","type":"text"},{"text":"by using accessibiltiy value","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["    MISOTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""],"type":"codeListing"},{"anchor":"Selection-of-tabs","type":"heading","text":"Selection of tabs","level":2},{"inlineContent":[{"type":"text","text":"For iOS lower than 26, a selected tab indicator is displayed in the "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" ; the "},{"type":"codeVoice","code":"count"},{"type":"text","text":" parameter must be defined (to the number of tabs in the component),"},{"type":"text","text":" "},{"type":"text","text":"and if the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding value is equal to a given tag associated to a tab item."},{"type":"text","text":" "},{"type":"text","text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator."},{"type":"text","text":" "},{"type":"text","text":"This rule is only applied if selected tab indicator must be displayed."},{"type":"text","text":" "},{"type":"text","text":"When the user taps a tab, the "},{"type":"codeVoice","code":"selectedTab"},{"type":"text","text":" binding is updated automatically, keeping the parent view in sync."}],"type":"paragraph"},{"anchor":"Technical-considerations","type":"heading","text":"Technical considerations","level":2},{"inlineContent":[{"type":"text","text":"In order to improve the Developer eXperience the current "},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" implementation lets users define their own tab items."},{"type":"text","text":" "},{"type":"text","text":"MISO applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a "},{"inlineContent":[{"text":"picker","type":"text"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Thus users will need to add their own accessiiblity label if badges are used or also apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"template"}]},{"type":"text","text":" rendering mode on images if needed."},{"type":"text","text":" "},{"type":"text","text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"You must use in your tab bar items images with ","type":"text"},{"inlineContent":[{"text":"a size of 26 x 26","type":"text"}],"type":"strong"},{"text":", otherwise rendering could be unaligned with Figma specifications","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,"},{"type":"text","text":" "},{"type":"text","text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS."}]},{"type":"paragraph","inlineContent":[{"text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer ","type":"text"},{"code":"hideTabBar()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" to hide the tab bar","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" and overlay items) with Liquid Glass is disabled or not available, or also ","type":"text"},{"code":"tabBar(isHidden:)","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Code samples","type":"heading","level":2,"anchor":"Code-samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Use the MISO tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    MISOTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside MISOTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"]},{"text":"Alternative components","type":"heading","level":2,"anchor":"Alternative-components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to use SwiftUI "},{"code":"Tab","type":"codeVoice"},{"type":"text","text":" View with or without rules, use instead "},{"type":"codeVoice","code":"MISOTabView"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you target apps with Liquid Glass enabled and need "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" or rules, use instead "},{"type":"codeVoice","code":"MISOLiquidGlassTabView"},{"type":"text","text":"."}]},{"text":"Design documentation","type":"heading","anchor":"Design-documentation","level":2},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","isActive":true,"type":"reference"}],"type":"paragraph"},{"text":"Themes rendering","type":"heading","anchor":"Themes-rendering","level":2},{"text":"Liquid Glass","type":"heading","anchor":"Liquid-Glass","level":3},{"text":"BlueCoat","type":"heading","anchor":"BlueCoat","level":4},{"inlineContent":[{"identifier":"component_tabBar_LiquidGlass_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","type":"image"}],"type":"paragraph"},{"text":"Without Liquid Glass","type":"heading","anchor":"Without-Liquid-Glass","level":3},{"text":"BlueCoat","type":"heading","anchor":"BlueCoat","level":4},{"inlineContent":[{"identifier":"component_tabBar_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_BlueCoat_dark","type":"image"}],"type":"paragraph"},{"name":"Version","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.0.0 (Figma component design version)"}]}]},{"name":"Since","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 1.0.0","type":"text"}]}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","references":{"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(selectedTab:count:content:)":{"url":"\/documentation\/misocomponents\/misotabbar\/init(selectedtab:count:content:)","role":"symbol","abstract":[{"text":"Defines the tab bar component with given tab bar items and a two-way binding to the selected tab index.","type":"text"},{"text":" ","type":"text"},{"text":"Number of tabs and selected tab are needed to compute the selected tab indicator for iOS lower than 26.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS 26+ or other platform, prefer instead ","type":"text"},{"code":"MISOTabBar(content:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"selectedTab","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s5UInt8V","text":"UInt8","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(selectedTab:count:content:)","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)"},"ic_folder_categories.png":{"alt":null,"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","identifier":"ic_folder_categories.png"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/body":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body","abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" populated with the given content where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"tab item"}]},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"body"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"url":"\/documentation\/misocomponents\/misotabbar\/body","type":"topic","role":"symbol","title":"body"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(content:)":{"abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS lower than 26, prefer instead "},{"type":"codeVoice","code":"MISOTabBar(selectedTab:count:content:)"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","kind":"symbol","title":"init(content:)","role":"symbol","url":"\/documentation\/misocomponents\/misotabbar\/init(content:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":")"}]},"doc://MISOComponents/documentation/MISOComponents/Navigations":{"type":"topic","url":"\/documentation\/misocomponents\/navigations","kind":"article","role":"article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations","abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"text":"navigation","type":"text"}]},{"text":".","type":"text"}],"title":"Navigations"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","kind":"symbol","title":"MISOBadgeStandard","role":"symbol","navigatorTitle":[{"text":"MISOBadgeStandard","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misobadgestandard","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeStandard","kind":"identifier"}]},"doc://MISOComponents/s8SendableP":{"identifier":"doc:\/\/MISOComponents\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar":{"navigatorTitle":[{"kind":"identifier","text":"MISOTabBar"}],"url":"\/documentation\/misocomponents\/misotabbar","role":"symbol","abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"text":"It allows users to switch between the sections of an app.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTabBar"}],"title":"MISOTabBar","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar"},"doc://MISOComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"https://r.orange.fr/r/S-miso-doc-ios-tab-bar":{"identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"url":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","title":"unified-design-system.orange.com","type":"link"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/View-Implementations":{"abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","kind":"article","title":"View Implementations","role":"collectionGroup","url":"\/documentation\/misocomponents\/misotabbar\/view-implementations","type":"topic"},"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","url":"\/documentation\/misocomponents","type":"topic","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"title":"Components"},"component_tabBar_BlueCoat_light":{"identifier":"component_tabBar_BlueCoat_light","type":"image","alt":"A  tab bar component in light mode without Liquid Glass effect and BlueCoat theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_light.png"}]},"component_tabBar_BlueCoat_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and BlueCoat theme","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_dark.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_BlueCoat_dark"},"component_tabBar_LiquidGlass_BlueCoat_light":{"identifier":"component_tabBar_LiquidGlass_BlueCoat_light","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_light.png","traits":["1x","light"]}],"alt":"A  tab bar component in light mode with Liquid Glass effect and BlueCoat theme","type":"image"},"component_tabBar_LiquidGlass_BlueCoat_dark":{"identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","type":"image","alt":"A  tab bar component in dark mode with Liquid Glass effect and BlueCoat theme","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_dark.png"}]},"doc://MISOComponents/7SwiftUI4ViewP":{"title":"SwiftUICore.View","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeCount":{"navigatorTitle":[{"kind":"identifier","text":"MISOBadgeCount"}],"title":"MISOBadgeCount","type":"topic","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"type":"text","text":" "},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount"},{"text":" displays a text, as integer, limited to 99.","type":"text"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misobadgecount","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOBadgeCount"}],"role":"symbol"}}}