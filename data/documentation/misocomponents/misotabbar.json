{"metadata":{"navigatorTitle":[{"text":"MISOTabBar","kind":"identifier"}],"role":"symbol","platforms":[{"introducedAt":"15.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"13.0","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"1.0","name":"visionOS","unavailable":false,"beta":false,"deprecated":false}],"modules":[{"name":"Components"}],"title":"MISOTabBar","externalID":"s:14MISOComponents10MISOTabBarV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure"},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"kind":"relationships","title":"Conforms To"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","interfaceLanguage":"swift"},"abstract":[{"text":"The Tab bar is a system navigation component with a position which can vary depending to the OS.","type":"text"},{"text":" ","type":"text"},{"text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to switch between the sections of an app.","type":"text"},{"text":" ","type":"text"},{"text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations.","type":"text"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Appearances","text":"Appearances"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars."},{"type":"text","text":" "},{"type":"text","text":"Because today the MISO tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar can be changed for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"background color of tab bar does not change since iOS 26","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed","type":"text"},{"text":" ","type":"text"},{"text":"and not the text making theme not readable in dark color scheme","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","isActive":true,"type":"reference"},{"text":", the native API is used instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before."},{"type":"text","text":" "},{"type":"text","text":"However if an app is built with Xcode 26 and the flag "},{"type":"emphasis","inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}]},{"type":"text","text":" set to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"YES"}]},{"type":"text","text":", then Liquid Glass won’t be applied but the alternative layout."},{"type":"text","text":" "},{"type":"text","text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use SF Symbols for images, if they exist their "},{"inlineContent":[{"type":"text","text":"fill"}],"type":"emphasis"},{"type":"text","text":" variant will be automatically used in the tab bar (native behaviour)."}]},{"type":"heading","text":"Platform considerations","anchor":"Platform-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"This component is tailored for iOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On iPadOS the tabs do not apply the fonts since iPadOS 18","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for watchOS"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is not available for tvOS","type":"text"}]}]}]},{"type":"heading","text":"Guidelines","anchor":"Guidelines","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"MISO guidelines recommends to:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"limit when possible the number of items to 5"}]}]},{"content":[{"inlineContent":[{"text":"use both images and texts in tab bar items","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"use badges only when needed to avoid to have heavy tab bar"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if decorative images are used for tab bar item, apply ","type":"text"},{"inlineContent":[{"text":"template","type":"text"}],"type":"emphasis"},{"text":" rendering mode on it to apply color on tabs","type":"text"}]}]}]},{"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If your tabs embedded in the "},{"type":"codeVoice","code":"MISOTabBar"},{"text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)","type":"text"},{"text":" ","type":"text"},{"text":"by using accessibiltiy value","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","code":["    MISOTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""],"type":"codeListing"},{"level":2,"anchor":"Selection-of-tabs","text":"Selection of tabs","type":"heading"},{"inlineContent":[{"text":"For iOS lower than 26, a selected tab indicator is displayed in the ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"text":" ; the ","type":"text"},{"type":"codeVoice","code":"count"},{"text":" parameter must be defined (to the number of tabs in the component),","type":"text"},{"text":" ","type":"text"},{"text":"and if the ","type":"text"},{"type":"codeVoice","code":"selectedTab"},{"text":" binding value is equal to a given tag associated to a tab item.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator.","type":"text"},{"text":" ","type":"text"},{"text":"This rule is only applied if selected tab indicator must be displayed.","type":"text"},{"text":" ","type":"text"},{"text":"When the user taps a tab, the ","type":"text"},{"type":"codeVoice","code":"selectedTab"},{"text":" binding is updated automatically, keeping the parent view in sync.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Technical-considerations","text":"Technical considerations","type":"heading"},{"inlineContent":[{"text":"In order to improve the Developer eXperience the current ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"text":" implementation lets users define their own tab items.","type":"text"},{"text":" ","type":"text"},{"text":"MISO applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"picker"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Thus users will need to add their own accessiiblity label if badges are used or also apply ","type":"text"},{"inlineContent":[{"type":"text","text":"template"}],"type":"emphasis"},{"type":"text","text":" rendering mode on images if needed."},{"type":"text","text":" "},{"type":"text","text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must use in your tab bar items images with "},{"type":"strong","inlineContent":[{"type":"text","text":"a size of 26 x 26"}]},{"type":"text","text":", otherwise rendering could be unaligned with Figma specifications"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,"},{"type":"text","text":" "},{"type":"text","text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS."}]},{"type":"paragraph","inlineContent":[{"text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer ","type":"text"},{"code":"hideTabBar()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" to hide the tab bar","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" and overlay items) with Liquid Glass is disabled or not available, or also ","type":"text"},{"code":"tabBar(isHidden:)","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"type":"heading","anchor":"Code-samples","text":"Code samples"},{"code":["    \/\/ Use the MISO tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    MISOTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside MISOTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Alternative-components","text":"Alternative components"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to use SwiftUI "},{"type":"codeVoice","code":"Tab"},{"type":"text","text":" View with or without rules, use instead "},{"type":"codeVoice","code":"MISOTabView"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"If you target apps with Liquid Glass enabled and need ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" or rules, use instead ","type":"text"},{"code":"MISOLiquidGlassTabView","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Design documentation","anchor":"Design-documentation","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar"}],"type":"paragraph"},{"type":"heading","text":"Themes rendering","anchor":"Themes-rendering","level":2},{"type":"heading","text":"Liquid Glass","anchor":"Liquid-Glass","level":3},{"type":"heading","text":"BlueCoat","anchor":"BlueCoat","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark"}],"type":"paragraph"},{"type":"heading","text":"Without Liquid Glass","anchor":"Without-Liquid-Glass","level":3},{"type":"heading","text":"BlueCoat","anchor":"BlueCoat","level":4},{"inlineContent":[{"type":"image","identifier":"component_tabBar_BlueCoat_light"},{"text":" ","type":"text"},{"type":"image","identifier":"component_tabBar_BlueCoat_dark"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Version","content":[{"inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 1.0.0","type":"text"}]}]}]}],"variants":[{"paths":["\/documentation\/misocomponents\/misotabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"references":{"component_tabBar_BlueCoat_light":{"alt":"A  tab bar component in light mode without Liquid Glass effect and BlueCoat theme","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_light.png","traits":["1x","light"]}],"type":"image","identifier":"component_tabBar_BlueCoat_light"},"component_tabBar_LiquidGlass_BlueCoat_light":{"identifier":"component_tabBar_LiquidGlass_BlueCoat_light","type":"image","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_light.png","traits":["1x","light"]}],"alt":"A  tab bar component in light mode with Liquid Glass effect and BlueCoat theme"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"type":"image","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/body":{"title":"body","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"url":"\/documentation\/misocomponents\/misotabbar\/body","kind":"symbol","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body","abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" populated with the given content where "},{"type":"emphasis","inlineContent":[{"text":"tab item","type":"text"}]},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}]},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeCount":{"navigatorTitle":[{"text":"MISOBadgeCount","kind":"identifier"}],"abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","isActive":true},{"type":"text","text":" displays a text, as integer, limited to 99."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeCount","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","role":"symbol","url":"\/documentation\/misocomponents\/misobadgecount","title":"MISOBadgeCount"},"doc://MISOComponents/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s8SendableP"},"doc://MISOComponents/7SwiftUI4ViewP":{"type":"unresolvable","title":"SwiftUICore.View","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(content:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"kind":"typeIdentifier","text":"Content"},{"text":")","kind":"text"}],"url":"\/documentation\/misocomponents\/misotabbar\/init(content:)","title":"init(content:)","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","abstract":[{"text":"Defines the tab bar component with given tab bar items.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS lower than 26, prefer instead ","type":"text"},{"type":"codeVoice","code":"MISOTabBar(selectedTab:count:content:)"}],"role":"symbol","type":"topic"},"doc://MISOComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP"},"https://r.orange.fr/r/S-miso-doc-ios-tab-bar":{"type":"link","url":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","title":"unified-design-system.orange.com","identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","titleInlineContent":[{"text":"unified-design-system.orange.com","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"url":"\/documentation\/misocomponents","kind":"symbol","title":"Components","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views. These are inherited from OUDS."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"url":"\/documentation\/misocomponents\/misobadgestandard","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeStandard","kind":"identifier"}],"navigatorTitle":[{"text":"MISOBadgeStandard","kind":"identifier"}],"title":"MISOBadgeStandard","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/View-Implementations":{"title":"View Implementations","type":"topic","url":"\/documentation\/misocomponents\/misotabbar\/view-implementations","abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","kind":"article","role":"collectionGroup"},"component_tabBar_BlueCoat_dark":{"alt":"A  tab bar component in dark mode without Liquid Glass effect and BlueCoat theme","type":"image","identifier":"component_tabBar_BlueCoat_dark","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_dark.png"}]},"doc://MISOComponents/documentation/MISOComponents/Navigations":{"title":"Navigations","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations","type":"topic","kind":"article","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":". These are inherited from OUDS."}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","url":"\/documentation\/misocomponents\/navigations"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTabBar"}],"url":"\/documentation\/misocomponents\/misotabbar","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","role":"symbol","title":"MISOTabBar","abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"navigatorTitle":[{"kind":"identifier","text":"MISOTabBar"}]},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(selectedTab:count:content:)":{"kind":"symbol","title":"init(selectedTab:count:content:)","role":"symbol","type":"topic","url":"\/documentation\/misocomponents\/misotabbar\/init(selectedtab:count:content:)","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"selectedTab","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, ","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt8","kind":"typeIdentifier","preciseIdentifier":"s:s5UInt8V"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"Defines the tab bar component with given tab bar items and a two-way binding to the selected tab index.","type":"text"},{"text":" ","type":"text"},{"text":"Number of tabs and selected tab are needed to compute the selected tab indicator for iOS lower than 26.","type":"text"},{"text":" ","type":"text"},{"text":"If you target iOS 26+ or other platform, prefer instead ","type":"text"},{"code":"MISOTabBar(content:)","type":"codeVoice"},{"text":".","type":"text"}]},"component_tabBar_LiquidGlass_BlueCoat_dark":{"type":"image","alt":"A  tab bar component in dark mode with Liquid Glass effect and BlueCoat theme","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_dark.png","traits":["1x","light"]}]}}}