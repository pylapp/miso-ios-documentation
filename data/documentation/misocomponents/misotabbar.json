{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/misocomponents\/misotabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"title":"MISOTabBar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"}],"navigatorTitle":[{"text":"MISOTabBar","kind":"identifier"}],"symbolKind":"struct","roleHeading":"Structure","modules":[{"name":"Components"}],"role":"symbol","externalID":"s:14MISOComponents10MISOTabBarV","platforms":[{"beta":false,"unavailable":false,"name":"iOS","introducedAt":"15.0","deprecated":false},{"beta":false,"unavailable":false,"name":"macOS","introducedAt":"13.0","deprecated":false},{"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0","deprecated":false}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar"},"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"]},{"kind":"content","content":[{"type":"heading","text":"Appearances","anchor":"Appearances","level":2},{"type":"paragraph","inlineContent":[{"text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars.","type":"text"},{"text":" ","type":"text"},{"text":"Because today the MISO tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar can be changed for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar does not change since iOS 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"reference"},{"text":", the native API is used instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before.","type":"text"},{"text":" ","type":"text"},{"text":"However if an app is built with Xcode 26 and the flag ","type":"text"},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" set to ","type":"text"},{"inlineContent":[{"type":"text","text":"YES"}],"type":"emphasis"},{"text":", then Liquid Glass won’t be applied but the alternative layout.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you use SF Symbols for images, if they exist their "},{"type":"emphasis","inlineContent":[{"text":"fill","type":"text"}]},{"type":"text","text":" variant will be automatically used in the tab bar (native behaviour)."}]},{"level":2,"type":"heading","text":"Platform considerations","anchor":"Platform-considerations"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"This component is tailored for iOS","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On iPadOS the tabs do not apply the fonts since iPadOS 18","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The component is not available for watchOS","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The component is not available for tvOS"}]}]}]},{"level":2,"type":"heading","text":"Guidelines","anchor":"Guidelines"},{"type":"paragraph","inlineContent":[{"type":"text","text":"MISO guidelines recommends to:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"limit when possible the number of items to 5"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"use both images and texts in tab bar items"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"use badges only when needed to avoid to have heavy tab bar"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if decorative images are used for tab bar item, apply ","type":"text"},{"inlineContent":[{"text":"template","type":"text"}],"type":"emphasis"},{"text":" rendering mode on it to apply color on tabs","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Accessibility-considerations","text":"Accessibility considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)","type":"text"},{"text":" ","type":"text"},{"text":"by using accessibiltiy value","type":"text"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["    MISOTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""]},{"type":"heading","level":2,"anchor":"Selection-of-tabs","text":"Selection of tabs"},{"type":"paragraph","inlineContent":[{"text":"For iOS lower than 26, a selected tab indicator is displayed in the ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" ; the ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" parameter must be defined (to the number of tabs in the component),","type":"text"},{"text":" ","type":"text"},{"text":"and if the ","type":"text"},{"code":"selectedTab","type":"codeVoice"},{"text":" binding value is equal to a given tag associated to a tab item.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator.","type":"text"},{"text":" ","type":"text"},{"text":"This rule is only applied if selected tab indicator must be displayed.","type":"text"},{"text":" ","type":"text"},{"text":"When the user taps a tab, the ","type":"text"},{"code":"selectedTab","type":"codeVoice"},{"text":" binding is updated automatically, keeping the parent view in sync.","type":"text"}]},{"type":"heading","level":2,"anchor":"Technical-considerations","text":"Technical considerations"},{"type":"paragraph","inlineContent":[{"text":"In order to improve the Developer eXperience the current ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" implementation lets users define their own tab items.","type":"text"},{"text":" ","type":"text"},{"text":"MISO applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a ","type":"text"},{"inlineContent":[{"type":"text","text":"picker"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Thus users will need to add their own accessiiblity label if badges are used or also apply ","type":"text"},{"inlineContent":[{"type":"text","text":"template"}],"type":"emphasis"},{"text":" rendering mode on images if needed.","type":"text"},{"text":" ","type":"text"},{"text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You must use in your tab bar items images with ","type":"text"},{"inlineContent":[{"type":"text","text":"a size of 26 x 26"}],"type":"strong"},{"text":", otherwise rendering could be unaligned with Figma specifications","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,","type":"text"},{"text":" ","type":"text"},{"text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer ","type":"text"},{"code":"hideTabBar()","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" to hide the tab bar","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" and overlay items) with Liquid Glass is disabled or not available, or also ","type":"text"},{"code":"tabBar(isHidden:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Code-samples","text":"Code samples"},{"syntax":"swift","type":"codeListing","code":["    \/\/ Use the MISO tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    MISOTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside MISOTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"]},{"type":"heading","level":2,"anchor":"Alternative-components","text":"Alternative components"},{"type":"paragraph","inlineContent":[{"text":"If you want to use SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" View with or without rules, use instead ","type":"text"},{"code":"MISOTabView","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If you target apps with Liquid Glass enabled and need ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" or rules, use instead ","type":"text"},{"code":"MISOLiquidGlassTabView","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Design-documentation","text":"Design documentation"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","type":"reference"}]},{"type":"heading","level":2,"anchor":"Themes-rendering","text":"Themes rendering"},{"type":"heading","level":3,"anchor":"Liquid-Glass","text":"Liquid Glass"},{"type":"heading","level":4,"anchor":"BlueCoat","text":"BlueCoat"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_LiquidGlass_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","type":"image"}]},{"type":"heading","level":3,"anchor":"Without-Liquid-Glass","text":"Without Liquid Glass"},{"type":"heading","level":4,"anchor":"BlueCoat","text":"BlueCoat"},{"type":"paragraph","inlineContent":[{"identifier":"component_tabBar_BlueCoat_light","type":"image"},{"text":" ","type":"text"},{"identifier":"component_tabBar_BlueCoat_dark","type":"image"}]},{"type":"aside","style":"note","name":"Version","content":[{"inlineContent":[{"type":"text","text":"1.0.0 (Figma component design version)"}],"type":"paragraph"}]},{"type":"aside","style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"OUDS 1.0.0"}],"type":"paragraph"}]}]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo","kind":"relationships"}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/View-Implementations":{"kind":"article","url":"\/documentation\/misocomponents\/misotabbar\/view-implementations","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","type":"topic","abstract":[],"role":"collectionGroup","title":"View Implementations"},"component_tabBar_LiquidGlass_BlueCoat_dark":{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_dark.png"}],"alt":"A  tab bar component in dark mode with Liquid Glass effect and BlueCoat theme"},"https://r.orange.fr/r/S-miso-doc-ios-tab-bar":{"type":"link","title":"unified-design-system.orange.com","url":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}]},"doc://MISOComponents/documentation/MISOComponents/Navigations":{"images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"role":"article","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations","title":"Navigations","type":"topic","url":"\/documentation\/misocomponents\/navigations","kind":"article","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"navigation","type":"text"}]},{"type":"text","text":"."}]},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"MISOBadgeStandard","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeStandard","kind":"identifier"}],"title":"MISOBadgeStandard","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard"},{"text":" displays only a colored pastille.","type":"text"}],"url":"\/documentation\/misocomponents\/misobadgestandard"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","title":"MISOTabBar","type":"topic","navigatorTitle":[{"kind":"identifier","text":"MISOTabBar"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misotabbar","abstract":[{"text":"The Tab bar is a system navigation component with a position which can vary depending to the OS.","type":"text"},{"text":" ","type":"text"},{"text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS.","type":"text"},{"text":" ","type":"text"},{"text":"It allows users to switch between the sections of an app.","type":"text"},{"text":" ","type":"text"},{"text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTabBar"}]},"doc://MISOComponents/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP"},"doc://MISOComponents/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/MISOComponents\/s8SendableP"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/body":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body","title":"body","type":"topic","url":"\/documentation\/misocomponents\/misotabbar\/body","kind":"symbol","abstract":[{"type":"text","text":"Uses a native SwiftUI "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" populated with the given content where "},{"type":"emphasis","inlineContent":[{"text":"tab item","type":"text"}]},{"type":"text","text":" elements are defined."},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}]},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","title":"Components","type":"topic","kind":"symbol","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}]},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeCount":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","title":"MISOBadgeCount","type":"topic","navigatorTitle":[{"text":"MISOBadgeCount","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/misocomponents\/misobadgecount","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"reference"},{"text":" displays a text, as integer, limited to 99.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOBadgeCount","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(selectedTab:count:content:)":{"url":"\/documentation\/misocomponents\/misotabbar\/init(selectedtab:count:content:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"selectedTab"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"count"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s5UInt8V","kind":"typeIdentifier","text":"UInt8"},{"kind":"text","text":", "},{"kind":"externalParam","text":"content"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items and a two-way binding to the selected tab index."},{"text":" ","type":"text"},{"type":"text","text":"Number of tabs and selected tab are needed to compute the selected tab indicator for iOS lower than 26."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS 26+ or other platform, prefer instead "},{"type":"codeVoice","code":"MISOTabBar(content:)"},{"type":"text","text":"."}],"role":"symbol","type":"topic","title":"init(selectedTab:count:content:)","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)"},"component_tabBar_BlueCoat_dark":{"type":"image","identifier":"component_tabBar_BlueCoat_dark","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_dark.png"}],"alt":"A  tab bar component in dark mode without Liquid Glass effect and BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(content:)":{"role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","title":"init(content:)","type":"topic","url":"\/documentation\/misocomponents\/misotabbar\/init(content:)","kind":"symbol","abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS lower than 26, prefer instead "},{"type":"codeVoice","code":"MISOTabBar(selectedTab:count:content:)"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://MISOComponents/7SwiftUI4ViewP":{"type":"unresolvable","title":"SwiftUICore.View","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP"},"component_tabBar_BlueCoat_light":{"type":"image","identifier":"component_tabBar_BlueCoat_light","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_light.png"}],"alt":"A  tab bar component in light mode without Liquid Glass effect and BlueCoat theme"},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"alt":null},"component_tabBar_LiquidGlass_BlueCoat_light":{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_light","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_light.png"}],"alt":"A  tab bar component in light mode with Liquid Glass effect and BlueCoat theme"}}}