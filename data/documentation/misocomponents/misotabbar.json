{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"variants":[{"paths":["\/documentation\/misocomponents\/misotabbar"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar"},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"}],"navigatorTitle":[{"text":"MISOTabBar","kind":"identifier"}],"role":"symbol","roleHeading":"Structure","platforms":[{"name":"iOS","introducedAt":"15.0","unavailable":false,"deprecated":false,"beta":false},{"name":"macOS","introducedAt":"13.0","unavailable":false,"deprecated":false,"beta":false},{"name":"visionOS","introducedAt":"1.0","unavailable":false,"deprecated":false,"beta":false}],"modules":[{"name":"Components"}],"symbolKind":"struct","title":"MISOTabBar","externalID":"s:14MISOComponents10MISOTabBarV"},"kind":"symbol","relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOTabBar"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"],"kind":"mentions"},{"content":[{"text":"Appearances","type":"heading","anchor":"Appearances","level":2},{"type":"paragraph","inlineContent":[{"text":"iOS 26 brings Liquid Glass, the new Apple look and feel which will prevent developers to define specific styles for some critical components like bars.","type":"text"},{"text":" ","type":"text"},{"text":"Because today the MISO tab bar relies on native component and is not designed from scratch, some elements will look different between iOS 26 and older versions:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar can be changed for iOS lower than 26"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"background color of tab bar does not change since iOS 26"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"normal \/ unselected tab item color can be changed for both image and text only for iOS lower than 26"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"with iOS 26 no token of color are applied on unselected \/ normal tab item because only the image will be changed"},{"type":"text","text":" "},{"type":"text","text":"and not the text making theme not readable in dark color scheme"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In addition the badges colors will be the same and cannot be changed (except with token definition). These particular badges do not rely on "},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","isActive":true},{"text":", the native API is used instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because Liquid Glass is available since iOS 26, the tab bar will be liquified \/ glassified since this OS version, not before."},{"type":"text","text":" "},{"type":"text","text":"However if an app is built with Xcode 26 and the flag "},{"inlineContent":[{"type":"text","text":"UIDesignRequiresCompatibility"}],"type":"emphasis"},{"text":" set to ","type":"text"},{"inlineContent":[{"type":"text","text":"YES"}],"type":"emphasis"},{"type":"text","text":", then Liquid Glass won’t be applied but the alternative layout."},{"type":"text","text":" "},{"type":"text","text":"Nevertheless with Xcode 27 and for iOS 27, Liquid Glass will be always applied, whatever the value of the flag is."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If you use SF Symbols for images, if they exist their ","type":"text"},{"inlineContent":[{"type":"text","text":"fill"}],"type":"emphasis"},{"text":" variant will be automatically used in the tab bar (native behaviour).","type":"text"}]},{"text":"Platform considerations","level":2,"anchor":"Platform-considerations","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"This component is tailored for iOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"On iPadOS the tabs do not apply the fonts since iPadOS 18"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Because macOS does not support UIKit and because UIKIt is used to define the style of the tab bar, there is no styling of the tab bar for macOS"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"visionOS with its specific UI does not apply colors on tab bars and things are glasssified"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The component is not available for watchOS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The component is not available for tvOS","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Guidelines","anchor":"Guidelines","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"MISO guidelines recommends to:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"limit when possible the number of items to 5","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"use both images and texts in tab bar items"}]}]},{"content":[{"inlineContent":[{"text":"use badges only when needed to avoid to have heavy tab bar","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"be sure the selected information is not only defined by the color of the tab; you may need to change the shape or the fill of the image"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if a badge must be displayed, prefer short texts. If the text is a decimal value greater than 99, prefer display “+99”"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"if decorative images are used for tab bar item, apply "},{"type":"emphasis","inlineContent":[{"type":"text","text":"template"}]},{"type":"text","text":" rendering mode on it to apply color on tabs"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"If your tabs embedded in the ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" do not contain texts but only images, add an accessibility label introducing the journey for this tab"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If your tabs embedded in the "},{"type":"codeVoice","code":"MISOTabBar"},{"text":" display a badge (empty or with text), vocalize it in your tab to let users know what it is (unread messages, new things, etc)","type":"text"},{"type":"text","text":" "},{"type":"text","text":"by using accessibiltiy value"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["    MISOTabBar {","        SomeView()","            .tabItem {","                Label {","                    Text(\"Emails\") \/\/ The text is vocalized first","                        .accessibilityValue(\"5 unread emails\") \/\/ A value vocalized after the text","            } icon: {","                Image(systemName: \"mail\").accessibilityHidden(true)","            }","        }","        .badge(5) \/\/ The value you give to the badge","    }",""],"type":"codeListing"},{"anchor":"Selection-of-tabs","text":"Selection of tabs","type":"heading","level":2},{"inlineContent":[{"text":"For iOS lower than 26, a selected tab indicator is displayed in the ","type":"text"},{"type":"codeVoice","code":"MISOTabBar"},{"type":"text","text":" ; the "},{"type":"codeVoice","code":"count"},{"text":" parameter must be defined (to the number of tabs in the component),","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and if the "},{"type":"codeVoice","code":"selectedTab"},{"text":" binding value is equal to a given tag associated to a tab item.","type":"text"},{"text":" ","type":"text"},{"text":"Otherwise the indicator won’t appear; these parameters are mandatory to compute the location of the indicator.","type":"text"},{"text":" ","type":"text"},{"text":"This rule is only applied if selected tab indicator must be displayed.","type":"text"},{"text":" ","type":"text"},{"text":"When the user taps a tab, the ","type":"text"},{"code":"selectedTab","type":"codeVoice"},{"text":" binding is updated automatically, keeping the parent view in sync.","type":"text"}],"type":"paragraph"},{"text":"Technical considerations","level":2,"anchor":"Technical-considerations","type":"heading"},{"inlineContent":[{"text":"In order to improve the Developer eXperience the current ","type":"text"},{"code":"MISOTabBar","type":"codeVoice"},{"text":" implementation lets users define their own tab items.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"MISO applies only appearances and styles on elements to prevent users to define raw data to assign to the component before being rendered like a "},{"inlineContent":[{"type":"text","text":"picker"}],"type":"emphasis"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"Thus users will need to add their own accessiiblity label if badges are used or also apply ","type":"text"},{"inlineContent":[{"text":"template","type":"text"}],"type":"emphasis"},{"text":" rendering mode on images if needed.","type":"text"},{"text":" ","type":"text"},{"text":"Thus it will be also possible to use Liquid Glass new API with animations and items stacking.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You must use in your tab bar items images with ","type":"text"},{"inlineContent":[{"text":"a size of 26 x 26","type":"text"}],"type":"strong"},{"text":", otherwise rendering could be unaligned with Figma specifications","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because the component cannot compute the ideal width of the selected tab indicator (for iOS before 26 and iPadOS before 18), ideal width based on the tab bar item content,","type":"text"},{"type":"text","text":" "},{"text":"this indicator is not displayed for iOS lower than 26 in landscape mode and iPadOS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If your app uses several universes with nested views, containing their own navigation and tab bars, prefer "},{"type":"codeVoice","code":"hideTabBar()"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" to hide the tab bar","type":"text"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"TabView"},{"type":"text","text":" and overlay items) with Liquid Glass is disabled or not available, or also "},{"type":"codeVoice","code":"tabBar(isHidden:)"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Code samples","type":"heading","anchor":"Code-samples"},{"code":["    \/\/ Use the MISO tab bar to wrap tab bar items and associated views","    \/\/ Item tagged 0 will be selected first, 3 tabs are embedded.","    \/\/ Image with size of 26 x 26","    @State private var selectedTab = 0","","    MISOTabBar(selectedTab: $selectedTab, count: 3) {","","        \/\/ Add the views with the SwiftUI tab item and labels","        \/\/ No need to define colors, everything is done inside MISOTabBar","        SomeView()","            .tabItem {","                Label(\"Label 1\", image: \"image_1\")","            }","            .tag(0) \/\/ Must match the selectedTab binding value","        OtherView()","            .tabItem {","                Label {","                    Text(\"Label 2\")","                } icon: {","                    Image(decorative: \"image_2\")","                        .renderingMode(.template) \/\/ Mandatory to apply color on selected item","                }","             }","            .tag(1) \/\/ Must be used for the selectedTab binding","        LastView()","            .tabItem {","                Label(\"Label 3\", image: \"image_3\")","            }","            .tag(2) \/\/ Must be used for the selectedTab binding","    }"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Alternative components","type":"heading","anchor":"Alternative-components"},{"inlineContent":[{"text":"If you want to use SwiftUI ","type":"text"},{"code":"Tab","type":"codeVoice"},{"text":" View with or without rules, use instead ","type":"text"},{"code":"MISOTabView","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If you target apps with Liquid Glass enabled and need "},{"code":"Tab","type":"codeVoice"},{"type":"text","text":" or rules, use instead "},{"code":"MISOLiquidGlassTabView","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Design documentation","type":"heading","anchor":"Design-documentation"},{"inlineContent":[{"identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","isActive":true,"type":"reference"}],"type":"paragraph"},{"text":"Themes rendering","anchor":"Themes-rendering","level":2,"type":"heading"},{"text":"Liquid Glass","anchor":"Liquid-Glass","level":3,"type":"heading"},{"text":"BlueCoat","anchor":"BlueCoat","level":4,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark"}],"type":"paragraph"},{"text":"Without Liquid Glass","anchor":"Without-Liquid-Glass","level":3,"type":"heading"},{"text":"BlueCoat","anchor":"BlueCoat","level":4,"type":"heading"},{"inlineContent":[{"type":"image","identifier":"component_tabBar_BlueCoat_light"},{"type":"text","text":" "},{"type":"image","identifier":"component_tabBar_BlueCoat_dark"}],"type":"paragraph"},{"name":"Version","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"1.0.0 (Figma component design version)","type":"text"}]}],"type":"aside"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"OUDS 1.0.0"}],"type":"paragraph"}],"type":"aside","name":"Since"}],"kind":"content"}],"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations"]}],"sections":[],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(selectedTab:count:content:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(selectedTab:count:content:)","url":"\/documentation\/misocomponents\/misotabbar\/init(selectedtab:count:content:)","title":"init(selectedTab:count:content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"selectedTab","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Binding","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":">, ","kind":"text"},{"text":"count","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"UInt8","kind":"typeIdentifier","preciseIdentifier":"s:s5UInt8V"},{"text":", ","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items and a two-way binding to the selected tab index."},{"type":"text","text":" "},{"type":"text","text":"Number of tabs and selected tab are needed to compute the selected tab indicator for iOS lower than 26."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS 26+ or other platform, prefer instead "},{"type":"codeVoice","code":"MISOTabBar(content:)"},{"type":"text","text":"."}],"type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeStandard":{"url":"\/documentation\/misocomponents\/misobadgestandard","abstract":[{"type":"text","text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only."},{"type":"text","text":" "},{"type":"text","text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","isActive":true},{"type":"text","text":" displays only a colored pastille."}],"role":"symbol","title":"MISOBadgeStandard","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeStandard","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOBadgeStandard"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"MISOBadgeStandard","kind":"identifier"}]},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"alt":null},"https://r.orange.fr/r/S-miso-doc-ios-tab-bar":{"type":"link","identifier":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar","title":"unified-design-system.orange.com","titleInlineContent":[{"type":"text","text":"unified-design-system.orange.com"}],"url":"https:\/\/r.orange.fr\/r\/S-miso-doc-ios-tab-bar"},"component_tabBar_LiquidGlass_BlueCoat_light":{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_light","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_light.png","traits":["1x","light"]}],"alt":"A  tab bar component in light mode with Liquid Glass effect and BlueCoat theme"},"doc://MISOComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s8SendableP","title":"Swift.Sendable"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/init(content:)":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/init(content:)","url":"\/documentation\/misocomponents\/misotabbar\/init(content:)","title":"init(content:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"content","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Defines the tab bar component with given tab bar items."},{"type":"text","text":" "},{"type":"text","text":"If you target iOS lower than 26, prefer instead "},{"type":"codeVoice","code":"MISOTabBar(selectedTab:count:content:)"}],"type":"topic"},"doc://MISOComponents/7SwiftUI4ViewP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View"},"component_tabBar_LiquidGlass_BlueCoat_dark":{"type":"image","identifier":"component_tabBar_LiquidGlass_BlueCoat_dark","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_LiquidGlass_BlueCoat_dark.png","traits":["1x","light"]}],"alt":"A  tab bar component in dark mode with Liquid Glass effect and BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents/Navigations":{"url":"\/documentation\/misocomponents\/navigations","abstract":[{"text":"Some components can be used for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"navigation"}]},{"text":".","type":"text"}],"role":"article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"title":"Navigations","type":"topic","kind":"article","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Navigations"},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","kind":"symbol","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","type":"topic","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"abstract":[{"text":"The catalog of all components provided by MISO. It contains also ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}]},"component_tabBar_BlueCoat_dark":{"type":"image","identifier":"component_tabBar_BlueCoat_dark","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_dark.png","traits":["1x","light"]}],"alt":"A  tab bar component in dark mode without Liquid Glass effect and BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/View-Implementations":{"abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/View-Implementations","role":"collectionGroup","url":"\/documentation\/misocomponents\/misotabbar\/view-implementations","kind":"article","type":"topic","title":"View Implementations"},"doc://MISOComponents/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"component_tabBar_BlueCoat_light":{"type":"image","identifier":"component_tabBar_BlueCoat_light","variants":[{"url":"\/images\/MISOComponents\/component_tabBar_BlueCoat_light.png","traits":["1x","light"]}],"alt":"A  tab bar component in light mode without Liquid Glass effect and BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents/MISOBadgeCount":{"url":"\/documentation\/misocomponents\/misobadgecount","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MISOBadgeCount"}],"kind":"symbol","navigatorTitle":[{"text":"MISOBadgeCount","kind":"identifier"}],"title":"MISOBadgeCount","abstract":[{"text":"Badge is a UI element that emphasizes system notifications, status, or the categorization of an information, throughout colour only.","type":"text"},{"text":" ","type":"text"},{"text":"Badge is rendered as a coloured shape, without icon, text or number; and its chosen size remains unchanged regardless of the changes of the interface size.","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOBadgeCount","isActive":true},{"text":" displays a text, as integer, limited to 99.","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar/body":{"title":"body","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"}],"type":"topic","url":"\/documentation\/misocomponents\/misotabbar\/body","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar\/body","abstract":[{"text":"Uses a native SwiftUI ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":" populated with the given content where ","type":"text"},{"inlineContent":[{"type":"text","text":"tab item"}],"type":"emphasis"},{"text":" elements are defined.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Rendering wil change depending to OS version, with a top divider and a selected tab indicator for legacy layouts."}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar":{"url":"\/documentation\/misocomponents\/misotabbar","abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"role":"symbol","title":"MISOTabBar","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","kind":"symbol","navigatorTitle":[{"text":"MISOTabBar","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"}]}}}