cM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOToolBarBottom","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"code":"toolBarBottom","type":"codeVoice"},{"text":" View helper applies a SwiftUI toolbar configuration.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Platform-considerations","text":"Platform considerations","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Available on iOS, iPadOS, and visionOS"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not available on watchOS, tvOS and macOS"}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Guidelines","anchor":"Guidelines"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test the use of the "},{"type":"codeVoice","code":"toolBarBottom"},{"type":"text","text":" for both iOS with Liquid Glass and not Liquid Glass"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If you use both an  ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","type":"reference"},{"text":" with the ","type":"text"},{"code":"toolBarBottom","type":"codeVoice"},{"text":", the toolbar will be above the tabbar for iOS lower than 26, ","type":"text"},{"inlineContent":[{"type":"text","text":"not recommended"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If you use both an  ","type":"text"},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","isActive":true},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"toolBarBottom"},{"text":", the toolbar will be ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"behind"}]},{"text":" the tabbar for iOS 26+, so not usable, ","type":"text"},{"type":"strong","inlineContent":[{"text":"not recommended","type":"text"}]}]}]},{"content":[{"inlineContent":[{"text":"Avoid use of both ","type":"text"},{"code":"toolBarBottom","type":"codeVoice"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","type":"reference","isActive":true},{"text":" in the same page","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Badges-uses","type":"heading","level":2,"text":"Badges uses"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the system does not render system badge for items in bottom toolbar, the MISO badge component is used for iOS 26 with Liquid Glass and bottom toolbars."},{"type":"text","text":" "},{"type":"text","text":"However the glassified effect of Liquid Glass does not make sometimes the badge readable, that is the reason why you should use badge for bottom toolbars with lots of care"},{"type":"text","text":" "},{"type":"text","text":"and prefer "},{"inlineContent":[{"type":"text","text":"prominent"}],"type":"emphasis"},{"type":"text","text":" or "},{"inlineContent":[{"text":"tinted","type":"text"}],"type":"emphasis"},{"type":"text","text":" styles for the item with the badge instead of "},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"For iOS until 18 and without Liquid Glass the MISO badge components are always used.","type":"text"}]},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"type":"paragraph","inlineContent":[{"text":"Define leading and trailing items for the bottom toolbar","type":"text"}]},{"syntax":"swift","code":["    SomeView()","        .toolBarBottom(leadingItems: {","                MISOToolBarItem(label: \"Some label\") { \/* Action to process *\/ }","            }, trailingItems: {","                MISOToolBarItem(icon: Image(decorative: \"some_image\"), accessibilityLabel: \"Label\") { \/* Action to process *\/ }","        })"],"type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 1.4.0","type":"text"}]}],"type":"aside","name":"Since"}]}],"abstract":[{"type":"text","text":"The bottom toolbar is a kind of navigation bar component used to display leading and trailing actions"},{"type":"text","text":" "},{"type":"text","text":"at the bottom of the screen when supported."}],"variants":[{"paths":["\/documentation\/misocomponents\/misotoolbarbottom"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MISOComponents/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s8SendableP","title":"Swift.Sendable"},"doc://MISOComponents/documentation/MISOComponents/MISOTabBar":{"abstract":[{"type":"text","text":"The Tab bar is a system navigation component with a position which can vary depending to the OS."},{"type":"text","text":" "},{"type":"text","text":"The tab bar can be found at the bottom of the screen for iOS. It can vary for iPadOS."},{"type":"text","text":" "},{"type":"text","text":"It allows users to switch between the sections of an app."},{"type":"text","text":" "},{"type":"text","text":"Each tab can be represented by a label, optionally paired with an icon, and maintains persistent visibility across top-level destinations."}],"url":"\/documentation\/misocomponents\/misotabbar","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOTabBar","navigatorTitle":[{"text":"MISOTabBar","kind":"identifier"}],"kind":"symbol","title":"MISOTabBar","role":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTabBar","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOToolBarBottom/init(groupedItems:)":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOToolBarBottom\/init(groupedItems:)","type":"topic","