View-Implementations"],"anchor":"Default-Implementations"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"platforms":[{"introducedAt":"15.0","deprecated":false,"unavailable":false,"beta":false,"name":"iOS"},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false,"name":"macOS"},{"introducedAt":"16.0","deprecated":false,"unavailable":false,"beta":false,"name":"tvOS"},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false,"name":"visionOS"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOAlertMessage"}],"navigatorTitle":[{"kind":"identifier","text":"MISOAlertMessage"}],"symbolKind":"struct","roleHeading":"Structure","role":"symbol","modules":[{"name":"Components"}],"externalID":"s:14MISOComponents16MISOAlertMessageV","title":"MISOAlertMessage"},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage","interfaceLanguage":"swift"},"abstract":[{"text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable","type":"text"},{"text":" ","type":"text"},{"text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link.","type":"text"},{"text":" ","type":"text"},{"text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOAlertMessage","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Dialogs"],"kind":"mentions"},{"content":[{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"syntax":"swift","code":["        \/\/ A basic positive alert message with text and description","        MISOAlertMessage(label: \"Label\", description: \"You should read this text\")","        \/\/ From a localizable in a bundle","        MISOAlertMessage(LocalizedStringKey(\"label_wording\"), bundle: Bundle.module)","","        \/\/ With a rich text for the description (e.g. markdown here, do not forget to manage the errors)","        let richDescription = AttributedString(markdown: \"You **must read this text**\")","        MISOAlertMessage(label: \"Label\", description: richDescription)","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        MISOAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        MISOAlertMessage(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_heart\"))))","        MISOAlertMessage(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = MISOAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        MISOAlertMessage(label: \"Label\", link: link)"],"type":"codeListing"},{"anchor":"Rich-text","text":"Rich text","type":"heading","level":2},{"inlineContent":[{"text":"Only the alert message descripti