Description)","","        \/\/ A more complex alert message for warning status with a description and a close action","        \/\/ to dismiss the message.","        MISOAlertMessage(label: \"Warning\", status: .warning, description: \"Some details about the warning\") {","              \/\/ Do some stuff here to dismiss the alert message when clicked","        }","","        \/\/ Add a custom icon for accent and neutral status","        \/\/ with original rendering mode (to avoid tints) or not.","        \/\/ By default, tinted, template mode.","        MISOAlertMessage(label: \"Label\", status: .accent(image: MISOImage(asset: Image(\"ic_heart\"))))","        MISOAlertMessage(label: \"Label\", status: .neutral(image: MISOImage(asset: Image(\"ic_heart\"), renderingMode: .original)))","","        \/\/ Add a custom action (i.e Link) at bottom (could also at top trailing position)","        @Environment(\\.openURL) private var openUrl","        let link = MISOAlertMessage.Link(text: \"Action\", position: .bottom) {","           openUrl.callAsFunction(url)","        }","        MISOAlertMessage(label: \"Label\", link: link)"],"type":"codeListing"},{"level":2,"type":"heading","anchor":"Rich-text","text":"Rich text"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only the alert message description and bullet list can use rich text."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Strong text can be used sparingly within alert messages to highlight key information."},{"type":"text","text":" "},{"type":"text","text":"Underlined text must not be used for emphasis, as it is commonly associated with links."},{"type":"text","text":" "},{"type":"text","text":"If a hyperlink is needed within the content, the underlined style should be used."},{"type":"text","text":" "},{"type":"text","text":"Italic should be used with care, some brands do not allow it."},{"type":"text","text":" "},{"type":"text","text":"No other text styles should be used."}]},{"level":2,"type":"heading","anchor":"Accessibility-considerations","text":"Accessibility considerations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always check the results of rich text mode with high contrast, light and dark modes, and Voice Over vocalization."}]},{"name":"Version","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.1.1 (Figma component design version)"}]}],"type":"aside","style":"note"},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 1.3.0"}]}],"type":"aside","style":"note"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"kind":"relationships"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOAlertMessage"},"abstract":[{"type":"text","text":"Alert message is a UI element that displays system feedback, status changes or required action; throughout detailed, prominent, persistent and actionable"},{"type":"text","text":" "},{"type":"text","text":"communication. Alert message includes functional icon and semantic colour, and may include as well a close button and\/or action link."},{"type":"text","text":" "},{"type":"text","text":"Alert Message does not disappear automatically and remains visible until dismissed or resolved by the user."}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOAlertMessage/init(_:tableName:bundle:status:description:bulletList:link:onClose:)-ums4":{"url":"\/documentation\/misocomponents\/misoalertmessage\/init(_:tablename:bundle:status:description:bulletlist:link:onclose:)-ums4","kind":"symbol","type":"topic","title":"init(_:tableName:bundle:status:description:bulletList:link:onClose:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(