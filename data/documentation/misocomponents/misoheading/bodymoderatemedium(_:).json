y of a screen.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Four sizes are available; the largest ("},{"code":".large","type":"codeVoice"},{"text":") can optionally display a ","type":"text"},{"type":"strong","inlineContent":[{"text":"marker","type":"text"}]},{"text":", i.e. a small brand-coloured","type":"text"},{"text":" ","type":"text"},{"text":"rectangle rendered below the text (when the current theme declares it supports one).","type":"text"}]},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOTheme":{"url":"\/documentation\/misothemescontract\/misotheme","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","kind":"symbol","title":"MISOTheme","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTheme","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MISOTheme","kind":"identifier"}],"abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"object oriented paradigm"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineCon