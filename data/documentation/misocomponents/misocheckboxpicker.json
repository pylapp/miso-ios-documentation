fine which one will be used.","type":"text"},{"text":" ","type":"text"},{"text":"However if defined in the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPickerData"},{"text":" the items inside the picker will have such accessibility identifiers.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"In addition the root item of the picker has for accessiiblity identifier the displayed text."}]},{"text":"Forbidden by design","anchor":"Forbidden-by-design","type":"heading","level":2},{"inlineContent":[{"text":"The design system does not allow to have ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","isActive":true,"type":"reference"},{"type":"text","text":" in both an error situation and a read only state."},{"type":"text","text":" "},{"text":"The design system does not allow to have ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","isActive":true,"type":"reference"},{"text":" in both an error situation and a disabled state.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The design system does not allow to have "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem"},{"type":"text","text":" in both a read only and a disabled state."}],"type":"paragraph"},{"anchor":"Code-samples","type":"heading","text":"Code samples","level":2},{"code":["    \/\/ Define the elements to display in checkboxes using MISOCheckboxPickerData.","    \/\/ This object has the same properties as the MISOCheckboxItem,","    \/\/ and some of them are optional with default values set","    var someDataToPopulate: [MISOCheckboxPickerData<String>] {","        [","        MISOCheckboxPickerData<String>(tag: \"Choice_1\",","                                       label: \"Virgin Holy Lava\",","                                       description: \"No alcohol, only tasty flavors\",","                                       image: MISOImage(asset: Image(systemName: \"flame\")),","","        MISOCheckboxPickerData<String>(tag: \"Choice_2\",","                                       label: \"IPA beer\",","                                       description: \"From Brewdog company\",","                                       image: MISOImage(asset: Image(systemName: \"dog.fill\")),","","        MISOCheckboxPickerData<String>(tag: \"Choice_3\",","                                       label: \"Mineral water\",","                                       image: MISOImage(asset: Image(systemName: \"waterbottle.fill\"))","        ]","    }","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [String] = [\"Choice_1\"] \/\/ or empty if nothing selected","","    \/\/ Here the picker is vertical by default","    MISOCheckboxPicker(selections: $selections, checkboxes: someDataToPopulate)","","    \/\/ The picker can be vertical and have a root item with a label and a counter","    MISOCheckboxPicker(selections: $selections,","                       placement: .verticalRooted(label, .textAndCount))","","    \/\/ The picker can apply some settings to all its radio buttons.","    \/\/ It can be also horizontal with a scroll indicator.","    \/\/ Here all the the checkboxes are in read only mode and use reversed layout.","    \/\/ Here the picker is horizontal and shows the scroll indicator","    MISOCheckboxPicker(selections: $selections,","                       checkboxes: someDataToPopulate)","                       isReversed: true,","                       isReadOnly: true,","                       placement: .horizontal(true))"],"type":"codeListing","syntax":"swift"},{"type":"aside","name":"Since","style":"note","content":[{"inlineContent":[{"text":"OUDS 0.14.0","type":"text"}],"type":"para