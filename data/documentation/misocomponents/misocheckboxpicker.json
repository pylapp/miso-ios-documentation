{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Structure","navigatorTitle":[{"text":"MISOCheckboxPicker","kind":"identifier"}],"symbolKind":"struct","platforms":[{"beta":false,"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"15.0"},{"beta":false,"name":"macOS","introducedAt":"13.0","unavailable":false,"deprecated":false},{"beta":false,"name":"visionOS","introducedAt":"1.0","unavailable":false,"deprecated":false}],"role":"symbol","externalID":"s:14MISOComponents18MISOCheckboxPickerV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"MISOCheckboxPicker","kind":"identifier"}],"title":"MISOCheckboxPicker","modules":[{"name":"Components"}]},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"symbol","identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker","interfaceLanguage":"swift"},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker\/init(selections:checkboxes:placement:isReversed:isError:isReadOnly:hasDivider:itemsSpacing:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker\/body"],"anchor":"Instance-Properties","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCheckboxPicker","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Tag","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Tag","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:SH","text":"Hashable","kind":"typeIdentifier"}],"languages":["swift"]}]},{"content":[{"text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Voice Over","type":"text"}],"type":"emphasis"},{"text":" will use several elements to describe the component: if component disabled \/ read only, if error context, the label and helper texts and a chekcbox trait.","type":"text"},{"text":" ","type":"text"},{"text":"The picker itself does no have any defined accessiiblity value, label or identifier ; it remains in the users hands to define which one will be used.","type":"text"},{"text":" ","type":"text"},{"text":"However if defined in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISORadioPickerData","type":"reference"},{"text":" the items inside the picker will have such accessibility identifiers.","type":"text"},{"text":" ","type":"text"},{"text":"In addition the root item of the picker has for accessiiblity identifier the displayed text.","type":"text"}]},{"type":"heading","text":"Forbidden by design","anchor":"Forbidden-by-design","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The design system does not allow to have "},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","type":"reference"},{"text":" in both an error situation and a read only state.","type":"text"},{"text":" ","type":"text"},{"text":"The design system does not allow to have ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","type":"reference"},{"text":" in both an error situation and a disabled state.","type":"text"},{"text":" ","type":"text"},{"text":"The design system does not allow to have ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","type":"reference"},{"text":" in both a read only and a disabled state.","type":"text"}]},{"type":"heading","text":"Code samples","anchor":"Code-samples","level":2},{"type":"codeListing","code":["    \/\/ Define the elements to display in checkboxes using MISOCheckboxPickerData.","    \/\/ This object has the same properties as the MISOCheckboxItem,","    \/\/ and some of them are optional with default values set","    var someDataToPopulate: [MISOCheckboxPickerData<String>] {","        [","        MISOCheckboxPickerData<String>(tag: \"Choice_1\",","                                       label: \"Virgin Holy Lava\",","                                       description: \"No alcohol, only tasty flavors\",","                                       image: MISOImage(asset: Image(systemName: \"flame\")),","","        MISOCheckboxPickerData<String>(tag: \"Choice_2\",","                                       label: \"IPA beer\",","                                       description: \"From Brewdog company\",","                                       image: MISOImage(asset: Image(systemName: \"dog.fill\")),","","        MISOCheckboxPickerData<String>(tag: \"Choice_3\",","                                       label: \"Mineral water\",","                                       image: MISOImage(asset: Image(systemName: \"waterbottle.fill\"))","        ]","    }","","    \/\/ Prepare the selection, with a value previously selected","    \/\/ Use the data and the binding for the picker.","    @State var selections: [String] = [\"Choice_1\"] \/\/ or empty if nothing selected","","    \/\/ Here the picker is vertical by default","    MISOCheckboxPicker(selections: $selections, checkboxes: someDataToPopulate)","","    \/\/ The picker can be vertical and have a root item with a label and a counter","    MISOCheckboxPicker(selections: $selections,","                       placement: .verticalRooted(label, .textAndCount))","","    \/\/ The picker can apply some settings to all its radio buttons.","    \/\/ It can be also horizontal with a scroll indicator.","    \/\/ Here all the the checkboxes are in read only mode and use reversed layout.","    \/\/ Here the picker is horizontal and shows the scroll indicator","    MISOCheckboxPicker(selections: $selections,","                       checkboxes: someDataToPopulate)","                       isReversed: true,","                       isReadOnly: true,","                       placement: .horizontal(true))"],"syntax":"swift"},{"type":"aside","style":"note","name":"Since","content":[{"inlineContent":[{"type":"text","text":"OUDS 0.14.0"}],"type":"paragraph"}]}],"kind":"content"}],"abstract":[{"text":"A picker allowing to expose several checkboxes and select some of them within the others.","type":"text"},{"type":"text","text":" "},{"text":"Each checkbox contains a “tag”, i.e. a supposed to be unique value.","type":"text"},{"text":" ","type":"text"},{"text":"The picker will expose the choosen values using this “tag”.","type":"text"},{"text":" ","type":"text"},{"text":"It has also some configuration elements which will override the one applied to nested ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem"},{"type":"text","text":" (divider, read only and error mode, layout and outlined)"}],"variants":[{"paths":["\/documentation\/misocomponents\/misocheckboxpicker"],"traits":[{"i