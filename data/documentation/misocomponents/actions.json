{"variants":[{"paths":["\/documentation\/misocomponents\/actions"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"actions","type":"text"}]},{"type":"text","text":". These are inherited from OUDS."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Actions"},"metadata":{"title":"Actions","roleHeading":"Article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"modules":[{"name":"Components"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"anchor":"Buttons","type":"heading","level":3,"text":"Buttons"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_button_BlueCoat"}]}]},{"title":"FoxyRough","content":[{"inlineContent":[{"type":"image","identifier":"component_button_FoxyRough"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"reference","isActive":true},{"text":" proposes layout with text only, icon only or text and icon.","type":"text"},{"text":" ","type":"text"},{"text":"Four hierarchies are proposed for all layouts: ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"default","type":"text"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"strong","type":"text"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"minimal"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"negative","type":"text"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two style are available: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"loading","type":"text"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If button is placed on colored surface using ","type":"text"},{"code":"MISOColoredSurface","type":"codeVoice"},{"type":"text","text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom."},{"type":"text","text":" "},{"type":"text","text":"A button with "},{"type":"codeVoice","code":"MISOButton.Appearance.Negative"},{"type":"text","text":" appearance is not allowed as a direct or indirect child of an "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Two sizes are available: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"small"}]},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["    \/\/ Icon only with default appearance","    MISOButton(image: MISOImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    MISOButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    MISOButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    MISOButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy."}]}],"kind":"content"}],"references":{"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"url":"\/documentation\/misocomponents","kind":"symbol","title":"Components","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views. These are inherited from OUDS."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","type":"topic"},"component_button_FoxyRough":{"type":"image","identifier":"component_button_FoxyRough","variants":[{"url":"\/images\/MISOComponents\/component_button_FoxyRough.png","traits":["1x","light"]}],"alt":"A button component in light and dark modes with FoxyRough theme"},"component_button_BlueCoat":{"alt":"A button component in light and dark modes with BlueCoat theme","type":"image","identifier":"component_button_BlueCoat","variants":[{"url":"\/images\/MISOComponents\/component_button_BlueCoat.png","traits":["1x","light"]}]},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misobutton","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","role":"symbol","title":"MISOButton","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"navigatorTitle":[{"text":"MISOButton","kind":"identifier"}]},"ic_folder_categories.png":{"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","identifier":"ic_folder_categories.png","alt":null}}}