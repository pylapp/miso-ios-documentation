{"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"actions","type":"text"}]},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"heading","anchor":"Buttons","level":3,"text":"Buttons"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"type":"paragraph","inlineContent":[{"identifier":"component_button_BlueCoat","type":"image"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","isActive":true,"type":"reference"},{"text":" proposes layout with text only, icon only or text and icon.","type":"text"},{"text":" ","type":"text"},{"text":"Four hierarchies are proposed for all layouts: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"strong"}]},{"text":", ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"minimal"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"negative"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two style are available: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"loading"}]},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If button is placed on colored surface using ","type":"text"},{"type":"codeVoice","code":"MISOColoredSurface"},{"text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom.","type":"text"},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"type":"codeVoice","code":"MISOButton.Appearance.Negative"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"type":"codeVoice","code":"MISOColoredSurface"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two sizes are available: ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"small"}]},{"text":".","type":"text"}]},{"type":"codeListing","code":["    \/\/ Icon only with default appearance","    MISOButton(image: MISOImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    MISOButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    MISOButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    MISOButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/misocomponents\/actions"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"metadata":{"title":"Actions","roleHeading":"Article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}],"role":"article","modules":[{"name":"Components"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Actions"},"sections":[],"kind":"article","references":{"component_button_BlueCoat":{"alt":"A button component in light and dark modes with BlueCoat theme","variants":[{"url":"\/images\/MISOComponents\/component_button_BlueCoat.png","traits":["1x","light"]}],"identifier":"component_button_BlueCoat","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"title":"MISOButton","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"text":" ","type":"text"},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","role":"symbol","navigatorTitle":[{"text":"MISOButton","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misobutton","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}]},"ic_folder_categories.png":{"alt":null,"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png","type":"image"},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","title":"Components","type":"topic","kind":"symbol","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}]}