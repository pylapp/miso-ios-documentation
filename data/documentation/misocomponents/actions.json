{"kind":"article","abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"text":"actions","type":"text"}],"type":"strong"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"sections":[],"metadata":{"title":"Actions","modules":[{"name":"Components"}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"role":"article","roleHeading":"Article"},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Actions","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"anchor":"Buttons","level":3,"type":"heading","text":"Buttons"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_button_BlueCoat"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton"},{"text":" proposes layout with text only, icon only or text and icon.","type":"text"},{"text":" ","type":"text"},{"text":"Four hierarchies are proposed for all layouts: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"strong"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"minimal"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"negative"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two style are available: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"loading"}],"type":"emphasis"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"If button is placed on colored surface using ","type":"text"},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom."},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"type":"codeVoice","code":"MISOButton.Appearance.Negative"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"code":"MISOColoredSurface","type":"codeVoice"},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Two sizes are available: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"type":"text","text":"small"}],"type":"emphasis"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ Icon only with default appearance","    MISOButton(image: MISOImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    MISOButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    MISOButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    MISOButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user."}]},{"inlineContent":[{"type":"text","text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/actions"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"type":"image","identifier":"ic_folder_categories.png","alt":null},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"navigatorTitle":[{"text":"MISOButton","kind":"identifier"}],"title":"MISOButton","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","role":"symbol","url":"\/documentation\/misocomponents\/misobutton","abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}],"type":"topic"},"component_button_BlueCoat":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_button_BlueCoat.png"}],"type":"image","identifier":"component_button_BlueCoat","alt":"A button component in light and dark modes with BlueCoat theme"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"}}}