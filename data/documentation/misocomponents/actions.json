{"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"actions","type":"text"}]},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"level":3,"anchor":"Buttons","type":"heading","text":"Buttons"},{"type":"tabNavigator","tabs":[{"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"component_button_BlueCoat"}]}],"title":"BlueCoat"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"reference","isActive":true},{"text":" proposes layout with text only, icon only or text and icon.","type":"text"},{"text":" ","type":"text"},{"text":"Four hierarchies are proposed for all layouts: ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"text":"strong","type":"text"}],"type":"emphasis"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"minimal"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"negative"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two style are available: ","type":"text"},{"inlineContent":[{"text":"default","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"loading"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If button is placed on colored surface using ","type":"text"},{"code":"MISOColoredSurface","type":"codeVoice"},{"text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom.","type":"text"},{"text":" ","type":"text"},{"text":"A button with ","type":"text"},{"code":"MISOButton.Appearance.Negative","type":"codeVoice"},{"text":" appearance is not allowed as a direct or indirect child of an ","type":"text"},{"code":"MISOColoredSurface","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Two sizes are available: ","type":"text"},{"inlineContent":[{"type":"text","text":"default"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"small"}],"type":"emphasis"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["    \/\/ Icon only with default appearance","    MISOButton(image: MISOImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    MISOButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    MISOButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    MISOButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"]},{"type":"paragraph","inlineContent":[{"text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/misocomponents\/actions"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Actions"},"metadata":{"modules":[{"name":"Components"}],"role":"article","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"roleHeading":"Article","title":"Actions"},"kind":"article","references":{"doc://MISOComponents/documentation/MISOComponents":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"kind":"symbol","url":"\/documentation\/misocomponents","type":"topic","role":"collection","images":[{"identifier":"ic_folder_categories.png","type":"icon"}],"title":"Components"},"ic_folder_categories.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}],"type":"image","identifier":"ic_folder_categories.png","alt":null},"component_button_BlueCoat":{"identifier":"component_button_BlueCoat","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/component_button_BlueCoat.png"}],"alt":"A button component in light and dark modes with BlueCoat theme","type":"image"},"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"navigatorTitle":[{"kind":"identifier","text":"MISOButton"}],"url":"\/documentation\/misocomponents\/misobutton","role":"symbol","abstract":[{"type":"text","text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action."},{"type":"text","text":" "},{"type":"text","text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis."}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOButton"}],"title":"MISOButton","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton"}}}