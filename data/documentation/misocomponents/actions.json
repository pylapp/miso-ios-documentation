{"metadata":{"modules":[{"name":"Components"}],"title":"Actions","role":"article","roleHeading":"Article","images":[{"identifier":"ic_folder_categories.png","type":"icon"},{"identifier":"ic_folder_categories.png","type":"card"}]},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"actions","type":"text"}]},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Actions"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"level":3,"anchor":"Buttons","text":"Buttons","type":"heading"},{"type":"tabNavigator","tabs":[{"title":"BlueCoat","content":[{"inlineContent":[{"type":"image","identifier":"component_button_BlueCoat"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","isActive":true},{"type":"text","text":" proposes layout with text only, icon only or text and icon."},{"type":"text","text":" "},{"type":"text","text":"Four hierarchies are proposed for all layouts: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"strong"}]},{"type":"text","text":", "},{"type":"emphasis","inlineContent":[{"type":"text","text":"minimal"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"negative"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Two style are available: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"loading"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If button is placed on colored surface using "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":", the default colors (content, background and border) are automatically adjusted to switch to monochrom."},{"type":"text","text":" "},{"type":"text","text":"A button with "},{"type":"codeVoice","code":"MISOButton.Appearance.Negative"},{"type":"text","text":" appearance is not allowed as a direct or indirect child of an "},{"type":"codeVoice","code":"MISOColoredSurface"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Two sizes are available: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"default"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"small"}]},{"type":"text","text":"."}],"type":"paragraph"},{"code":["    \/\/ Icon only with default appearance","    MISOButton(image: MISOImage(asset: Image(\"ic_heart\")), accessibilityLabel: \"Like\", appearance: .default) { \/* the action to process *\/ }","","    \/\/ Text only with negative appearance","    MISOButton(text: \"Delete\", appearance: .negative, size: .small) {}","    ","    \/\/ The same button (text only) with loading style (indeterminate process)","    MISOButton(text: \"Delete\", style: .loading(), size: .small) {}","    ","    \/\/ The same button (text only) with loading style (progress at 75 %)","    MISOButton(text: \"Delete\", style: .loading(progress: 0.75), size: .small) {}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"For accessibility reasons, if the user in the system settings toggles the option to reduce the animations, the loading indicator will be frozen to be more comfortable for the user."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For ecodesign reasons, if the user toggles the low power mode, the loading indicator will be frozen to prevent the CPU to work and waste energy."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/misocomponents\/actions"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MISOComponents/documentation/MISOComponents/MISOButton":{"url":"\/documentation\/misocomponents\/misobutton","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOButton","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOButton","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOButton"}],"title":"MISOButton","abstract":[{"text":"Button is a UI element that triggers an action or event, and is used to initiate tasks or confirming an action.","type":"text"},{"text":" ","type":"text"},{"text":"Button appears in different layouts, styles and states to indicate hierarchy or emphasis.","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","kind":"symbol","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","type":"topic","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"abstract":[{"text":"The catalog of all components provided by MISO. It contains also ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}]},"ic_folder_categories.png":{"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png","type":"image","alt":null},"component_button_BlueCoat":{"variants":[{"url":"\/images\/MISOComponents\/component_button_BlueCoat.png","traits":["1x","light"]}],"identifier":"component_button_BlueCoat","type":"image","alt":"A button component in light and dark modes with BlueCoat theme"}}}