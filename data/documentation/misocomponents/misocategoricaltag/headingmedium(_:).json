misothemescontract\/misotheme","kind":"symbol","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","role":"symbol","title":"MISOTheme","abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"text":"A Swift ","type":"text"},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"text":" ","type":"text"},{"text":"Any properties of an overridable theme should be defined so as to provide defaults values.","type":"text"},{"type":"text","text":" "},{"text":"We allow this theme to be derivated and be overridden.","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme"},{"text":" can be seen as a kind of “abstract class” in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"object oriented paradigm","type":"text"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme contract"}]},{"type":"text","text":"."},{"text":" ","type":"text"},{"text":"Because ","type":"text"},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"text":"final","type":"text"}]},{"text":" class, its type cannot be seen as ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":", that is the reason why this conformity is unchecked.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"MISOTheme"}]},"ic_folder_categories.png":{"type":"image","identifier":"ic_folder_categories.png","alt":null,"variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}]},"doc://MISOComponents/documentation/MISOComponents/MISOCategoricalTag":{"navigatorTitle":[{"text":"MISOCategoricalTag","kind":"identifier"}],"abstract":[{"text":"A ","type":"text"},{"code":"MISOCategoricalTag","type":"codeVoice"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It can represent information such as promotions, events, benefits or other locally defined categories."},{"type":"text","text":" "},{"type":"text","text":"It does not communicate functional status or system feedback."},{"type":"text","text":" "},{"type":"text","text":"Use the "},{"type":"codeVoice","code":"MISOTag"},{"type":"text","text":" for success, warning, error, availability or other functional states."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"MISOCategoricalTag"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCategoricalTag","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCategoricalTag","role":"symbol","title":"MISOCategoricalTag","url":"\/documentation\/misocomponents\/misocategoricaltag"}}}