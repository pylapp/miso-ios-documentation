,"abstract":[{"text":"A ","type":"text"},{"code":"MISOCategoricalTag","type":"codeVoice"},{"text":" is a non-interactive label used to visually distinguish non-functional categories using categorical colours.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"It can represent information such as promotions, events, benefits or other locally defined categories."},{"type":"text","text":" "},{"type":"text","text":"It does not communicate functional status or system feedback."},{"type":"text","text":" "},{"type":"text","text":"Use the "},{"type":"codeVoice","code":"MISOTag"},{"type":"text","text":" for success, warning, error, availability or other functional states."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"type":"codeVoice","code":"MISOCategoricalTag"},{"type":"text","text":" tag only when its colour categories are defined by the product or local market guidelines."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCategoricalTag","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCategoricalTag","role":"symbol","title":"MISOCategoricalTag","url":"\/documentation\/misocomponents\/misocategoricaltag"}}}