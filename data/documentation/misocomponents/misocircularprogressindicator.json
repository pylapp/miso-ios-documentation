{"abstract":[{"text":"A circular indicator shows the progress of a task using a circle.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOCircularProgressIndicator"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"]},{"content":[{"text":"Variants","anchor":"Variants","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Two variants are provided:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Determinate","type":"text"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Indeterminate","type":"text"}]},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."},{"type":"text","text":" "},{"type":"text","text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Statuses","anchor":"Statuses","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Neutral","type":"text"}]},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,"},{"type":"text","text":" "},{"type":"text","text":"processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Accent","type":"text"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Positive","type":"text"}]},{"type":"text","text":": indicates successful progress or a process leading to a successful outcome."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Info","type":"text"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data retrieval)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Warning","type":"text"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be monitored."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Negative","type":"text"}]},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Gap size","anchor":"Gap-size","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"default","type":"text"}]},{"type":"text","text":": standard gap between the indicator and the track (about 14° of arc)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"type":"text","text":": reduced gap for a more compact appearance."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Track","anchor":"Track","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear"},{"type":"text","text":" "},{"type":"text","text":"structure. The track helps define the full range of progress and makes the value easier to read."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Animation (determinate mode only)","anchor":"Animation-determinate-mode-only","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (default), the determinate indicator progressively fills from "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to the target"},{"type":"text","text":" "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" on first display, and animates any subsequent change of "},{"type":"codeVoice","code":"progress"},{"type":"text","text":". When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the indicator is displayed instantly at its target value with no animation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Animations are always disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled,"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" flag."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}],"type":"paragraph"},{"text":"Helper text","anchor":"Helper-text","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An optional text displayed below the circular indicator to provide context or additional information."},{"type":"text","text":" "},{"type":"text","text":"The helper text is always centered under the indicator."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"type":"text","text":" mode, use "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType","isActive":true},{"type":"text","text":" which offers two variants:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".description(_:)","type":"codeVoice"}]},{"type":"text","text":": Displays a simple description text without the progress percentage."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".percent(_:)","type":"codeVoice"}]},{"type":"text","text":": Displays the progress percentage with an optional description. The percentage"},{"type":"text","text":" "},{"type":"text","text":"value and its "},{"type":"codeVoice","code":"%"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"type":"codeVoice","code":"\"75%\""},{"type":"text","text":" in English, "},{"type":"codeVoice","code":"\"75 %\""},{"type":"text","text":" in French, "},{"type":"codeVoice","code":"\"٪75\""},{"type":"text","text":" in Arabic)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" parameter is a simple "},{"type":"codeVoice","code":"String?"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Code samples","anchor":"Code-samples","level":2,"type":"heading"},{"syntax":"swift","code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    MISOCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    MISOCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    MISOCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    MISOCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    MISOCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    MISOCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    MISOCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    MISOCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    MISOCircularProgressIndicator()","    MISOCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    MISOCircularProgressIndicator(status: .info, helperText: \"Processing...\")"],"type":"codeListing"},{"text":"Accessibility considerations","anchor":"Accessibility-considerations","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" parameter to provide a custom name and state for VoiceOver:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"type":"text","text":": The name of the component (e.g., “progress bar”, “download bar”)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"type":"strong","inlineContent":[{"text":"[name]. [state]. [helperText] [value]","type":"text"}]},{"type":"text","text":". Example: "},{"type":"emphasis","inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage) so that"},{"type":"text","text":" "},{"type":"text","text":"VoiceOver reads e.g. "},{"type":"emphasis","inlineContent":[{"text":"“75 percent”","type":"text"}]},{"type":"text","text":", and is marked with the "},{"type":"codeVoice","code":".updatesFrequently"},{"type":"text","text":" trait so that assistive"},{"type":"text","text":" "},{"type":"text","text":"technologies know the value is changing."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"type":"strong","inlineContent":[{"text":"Full Keyboard Access","type":"text"}]},{"type":"text","text":" focus, as no interaction is possible on a progress"},{"type":"text","text":" "},{"type":"text","text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"type":"text","text":"; on earlier OS versions, the semantic "},{"type":"codeVoice","code":".isStaticText"},{"type":"text","text":" "},{"type":"text","text":"trait is used."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"type":"text","text":" mode, the view is hidden from VoiceOver ("},{"type":"codeVoice","code":".accessibilityHidden(true)"},{"type":"text","text":") — and therefore"},{"type":"text","text":" "},{"type":"text","text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the"},{"type":"text","text":" "},{"type":"text","text":"element focusable would only pollute navigation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Colored surfaces","anchor":"Colored-surfaces","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When placed on an "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","isActive":true},{"type":"text","text":", the indicator switches to a "},{"type":"strong","inlineContent":[{"text":"monochrome","type":"text"}]},{"type":"text","text":" rendering, the "},{"type":"codeVoice","code":"status"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"ignored."}],"type":"paragraph"},{"name":"Version","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0 (Figma component design version)","type":"text"}]}],"type":"aside"},{"name":"Since","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}],"type":"aside"}],"kind":"content"}],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","interfaceLanguage":"swift"},"sections":[],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"title":"Conforms To","kind":"relationships"}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/body"],"title":"Instance Properties","anchor":"Instance-Properties"},{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/defaultSize"],"title":"Type Properties","anchor":"Type-Properties"},{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType"],"title":"Enumerations","anchor":"Enumerations"},{"generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/View-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"variants":[{"paths":["\/documentation\/misocomponents\/misocircularprogressindicator"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","roleHeading":"Structure","title":"MISOCircularProgressIndicator","externalID":"s:14MISOComponents29MISOCircularProgressIndicatorV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"platforms":[{"beta":false,"unavailable":false,"name":"iOS","introducedAt":"15.0","deprecated":false},{"beta":false,"unavailable":false,"name":"macOS","introducedAt":"13.0","deprecated":false},{"beta":false,"unavailable":false,"name":"tvOS","introducedAt":"16.0","deprecated":false},{"beta":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0","deprecated":false},{"beta":false,"unavailable":false,"name":"watchOS","introducedAt":"11.0","deprecated":false}],"modules":[{"name":"Components"}],"navigatorTitle":[{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"symbolKind":"struct"},"kind":"symbol","references":{"doc://MISOComponents/s16SendableMetatypeP":{"identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/init(status:track:gapSize:size:helperText:accessibility:)":{"abstract":[{"type":"text","text":"Creates an "},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"type":"text","text":" circular progress indicator."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)","role":"symbol","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/init(status:track:gapsize:size:helpertext:accessibility:)","title":"init(status:track:gapSize:size:helperText:accessibility:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents27MISOProgressIndicatorStatusO","text":"MISOProgressIndicatorStatus"},{"kind":"text","text":", "},{"kind":"externalParam","text":"track"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"gapSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents28MISOProgressIndicatorGapSizeO","text":"MISOProgressIndicatorGapSize"},{"kind":"text","text":", "},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV","text":"CGFloat"},{"kind":"text","text":", "},{"kind":"externalParam","text":"helperText"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"accessibility"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14MISOComponents30MISOAccessibilityConfigurationV","text":"MISOAccessibilityConfiguration"},{"kind":"text","text":"?)"}],"type":"topic","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator":{"role":"symbol","abstract":[{"text":"A circular indicator shows the progress of a task using a circle.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"navigatorTitle":[{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"type":"topic","title":"MISOCircularProgressIndicator","url":"\/documentation\/misocomponents\/misocircularprogressindicator","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/HelperTextType":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HelperTextType"}],"title":"MISOCircularProgressIndicator.HelperTextType","navigatorTitle":[{"kind":"identifier","text":"HelperTextType"}],"abstract":[{"type":"text","text":"The helper text can be added in "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" indicator"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType","kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/helpertexttype"},"doc://MISOComponents/7SwiftUI4ViewP":{"identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","type":"unresolvable","title":"SwiftUICore.View"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)":{"kind":"symbol","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/init(progress:status:track:gapsize:animated:size:helpertext:accessibility:)","abstract":[{"type":"text","text":"Creates a "},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"type":"text","text":" circular progress indicator."}],"role":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"progress"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MISOProgressIndicatorStatus","preciseIdentifier":"s:14MISOComponents27MISOProgressIndicatorStatusO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"track"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"gapSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MISOProgressIndicatorGapSize","preciseIdentifier":"s:14MISOComponents28MISOProgressIndicatorGapSizeO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"animated"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"helperText"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MISOCircularProgressIndicator","preciseIdentifier":"s:14MISOComponents29MISOCircularProgressIndicatorV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"HelperTextType","preciseIdentifier":"s:14MISOComponents29MISOCircularProgressIndicatorV14HelperTextTypeO"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"accessibility"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MISOAccessibilityConfiguration","preciseIdentifier":"s:14MISOComponents30MISOAccessibilityConfigurationV"},{"kind":"text","text":"?)"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","title":"init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","type":"topic"},"doc://MISOComponents/s8SendableP":{"identifier":"doc:\/\/MISOComponents\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/defaultSize":{"abstract":[{"type":"text","text":"The default component size (matches the Android reference implementation and Material 3 defaults)."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/defaultSize","role":"symbol","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/defaultsize","title":"defaultSize","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV","text":"CGFloat"}],"type":"topic","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/Indicators":{"kind":"article","type":"topic","title":"Indicators","abstract":[{"type":"text","text":"Some components can be used for "},{"inlineContent":[{"type":"text","text":"indicators"}],"type":"strong"},{"type":"text","text":"."}],"images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents\/indicators","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators","role":"article"},"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"role":"symbol","abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"navigatorTitle":[{"text":"MISOColoredSurface","kind":"identifier"}],"type":"topic","url":"\/documentation\/misocomponents\/misocoloredsurface","title":"MISOColoredSurface","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MISOColoredSurface","kind":"identifier"}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/body":{"abstract":[],"title":"body","type":"topic","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/body","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/body"},"ic_folder_categories.png":{"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"identifier":"ic_folder_categories.png","type":"image","alt":null},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/View-Implementations":{"abstract":[],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/View-Implementations","role":"collectionGroup","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/view-implementations","title":"View Implementations","type":"topic","kind":"article"}}}