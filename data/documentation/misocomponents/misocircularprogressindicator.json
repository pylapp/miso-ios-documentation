tifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":", "},{"kind":"externalParam","text":"status"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MISOProgressIndicatorStatus","preciseIdentifier":"s:14MISOComponents27MISOProgressIndicatorStatusO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"track"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"gapSize"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MISOProgressIndicatorGapSize","preciseIdentifier":"s:14MISOComponents28MISOProgressIndicatorGapSizeO"},{"kind":"text","text":", "},{"kind":"externalParam","text":"animated"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"size"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"helperText"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MISOCircularProgressIndicator","preciseIdentifier":"s:14MISOComponents29MISOCircularProgressIndicatorV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"HelperTextType","preciseIdentifier":"s:14MISOComponents29MISOCircularProgressIndicatorV14HelperTextTypeO"},{"kind":"text","text":"?, "},{"text":"accessibility","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MISOAccessibilityConfiguration","preciseIdentifier":"s:14MISOComponents30MISOAccessibilityConfigurationV","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)"},"doc://MISOComponents/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresol