text":"CGFloat","kind":"typeIdentifier"}],"title":"defaultSize","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/defaultsize","abstract":[{"text":"The default component size (matches the Android reference implementation and Material 3 defaults).","type":"text"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/defaultSize","kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"navigatorTitle":[{"kind":"identifier","text":"MISOColoredSurface"}],"abstract":[{"type":"text","text":"Used to define if a content is used on a colored surface."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOColoredSurface"}],"url":"\/documentation\/misocomponents\/misocoloredsurface","title":"MISOColoredSurface","kind":"symbol","role":"symbol","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/body":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}],"abstract":[],"title":"body","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/body","kind":"symbol","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/body","role":"symbol","type":"topic"}}}