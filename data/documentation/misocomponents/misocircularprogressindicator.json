{"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/body"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/defaultSize"]},{"title":"Enumerations","anchor":"Enumerations","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/View-Implementations","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/View-Implementations"]}],"sections":[],"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"]},{"kind":"content","content":[{"level":2,"anchor":"Variants","text":"Variants","type":"heading"},{"inlineContent":[{"text":"Two variants are provided:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Determinate"}]},{"type":"text","text":": the caller provides a "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" value in "},{"type":"codeVoice","code":"[0, 1]"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Indeterminate"}],"type":"strong"},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."},{"type":"text","text":" "},{"type":"text","text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Statuses","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Neutral"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,"},{"type":"text","text":" "},{"type":"text","text":"processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Accent","type":"text"}],"type":"strong"},{"text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding).","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Positive","type":"text"}],"type":"strong"},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Info","type":"text"}],"type":"strong"},{"text":": indicates informational or system-related processes (background synchronization, data retrieval).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be monitored."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Negative","type":"text"}],"type":"strong"},{"text":": indicates progress related to an error, recovery, cancellation or failure.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Gap size","anchor":"Gap-size"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"default"}]},{"text":": standard gap between the indicator and the track (about 14° of arc).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"small","type":"text"}],"type":"strong"},{"type":"text","text":": reduced gap for a more compact appearance."}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Track","level":2,"text":"Track"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"true","type":"codeVoice"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear","type":"text"},{"text":" ","type":"text"},{"text":"structure. The track helps define the full range of progress and makes the value easier to read.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"false","type":"codeVoice"},{"text":": the track is hidden. Recommended when the indicator is embedded inside another component","type":"text"},{"text":" ","type":"text"},{"text":"(button, tag, toast) or when a more minimal appearance is needed.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Animation-determinate-mode-only","type":"heading","text":"Animation (determinate mode only)","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (default), the determinate indicator progressively fills from "},{"type":"codeVoice","code":"0"},{"text":" to the target","type":"text"},{"text":" ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" on first display, and animates any subsequent change of ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the indicator is displayed instantly at its target value with no animation."}]},{"inlineContent":[{"text":"Animations are always disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":" or when Low Power Mode is enabled,"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"type":"codeVoice","code":"animated"},{"text":" flag.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}]},{"level":2,"type":"heading","text":"Helper text","anchor":"Helper-text"},{"inlineContent":[{"text":"An optional text displayed below the circular indicator to provide context or additional information.","type":"text"},{"type":"text","text":" "},{"text":"The helper text is always centered under the indicator.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, use ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType","type":"reference","isActive":true},{"text":" which offers two variants:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".description(_:)"}]},{"type":"text","text":": Displays a simple description text without the progress percentage."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".percent(_:)"}]},{"text":": Displays the progress percentage with an optional description. The percentage","type":"text"},{"text":" ","type":"text"},{"text":"value and its ","type":"text"},{"code":"%","type":"codeVoice"},{"text":" symbol are assembled through the localized wording key","type":"text"},{"text":" ","type":"text"},{"code":"core_progressIndicator_percent_value","type":"codeVoice"},{"text":", so the symbol, its spacing and its position follow the","type":"text"},{"text":" ","type":"text"},{"text":"typographic rules of the current language (e.g. ","type":"text"},{"code":"\"75%\"","type":"codeVoice"},{"text":" in English, ","type":"text"},{"code":"\"75 %\"","type":"codeVoice"},{"text":" in French, ","type":"text"},{"code":"\"٪75\"","type":"codeVoice"},{"text":" in Arabic).","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"text":" parameter is a simple ","type":"text"},{"type":"codeVoice","code":"String?"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Code-samples","type":"heading","level":2,"text":"Code samples"},{"type":"codeListing","syntax":"swift","code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    MISOCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    MISOCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    MISOCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    MISOCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    MISOCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    MISOCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    MISOCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    MISOCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    MISOCircularProgressIndicator()","    MISOCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    MISOCircularProgressIndicator(status: .info, helperText: \"Processing...\")"]},{"anchor":"Accessibility-considerations","text":"Accessibility considerations","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}]}]}]}]},{"content":[{"inlineContent":[{"text":"VoiceOver reads: ","type":"text"},{"type":"strong","inlineContent":[{"text":"[name]. [state]. [helperText] [value]","type":"text"}]},{"type":"text","text":". Example: "},{"type":"emphasis","inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"accessibility"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage) so that"},{"type":"text","text":" "},{"type":"text","text":"VoiceOver reads e.g. "},{"inlineContent":[{"text":"“75 percent”","type":"text"}],"type":"emphasis"},{"type":"text","text":", and is marked with the "},{"type":"codeVoice","code":".updatesFrequently"},{"type":"text","text":" trait so that assistive"},{"text":" ","type":"text"},{"text":"technologies know the value is changing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"type":"strong","inlineContent":[{"type":"text","text":"Full Keyboard Access"}]},{"type":"text","text":" focus, as no interaction is possible on a progress"},{"type":"text","text":" "},{"type":"text","text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via"},{"type":"text","text":" "},{"code":"accessibilityRespondsToUserInteraction(false)","type":"codeVoice"},{"text":"; on earlier OS versions, the semantic ","type":"text"},{"type":"codeVoice","code":".isStaticText"},{"text":" ","type":"text"},{"text":"trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"indeterminate"}]},{"type":"text","text":" mode, the view is hidden from VoiceOver ("},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"type":"text","text":") — and therefore"},{"type":"text","text":" "},{"type":"text","text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the"},{"type":"text","text":" "},{"type":"text","text":"element focusable would only pollute navigation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Animations are disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Colored-surfaces","text":"Colored surfaces","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When placed on an ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","isActive":true,"type":"reference"},{"text":", the indicator switches to a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"monochrome"}]},{"text":" rendering, the ","type":"text"},{"type":"codeVoice","code":"status"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]},{"name":"Version","content":[{"inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}],"type":"paragraph"}],"type":"aside","style":"note"},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}],"type":"aside","style":"note"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misocircularprogressindicator"]}],"metadata":{"platforms":[{"introducedAt":"15.0","deprecated":false,"unavailable":false,"beta":false,"name":"iOS"},{"introducedAt":"13.0","deprecated":false,"unavailable":false,"beta":false,"name":"macOS"},{"introducedAt":"16.0","deprecated":false,"unavailable":false,"beta":false,"name":"tvOS"},{"introducedAt":"1.0","deprecated":false,"unavailable":false,"beta":false,"name":"visionOS"},{"introducedAt":"11.0","deprecated":false,"unavailable":false,"beta":false,"name":"watchOS"}],"externalID":"s:14MISOComponents29MISOCircularProgressIndicatorV