{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOCircularProgressIndicator"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Variants","text":"Variants"},{"inlineContent":[{"type":"text","text":"Two variants are provided:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Determinate","type":"text"}]},{"type":"text","text":": the caller provides a "},{"code":"progress","type":"codeVoice"},{"type":"text","text":" value in "},{"code":"[0, 1]","type":"codeVoice"},{"type":"text","text":". Values outside this range are coerced."},{"type":"text","text":" "},{"type":"text","text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%."},{"type":"text","text":" "},{"type":"text","text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty."},{"type":"text","text":" "},{"type":"text","text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g."},{"type":"text","text":" "},{"type":"text","text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"type":"text","text":": no "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" is provided and the indicator loops continuously."},{"type":"text","text":" "},{"type":"text","text":"Shows that a process is active without indicating exact progress."},{"type":"text","text":" "},{"type":"text","text":"Used when the system cannot determine how long the task will take."},{"type":"text","text":" "},{"type":"text","text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen."},{"type":"text","text":" "},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."},{"type":"text","text":" "},{"type":"text","text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Statuses","anchor":"Statuses"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Neutral"}]},{"text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,","type":"text"},{"text":" ","type":"text"},{"text":"processing, synchronization or background tasks.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Accent","type":"text"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Positive","type":"text"}],"type":"strong"},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Info"}]},{"type":"text","text":": indicates informational or system-related processes (background synchronization, data retrieval)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Warning","type":"text"}],"type":"strong"},{"text":": indicates progress related to an operation that requires user attention or should be monitored.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Negative"}],"type":"strong"},{"text":": indicates progress related to an error, recovery, cancellation or failure.","type":"text"}]}]}]},{"type":"heading","anchor":"Gap-size","text":"Gap size","level":2},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"default"}],"type":"strong"},{"text":": standard gap between the indicator and the track (about 14° of arc).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"text":": reduced gap for a more compact appearance.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Track","anchor":"Track","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear"},{"text":" ","type":"text"},{"text":"structure. The track helps define the full range of progress and makes the value easier to read.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"text":": the track is hidden. Recommended when the indicator is embedded inside another component","type":"text"},{"text":" ","type":"text"},{"text":"(button, tag, toast) or when a more minimal appearance is needed.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","anchor":"Animation-determinate-mode-only","text":"Animation (determinate mode only)","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" (default), the determinate indicator progressively fills from "},{"type":"codeVoice","code":"0"},{"type":"text","text":" to the target"},{"type":"text","text":" "},{"type":"codeVoice","code":"progress"},{"type":"text","text":" on first display, and animates any subsequent change of "},{"type":"codeVoice","code":"progress"},{"type":"text","text":". When "},{"code":"animated","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"the indicator is displayed instantly at its target value with no animation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Animations are always disabled when "},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" or when Low Power Mode is enabled,"},{"type":"text","text":" "},{"type":"text","text":"regardless of the "},{"type":"codeVoice","code":"animated"},{"type":"text","text":" flag."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}]},{"anchor":"Helper-text","text":"Helper text","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"An optional text displayed below the circular indicator to provide context or additional information.","type":"text"},{"text":" ","type":"text"},{"text":"The helper text is always centered under the indicator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType"},{"type":"text","text":" which offers two variants:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".description(_:)"}],"type":"strong"},{"text":": Displays a simple description text without the progress percentage.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".percent(_:)","type":"codeVoice"}]},{"type":"text","text":": Displays the progress percentage with an optional description. The percentage"},{"type":"text","text":" "},{"type":"text","text":"value and its "},{"type":"codeVoice","code":"%"},{"type":"text","text":" symbol are assembled through the localized wording key"},{"type":"text","text":" "},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"type":"text","text":", so the symbol, its spacing and its position follow the"},{"type":"text","text":" "},{"type":"text","text":"typographic rules of the current language (e.g. "},{"type":"codeVoice","code":"\"75%\""},{"type":"text","text":" in English, "},{"type":"codeVoice","code":"\"75 %\""},{"type":"text","text":" in French, "},{"type":"codeVoice","code":"\"٪75\""},{"type":"text","text":" in Arabic)."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"text":" mode, the ","type":"text"},{"code":"helperText","type":"codeVoice"},{"text":" parameter is a simple ","type":"text"},{"code":"String?","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Code-samples","text":"Code samples","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    MISOCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    MISOCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    MISOCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    MISOCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    MISOCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    MISOCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    MISOCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    MISOCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    MISOCircularProgressIndicator()","    MISOCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    MISOCircularProgressIndicator(status: .info, helperText: \"Processing...\")"]},{"text":"Accessibility considerations","type":"heading","level":2,"anchor":"Accessibility-considerations"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"accessibility"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"accessibility.name"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"accessibility.state","type":"codeVoice"},{"text":": The state of the component (e.g., “downloading”, “step 1 of 4”)","type":"text"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"VoiceOver reads: "},{"inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}],"type":"strong"},{"type":"text","text":". Example: "},{"type":"emphasis","inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}]}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If "},{"code":"accessibility","type":"codeVoice"},{"type":"text","text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" mode, the view exposes the current progress as an accessibility value (percentage) so that"},{"type":"text","text":" "},{"type":"text","text":"VoiceOver reads e.g. "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“75 percent”"}]},{"text":", and is marked with the ","type":"text"},{"type":"codeVoice","code":".updatesFrequently"},{"text":" trait so that assistive","type":"text"},{"text":" ","type":"text"},{"text":"technologies know the value is changing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"type":"strong","inlineContent":[{"text":"Full Keyboard Access","type":"text"}]},{"type":"text","text":" focus, as no interaction is possible on a progress"},{"type":"text","text":" "},{"type":"text","text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"type":"text","text":"; on earlier OS versions, the semantic "},{"type":"codeVoice","code":".isStaticText"},{"type":"text","text":" "},{"type":"text","text":"trait is used."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"type":"text","text":"indeterminate"}],"type":"strong"},{"type":"text","text":" mode, the view is hidden from VoiceOver ("},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"type":"text","text":") — and therefore"},{"type":"text","text":" "},{"type":"text","text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the"},{"type":"text","text":" "},{"type":"text","text":"element focusable would only pollute navigation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"type":"codeVoice","code":"accessibilityReduceMotion"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" or when Low Power Mode is enabled.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Colored-surfaces","level":2,"text":"Colored surfaces"},{"type":"paragraph","inlineContent":[{"text":"When placed on an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","type":"reference"},{"text":", the indicator switches to a ","type":"text"},{"inlineContent":[{"type":"text","text":"monochrome"}],"type":"strong"},{"text":" rendering, the ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"1.2.0 (Figma component design version)"}]}],"name":"Version","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"OUDS 3.0.0"}]}],"name":"Since","style":"note"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"MISOCircularProgressIndicator"}],"symbolKind":"struct","externalID":"s:14MISOComponents29MISOCircularProgressIndicatorV","role":"symbol","roleHeading":"Structure","title":"MISOCircularProgressIndicator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOCircularProgressIndicator"}],"modules":[{"name":"Components"}],"platforms":[{"introducedAt":"15.0","deprecated":false,"name":"iOS","unavailable":false,"beta":false},{"introducedAt":"13.0","deprecated":false,"name":"macOS","unavailable":false,"beta":false},{"introducedAt":"16.0","deprecated":false,"name":"tvOS","unavailable":false,"beta":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"11.0","name":"watchOS","deprecated":false,"beta":false}]},"sections":[],"abstract":[{"type":"text","text":"A circular indicator shows the progress of a task using a circle."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"type":"text","text":"Useful when you need more visual focus or when space is limited."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misocircularprogressindicator"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"],"title":"Initializers"},{"anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/body"],"title":"Insta