{"identifier":{"url":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A circular indicator shows the progress of a task using a circle."},{"type":"text","text":" "},{"type":"text","text":"It can show a specific value (determinate) or just that something is in progress (indeterminate)."},{"type":"text","text":" "},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/misocomponents\/misocircularprogressindicator"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"role":"symbol","externalID":"s:14MISOComponents29MISOCircularProgressIndicatorV","modules":[{"name":"Components"}],"platforms":[{"introducedAt":"15.0","beta":false,"name":"iOS","deprecated":false,"unavailable":false},{"name":"macOS","deprecated":false,"beta":false,"introducedAt":"13.0","unavailable":false},{"name":"tvOS","deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false},{"name":"visionOS","deprecated":false,"beta":false,"introducedAt":"1.0","unavailable":false},{"name":"watchOS","deprecated":false,"beta":false,"introducedAt":"11.0","unavailable":false}],"title":"MISOCircularProgressIndicator","roleHeading":"Structure","navigatorTitle":[{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"symbolKind":"struct"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCircularProgressIndicator","kind":"identifier"}]}]},{"kind":"mentions","mentions":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Variants","text":"Variants"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two variants are provided:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Determinate"}],"type":"strong"},{"text":": the caller provides a ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" value in ","type":"text"},{"code":"[0, 1]","type":"codeVoice"},{"text":". Values outside this range are coerced.","type":"text"},{"text":" ","type":"text"},{"text":"Shows the exact progress of a task, usually as a percentage from 0% to 100%.","type":"text"},{"text":" ","type":"text"},{"text":"Provides clear and measurable feedback, helping users understand how long the task will take and reducing uncertainty.","type":"text"},{"text":" ","type":"text"},{"text":"Use determinate indicators whenever possible. Avoid indeterminate when progress can be measured, e.g.","type":"text"},{"text":" ","type":"text"},{"text":"when the progress value is known (e.g. file upload, installation, data sync) or when the system can estimate completion time or percentage","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Indeterminate","type":"text"}],"type":"strong"},{"text":": no ","type":"text"},{"type":"codeVoice","code":"progress"},{"text":" is provided and the indicator loops continuously.","type":"text"},{"text":" ","type":"text"},{"text":"Shows that a process is active without indicating exact progress.","type":"text"},{"text":" ","type":"text"},{"text":"Used when the system cannot determine how long the task will take.","type":"text"},{"text":" ","type":"text"},{"text":"Communicates that the system is working, even without precise data, and prevents users from thinking the interface is frozen.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"For long loading times (over 5 seconds), additional context must be provided."},{"type":"text","text":" "},{"text":"This helps inform users about the system state, reduces uncertainty, and prevents the interface from being perceived as unresponsive.","type":"text"}]}]}]},{"text":"Statuses","type":"heading","anchor":"Statuses","level":2},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Neutral"}],"type":"strong"},{"type":"text","text":": default status used when progress has no specific semantic meaning. Suitable for generic loading,"},{"type":"text","text":" "},{"type":"text","text":"processing, synchronization or background tasks."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Accent"}]},{"type":"text","text":": used to highlight primary or brand-related actions (uploads, downloads, installations, onboarding)."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Positive","type":"text"}],"type":"strong"},{"text":": indicates successful progress or a process leading to a successful outcome.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Info"}],"type":"strong"},{"text":": indicates informational or system-related processes (background synchronization, data retrieval).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Warning"}]},{"type":"text","text":": indicates progress related to an operation that requires user attention or should be monitored."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Negative"}]},{"type":"text","text":": indicates progress related to an error, recovery, cancellation or failure."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Gap size","anchor":"Gap-size","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"default","type":"text"}],"type":"strong"},{"text":": standard gap between the indicator and the track (about 14° of arc).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"small","type":"text"}]},{"text":": reduced gap for a more compact appearance.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Track","anchor":"Track","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"true"},{"text":" (default): the track is displayed. Recommended when the indicator is shown on its own and needs a clear","type":"text"},{"text":" ","type":"text"},{"text":"structure. The track helps define the full range of progress and makes the value easier to read.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":": the track is hidden. Recommended when the indicator is embedded inside another component"},{"type":"text","text":" "},{"type":"text","text":"(button, tag, toast) or when a more minimal appearance is needed."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Animation (determinate mode only)","anchor":"Animation-determinate-mode-only","type":"heading"},{"inlineContent":[{"type":"text","text":"When "},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" (default), the determinate indicator progressively fills from ","type":"text"},{"code":"0","type":"codeVoice"},{"text":" to the target","type":"text"},{"text":" ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":" on first display, and animates any subsequent change of ","type":"text"},{"code":"progress","type":"codeVoice"},{"text":". When ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the indicator is displayed instantly at its target value with no animation.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Animations are always disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled,","type":"text"},{"text":" ","type":"text"},{"text":"regardless of the ","type":"text"},{"code":"animated","type":"codeVoice"},{"text":" flag.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The indeterminate mode is not affected by this flag: its Android Material 3 animation is intrinsic to the mode."}]},{"type":"heading","text":"Helper text","level":2,"anchor":"Helper-text"},{"type":"paragraph","inlineContent":[{"text":"An optional text displayed below the circular indicator to provide context or additional information.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The helper text is always centered under the indicator."}]},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"determinate","type":"text"}]},{"type":"text","text":" mode, use "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType","isActive":true},{"type":"text","text":" which offers two variants:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".description(_:)","type":"codeVoice"}],"type":"strong"},{"text":": Displays a simple description text without the progress percentage.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".percent(_:)","type":"codeVoice"}],"type":"strong"},{"text":": Displays the progress percentage with an optional description. The percentage","type":"text"},{"text":" ","type":"text"},{"text":"value and its ","type":"text"},{"type":"codeVoice","code":"%"},{"text":" symbol are assembled through the localized wording key","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"core_progressIndicator_percent_value"},{"text":", so the symbol, its spacing and its position follow the","type":"text"},{"text":" ","type":"text"},{"text":"typographic rules of the current language (e.g. ","type":"text"},{"type":"codeVoice","code":"\"75%\""},{"text":" in English, ","type":"text"},{"type":"codeVoice","code":"\"75 %\""},{"text":" in French, ","type":"text"},{"type":"codeVoice","code":"\"٪75\""},{"text":" in Arabic).","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"In "},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"type":"text","text":" mode, the "},{"type":"codeVoice","code":"helperText"},{"type":"text","text":" parameter is a simple "},{"type":"codeVoice","code":"String?"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Code samples","anchor":"Code-samples"},{"code":["    \/\/ Determinate - default (neutral, with track, default gap, reveal animation on display)","    MISOCircularProgressIndicator(progress: 0.75)","","    \/\/ Determinate with an accent status and no track","    MISOCircularProgressIndicator(progress: 0.5, status: .accent, track: false)","","    \/\/ Determinate with a warning status and a small gap","    MISOCircularProgressIndicator(progress: 0.3, status: .warning, gapSize: .small)","","    \/\/ Determinate displayed instantly at its target value, without any animation","    MISOCircularProgressIndicator(progress: 0.75, animated: false)","","    \/\/ Determinate with helper text","    MISOCircularProgressIndicator(progress: 0.75, helperText: .description(\"Uploading...\"))","","    \/\/ Determinate with percentage and description","    MISOCircularProgressIndicator(progress: 0.75,","                                  helperText: .percent(\"of 100 MB\"))","","    \/\/ Determinate with accessibility name and state for VoiceOver","    MISOCircularProgressIndicator(progress: 0.75,","                                  accessibility: .init(name: \"download bar\", state: \"downloading\"))","","    \/\/ Determinate with accessibility and helper text","    MISOCircularProgressIndicator(progress: 0.5,","                                  accessibility: .init(name: \"progress bar\", state: \"step 1 of 4\"),","                                  helperText: .description(\"Loading...\"))","","    \/\/ Indeterminate","    MISOCircularProgressIndicator()","    MISOCircularProgressIndicator(status: .info)","","    \/\/ Indeterminate with helper text","    MISOCircularProgressIndicator(status: .info, helperText: \"Processing...\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Accessibility considerations","anchor":"Accessibility-considerations"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"accessibility"},{"text":" parameter to provide a custom name and state for VoiceOver:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"accessibility.name","type":"codeVoice"},{"text":": The name of the component (e.g., “progress bar”, “download bar”)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"accessibility.state"},{"type":"text","text":": The state of the component (e.g., “downloading”, “step 1 of 4”)"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"VoiceOver reads: ","type":"text"},{"inlineContent":[{"type":"text","text":"[name]. [state]. [helperText] [value]"}],"type":"strong"},{"text":". Example: ","type":"text"},{"inlineContent":[{"text":"“download bar. downloading. 75 percent”","type":"text"}],"type":"emphasis"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If ","type":"text"},{"code":"accessibility","type":"codeVoice"},{"text":" is not provided, the behavior is unchanged: only the helper text (if provided) is used as label.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"inlineContent":[{"type":"text","text":"determinate"}],"type":"strong"},{"text":" mode, the view exposes the current progress as an accessibility value (percentage) so that","type":"text"},{"text":" ","type":"text"},{"text":"VoiceOver reads e.g. ","type":"text"},{"inlineContent":[{"text":"“75 percent”","type":"text"}],"type":"emphasis"},{"text":", and is marked with the ","type":"text"},{"type":"codeVoice","code":".updatesFrequently"},{"text":" trait so that assistive","type":"text"},{"text":" ","type":"text"},{"text":"technologies know the value is changing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The indicator never captures "},{"type":"strong","inlineContent":[{"type":"text","text":"Full Keyboard Access"}]},{"type":"text","text":" focus, as no interaction is possible on a progress"},{"type":"text","text":" "},{"type":"text","text":"indicator. On iOS 17+ \/ macOS 14+ \/ visionOS 1+ \/ watchOS 10+ \/ tvOS 17+, this is enforced via"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessibilityRespondsToUserInteraction(false)"},{"type":"text","text":"; on earlier OS versions, the semantic "},{"type":"codeVoice","code":".isStaticText"},{"text":" ","type":"text"},{"text":"trait is used.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"inlineContent":[{"text":"indeterminate","type":"text"}],"type":"strong"},{"type":"text","text":" mode, the view is hidden from VoiceOver ("},{"code":".accessibilityHidden(true)","type":"codeVoice"},{"type":"text","text":") — and therefore"},{"type":"text","text":" "},{"type":"text","text":"also excluded from Full Keyboard Access navigation: there is no readable value to expose and keeping the"},{"type":"text","text":" "},{"type":"text","text":"element focusable would only pollute navigation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Animations are disabled when ","type":"text"},{"code":"accessibilityReduceMotion","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" or when Low Power Mode is enabled.","type":"text"}]}]}]},{"text":"Colored surfaces","level":2,"anchor":"Colored-surfaces","type":"heading"},{"inlineContent":[{"text":"When placed on an ","type":"text"},{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","isActive":true,"type":"reference"},{"text":", the indicator switches to a ","type":"text"},{"inlineContent":[{"text":"monochrome","type":"text"}],"type":"strong"},{"text":" rendering, the ","type":"text"},{"code":"status","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"ignored.","type":"text"}],"type":"paragraph"},{"name":"Version","content":[{"type":"paragraph","inlineContent":[{"text":"1.2.0 (Figma component design version)","type":"text"}]}],"style":"note","type":"aside"},{"name":"Since","content":[{"type":"paragraph","inlineContent":[{"text":"OUDS 3.0.0","type":"text"}]}],"style":"note","type":"aside"}]}],"topicSections":[{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(progress:status:track:gapSize:animated:size:helperText:accessibility:)","doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/init(status:track:gapSize:size:helperText:accessibility:)"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/body"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOCom