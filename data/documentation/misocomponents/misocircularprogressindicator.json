ypeIdentifier","text":"MISOCircularProgressIndicator"},{"kind":"text","text":"."},{"preciseIdentifier":"s:14MISOComponents29MISOCircularProgressIndicatorV14HelperTextTypeO","kind":"typeIdentifier","text":"HelperTextType"},{"text":"?, ","kind":"text"},{"text":"accessibility","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents30MISOAccessibilityConfigurationV","text":"MISOAccessibilityConfiguration","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Creates a "},{"inlineContent":[{"text":"determinate","type":"text"}],"type":"strong"},{"type":"text","text":" circular progress indicator."}]},"doc://MISOComponents/documentation/MISOComponents":{"images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"role":"collection"},"doc://MISOComponents/7SwiftUI4ViewP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/7SwiftUI4ViewP","title":"SwiftUICore.View"},"ic_folder_categories.png":{"alt":null,"variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}],"type":"image","identifier":"ic_folder_categories.png"}}}