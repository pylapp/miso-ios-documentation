t","text":" extensions and "},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}]},"doc://MISOComponents/documentation/MISOComponents/MISOColoredSurface":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOColoredSurface"}],"type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOColoredSurface","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MISOColoredSurface"}],"abstract":[{"text":"Used to define if a content is used on a colored surface.","type":"text"}],"title":"MISOColoredSurface","url":"\/documentation\/misocomponents\/misocoloredsurface"},"doc://MISOComponents/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/MISOComponents\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/View-Implementations":{"url":"\/documentation\/misocomponents\/misocircularprogressindicator\/view-implementations","role":"collectionGroup","abstract":[],"title":"View Implementations","kind":"article","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/View-Implementations","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator":{"url":"\/documentation\/misocomponents\/misocircularprogressindicator","abstract":[{"text":"A circular indicator shows the progress of a task using a circle.","type":"text"},{"text":" ","type":"text"},{"text":"It can show a specific value (determinate) or just that something is in progress (indeterminate).","type":"text"},{"text":" ","type":"text"},{"text":"Useful when you need more visual focus or when space is limited.","type":"text"}],"role":"symbol","title":"MISOCircularProgressIndicator","type":"topic","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator","kind":"symbol","navigatorTitle":[{"text":"MISOCircularProgressIndicator","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCircularProgressIndicator","kind":"identifier"}]},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/defaultSize":{"url":"\/documentation\/misocomponents\/misocircularprogressindicator\/defaultsize","role":"symbol","abstract":[{"type":"text","text":"The default component size (matches the Android reference implementation and Material 3 defaults)."}],"title":"defaultSize","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"defaultSize","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CGFloat","kind":"typeIdentifier","preciseIdentifier":"s:14CoreFoundation7CGFloatV"}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/defaultSize","type":"topic"},"doc://MISOComponents/documentation/MISOComponents/Indicators":{"role":"article","title":"Indicators","url":"\/documentation\/misocomponents\/indicators","images":[{"type":"icon","identifier":"ic_folder_categories.png"},{"type":"card","identifier":"ic_folder_categories.png"}],"kind":"article","type":"topic","abstract":[{"type":"text","text":"Some components can be used for "},{"type":"strong","inlineContent":[{"text":"indicators","type":"text"}]},{"type":"text","text":"."}],"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/Indicators"}}}