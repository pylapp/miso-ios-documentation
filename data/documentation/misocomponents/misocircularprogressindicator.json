r","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"text":", ","kind":"text"},{"text":"helperText","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?, ","kind":"text"},{"text":"accessibility","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:14MISOComponents30MISOAccessibilityConfigurationV","text":"MISOAccessibilityConfiguration","kind":"typeIdentifier"},{"text":"?)","kind":"text"}],"abstract":[{"text":"Creates an ","type":"text"},{"type":"strong","inlineContent":[{"text":"indeterminate","type":"text"}]},{"text":" circular progress indicator.","type":"text"}],"title":"init(status:track:gapSize:size:helperText:accessibility:)","type":"topic","url":"\/documentation\/misocomponents\/misocircularprogressindicator\/init(status:track:gapsize:size:helpertext:accessibility:)"},"doc://MISOComponents/documentation/MISOComponents/MISOCircularProgressIndicator/HelperTextType":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCircularProgressIndicator\/HelperTextType","navigatorTitle":[{"kind":"identifier","text":"HelperTextType"}],"url":"\/documentation\/misocomponents\/misocircularprogressindicator\/helpertexttype","role":"symbol","title":"MISOCircularProgressIndicator.HelperTextType","abstract":[{"type":"text","text":"The helper text can be added in "},{"type":"strong","inlineContent":[{"type":"text","text":"determinate"}]},{"type":"text","text":" indicator"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"HelperTextType"}],"kind":"symbol","type":"topic"},"doc://MISOComponents/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/MISOComponents\/s8SendableP","type":"unresolvable"},"ic_folder_categories.png":{"identifier":"ic_folder_categories.png","alt":null,"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/MISOComponents\/ic_folder_categories.png"}]},"doc://MISO