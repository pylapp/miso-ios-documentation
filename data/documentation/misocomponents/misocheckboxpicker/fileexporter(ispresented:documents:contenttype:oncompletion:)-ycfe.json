kboxPicker":{"abstract":[{"type":"text","text":"A picker allowing to expose several checkboxes and select some of them within the others."},{"type":"text","text":" "},{"type":"text","text":"Each checkbox contains a “tag”, i.e. a supposed to be unique value."},{"type":"text","text":" "},{"type":"text","text":"The picker will expose the choosen values using this “tag”."},{"type":"text","text":" "},{"type":"text","text":"It has also some configuration elements which will override the one applied to nested "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","isActive":true},{"type":"text","text":" (divider, read only and error mode, layout and outlined)"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"MISOCheckboxPicker","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misocheckboxpicker","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCheckboxPicker","kind":"identifier"}],"title":"MISOCheckboxPicker"},"doc://MISOComponents/documentation/MISOComponents/MISOCheckboxItem":{"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","title":"MISOCheckboxItem","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices."},{"text":" ","type":"text"},{"text":"Checkbox item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets.","type":"text"}],"url":"\/documentation\/misocomponents\/misocheckboxitem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOCheckboxItem"}],"navigatorTitle":[{"kind":"identifier","text":"MISOCheckboxItem"}]},"ic_folder_categories.png":{"type":"image","identifi