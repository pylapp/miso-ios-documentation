documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOCheckboxPicker":{"abstract":[{"text":"A picker allowing to expose several checkboxes and select some of them within the others.","type":"text"},{"text":" ","type":"text"},{"text":"Each checkbox contains a “tag”, i.e. a supposed to be unique value.","type":"text"},{"text":" ","type":"text"},{"text":"The picker will expose the choosen values using this “tag”.","type":"text"},{"type":"text","text":" "},{"text":"It has also some configuration elements which will override the one applied to nested ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem"},{"text":" (divider, read only and error mode, layout and outlined)","type":"text"}],"url":"\/documentation\/misocomponents\/misocheckboxpicker","title":"MISOCheckboxPicker","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"MISOCheckboxPicker","kind":"identifier"}],"navigatorTitle":[{"text":"MISOCheckboxPicker","kind":"identifier"}]},"doc://MISOThemesContract/documentation/MISOThemesContract/MISOTheme":{"url":"\/documentation\/misothemescontract\/misotheme","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","kind":"symbol","title":"MISOTheme","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOTheme","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"MISOTheme","kind":"identifier"}],"abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"object oriented paradigm"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"type":"text","text":"theme contract"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"final"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}]},"ic_folder_categories.png":{"alt":null,"type":"image","identifier":"ic_folder_categories.png","variants":[{"url":"\/images\/MISOComponents\/ic_folder_categories.png","traits":["1x","light"]}]}}}