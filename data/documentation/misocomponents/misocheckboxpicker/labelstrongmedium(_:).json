,"title":"MISOTheme","navigatorTitle":[{"kind":"identifier","text":"MISOTheme"}],"kind":"symbol","url":"\/documentation\/misothemescontract\/misotheme","type":"topic","abstract":[{"type":"text","text":"This is a basic theme any theme must be a subclass off, or all themes must have as ancestor."},{"type":"text","text":" "},{"type":"text","text":"A Swift "},{"type":"codeVoice","code":"class"},{"type":"text","text":" has been used so as to allow to easily override some attributes and have inheritance, without having for developers"},{"type":"text","text":" "},{"type":"text","text":"to implement all tokens."},{"type":"text","text":" "},{"type":"text","text":"Any properties of an overridable theme should be defined so as to provide defaults values."},{"type":"text","text":" "},{"type":"text","text":"We allow this theme to be derivated and be overridden."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/MISOThemesContract\/documentation\/MISOThemesContract\/MISOTheme","isActive":true},{"type":"text","text":" can be seen as a kind of “abstract class” in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"object oriented paradigm"}]},{"type":"text","text":", or "},{"type":"emphasis","inlineContent":[{"text":"theme contract","type":"text"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because "},{"type":"codeVoice","code":"MISOTheme"},{"type":"text","text":" is not a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"final"}]},{"type":"text","text":" class, its type cannot be seen as "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", that is the reason why this conformity is unchecked."}]},"doc://MISOComponents/documentation/MISOComponents":{"role":"collection","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","url":"\/documentation\/misocomponents","abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"text":" extensions and ","type":"text"},{"code":"ViewModifiers","type":"codeVoice"},{"text":" to apply tokens and styles on components and higher-level views.","type":"text"}],"kind":"symbol","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"type":"topic","title":"Components"},"doc://MISOComponents/documentation/MISOComponents/MISOCheckboxPicker":{"abstract":[{"type":"text","text":"A picker allowing to expose several checkboxes and select some of them within the others."},{"type":"text","text":" "},{"type":"text","text":"Each checkbox contains a “tag”, i.e. a supposed to be unique value."},{"type":"text","text":" "},{"type":"text","text":"The picker will expose the choosen values using this “tag”."},{"type":"text","text":" "},{"type":"text","text":"It has also some configuration elements which will override the one applied to nested "},{"type":"reference","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","isActive":true},{"type":"text","text":" (divider, read only and error mode, layout and outlined)"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"MISOCheckboxPicker","kind":"identifier"}],"url":"\/documentation\/misocomponents\/misocheckboxpicker","role":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxPicker","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MISOCheckboxPicker","kind":"identifier"}],"title":"MISOCheckboxPicker"}}}