xt":", that is the reason why this conformity is unchecked."}]},"doc://MISOComponents/documentation/MISOComponents":{"abstract":[{"type":"text","text":"The catalog of all components provided by MISO. It contains also "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extensions and "},{"type":"codeVoice","code":"ViewModifiers"},{"type":"text","text":" to apply tokens and styles on components and higher-level views."}],"type":"topic","url":"\/documentation\/misocomponents","title":"Components","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents","role":"collection","images":[{"type":"icon","identifier":"ic_folder_categories.png"}],"kind":"symbol"},"doc://MISOComponents/documentation/MISOComponents/MISOCheckboxItem":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxItem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOCheckboxItem"}],"abstract":[{"text":"Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices.","type":"text"},{"text":" ","type":"text"},{"text":"Checkbox item covers a wider range of contexts by allowing to toggle the visibility of additional text labels and icon assets.","type":"text"}],"type":"topic","url":"\/documentation\/misocomponents\/misocheckboxitem","title":"MISOCheckboxItem","navigatorTitle":[{"kind":"identifier","text":"MISOCheckboxItem"}]}}}