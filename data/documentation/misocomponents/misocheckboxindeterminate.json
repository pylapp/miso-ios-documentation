{"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/MISOComponents\/s8SendableP","doc:\/\/MISOComponents\/s16SendableMetatypeP","doc:\/\/MISOComponents\/7SwiftUI4ViewP"],"type":"conformsTo"}],"metadata":{"role":"symbol","platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"15.0","beta":false,"name":"iOS"},{"deprecated":false,"unavailable":false,"introducedAt":"13.0","beta":false,"name":"macOS"},{"deprecated":false,"unavailable":false,"introducedAt":"16.0","beta":false,"name":"tvOS"},{"deprecated":false,"unavailable":false,"introducedAt":"1.0","beta":false,"name":"visionOS"},{"deprecated":false,"unavailable":false,"introducedAt":"11.0","beta":false,"name":"watchOS"}],"symbolKind":"struct","externalID":"s:14MISOComponents25MISOCheckboxIndeterminateV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MISOCheckboxIndeterminate"}],"navigatorTitle":[{"kind":"identifier","text":"MISOCheckboxIndeterminate"}],"title":"MISOCheckboxIndeterminate","modules":[{"name":"Components"}],"roleHeading":"Structure"},"variants":[{"paths":["\/documentation\/misocomponents\/misocheckboxindeterminate"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/MISOComponents\/documentation\/MISOComponents"]]},"abstract":[{"type":"text","text":"Checkbox is a UI element that allows to select multiple options from a set of mutually non exclusive choices."},{"type":"text","text":" "},{"type":"text","text":"Checkbox that does not show icon or text, provides greater flexibility when creating other components that require a checkbox to be displayed."}],"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/MISOComponents\/documentation\/MISOComponents\/MISOCheckboxIndeterminate\/init(selection:accessibilityLabel:isError:isReadOnly:)","doc:\/\/M